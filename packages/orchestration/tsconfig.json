{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@letbuyy/distributed-runtime": [
        "../distributed-runtime/src/index.ts"
      ],
      "@letbuyy/event-core": [
        "../event-core/src/index.ts"
      ],
      "@letbuyy/shared-types": [
        "../shared-types/src/index.ts"
      ]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../distributed-runtime"
    },
    {
      "path": "../event-core"
    },
    {
      "path": "../shared-types"
    }
  ]
}
