{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@letbuyy/application-services": [
        "../application-services/src/index.ts"
      ],
      "@letbuyy/checkout-core": [
        "../checkout-core/src/index.ts"
      ],
      "@letbuyy/cms-core": [
        "../cms-core/src/index.ts"
      ],
      "@letbuyy/commerce-core": [
        "../commerce-core/src/index.ts"
      ],
      "@letbuyy/distributed-runtime": [
        "../distributed-runtime/src/index.ts"
      ],
      "@letbuyy/event-core": [
        "../event-core/src/index.ts"
      ],
      "@letbuyy/infrastructure/*": [
        "../infrastructure/*/index.ts"
      ],
      "@letbuyy/projection-runtime": [
        "../projection-runtime/src/index.ts"
      ],
      "@letbuyy/search-core": [
        "../search-core/src/index.ts"
      ],
      "@letbuyy/shared-types": [
        "../shared-types/src/index.ts"
      ],
      "@letbuyy/tenant-core": [
        "../tenant-core/src/index.ts"
      ],
      "@letbuyy/theme-engine": [
        "../theme-engine/src/index.ts"
      ]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "*-query-layer/**/*.ts",
    "*-adapter/**/*.ts"
  ],
  "references": [
    {
      "path": "../application-services"
    },
    {
      "path": "../checkout-core"
    },
    {
      "path": "../cms-core"
    },
    {
      "path": "../commerce-core"
    },
    {
      "path": "../infrastructure"
    },
    {
      "path": "../projection-runtime"
    },
    {
      "path": "../search-core"
    },
    {
      "path": "../shared-types"
    },
    {
      "path": "../tenant-core"
    },
    {
      "path": "../theme-engine"
    }
  ]
}
