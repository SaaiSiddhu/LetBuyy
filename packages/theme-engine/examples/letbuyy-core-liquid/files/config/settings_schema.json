{
  "schema_version": "2026-05-json-contract",
  "settings": {
    "colors": {
      "label": "Colors",
      "description": "LetBuyy Core storefront color tokens.",
      "fields": {
        "primaryColor": {
          "type": "color",
          "label": "Primary color",
          "default": "#8B5CF6"
        },
        "secondaryColor": {
          "type": "color",
          "label": "Secondary color",
          "default": "#3B82F6"
        },
        "accentColor": {
          "type": "color",
          "label": "Accent color",
          "default": "#F59E0B"
        },
        "backgroundColor": {
          "type": "color",
          "label": "Background color",
          "default": "#FFFFFF"
        },
        "textColor": {
          "type": "color",
          "label": "Text color",
          "default": "#1F2937"
        },
        "surfaceColor": {
          "type": "color",
          "label": "Surface color",
          "default": "#F8FAFC"
        }
      }
    },
    "typography": {
      "label": "Typography",
      "description": "First-party type settings mirrored from the JSON-contract LetBuyy Core theme.",
      "fields": {
        "headingFontFamily": {
          "type": "text",
          "label": "Heading font",
          "default": "Inter"
        },
        "bodyFontFamily": {
          "type": "text",
          "label": "Body font",
          "default": "Inter"
        }
      }
    },
    "appearance": {
      "label": "Appearance",
      "description": "Layout tokens shared by every section.",
      "fields": {
        "borderRadius": {
          "type": "number",
          "label": "Corner radius",
          "default": 12
        }
      }
    },
    "seo": {
      "label": "SEO and social",
      "description": "Metadata rendered into <head> by the theme layout.",
      "fields": {
        "metaDescription": {
          "type": "textarea",
          "label": "Meta description",
          "default": "",
          "info": "Falls back to the shop description. Truncated to 160 characters on output.",
          "maxLength": 160
        },
        "socialImageUrl": {
          "type": "url",
          "label": "Social share image URL",
          "default": "",
          "info": "Used for og:image and twitter:image. Left empty until the merchant uploads one."
        },
        "faviconUrl": {
          "type": "url",
          "label": "Favicon URL",
          "default": "",
          "info": "Rendered as <link rel=\"icon\">. Left empty until the merchant uploads one."
        }
      }
    }
  }
}