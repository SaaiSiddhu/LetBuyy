    "featured-collection-default": {
      "type": "featured-products",
      "settings": {
        "title": "Drop-ready collection",
        "subtitle": "Curated items for the first storefront launch.",
        "viewAllLabel": "View collection",
        "viewAllHref": "/collections/new-arrivals"
      },
      "blocks": {
        "product-sneaker": {
          "type": "product-card",
          "settings": {
            "title": "Velocity Runner",
            "price": "Rs 4,999",
            "url": "/products/velocity-runner"
          },
          "disabled": false
        },
        "product-hoodie": {
          "type": "product-card",
          "settings": {
            "title": "Everyday Hoodie",
            "price": "Rs 2,499",
            "url": "/products/everyday-hoodie"
          },
          "disabled": false
        },
        "product-cap": {
          "type": "product-card",
          "settings": {
            "title": "Street Cap",
            "price": "Rs 899",
            "url": "/products/street-cap"
          },
          "disabled": false
        }
      },
      "block_order": [
        "product-sneaker",
        "product-hoodie",
        "product-cap"
      ],
      "disabled": false
