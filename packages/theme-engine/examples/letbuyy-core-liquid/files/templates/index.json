{
  "name": "LetBuyy Core home page",
  "layout": "theme",
  "sections": {
    "banner-carousel-default": {
      "type": "banner-carousel",
      "settings": {
        "title": "This week",
        "autoplay": true
      },
      "blocks": {
        "carousel-monsoon": {
          "type": "slide",
          "settings": {
            "heading": "Monsoon-ready sneakers, restocked",
            "link": "/collections/new-arrivals"
          },
          "disabled": false,
          "blocks": {},
          "block_order": []
        },
        "carousel-apparel": {
          "type": "slide",
          "settings": {
            "heading": "Apparel drop: up to 30% off",
            "link": "/products"
          },
          "disabled": false,
          "blocks": {},
          "block_order": []
        }
      },
      "block_order": [
        "carousel-monsoon",
        "carousel-apparel"
      ],
      "disabled": false
    },
    "hero-default": {
      "type": "hero-banner",
      "settings": {
        "eyebrow": "New season essentials",
        "heading": "Fresh drops for daily buyers",
        "subheading": "Launch-ready sneakers, apparel, and accessories for a commerce storefront.",
        "ctaText": "Shop Now",
        "ctaLink": "/products",
        "height": "full",
        "textAlign": "center",
        "overlay": 0.4
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "category-grid-default": {
      "type": "category-grid",
      "settings": {
        "title": "Shop by style",
        "subtitle": "Launch-ready groupings for daily buyers."
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "featured-collection-default": {
      "type": "featured-products",
      "settings": {
        "title": "Drop-ready collection",
        "subtitle": "Curated items for the first storefront launch.",
        "viewAllLabel": "View collection",
        "viewAllHref": "/collections/new-arrivals",
        "productLimit": 3
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "product-grid-default": {
      "type": "product-grid",
      "settings": {
        "title": "Featured Products",
        "subtitle": "Products selected from your catalog.",
        "columns": 4,
        "productLimit": 8
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "video-hero-default": {
      "type": "video-hero",
      "settings": {
        "heading": "See the fit in motion",
        "subheading": "A quick look at how each drop moves, from the box to your feet."
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "spotlight-default": {
      "type": "spotlight",
      "settings": {
        "heading": "Made for daily buyers",
        "subheading": "A little extra with every order."
      },
      "blocks": {
        "spotlight-badge": {
          "type": "badge",
          "settings": {
            "label": "New"
          },
          "disabled": false,
          "blocks": {},
          "block_order": []
        },
        "spotlight-app": {
          "type": "@app",
          "settings": {
            "extension_handle": "letbuyy-core-offer",
            "slot": "home.spotlight.offer"
          },
          "disabled": false,
          "blocks": {},
          "block_order": []
        }
      },
      "block_order": [
        "spotlight-badge",
        "spotlight-app"
      ],
      "disabled": false
    },
    "testimonials-default": {
      "type": "testimonials",
      "settings": {
        "title": "What our buyers say"
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "newsletter-default": {
      "type": "newsletter-signup",
      "settings": {
        "title": "Get first access",
        "subtitle": "Store updates, new drops, and offers sent to your inbox.",
        "buttonLabel": "Sign up"
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    }
  },
  "order": [
    "banner-carousel-default",
    "hero-default",
    "category-grid-default",
    "featured-collection-default",
    "product-grid-default",
    "video-hero-default",
    "spotlight-default",
    "testimonials-default",
    "newsletter-default"
  ]
}