{
  "name": "LetBuyy Core home page",
  "layout": "theme",
  "sections": {
    "announcement-default": {
      "type": "announcement-bar",
      "settings": {
        "text": "Free shipping on fresh drops this week.",
        "linkLabel": "Shop now",
        "linkHref": "/products"
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "hero-default": {
      "type": "hero-banner",
      "settings": {
        "eyebrow": "New season essentials",
        "heading": "Fresh drops for daily buyers",
        "subheading": "Launch-ready sneakers, apparel, and accessories for a commerce storefront.",
        "ctaText": "Shop Now",
        "ctaLink": "/products",
        "height": "full",
        "textAlign": "center",
        "overlay": 0.4
      },
      "blocks": {},
      "block_order": [],
      "disabled": false
    },
    "category-grid-default": {
      "type": "category-grid",
      "settings": {
        "title": "Shop by style",
        "subtitle": "Launch-ready groupings for daily buyers."
      },
      "blocks": {
        "category-sneakers": {
          "type": "category",
          "settings": {
            "name": "Sneakers",
            "slug": "sneakers",
            "tagline": "Fresh pairs"
          },
          "disabled": false
        },
        "category-apparel": {
          "type": "category",
          "settings": {
            "name": "Apparel",
            "slug": "apparel",
            "tagline": "Daily fits"
          },
          "disabled": false
        },
        "category-accessories": {
          "type": "category",
          "settings": {
