    "product-grid-default": {
      "type": "product-grid",
      "settings": {
        "title": "Featured Products",
        "subtitle": "Products selected from your catalog.",
        "columns": 4
      },
      "blocks": {
        "grid-sneaker": {
          "type": "product-card",
          "settings": {
            "title": "Court Sneaker",
            "price": "Rs 3,499",
            "url": "/products/court-sneaker"
          },
          "disabled": false
        },
        "grid-backpack": {
          "type": "product-card",
          "settings": {
            "title": "Transit Backpack",
            "price": "Rs 1,999",
            "url": "/products/transit-backpack"
          },
          "disabled": false
        }
      },
      "block_order": [
        "grid-sneaker",
        "grid-backpack"
