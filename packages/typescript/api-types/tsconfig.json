{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@letbuyy/app-engine": [
        "../../app-engine/src/index.ts"
      ],
      "@letbuyy/auth-core": [
        "../../auth-core/src/index.ts"
      ],
      "@letbuyy/billing-core": [
        "../../billing-core/src/index.ts"
      ],
      "@letbuyy/checkout-core": [
        "../../checkout-core/src/index.ts"
      ],
      "@letbuyy/cms-core": [
        "../../cms-core/src/index.ts"
      ],
      "@letbuyy/commerce-core": [
        "../../commerce-core/src/index.ts"
      ],
      "@letbuyy/event-core": [
        "../../event-core/src/index.ts"
      ],
      "@letbuyy/notification-core": [
        "../../notification-core/src/index.ts"
      ],
      "@letbuyy/payments": [
        "../../payments/src/index.ts"
      ],
      "@letbuyy/search-core": [
        "../../search-core/src/index.ts"
      ],
      "@letbuyy/shared-types": [
        "../../shared-types/src/index.ts"
      ],
      "@letbuyy/tenant-core": [
        "../../tenant-core/src/index.ts"
      ],
      "@letbuyy/theme-engine": [
        "../../theme-engine/src/index.ts"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../../app-engine"
    },
    {
      "path": "../../auth-core"
    },
    {
      "path": "../../billing-core"
    },
    {
      "path": "../../checkout-core"
    },
    {
      "path": "../../cms-core"
    },
    {
      "path": "../../commerce-core"
    },
    {
      "path": "../../event-core"
    },
    {
      "path": "../../notification-core"
    },
    {
      "path": "../../payments"
    },
    {
      "path": "../../search-core"
    },
    {
      "path": "../../shared-types"
    },
    {
      "path": "../../tenant-core"
    },
    {
      "path": "../../theme-engine"
    }
  ]
}
