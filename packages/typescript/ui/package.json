{
  "name": "@letbuyy/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.dist.json",
    "test": "vitest run --config vitest.config.ts",
    "test:visual": "node tests/visual/storybook-visual-regression.mjs",
    "test:visual:update": "node tests/visual/storybook-visual-regression.mjs --update",
    "test:watch": "vitest --config vitest.config.ts",
    "snapshot:aliases:update": "node tests/validators/ui-no-new-token-alias-validator.mjs --update",
    "snapshot:api:update": "node tests/validators/ui-public-api-snapshot-validator.mjs --update",
    "snapshot:tokens:update": "node tests/validators/ui-token-variable-snapshot-validator.mjs --update",
    "validate:aliases": "node tests/validators/ui-no-new-token-alias-validator.mjs",
    "validate:api": "node tests/validators/ui-public-api-snapshot-validator.mjs",
    "validate:tokens": "node tests/validators/ui-token-variable-snapshot-validator.mjs",
    "validate:ui": "pnpm test && pnpm validate:api && pnpm validate:tokens && pnpm validate:aliases",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/react-vite": "10.4.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19",
    "@types/react-dom": "19.2.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.4.1",
    "tailwindcss": "4.3.0",
    "typescript": "^5.7.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}
