{
  "name": "@letbuyy/ui",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./formatting": "./src/formatting.ts",
    "./logging": "./src/logging.ts",
    "./marketplace": "./src/marketplace.tsx",
    "./preview": "./src/preview.tsx",
    "./tokens": "./src/tokens.ts",
    "./turnstile": "./src/turnstile.tsx",
    "./turnstile-client": "./src/turnstile-client.ts"
  },
  "files": [
    "dist",
    "src",
    "eslint",
    "codemods",
    "assets",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./formatting": {
        "types": "./dist/formatting.d.ts",
        "default": "./dist/formatting.js"
      },
      "./logging": {
        "types": "./dist/logging.d.ts",
        "default": "./dist/logging.js"
      },
      "./marketplace": {
        "types": "./dist/marketplace.d.ts",
        "default": "./dist/marketplace.js"
      },
      "./preview": {
        "types": "./dist/preview.d.ts",
        "default": "./dist/preview.js"
      },
      "./tokens": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.js"
      },
      "./turnstile": {
        "types": "./dist/turnstile.d.ts",
        "default": "./dist/turnstile.js"
      },
      "./turnstile-client": {
        "types": "./dist/turnstile-client.d.ts",
        "default": "./dist/turnstile-client.js"
      }
    }
  },
  "scripts": {
    "dev": "storybook dev --port 9009 --no-open",
    "build": "tsc -b && tsc -p tsconfig.dist.json",
    "test": "vitest run --config vitest.config.ts",
    "test:codemods": "node codemods/dry-run.mjs",
    "migrate": "node codemods/cli.mjs",
    "generate:mobile-tokens": "node ../../../scripts/generators/generate-mobile-tokens.mjs",
    "test:eslint-rules": "node eslint/rules.test.mjs",
    "test:visual": "node tests/visual/storybook-visual-regression.mjs",
    "test:visual:update": "node tests/visual/storybook-visual-regression.mjs --update",
    "test:watch": "vitest --config vitest.config.ts",
    "snapshot:aliases:update": "node tests/validators/ui-no-new-token-alias-validator.mjs --update",
    "snapshot:api:update": "node tests/validators/ui-public-api-snapshot-validator.mjs --update",
    "snapshot:tokens:update": "node tests/validators/ui-token-variable-snapshot-validator.mjs --update",
    "validate:aliases": "node tests/validators/ui-no-new-token-alias-validator.mjs",
    "validate:api": "node tests/validators/ui-public-api-snapshot-validator.mjs",
    "validate:tokens": "node tests/validators/ui-token-variable-snapshot-validator.mjs",
    "validate:ui": "pnpm test && pnpm test:eslint-rules && pnpm test:codemods && pnpm validate:api && pnpm validate:tokens && pnpm validate:aliases",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build",
    "lint:css": "stylelint \"src/**/*.css\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.562.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/react-vite": "10.4.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19",
    "@types/react-dom": "19.2.3",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "storybook": "10.4.1",
    "tailwindcss": "4.3.0",
    "typescript": "^5.7.0",
    "vite": "8.1.6",
    "vitest": "^4.1.8",
    "@tailwindcss/vite": "4.3.0"
  }
}
