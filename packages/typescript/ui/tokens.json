{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "LetBuyy design tokens — W3C Design Token Community Group (DTCG) interchange format. This file is the canonical INTERCHANGE artifact for Figma and cross-platform code generation. The authoring source of truth remains packages/typescript/ui/src/tokens.ts; this file is kept in parity with it by scripts/generators/generate-design-tokens.mjs (run with --check in CI). Do not hand-edit values out of sync with tokens.ts.",
  "color": {
    "$type": "color",
    "primitive": {
      "$description": "Raw palette. Private — compose semantic tokens from these, never reference primitives directly in product code.",
      "purple": {
        "100": { "$value": "#EDE9FE" },
        "200": { "$value": "#DDD6FE" },
        "300": { "$value": "#C4B5FD" },
        "400": { "$value": "#A78BFA" },
        "500": { "$value": "#8B5CF6" },
        "600": { "$value": "#7C3AED" },
        "700": { "$value": "#6D28D9" },
        "800": { "$value": "#5B21B6" },
        "900": { "$value": "#4C1D95" }
      },
      "gray": {
        "50": { "$value": "#F9FAFB" },
        "100": { "$value": "#F5F5F7" },
        "125": { "$value": "#F6F7F9" },
        "150": { "$value": "#EFEFF1" },
        "175": { "$value": "#F1F2F4" },
        "200": { "$value": "#E5E7EB" },
        "300": { "$value": "#D1D5DB" },
        "400": { "$value": "#94A3B8" },
        "500": { "$value": "#6B7280" },
        "600": { "$value": "#4B5563" },
        "700": { "$value": "#374151" },
        "800": { "$value": "#1F2937" },
        "900": { "$value": "#111827" }
      },
      "slate": {
        "50": { "$value": "#F8FAFC" },
        "100": { "$value": "#F1F5F9" },
        "200": { "$value": "#E2E8F0" },
        "300": { "$value": "#CBD5E1" },
        "400": { "$value": "#94A3B8" },
        "500": { "$value": "#64748B" },
        "600": { "$value": "#475569" },
        "700": { "$value": "#334155" },
        "800": { "$value": "#1E293B" },
        "850": { "$value": "#1F2937" },
        "900": { "$value": "#0F172A" },
        "950": { "$value": "#0A0F1A" }
      },
      "green": { "100": { "$value": "#DCFCE7" }, "500": { "$value": "#22C55E" }, "700": { "$value": "#15803D" }, "950": { "$value": "#052E16" } },
      "amber": { "100": { "$value": "#FEF3C7" }, "500": { "$value": "#F59E0B" }, "800": { "$value": "#92400E" }, "950": { "$value": "#422006" } },
      "red": { "100": { "$value": "#FEE2E2" }, "300": { "$value": "#FCA5A5" }, "500": { "$value": "#EF4444" }, "600": { "$value": "#DC2626" }, "700": { "$value": "#B91C1C" }, "950": { "$value": "#451A1A" } },
      "pink": { "300": { "$value": "#F9A8D4" }, "400": { "$value": "#F472B6" }, "500": { "$value": "#EC4899" }, "600": { "$value": "#DB2777" }, "700": { "$value": "#BE185D" } },
      "blue": { "100": { "$value": "#E0F2FE" }, "300": { "$value": "#7DD3FC" }, "500": { "$value": "#3B82F6" }, "700": { "$value": "#1D4ED8" }, "950": { "$value": "#082F49" } },
      "cyan": { "500": { "$value": "#06B6D4" } },
      "teal": { "500": { "$value": "#14B8A6" } },
      "emerald": { "500": { "$value": "#10B981" } },
      "white": { "$value": "#FFFFFF" },
      "black": { "$value": "#000000" }
    },
    "semantic": {
      "$description": "Public alias tokens. light + dark color schemes. These map onto --lb-color-* CSS variables emitted by tokens.ts.",
      "light": {
        "bg": { "$value": "{color.primitive.gray.125}" },
        "surface": { "$value": "{color.primitive.white}" },
        "surface-subdued": { "$value": "{color.primitive.gray.50}" },
        "card": { "$value": "{color.primitive.white}" },
        "sidebar": { "$value": "{color.primitive.gray.175}" },
        "text": { "$value": "{color.primitive.gray.900}" },
        "text-subdued": { "$value": "{color.primitive.gray.500}" },
        "text-inverse": { "$value": "{color.primitive.white}" },
        "border": { "$value": "{color.primitive.gray.200}" },
        "primary": { "$value": "{color.primitive.purple.500}" },
        "primary-cta": { "$value": "{color.primitive.purple.700}" },
        "primary-text": { "$value": "{color.primitive.purple.700}" },
        "critical": { "$value": "{color.primitive.red.500}" },
        "success": { "$value": "{color.primitive.green.500}" },
        "warning": { "$value": "{color.primitive.amber.500}" },
        "info": { "$value": "{color.primitive.blue.500}" },
        "focus-ring": { "$value": "{color.primitive.purple.800}" }
      },
      "dark": {
        "bg": { "$value": "{color.primitive.gray.900}" },
        "surface": { "$value": "{color.primitive.gray.900}" },
        "surface-subdued": { "$value": "{color.primitive.slate.950}" },
        "card": { "$value": "{color.primitive.slate.850}" },
        "sidebar": { "$value": "{color.primitive.slate.900}" },
        "text": { "$value": "{color.primitive.white}" },
        "text-subdued": { "$value": "{color.primitive.slate.300}" },
        "text-inverse": { "$value": "{color.primitive.gray.900}" },
        "border": { "$value": "{color.primitive.slate.700}" },
        "primary": { "$value": "{color.primitive.purple.500}" },
        "primary-cta": { "$value": "{color.primitive.purple.700}" },
        "primary-text": { "$value": "{color.primitive.purple.300}" },
        "critical": { "$value": "{color.primitive.red.500}" },
        "success": { "$value": "{color.primitive.green.500}" },
        "warning": { "$value": "{color.primitive.amber.500}" },
        "info": { "$value": "{color.primitive.blue.500}" },
        "focus-ring": { "$value": "{color.primitive.purple.500}" }
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "$description": "12-step spacing scale → --lb-space-*.",
      "none": { "$value": "0" },
      "2xs": { "$value": "2px" },
      "xs": { "$value": "4px" },
      "xs-plus": { "$value": "6px" },
      "sm": { "$value": "8px" },
      "md": { "$value": "12px" },
      "lg": { "$value": "16px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "32px" },
      "4xl": { "$value": "40px" },
      "5xl": { "$value": "48px" },
      "6xl": { "$value": "64px" },
      "7xl": { "$value": "96px" }
    },
    "radius": {
      "sm": { "$value": "4px" },
      "md": { "$value": "8px" },
      "lg": { "$value": "12px" },
      "xl": { "$value": "16px" },
      "full": { "$value": "999px" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "body": { "$value": "var(--font-letbuyy-sans), ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
      "display": { "$value": "var(--font-letbuyy-display), var(--font-letbuyy-sans), ui-sans-serif, system-ui, sans-serif" },
      "mono": { "$value": "var(--font-letbuyy-mono), \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace" }
    },
    "fontSize": {
      "$type": "dimension",
      "display": { "$value": "32px" },
      "h1": { "$value": "28px" },
      "h2": { "$value": "24px" },
      "h3": { "$value": "20px" },
      "h4": { "$value": "18px" },
      "page-title": { "$value": "24px" },
      "section-title": { "$value": "18px" },
      "card-title": { "$value": "16px" },
      "body-large": { "$value": "16px" },
      "body": { "$value": "14px" },
      "secondary": { "$value": "13px" },
      "caption": { "$value": "12px" }
    },
    "lineHeight": {
      "$type": "dimension",
      "page-title": { "$value": "32px" },
      "section-title": { "$value": "24px" },
      "card-title": { "$value": "20px" },
      "body-large": { "$value": "24px" },
      "body": { "$value": "20px" },
      "secondary": { "$value": "18px" },
      "caption": { "$value": "16px" }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "density": {
    "$type": "dimension",
    "$description": "Three density presets → --lb-density-*. Values shown are the canonical control/layout dimensions.",
    "compact": {
      "input-height": { "$value": "36px" },
      "button-height": { "$value": "36px" },
      "table-row-height": { "$value": "44px" },
      "card-padding": { "$value": "16px" },
      "page-gap": { "$value": "12px" }
    },
    "comfortable": {
      "input-height": { "$value": "40px" },
      "button-height": { "$value": "40px" },
      "table-row-height": { "$value": "48px" },
      "card-padding": { "$value": "20px" },
      "page-gap": { "$value": "16px" }
    },
    "spacious": {
      "input-height": { "$value": "44px" },
      "button-height": { "$value": "44px" },
      "table-row-height": { "$value": "52px" },
      "card-padding": { "$value": "24px" },
      "page-gap": { "$value": "20px" }
    }
  }
}
