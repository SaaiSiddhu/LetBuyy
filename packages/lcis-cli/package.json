{
  "name": "@letbuyy/lcis-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LCIS CLI — developer access to the deterministic LCIS engine. Consumes @letbuyy/lcis-core.",
  "bin": { "lcis": "./dist/cli.js" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@letbuyy/lcis-core": "workspace:*",
    "@letbuyy/lcis-live": "workspace:*",
    "@letbuyy/lcis-execution": "workspace:*",
    "@letbuyy/lcis-governance": "workspace:*",
    "@letbuyy/lcis-operations": "workspace:*",
    "@letbuyy/lcis-engineering": "workspace:*",
    "@letbuyy/lcis-orchestration": "workspace:*",
    "commander": "^12.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "typescript": "^5.9.3"
  }
}
