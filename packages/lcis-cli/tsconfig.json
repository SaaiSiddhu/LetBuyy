{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@letbuyy/lcis-core": [
        "../lcis-core/src/index.ts"
      ],
      "@letbuyy/lcis-live": [
        "../lcis-live/src/index.ts"
      ],
      "@letbuyy/lcis-adapters": [
        "../lcis-adapters/src/index.ts"
      ],
      "@letbuyy/lcis-execution": [
        "../lcis-execution/src/index.ts"
      ],
      "@letbuyy/lcis-governance": [
        "../lcis-governance/src/index.ts"
      ],
      "@letbuyy/lcis-operations": [
        "../lcis-operations/src/index.ts"
      ],
      "@letbuyy/lcis-engineering": [
        "../lcis-engineering/src/index.ts"
      ],
      "@letbuyy/lcis-orchestration": [
        "../lcis-orchestration/src/index.ts"
      ]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../lcis-core"
    },
    {
      "path": "../lcis-live"
    },
    {
      "path": "../lcis-execution"
    },
    {
      "path": "../lcis-governance"
    },
    {
      "path": "../lcis-operations"
    },
    {
      "path": "../lcis-engineering"
    },
    {
      "path": "../lcis-orchestration"
    }
  ]
}
