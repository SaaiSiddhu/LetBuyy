{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@letbuyy/auth-core": ["../auth-core/src/index.ts"],
      "@letbuyy/identity-core": ["../identity-core/src/index.ts"],
      "@letbuyy/shared-types": ["../shared-types/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../auth-core" },
    { "path": "../identity-core" },
    { "path": "../shared-types" }
  ]
}
