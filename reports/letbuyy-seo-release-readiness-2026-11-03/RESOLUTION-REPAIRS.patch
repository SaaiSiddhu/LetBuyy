diff --git a/tests/marketing/online-store-sequence.test.ts b/tests/marketing/online-store-sequence.test.ts
--- /dev/null
+++ b/tests/marketing/online-store-sequence.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { ARTICLES } from '../../apps/marketing/web/src/lib/resources/articles'
+import { articleSourceText, localizeArticleContent } from '../../apps/marketing/web/src/lib/i18n/article-content'
+import { resourceHeadingId } from '../../apps/marketing/web/src/lib/resources/headings'
+
+const source = ARTICLES.find(article => article.slug === 'how-to-start-an-online-store-india')!
+const existingStepTwoAnchor = 'validate-demand-in-the-locations-you-can-serve-interview-potential-customers-and-compare-alternatives-neither-a-city-tier-nor-a-category-label-establishes-demand-or-a-predictable-growth-window'
+
+for (const language of ['en', 'hi', 'ta']) {
+    test(`${language}: online-store planning steps include registration and retain the existing deep link`, () => {
+        const article = language === 'en' ? source : localizeArticleContent(source, language).article
+        const headings = article.body.filter(block => block.type === 'h2')
+        assert.deepEqual(headings.map(block => Number(block.text.match(/\d+/u)?.[0])), [1, 2, 3, 4, 5, 6, 7])
+        assert.equal(headings[1].id ?? resourceHeadingId(headings[1].text), existingStepTwoAnchor)
+    })
+}
+
+test('guides do not restore the unsupported category, discount-conversion or fulfilment rankings', () => {
+    for (const article of ARTICLES) {
+        assert.doesNotMatch(articleSourceText(article).join('\n'), /best-performing Indian (?:D2C stores|brands)|converts significantly better/u, article.slug)
+    }
+})
diff --git a/tests/marketing/directory-indexing.test.ts b/tests/marketing/directory-indexing.test.ts
--- /dev/null
+++ b/tests/marketing/directory-indexing.test.ts
@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import sitemap from '../../apps/marketing/web/src/app/sitemap'
+import { ARTICLES } from '../../apps/marketing/web/src/lib/resources/articles'
+
+test('XML advertises indexable landing pages and every guide, excluding the HTML utility directory', () => {
+    const paths = new Set(sitemap().map(entry => new URL(entry.url).pathname))
+    for (const locale of ['in', 'in-hi', 'in-ta']) {
+        assert.equal(paths.has(`/${locale}/sitemap`), false)
+        for (const suffix of ['', '/pricing', '/resources']) assert.ok(paths.has(`/${locale}${suffix}`))
+        for (const article of ARTICLES) assert.ok(paths.has(`/${locale}/resources/${article.category}/${article.slug}`), article.slug)
+    }
+})
diff --git a/tests/marketing/capability-artwork-priority.test.ts b/tests/marketing/capability-artwork-priority.test.ts
--- /dev/null
+++ b/tests/marketing/capability-artwork-priority.test.ts
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict'
+import { createRequire } from 'node:module'
+import test from 'node:test'
+import CapabilityArtwork from '../../apps/marketing/web/src/components/CapabilityArtwork'
+
+const appRequire = createRequire(new URL('../../apps/marketing/web/package.json', import.meta.url))
+const { createElement } = appRequire('react')
+const { renderToStaticMarkup } = appRequire('react-dom/server')
+
+test('decorative capability icons remain eager without competing image preloads', () => {
+    for (const module of ['storefronts', 'orders', 'inventory', 'payments', 'customers', 'analytics', 'ai', 'b2b']) {
+        const html = renderToStaticMarkup(createElement(CapabilityArtwork, { module }))
+        assert.doesNotMatch(html, /<link\b[^>]*as="image"/iu, module)
+        assert.match(html, /fetchPriority="low"/iu, module)
+        assert.match(html, /loading="eager"/u)
+        assert.match(html, /width="256" height="256"/u)
+        assert.match(html, /alt=""/u)
+        assert.match(html, /aria-hidden="true"/u)
+        assert.ok(html.includes(`/illustrations/capabilities/icons/${module}-v2.webp`))
+    }
+})
