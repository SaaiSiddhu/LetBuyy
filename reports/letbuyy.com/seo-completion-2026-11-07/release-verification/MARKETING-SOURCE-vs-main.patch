+  --border-glow: color-mix(in srgb, var(--lb-primitive-color-purple-500) 40%, transparent);
+  --primary-glow: color-mix(in srgb, var(--lb-primitive-color-purple-500) 35%, transparent);
+
+  /* ── Depth variants (panel / card / surface states) ── */
+  --cmap-panel-bg: var(--lb-color-surface);
+  --cmap-card-bg: var(--lb-color-surface-subdued);
+  --cmap-card-bg-open: var(--lb-color-surface);
