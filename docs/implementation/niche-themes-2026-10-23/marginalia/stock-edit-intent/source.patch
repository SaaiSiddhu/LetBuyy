+/** Older presentation drafts have no evidence of inventory intent. Keep their
+ * quantities and other fields, but require review rather than inferring intent
+ * from a difference against today's (possibly consumed) inventory. */
+function reviewLegacyInventory(snapshot: ProductFormSnapshot): ProductFormSnapshot {
+    return { ...snapshot,
+        ...(snapshot.quantityBaseline === undefined ? { quantityNeedsReview: true } : {}),
+        variantMatrix: snapshot.variantMatrix.map(row => row.id && row.stockBaseline === undefined ? { ...row, stockNeedsReview: true } : row),
+    }
+}
+
+function restoreInventoryValue(value: string, baseline: string | undefined, review: boolean | undefined, current: string | undefined) {
+    if (review || baseline === undefined || current === undefined) return { value, baseline, review: true }
+    if (value === baseline) return { value: current, baseline: current, review: false }
+    return { value, baseline, review: baseline !== current }
+}
+
+/** Reconcile an unsent retained draft with a real current read, using original
+ * baselines and durable UUIDs. An untouched old quantity is never a restock. */
+export function restoreProductInventory(draft: ProductFormSnapshot, current: ProductFormSnapshot): ProductFormSnapshot {
+    const quantity = restoreInventoryValue(draft.quantity, draft.quantityBaseline, draft.quantityNeedsReview, current.quantity)
+    return { ...draft, quantity: quantity.value, quantityBaseline: quantity.baseline, quantityNeedsReview: quantity.review,
+        variantMatrix: draft.variantMatrix.map(row => {
+            if (!row.id) return row
+            const saved = current.variantMatrix.find(candidate => candidate.id === row.id)
+            const stock = restoreInventoryValue(row.stock, row.stockBaseline, row.stockNeedsReview, saved?.stock)
+            return { ...row, stock: stock.value, stockBaseline: stock.baseline, stockNeedsReview: stock.review }
+        }),
+    }
+}
+
+/** Explicit review action: retain all catalogue drafts and use quantities from
+ * the acknowledged readback. Missing UUIDs remain blocked for review. */
+export function keepCurrentProductInventory(draft: ProductFormSnapshot, current: ProductFormSnapshot): ProductFormSnapshot {
+    return { ...draft, quantity: current.quantity, quantityBaseline: current.quantity, quantityNeedsReview: false,
+        variantMatrix: draft.variantMatrix.map(row => {
+            if (!row.id) return row
+            const saved = current.variantMatrix.find(candidate => candidate.id === row.id)
+            return saved ? { ...row, stock: saved.stock, stockBaseline: saved.stock, stockNeedsReview: false } : { ...row, stockNeedsReview: true }
+        }),
+    }
+}
+
+function acknowledgedInventoryValue(value: string, baseline: string | undefined, review: boolean | undefined, sent: string | undefined, acknowledged: string | undefined) {
+    if (acknowledged === undefined) return { value, baseline, review: true }
+    // Equality with the exact sent presentation means there is no newer stock
+    // edit, including after an immutable legacy command has been acknowledged.
+    if (value === sent) return { value: acknowledged, baseline: acknowledged, review: false }
+    return { value, baseline: acknowledged, review: Boolean(review || baseline === undefined || sent === undefined) }
+}
+
+/** A pending command's bytes/key never change. Once confirmed, clear only its
+ * acknowledged inventory intent; keep genuinely newer edits by UUID. */
+export function rebaseProductInventoryAfterSave(draft: ProductFormSnapshot, sent: ProductFormSnapshot, acknowledged: ProductFormSnapshot): ProductFormSnapshot {
+    const quantity = acknowledgedInventoryValue(draft.quantity, draft.quantityBaseline, draft.quantityNeedsReview, sent.quantity, acknowledged.quantity)
+    return { ...draft, quantity: quantity.value, quantityBaseline: quantity.baseline, quantityNeedsReview: quantity.review,
+        variantMatrix: draft.variantMatrix.map(row => {
