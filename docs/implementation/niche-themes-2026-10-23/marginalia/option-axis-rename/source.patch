+    }
+    if (!nextName || !ProductOptionSchema.shape.name.safeParse(nextName).success) throw new Error('Enter an option name between 1 and 100 characters.')
+    if (nextName === '__proto__') throw new Error('Choose an option name that can be saved safely.')
+    if (options.some((axis, index) => index !== optionIndex && axis.name.toLowerCase() === nextName.toLowerCase())) throw new Error('This product already has that option name. Choose a distinct name.')
