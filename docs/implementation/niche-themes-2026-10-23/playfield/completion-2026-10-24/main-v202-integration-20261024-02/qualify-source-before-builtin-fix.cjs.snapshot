const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const { createRequire, builtinModules } = require('node:module');
const ts = require('typescript');
const root = '/Volumes/Projects/LetBuyy';
const out = __dirname;
const mode = process.argv[2];
if (!['before', 'after', 'typecheck'].includes(mode)) throw new Error('Explicit qualification mode required.');
const entries = ['packages/theme-engine/src/playfield-theme-v202.ts', 'packages/theme-engine/test/playfield-subtitle-successor.test.ts'].map(p => path.join(root, p));
const configFile = path.join(root, 'packages/theme-engine/tsconfig.json');
const config = ts.readConfigFile(configFile, ts.sys.readFile);
if (config.error) throw new Error(ts.flattenDiagnosticMessageText(config.error.messageText, '\n'));
const parsed = ts.parseJsonConfigFileContent(config.config, ts.sys, path.dirname(configFile));
const options = { ...parsed.options, noEmit: true, composite: false, incremental: false, declaration: false, declarationMap: false, strict: true, skipLibCheck: true, types: ['node'], lib: ['lib.es2022.d.ts', 'lib.dom.d.ts', 'lib.dom.iterable.d.ts'] };
for (const key of ['outDir', 'tsBuildInfoFile', 'rootDir']) delete options[key];
const program = ts.createProgram(entries, options);
const hash = file => crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
const real = file => fs.realpathSync(file);
const owned = file => file.startsWith(root + '/') && !file.includes('/node_modules/');
const rel = file => path.relative(root, file);
const pin = file => ({ path: rel(file), sha256: hash(file), bytes: fs.statSync(file).size });
if (mode === 'typecheck') {
  const diagnostics = ts.getPreEmitDiagnostics(program);
  const text = ts.formatDiagnosticsWithColorAndContext(diagnostics, { getCurrentDirectory: () => root, getCanonicalFileName: s => s, getNewLine: () => '\n' });
  process.stdout.write(text);
  fs.writeFileSync(path.join(out, 'strict-noemit-result.json'), JSON.stringify({ command: 'node --conditions=react-server --import tsx ' + rel(__filename) + ' typecheck', diagnostics: diagnostics.length, exitCode: diagnostics.length ? 1 : 0, strict: true, noEmit: true, composite: false, incremental: false, entries: entries.map(rel), typescript: ts.version }, null, 2) + '\n');
  process.exitCode = diagnostics.length ? 1 : 0;
} else {
  const queue = [...entries]; const seen = new Set(); const edges = []; const unresolved = []; const external = new Map();
  const nodeNames = new Set(builtinModules.map(s => s.replace(/^node:/, '')));
  while (queue.length) {
    const file = real(queue.shift()); if (seen.has(file)) continue; seen.add(file);
    const source = ts.createSourceFile(file, fs.readFileSync(file, 'utf8'), ts.ScriptTarget.Latest, true);
    function visit(node) {
      let specifier; let typeOnly = false;
      if ((ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) && node.moduleSpecifier && ts.isStringLiteral(node.moduleSpecifier)) {
        specifier = node.moduleSpecifier.text;
        typeOnly = node.isTypeOnly || node.importClause?.isTypeOnly || (!!node.importClause?.namedBindings && ts.isNamedImports(node.importClause.namedBindings) && !node.importClause.name && node.importClause.namedBindings.elements.every(e => e.isTypeOnly));
      } else if (ts.isCallExpression(node) && node.arguments.length === 1 && ts.isStringLiteral(node.arguments[0]) && (node.expression.kind === ts.SyntaxKind.ImportKeyword || (ts.isIdentifier(node.expression) && node.expression.text === 'require'))) specifier = node.arguments[0].text;
      if (specifier && !typeOnly && !nodeNames.has(specifier.replace(/^node:/, ''))) {
        const declared = ts.resolveModuleName(specifier, file, options, ts.sys).resolvedModule;
        let actual; let mechanism = 'node-createRequire-with-tsx';
        try { actual = createRequire(file).resolve(specifier); } catch { actual = declared?.resolvedFileName; mechanism = 'typescript-bundler-fallback'; }
        if (!actual || !fs.existsSync(actual)) unresolved.push({ from: rel(file), specifier });
        else {
          actual = real(actual);
          if (owned(actual)) {
            edges.push({ from: rel(file), specifier, to: rel(actual), mechanism }); queue.push(actual);
          } else external.set(specifier + ':' + actual, { specifier, resolved: actual, mechanism });
        }
      }
      ts.forEachChild(node, visit);
    }
    visit(source);
  }
  const typeFiles = program.getSourceFiles().map(f => real(f.fileName)).filter(owned);
  const extras = ['pnpm-lock.yaml', 'package.json', 'tsconfig.base.json', 'packages/theme-engine/tsconfig.json', 'packages/theme-engine/package.json', 'packages/theme-engine/test/playfield-v201.test.ts', 'docs/implementation/niche-themes-2026-10-23/playfield/installed-fixture-preparation/toys-fixture-proposal.json'].map(p => path.join(root, p));
  const files = [...new Set([...seen, ...typeFiles, ...extras])].sort().map(pin);
  const result = { recordedAt: new Date().toISOString(), classification: 'RESOLVED_LITERAL_RUNTIME_CLOSURE_PLUS_TYPECHECK_AND_FIXTURE_ENVELOPE_NOT_NATIVE_OR_BROWSER', node: process.version, nodeConditions: ['react-server', 'default'], loader: 'tsx via --import', typescript: ts.version, entries: entries.map(rel), files, runtimeWorkspaceFiles: [...seen].sort().map(rel), edges, externalDependencies: [...external.values()], unresolved, dynamicNonliteralImportsClaimed: false, noEmit: true, qualificationMeaning: 'Runtime edges resolved, not proof that every conditional module executed. External dependency versions locked by pnpm-lock.yaml; node_modules are dependency resolution metadata, not source authority.' };
  const filename = path.join(out, 'closure-' + mode + '.json'); if (fs.existsSync(filename)) throw new Error('Preserve existing closure receipt.');
  fs.writeFileSync(filename, JSON.stringify(result, null, 2) + '\n');
  console.log(JSON.stringify({ mode, sourceAndFixtureInputs: files.length, runtimeWorkspaceFiles: seen.size, runtimeEdges: edges.length, unresolved: unresolved.length, serverDomEdges: edges.filter(e => e.specifier.includes('server-dom')) }));
  if (unresolved.length) process.exitCode = 1;
}
