      <details class="lb-product-detail__accordion"><summary>Shipping</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/shipping">Read our shipping policy</a></div></details>
      {% endif %}
      {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}
      <details class="lb-product-detail__accordion"><summary>Returns</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/returns">Read our returns policy</a></div></details>
      {% endif %}
      </div>
      </div>
      {% if section.settings.showToyFacts %}<section class="pf-facts" id="playfield-product-facts-{{ section.id }}" aria-label="Product contents and facts"><p class="pf-eyebrow">THE DETAILS, BEFORE YOU BUY</p><div class="pf-facts-layout"><div><h2>What’s in the box?</h2><div data-lb-toy-contents>{% if pf201_ready and product.toys.contents.size > 0 %}<ul class="pf-contents">{% assign pf201_total = 0 %}{% for content in product.toys.contents %}{% assign pf201_total = pf201_total | plus: content.quantity %}<li><strong>{{ content.quantity }}</strong><span>{{ content.label }}</span></li>{% endfor %}</ul><p data-lb-toy-contents-completeness>{% if product.toys.contentsComplete %}{{ pf201_total }} items in total, according to the merchant.{% else %}This is a partial contents list supplied by the merchant.{% endif %}</p>{% elsif pf201_ready %}<p>Contents have not been supplied.</p>{% else %}<p>Choose an edition for its included contents.</p>{% endif %}</div></div><div><h2>Know the object.</h2><dl data-lb-toy-details>{% if pf201_ready %}<div><dt>Dimensions</dt><dd data-lb-toy-field="dimensions">{% if product.toys.dimensions %}{% if product.toys.dimensions.label != blank %}<strong>{{ product.toys.dimensions.label }}</strong><br>{% endif %}{% if product.toys.dimensions.length %}Length {{ product.toys.dimensions.length }} {{ product.toys.dimensions.unit }}{% endif %}{% if product.toys.dimensions.width %}{% if product.toys.dimensions.length %} · {% endif %}Width {{ product.toys.dimensions.width }} {{ product.toys.dimensions.unit }}{% endif %}{% if product.toys.dimensions.height %}{% if product.toys.dimensions.length or product.toys.dimensions.width %} · {% endif %}Height {{ product.toys.dimensions.height }} {{ product.toys.dimensions.unit }}{% endif %}{% else %}Dimensions have not been supplied.{% endif %}</dd></div>{% for measured in product.toys.additionalDimensions %}<div><dt>{{ measured.label }}</dt><dd data-lb-toy-field="additional-dimensions">{% if measured.length %}Length {{ measured.length }} {{ measured.unit }}{% endif %}{% if measured.width %}{% if measured.length %} · {% endif %}Width {{ measured.width }} {{ measured.unit }}{% endif %}{% if measured.height %}{% if measured.length or measured.width %} · {% endif %}Height {{ measured.height }} {{ measured.unit }}{% endif %}</dd></div>{% endfor %}<div><dt>Materials</dt><dd data-lb-toy-field="materials">{% if product.toys.materials != blank %}{{ product.toys.materials }}{% else %}Not supplied.{% endif %}</dd></div><div><dt>Finish</dt><dd data-lb-toy-field="finish">{% if product.toys.finish != blank %}{{ product.toys.finish }}{% else %}Not supplied.{% endif %}</dd></div><div><dt>Care</dt><dd data-lb-toy-field="care">{% if product.toys.care != blank %}{{ product.toys.care }}{% else %}Not supplied.{% endif %}</dd></div>{% else %}<div><dt>Edition facts</dt><dd>Choose an edition for its measurements and materials.</dd></div>{% endif %}</dl><p class="pf-note">Product information is supplied by the merchant. Age recommendations are guidance for the adult choosing the product.</p></div></div></section>{% endif %}
      {% if section.settings.showReviews and product.reviews.size > 0 %}<div class="lb-product-reviews" data-section-id="{{ section.id }}-reviews">
        <h2 class="lb-product-reviews__title">Customer reviews ({{ product.review_count }})</h2>
        {% for review in product.reviews %}<article class="lb-product-review">
          <header class="lb-product-review__head"><strong class="lb-product-review__author">{{ review.author }}</strong><span class="lb-product-review__stars" aria-label="Rated {{ review.rating }} out of 5">★ {{ review.rating }}</span>{% if review.is_verified %}<span class="lb-product-review__verified">Verified purchase</span>{% endif %}</header>
          {% if review.title %}<h3 class="lb-product-review__heading">{{ review.title }}</h3>{% endif %}
          {% if review.body %}<p class="lb-product-review__body">{{ review.body }}</p>{% endif %}
          {% if review.helpful_count > 0 %}<footer class="lb-product-review__helpful">{{ review.helpful_count }} found this helpful</footer>{% endif %}
        </article>{% endfor %}
      </div>{% endif %}
      {% if section.settings.showReviews %}<lb-review-form data-lb-island="review-form" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}"></lb-review-form>{% endif %}
    </section>
    </div>
