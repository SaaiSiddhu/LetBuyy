    const limit: Field = { id: 'productLimit', type: 'range', label: 'Products to show', min: 1, max: 24, step: 1, default: 6 };
    
    function section(type: string, name: string, fields: Field[], body: string, blocks: ThemeLiquidSectionFile['schema']['blocks'] = []): ThemeLiquidSectionFile {
      const schema = ThemeLiquidSectionSchema.parse({ name, settings: fields, blocks, presets: [{ name }] });
      return { path: `sections/${type}.liquid`, source: `${body}\n{% schema %}\n${JSON.stringify(schema)}\n{% endschema %}`, schema };
    }
    function template(name: string, specs: { id: string; type: string; settings?: Record<string, ThemeBundleJson> }[]): LiquidThemePackageBundle['templates'][string] {
      return { name, layout: 'theme', order: specs.map(s => s.id), sections: Object.fromEntries(specs.map(s => [s.id, { type: s.type, settings: s.settings ?? {}, blocks: {}, block_order: [], disabled: false }])) };
    }
    
    /** No label parsing or client-derived value. Public food/unitPrice is server-supplied presentation. */
    export const PANTRY_CARD = `{% assign pantry_has_options = item.has_options %}{% if item.options.size > 0 %}{% assign pantry_has_options = true %}{% endif %}<article class="pn-card"><a class="pn-card-media" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<span class="pn-card-placeholder">Product image not supplied</span>{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.title }}</a></h3>{% if pantry_has_options %}<p class="pn-card-net">Choose a pack to check its net quantity</p>{% elsif item.food.netQuantityValue %}<p class="pn-card-net">{{ item.food.netQuantityValue }} {{ item.food.netQuantityUnit }} net per pack</p>{% else %}<p class="pn-card-net">Net quantity not supplied</p>{% endif %}<p class="pn-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if pantry_has_options != true and item.food.unitPriceMinor != nil %}<p class="pn-meta">{{ item.food.unitPriceMinor | money_with_currency: item.currency }} / {{ item.food.basisQuantity }} {{ item.food.netQuantityUnit }}</p>{% endif %}<a class="pn-link" href="{{ item.url }}">Choose pack</a>{% if item.available == false %}<p class="pn-meta">Unavailable</p>{% endif %}</div></article>`;
    
    const FOOD_FACTS = `<section class="pn-food-facts" id="food-facts" aria-label="Ingredients and allergen information"><p class="pn-eyebrow">Read before choosing</p><h2>Inside the pack</h2><div class="pn-food-fact"><strong>Ingredients</strong><p>{% if product.food.ingredients != blank %}{{ product.food.ingredients }}{% else %}Not supplied by the merchant.{% endif %}</p></div><div class="pn-food-fact"><strong>Allergen information</strong>{% if product.food.allergens.status == 'supplied' %}<p>{{ product.food.allergens.statement }}</p><p class="pn-meta">Source: {{ product.food.allergens.source }}</p>{% else %}<p>Not supplied by the merchant.</p><div class="pn-food-unknown"><strong>Unknown is not allergen-free</strong><p>Ask the merchant before buying if this information matters for your diet.</p></div>{% endif %}</div>{% if product.food.storage != blank %}<div class="pn-food-fact"><strong>Storage</strong><p>{{ product.food.storage }}</p></div>{% endif %}{% if product.food.preparation != blank %}<div class="pn-food-fact"><strong>Preparation</strong><p>{{ product.food.preparation }}</p></div>{% endif %}{% if section.settings.showNutrition and product.food.nutritionText != blank %}<div class="pn-food-fact"><strong>Supplied nutrition information</strong><p>{{ product.food.nutritionText }}</p></div>{% endif %}</section>`;
    
    const PACK_FACTS = `<div class="pn-net-info" data-lb-food-presentation data-product-id="{{ product.id }}" data-facts="{{ product.facts_json }}">{% if product.options.size == 0 and product.food.netQuantityValue %}<p data-lb-food-net-quantity>{{ product.food.netQuantityValue }} {{ product.food.netQuantityUnit }} net per pack</p>{% if product.food.unitPriceMinor != nil %}<p data-lb-food-unit-price>{{ product.food.unitPriceMinor | money_with_currency: product.currency }} / {{ product.food.basisQuantity }} {{ product.food.netQuantityUnit }}</p>{% endif %}{% elsif product.options.size > 0 %}<p>Choose a pack. Net contents belong to the selected variant.</p>{% else %}<p>Net quantity not supplied.</p>{% endif %}<p>Quantity counts sellable packs. Shipping is calculated at checkout.</p></div>{% if product.options.size > 0 %}<details class="pn-pack-options"><summary>Pack facts by option</summary><ul>{% for variant in product.variants %}<li><strong>{{ variant.name | default: variant.title }}</strong>{% if variant.food.netQuantityValue %}: {{ variant.food.netQuantityValue }} {{ variant.food.netQuantityUnit }} net per pack{% else %}: net quantity not supplied{% endif %}{% if variant.food.unitPriceMinor != nil %} · {{ variant.food.unitPriceMinor | money_with_currency: product.currency }} / {{ variant.food.basisQuantity }} {{ variant.food.netQuantityUnit }}{% endif %}{% if variant.stock == 0 %} · unavailable{% endif %}</li>{% endfor %}</ul></details>{% endif %}`;
    
    /** Pure factory for one portable Liquid package. No catalog dispatch or merchant-state mutation. */
    export function createPantryTheme(base: LiquidThemePackageBundle): LiquidThemePackageBundle {
      const bundle = structuredClone(base);
      bundle.package = { ...bundle.package, slug: 'letbuyy-refresh', name: 'Pantry', version: PANTRY_VERSION, version_number: 2, description: 'Shelf-stable pantry shopping with ingredients, supplied allergen information and explicit pack quantities.' };
      Object.assign(bundle.config.settings_data.current, { primaryColor: '#36533D', secondaryColor: '#36533D', accentColor: '#707858', backgroundColor: '#FCF8EF', textColor: '#262A1D', surfaceColor: '#EEE8D8', headingFontFamily: 'Inter', bodyFontFamily: 'Inter', borderRadius: 6 });
      delete bundle.config.settings_data.current.fontFamily;
    
      bundle.sections['hero-banner'] = section('hero-banner', 'Compact pantry introduction', [text('eyebrow', 'Eyebrow', 'THE EVERYDAY PANTRY'), text('heading', 'Heading', 'Good things start with staples.'), text('subheading', 'Description', 'Find your shelf, read the details, choose your pack.'), text('ctaText', 'Action label', 'Explore pantry shelves'), url('ctaLink', 'Action destination', '/products'), image('image', 'Seasonal photograph'), text('imageAlt', 'Image description'), { id: 'focalPoint', type: 'select', label: 'Image focal point', default: 'center', options: ['center', 'left', 'right'] }], `<section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><div class="pn-hero{% if section.settings.image == blank %} pn-hero--no-media{% endif %}"><div class="pn-hero-copy"><p class="pn-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="pn-button" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>{% endif %}{% for block in section.blocks %}{% if block.type == 'note' %}<p class="pn-meta" {{ block.editor_attributes | raw }}>{{ block.settings.text }}</p>{% endif %}{% endfor %}</div>{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" class="pn-focal-{{ section.settings.focalPoint }}" fetchpriority="high" decoding="async">{% endif %}</div></div></section>`, [{ type: 'note', name: 'Introductory note', settings: [text('text', 'Note text')] }]);
    
      bundle.sections['category-grid'] = section('category-grid', 'Pantry shelf shortcuts', [text('title', 'Heading', 'Find your shelf'), ...[1, 2, 3, 4].map(slot => ({ id: `collection${slot}`, type: 'collection' as const, label: `Shelf ${slot}` }))], `<section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><h2>{{ section.settings.title }}</h2>{% if collections.size > 0 %}<nav class="pn-shelves" aria-label="Pantry shelves">{% for item in collections limit: 100 %}{% if section.settings.collection1 != blank or section.settings.collection2 != blank or section.settings.collection3 != blank or section.settings.collection4 != blank %}{% unless item.id == section.settings.collection1 or item.id == section.settings.collection2 or item.id == section.settings.collection3 or item.id == section.settings.collection4 %}{% continue %}{% endunless %}{% elsif forloop.index > 4 %}{% break %}{% endif %}<a class="pn-shelf" href="{{ routes.collections_url }}/{{ item.handle }}"><span>{{ item.title }}</span><span aria-hidden="true">→</span></a>{% endfor %}</nav>{% else %}<p class="pn-empty">Collections added to this store will appear here.</p>{% endif %}</div></section>`);
    
      const gridFields: Field[] = [text('title', 'Heading', 'Everyday staples'), text('subtitle', 'Description'), limit, { id: 'collectionId', type: 'collection', label: 'Collection' }];
      bundle.sections['product-grid'] = section('product-grid', 'Pantry shelf list', gridFields, `<section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><div class="pn-heading"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div></div>{% assign pantry_products = section.products | default: collection.products %}{% if pantry_products.size > 0 %}<div class="pn-product-list">{% for item in pantry_products limit: section.settings.productLimit %}${PANTRY_CARD}{% endfor %}</div>${PANTRY_PAGINATION}{% else %}<p class="pn-empty">No products found. Keep your search and broaden the shelf or clear a filter.</p>{% endif %}</div></section>`);
      bundle.sections['collection-filter'] = section('collection-filter', 'Pantry discovery', [text('title', 'Fallback heading', 'Everyday staples'), { id: 'showSearch', type: 'toggle', label: 'Show search', default: true }], PANTRY_FILTERS);
      // Preserve the existing search section identity/settings while sharing canonical discovery behavior.
      const searchBox = bundle.sections['search-box'];
      searchBox.source = `${PANTRY_FILTERS}\n{% schema %}\n${JSON.stringify(searchBox.schema)}\n{% endschema %}`;
      bundle.sections['collection-product-list'] = section('collection-product-list', 'Pantry collection rows', [text('title', 'Heading', 'Everyday staples')], `<section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section">{% if collection.products.size > 0 %}<div class="pn-product-list">{% for item in collection.products %}${PANTRY_CARD}{% endfor %}</div>${PANTRY_PAGINATION}{% else %}<p class="pn-empty">No matching products. Try a broader shelf or clear a filter.</p><a class="pn-link" href="{{ routes.all_products_collection_url | default: routes.search_url }}">Explore all staples</a>{% endif %}</div></section>`);
      bundle.sections['featured-products'] = section('featured-products', 'Independently sold pantry pairings', [text('title', 'Heading', 'Also on the shelf'), text('subtitle', 'Description', 'Each product is priced and sold separately.'), { id: 'requireSelection', type: 'toggle', label: 'Only show selected products', default: true }, ...[1, 2, 3].map(slot => ({ id: `product${slot}`, type: 'product' as const, label: `Independent product ${slot}` })), limit], `<section data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<div class="pn-wrap pn-section"><div class="pn-heading"><div><h2>{{ section.settings.title }}</h2><p>{{ section.settings.subtitle }}</p></div></div><div class="pn-product-list">{% for item in section.products limit: section.settings.productLimit %}${PANTRY_CARD}{% endfor %}</div></div>{% endif %}</section>`);
      bundle.sections['about-section'] = section('about-section', 'Ingredient and recipe education', [text('title', 'Heading', 'Know what is inside.'), text('content', 'Merchant-authored information'), image('image', 'Editorial photograph'), text('imageAlt', 'Image description'), text('linkLabel', 'Independent page or product link label'), url('linkUrl', 'Independent page or product destination')], `<section data-section-id="{{ section.id }}">{% if section.settings.content != blank or section.settings.image != blank %}<div class="pn-wrap pn-section"><div class="pn-feature{% if section.settings.image == blank %} pn-feature--no-media{% endif %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy" decoding="async">{% endif %}<div><h2>{{ section.settings.title }}</h2><p>{{ section.settings.content }}</p>{% if section.settings.linkLabel != blank and section.settings.linkUrl != blank %}<a class="pn-link" href="{{ section.settings.linkUrl | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}</div></div></div>{% endif %}</section>`);
      bundle.sections['trust-badges'] = section('trust-badges', 'Merchant service information', [text('packText', 'Pack guidance'), text('factsText', 'Food information guidance'), text('shippingText', 'Shipping information')], `<section data-section-id="{{ section.id }}"><div class="pn-wrap pn-services">{% if section.settings.packText != blank %}<div><h3>Choose the right pack</h3><p>{{ section.settings.packText }}</p></div>{% endif %}{% if section.settings.factsText != blank %}<div><h3>Read the supplied details</h3><p>{{ section.settings.factsText }}</p></div>{% endif %}{% if section.settings.shippingText != blank %}<div><h3>Shipping for your address</h3><p>{{ section.settings.shippingText }}</p></div>{% endif %}</div></section>`);
    
      const product = bundle.sections['product-detail'];
      product.schema.settings.push({ id: 'showNutrition', type: 'toggle', label: 'Show supplied nutrition text', default: true });
      product.source = product.source.replace('class="lb-product-detail__layout"', 'class="lb-product-detail__layout pn-product-layout"')
        .replace('  <div class="lb-product-detail__info">', `{% if section.settings.showGallery and product.images.size == 0 %}<div class="lb-product-detail__gallery pn-empty">Product image not supplied</div>{% endif %}${FOOD_FACTS}\n  <div class="lb-product-detail__info">`)
        .replace('  {% if product.options.size > 0 %}<lb-variant-picker', `${PACK_FACTS}\n  {% if product.options.size > 0 %}<lb-variant-picker`)
        .replace('class="lb-sr-only" for="lb-quantity-', 'class="pn-quantity-label" for="lb-quantity-')
        .replace('>Quantity</label>', '>Number of packs</label>')
        .replace(/\s*<button[^>]*data-lb-buy-now[\s\S]*?<\/button>/, '');
    
      bundle.templates.index = template('Pantry home', [
        { id: 'pantry-hero', type: 'hero-banner', settings: { eyebrow: 'THE EVERYDAY PANTRY', heading: 'Good things start with staples.', subheading: 'Find your shelf, read the details, choose your pack.', ctaText: 'Explore pantry shelves', ctaLink: '/products', focalPoint: 'center' } },
        { id: 'pantry-shelves', type: 'category-grid', settings: { title: 'Find your shelf' } },
        { id: 'pantry-staples', type: 'product-grid', settings: { title: 'A little everyday order.', productLimit: 6 } },
        { id: 'pantry-ingredients', type: 'about-section', settings: { title: 'Meet the staple. Know what is inside.', content: '' } },
        { id: 'pantry-pairings', type: 'featured-products', settings: { title: 'Start with two staples.', subtitle: 'Independent products. No automatic bundle.', requireSelection: true, productLimit: 2 } },
        { id: 'pantry-information', type: 'trust-badges', settings: { packText: 'Pack count and total net quantity stay distinct.', factsText: 'Supplied ingredients and known information, clearly stated.', shippingText: 'Available rates are shown for your address at checkout.' } },
      ]);
      bundle.templates.product = template('Pantry product', [{ id: 'pantry-selection', type: 'product-detail', settings: { showGallery: true, showDescription: true, showReviews: false, showNutrition: true } }, { id: 'pantry-related', type: 'featured-products', settings: { title: 'Also on the shelf', subtitle: 'Independently priced and sold.', requireSelection: true, productLimit: 2 } }]);
      bundle.templates.collection = template('Pantry shelf', [{ id: 'pantry-discovery', type: 'collection-filter', settings: { title: 'Everyday staples', showSearch: true } }, { id: 'pantry-results', type: 'product-grid', settings: { title: 'On this shelf', productLimit: 24 } }]);
      // This fresh inherited default is unused by Pantry's heading-and-links shelf section.
      const collectionIndex = bundle.templates['list-collections']?.sections['list-collections-grid'];
      if (collectionIndex?.type === 'category-grid') delete collectionIndex.settings.subtitle;
      for (const instance of Object.values(bundle.templates.header.sections)) if (instance.type === 'announcement-bar') instance.settings = { ...instance.settings, text: 'Everyday staples. Ingredients in plain sight.', linkLabel: '', linkHref: '' };
    
      // Retain canonical cart/account/content behavior and scope every section; no global/admin CSS.
      for (const file of Object.values(bundle.sections)) {
        const marker = '{% schema %}';
        file.source = `<div class="pn-theme">${file.source.replace(marker, '</div>\n' + marker)}`;
        file.source = file.source.replace(/\{% schema %\}[\s\S]*?\{% endschema %\}/, `{% schema %}\n${JSON.stringify(file.schema)}\n{% endschema %}`);
      }
      bundle.layout.theme.source = bundle.layout.theme.source.replace('{{ content_for_header | raw }}', `{{ content_for_header | raw }}\n<style data-pantry="2">${PANTRY_CSS}</style>`);
      return LiquidThemePackageBundleSchema.parse(bundle);
    }
    
