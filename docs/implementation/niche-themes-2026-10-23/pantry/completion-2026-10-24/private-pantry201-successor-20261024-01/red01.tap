      about-section:
        path: 'sections/about-section.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}">{% if section.settings.content != blank or section.settings.image != blank %}<div class="pn-wrap pn-section"><div class="pn-feature{% if section.settings.image == blank %} pn-feature--no-media{% endif %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy" decoding="async">{% endif %}<div><h2>{{ section.settings.title }}</h2><p>{{ section.settings.content }}</p>{% if section.settings.linkLabel != blank and section.settings.linkUrl != blank %}<a class="pn-link" href="{{ section.settings.linkUrl | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}</div></div></div>{% endif %}</section>
          </div>
          {% schema %}
          {"name":"Ingredient and recipe education","tag":"section","settings":[{"type":"text","label":"Heading","default":"Know what is inside.","id":"title"},{"type":"text","label":"Merchant-authored information","default":"","id":"content"},{"type":"image","label":"Editorial photograph","id":"image"},{"type":"text","label":"Image description","default":"","id":"imageAlt"},{"type":"text","label":"Independent page or product link label","default":"","id":"linkLabel"},{"type":"url","label":"Independent page or product destination","default":"","id":"linkUrl"}],"blocks":[],"presets":[{"name":"Ingredient and recipe education","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
