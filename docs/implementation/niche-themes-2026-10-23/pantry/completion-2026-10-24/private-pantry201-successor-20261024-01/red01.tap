        source: |-
          <div class="pn-theme"><section class="lb-banner-carousel" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}">
            {% if section.settings.title %}<h2>{{ section.settings.title }}</h2>{% endif %}
            <div class="lb-banner-carousel__slides">
              {% for block in section.blocks %}<a href="{{ block.settings.link | store_url }}">{% if block.settings.image %}<img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading }}">{% endif %}<h3>{{ block.settings.heading }}</h3></a>{% endfor %}
            </div>
          </section>
          </div>
          {% schema %}
          {"name":"Banner Carousel","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"toggle","label":"Autoplay","default":true,"id":"autoplay"}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"text","label":"Heading","id":"heading"},{"type":"image","label":"Image","id":"image"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Banner Carousel","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
