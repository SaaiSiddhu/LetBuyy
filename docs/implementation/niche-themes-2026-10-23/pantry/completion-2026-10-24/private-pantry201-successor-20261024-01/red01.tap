-pn-action-label,#fff);font-weight:600}.pn-theme .lb-product-detail__accordion{border-bottom:1px solid var(--pn-line);padding-block:14px}.pn-theme .lb-product-detail__accordion summary{cursor:pointer;min-height:44px}.pn-food-facts h2{font-size:1.5rem;margin:0 0 22px}.pn-food-fact{padding-block:14px;border-bottom:1px solid var(--pn-line)}.pn-food-fact p{margin:7px 0;font-size:.875rem}.pn-food-unknown{padding:18px;background:var(--pn-warning-surface);color:var(--pn-warning);border-radius:6px;margin-block:16px}.pn-food-unknown p{color:var(--pn-warning);font-size:.875rem;margin:8px 0 0}.pn-net-info{margin-block:16px;padding:14px;background:var(--surface);border-radius:6px;font-size:.875rem}.pn-net-info p{margin:5px 0}.pn-pack-options{margin-block:16px;font-size:.875rem}.pn-pack-options summary{min-height:44px;cursor:pointer}.pn-pack-options ul{padding-left:20px}.pn-pack-options li{margin-block:12px}.pn-quantity-label{font-size:.875rem}.pn-theme :where(button:disabled){opacity:.65;cursor:not-allowed}.pn-theme :where(.lb-header,.lb-footer){font-family:var(--font-body)}.pn-theme .lb-header{background:var(--background);color:var(--foreground);border-bottom:1px solid var(--pn-line)}.pn-theme .lb-footer{background:var(--surface);color:var(--foreground)}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses,.lb-content-page){color:var(--foreground);background:var(--background);font-family:var(--font-body)}.pn-theme :where(.lb-cart__checkout,.lb-settings button,.lb-addresses button){border-radius:6px}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses) :where(input,select){min-height:44px;border-color:var(--pn-boundary)}
          .pn-theme .lb-header__brand,.pn-theme .lb-header__nav-links>a{min-height:44px;display:inline-flex;align-items:center}.pn-theme :is(.lb-header__search-toggle,.lb-header__account,.lb-header__toggle,.lb-header__nav-close){min-width:44px;min-height:44px;flex-shrink:0}.pn-theme .pn-card h3 a{display:inline-flex;align-items:center;min-height:44px;min-width:44px;max-width:100%}.pn-theme .lb-footer__col h4,.pn-theme .lb-footer__col a,.pn-theme .lb-footer__bottom{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb a{color:var(--pn-muted);min-width:44px}.pn-theme .lb-product-detail__breadcrumb span[aria-current]{overflow:visible;text-overflow:clip;white-space:normal;max-width:100%;overflow-wrap:anywhere}
          @media(max-width:767px){.pn-theme .lb-mobile-nav:not([data-open="true"]) [data-lb-nav-panel]{display:none}.pn-theme .lb-mobile-nav[data-open="true"] [data-lb-nav-panel]{display:flex}}
          @media(max-width:600px){.pn-theme .lb-header__inner{flex-wrap:wrap;gap:8px 12px}.pn-theme .lb-header__brand{order:0;flex:1 1 calc(100% - 56px);max-width:calc(100% - 56px);overflow-wrap:anywhere}.pn-theme .lb-header__toggle{order:1;flex:0 0 44px}.pn-theme .lb-header__actions{order:2;flex:0 0 100%;justify-content:flex-end}}
          @media(max-width:1100px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 64px)}.pn-theme .pn-product-layout{grid-template-columns:1fr 1fr}.pn-theme .lb-product-detail__gallery{grid-column:1;grid-row:1}.pn-food-facts{grid-column:1;grid-row:2}.pn-theme .lb-product-detail__info{grid-column:2;grid-row:1/3}.pn-card{grid-template-columns:100px minmax(0,1fr);gap:14px}.pn-card-media img{width:100px}.pn-hero-copy{padding:32px}}
          @media(max-width:900px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 48px)}.pn-shelves{grid-template-columns:repeat(2,minmax(0,1fr))}.pn-product-list{grid-template-columns:1fr}.pn-services{gap:20px}.pn-card{grid-template-columns:120px minmax(0,1fr)}.pn-card-media img{width:120px}}
          @media(max-width:600px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 40px)}.pn-section{padding-block:30px}.pn-hero,.pn-feature,.pn-pairing{grid-template-columns:1fr}.pn-hero-copy{padding:26px}.pn-hero img{min-height:0;height:220px}.pn-heading{display:block}.pn-shelf{padding:14px;min-height:72px}.pn-card{grid-template-columns:85px minmax(0,1fr);gap:13px;padding:12px}.pn-card-media img{width:85px;height:126px}.pn-card-media{min-height:126px}.pn-card h3{font-size:1.05rem}.pn-card-price{font-size:1.15rem}.pn-theme .pn-product-layout{display:flex;flex-direction:column;gap:24px}.pn-theme .pn-product-layout>*{width:100%}.pn-theme .lb-product-detail__gallery-main img{max-height:320px;aspect-ratio:1.15}.pn-theme .lb-product-detail__info h1{font-size:1.9rem}.pn-theme .lb-product-detail__cta{flex:1}.pn-services{grid-template-columns:1fr;gap:0}.pn-feature img{height:260px}.pn-filters label{width:100%}.pn-filters input,.pn-filters select{width:100%}}
          @media(max-width:350px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 32px)}.pn-card{grid-template-columns:65px minmax(0,1fr)}.pn-card-media img{width:65px}.pn-shelves{gap:8px}.pn-shelf{padding:10px}}
          @media(prefers-reduced-motion:reduce){.pn-theme *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
          </style>
          </head>
          <body class="lb-theme lb-theme--letbuyy-core">
            <a class="lb-skip-link" href="#MainContent">Skip to content</a>
            <header class="lb-layout__header">
              <a class="lb-layout__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
              <nav class="lb-layout__nav" aria-label="Primary">
                {% if linklists.main_menu.links.size > 0 %}{% for link in linklists.main_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
                {% else %}<a href="{{ routes.all_products_collection_url }}">Products</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a><a href="{{ routes.account_url }}">Account</a>{% endif %}
              </nav>
            </header>
            <main id="MainContent">
              {{ content_for_layout | raw }}
            </main>
            <footer class="lb-layout__footer">
              {% if linklists.footer.links.size > 0 %}<nav class="lb-layout__nav" aria-label="Footer">{% for link in linklists.footer.links %}<a href="{{ link.url | store_url }}">{{ link.title }}</a>{% endfor %}</nav>{% endif %}
              <p class="lb-layout__legal">&copy; {{ shop.name }}</p>
            </footer>
            {{ content_for_footer | raw }}
          </body>
          </html>
    config:
      settings_schema:
        schema_version: '2026-05-json-contract'
        settings:
          colors:
            label: 'Colors'
            description: 'LetBuyy Core storefront color tokens.'
            fields:
              primaryColor:
                type: 'color'
                label: 'Primary color'
                default: '#8B5CF6'
              secondaryColor:
                type: 'color'
                label: 'Secondary color'
                default: '#3B82F6'
              accentColor:
                type: 'color'
                label: 'Accent color'
                default: '#F59E0B'
              backgroundColor:
                type: 'color'
                label: 'Background color'
                default: '#FFFFFF'
              textColor:
                type: 'color'
                label: 'Text color'
                default: '#1F2937'
              surfaceColor:
                type: 'color'
                label: 'Surface color'
                default: '#F8FAFC'
          typography:
            label: 'Typography'
            description: 'First-party type settings mirrored from the JSON-contract LetBuyy Core theme.'
            fields:
              headingFontFamily:
                type: 'text'
                label: 'Heading font'
                default: 'Inter'
              bodyFontFamily:
                type: 'text'
                label: 'Body font'
                default: 'Inter'
          appearance:
            label: 'Appearance'
            description: 'Layout tokens shared by every section.'
            fields:
              borderRadius:
                type: 'number'
                label: 'Corner radius'
                default: 12
          seo:
            label: 'SEO and social'
            description: 'Metadata rendered into <head> by the theme layout.'
            fields:
              metaDescription:
                type: 'textarea'
                label: 'Meta description'
                default: ''
                info: 'Falls back to the shop description. Truncated to 160 characters on output.'
                maxLength: 160
              socialImageUrl:
                type: 'url'
                label: 'Social share image URL'
                default: ''
                info: 'Used for og:image and twitter:image. Left empty until the merchant uploads one.'
              faviconUrl:
                type: 'url'
                label: 'Favicon URL'
                default: ''
                info: 'Rendered as <link rel="icon">. Left empty until the merchant uploads one.'
      settings_data:
        current:
          primaryColor: '#36533D'
          secondaryColor: '#36533D'
          accentColor: '#707858'
          backgroundColor: '#FCF8EF'
          textColor: '#262A1D'
          surfaceColor: '#EEE8D8'
          headingFontFamily: 'Inter'
          bodyFontFamily: 'Inter'
          borderRadius: 6
          metaDescription: ''
          socialImageUrl: ''
          faviconUrl: ''
        presets:
          Forge:
            primaryColor: '#1E3A5F'
            secondaryColor: '#1E40AF'
            accentColor: '#00B4D8'
            backgroundColor: '#FFFFFF'
            textColor: '#1A202C'
            surfaceColor: '#F0F4F8'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 8
          Threadline:
            primaryColor: '#713F35'
            secondaryColor: '#65574C'
            accentColor: '#005FCC'
            backgroundColor: '#FAF7F2'
            textColor: '#241E1A'
            surfaceColor: '#EFE7DC'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Playfair Display'
            borderRadius: 4
          Aura:
            primaryColor: '#C2798B'
            secondaryColor: '#9E5A6F'
            accentColor: '#D4AF7A'
            backgroundColor: '#FFFFFF'
            textColor: '#2D1B22'
            surfaceColor: '#FFF8F9'
            bodyFontFamily: 'Lato'
            headingFontFamily: 'Cormorant Garamond'
            borderRadius: 16
          Craft:
            primaryColor: '#3E2723'
            secondaryColor: '#5D3B2E'
            accentColor: '#8D6E63'
            backgroundColor: '#FFFFFF'
            textColor: '#2C1B12'
            surfaceColor: '#FFF8F0'
            bodyFontFamily: 'Source Sans Pro'
            headingFontFamily: 'Libre Baskerville'
            borderRadius: 6
          Refresh:
            primaryColor: '#2D6A4F'
            secondaryColor: '#1B4332'
            accentColor: '#F4A261'
            backgroundColor: '#FFFFFF'
            textColor: '#1B2521'
            surfaceColor: '#F8FFF4'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 10
          Ride:
            primaryColor: '#FF4D00'
            secondaryColor: '#1C1C1C'
            accentColor: '#FFD100'
            backgroundColor: '#FFFFFF'
            textColor: '#111111'
            surfaceColor: '#F5F5F5'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 6
          Dawn:
            primaryColor: '#3B4F6B'
            secondaryColor: '#2C3E50'
            accentColor: '#C0832B'
            backgroundColor: '#FFFFFF'
            textColor: '#2C2C2C'
            surfaceColor: '#FDF6EC'
            bodyFontFamily: 'Source Sans Pro'
            headingFontFamily: 'Libre Baskerville'
            borderRadius: 4
          Bloom:
            primaryColor: '#E07B39'
            secondaryColor: '#B55E24'
            accentColor: '#4CAF73'
            backgroundColor: '#FFFFFF'
            textColor: '#2C1A0A'
            surfaceColor: '#FFF9F0'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 14
          Nova:
            primaryColor: '#8B5CF6'
            secondaryColor: '#6D28D9'
            accentColor: '#F59E0B'
            backgroundColor: '#FFFFFF'
            textColor: '#1A1A2E'
            surfaceColor: '#F8FAFC'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 10
          Summit:
            primaryColor: '#00B3B3'
            secondaryColor: '#008080'
            accentColor: '#A4E500'
            backgroundColor: '#FFFFFF'
            textColor: '#1A1A2E'
            surfaceColor: '#F9FAFB'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 12
    templates:
      header:
        name: 'LetBuyy Core header'
        layout: 'theme'
        sections:
          announcement-default:
            type: 'announcement-bar'
            settings:
              text: 'Everyday staples. Ingredients in plain sight.'
              linkLabel: ''
              linkHref: ''
            blocks:
            block_order:
            disabled: false
          header-default:
            type: 'header'
            settings:
              showSearch: true
              showCart: true
              behavior: 'sticky'
            blocks:
            block_order:
            disabled: false
        order:
          0: 'announcement-default'
          1: 'header-default'
      footer:
        name: 'LetBuyy Core footer'
        layout: 'theme'
        sections:
          footer-default:
            type: 'footer'
            settings:
            blocks:
            block_order:
            disabled: false
        order:
          0: 'footer-default'
      index:
        name: 'Pantry home'
        layout: 'theme'
        sections:
          pantry-hero:
            type: 'hero-banner'
            settings:
              eyebrow: 'THE EVERYDAY PANTRY'
              heading: 'Good things start with staples.'
              subheading: 'Find your shelf, read the details, choose your pack.'
              ctaText: 'Explore pantry shelves'
              ctaLink: '/products'
              focalPoint: 'center'
            blocks:
            block_order:
            disabled: false
          pantry-shelves:
            type: 'category-grid'
            settings:
              title: 'Find your shelf'
            blocks:
            block_order:
            disabled: false
          pantry-staples:
            type: 'product-grid'
            settings:
              title: 'A little everyday order.'
              productLimit: 6
            blocks:
            block_order:
            disabled: false
          pantry-ingredients:
            type: 'about-section'
            settings:
              title: 'Meet the staple. Know what is inside.'
              content: ''
            blocks:
            block_order:
            disabled: false
          pantry-pairings:
            type: 'featured-products'
            settings:
              title: 'Start with two staples.'
              subtitle: 'Independent products. No automatic bundle.'
              requireSelection: true
              productLimit: 2
            blocks:
            block_order:
            disabled: false
          pantry-information:
            type: 'trust-badges'
            settings:
              packText: 'Pack count and total net quantity stay distinct.'
              factsText: 'Supplied ingredients and known information, clearly stated.'
              shippingText: 'Available rates are shown for your address at checkout.'
            blocks:
            block_order:
            disabled: false
        order:
          0: 'pantry-hero'
          1: 'pantry-shelves'
          2: 'pantry-staples'
          3: 'pantry-ingredients'
          4: 'pantry-pairings'
          5: 'pantry-information'
      product:
        name: 'Pantry product'
        layout: 'theme'
        sections:
          pantry-selection:
            type: 'product-detail'
            settings:
              showGallery: true
              showDescription: true
              showReviews: false
              showNutrition: true
            blocks:
            block_order:
            disabled: false
          pantry-related:
            type: 'featured-products'
            settings:
              title: 'Also on the shelf'
              subtitle: 'Independently priced and sold.'
              requireSelection: true
              productLimit: 2
            blocks:
            block_order:
            disabled: false
        order:
          0: 'pantry-selection'
          1: 'pantry-related'
      collection:
        name: 'Pantry shelf'
        layout: 'theme'
        sections:
          pantry-discovery:
            type: 'collection-filter'
            settings:
              title: 'Everyday staples'
              showSearch: true
            blocks:
            block_order:
            disabled: false
          pantry-results:
            type: 'product-grid'
            settings:
              title: 'On this shelf'
              productLimit: 24
            blocks:
            block_order:
            disabled: false
        order:
          0: 'pantry-discovery'
          1: 'pantry-results'
      search:
        name: 'LetBuyy Core search'
        layout: 'theme'
        sections:
          search-box-default:
            type: 'search-box'
            settings:
              placeholder: 'Search products'
            blocks:
            block_order:
            disabled: false
          search-results:
            type: 'collection-product-list'
            settings:
              title: 'Merchant shelf'
            blocks:
            block_order:
            disabled: false
        order:
          0: 'search-box-default'
          1: 'search-results'
      cart:
        name: 'LetBuyy Core cart'
        layout: 'theme'
        sections:
          cart-summary-default:
            type: 'cart-summary'
