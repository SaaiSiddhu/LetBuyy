      footer:
        path: 'sections/footer.liquid'
        source: |-
          <div class="pn-theme"><footer class="lb-footer" data-section-id="{{ section.id }}">
            <div class="lb-footer__grid">
              <div class="lb-footer__brand">
                <h3>{{ section.settings.storeName | default: shop.name }}</h3>
                {% if section.settings.tagline %}<p>{{ section.settings.tagline }}</p>{% endif %}
                {% if section.settings.instagramUrl != blank or section.settings.facebookUrl != blank or section.settings.twitterUrl != blank %}
                <div class="lb-footer__social">
                  {% if section.settings.instagramUrl != blank %}<a href="{{ section.settings.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a>{% endif %}
                  {% if section.settings.facebookUrl != blank %}<a href="{{ section.settings.facebookUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 4h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path></svg></a>{% endif %}
                  {% if section.settings.twitterUrl != blank %}<a href="{{ section.settings.twitterUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="4" x2="20" y2="20"></line><line x1="20" y1="4" x2="4" y2="20"></line></svg></a>{% endif %}
                </div>
                {% endif %}
              </div>
              {% if section.blocks.size > 0 %}
              <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}</nav></div>
              {% elsif linklists.footer_menu.links.size > 0 %}
              <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for link in linklists.footer_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}</nav></div>
              {% endif %}
              {% if shop.policies.size > 0 %}<div class="lb-footer__col">
                <h4>Policies</h4>
                <nav>
                  {% if shop.policies contains 'privacy' %}<a href="{{ routes.root_url }}/privacy">Privacy policy</a>{% endif %}
                  {% if shop.policies contains 'terms' %}<a href="{{ routes.root_url }}/terms">Terms of service</a>{% endif %}
                  {% if shop.policies contains 'shipping' %}<a href="{{ routes.root_url }}/shipping">Shipping policy</a>{% endif %}
                  {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}<a href="{{ routes.root_url }}/returns">Returns policy</a>{% endif %}
                </nav>
              </div>{% endif %}
              <div class="lb-footer__col">
                <h4>Contact</h4>
                {% if section.settings.contactEmail != blank %}<p><a href="mailto:{{ section.settings.contactEmail }}">{{ section.settings.contactEmail }}</a></p>{% endif %}
                {% if section.settings.contactPhone != blank %}<p><a href="tel:{{ section.settings.contactPhone }}">{{ section.settings.contactPhone }}</a></p>{% endif %}
                <a href="{{ routes.contact_url }}">Contact us</a>
              </div>
            </div>
            <div class="lb-footer__bottom">
              <p>&copy; {{ shop.name }}. All rights reserved.</p>
              <a class="lb-footer__watermark" href="https://letbuyy.com" target="_blank" rel="noopener noreferrer">Powered by LetBuyy</a>
            </div>
          </footer>
          </div>
          {% schema %}
          {"name":"Footer","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"text","label":"Tagline","id":"tagline"},{"type":"text","label":"Contact email","id":"contactEmail"},{"type":"text","label":"Contact phone","id":"contactPhone"},{"type":"url","label":"Instagram URL","id":"instagramUrl"},{"type":"url","label":"Facebook URL","id":"facebookUrl"},{"type":"url","label":"Twitter/X URL","id":"twitterUrl"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Footer","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Footer'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Store name'
              id: 'storeName'
            1:
              type: 'text'
              label: 'Tagline'
              id: 'tagline'
            2:
              type: 'text'
              label: 'Contact email'
              id: 'contactEmail'
            3:
              type: 'text'
              label: 'Contact phone'
              id: 'contactPhone'
            4:
              type: 'url'
              label: 'Instagram URL'
              id: 'instagramUrl'
            5:
              type: 'url'
              label: 'Facebook URL'
              id: 'facebookUrl'
            6:
              type: 'url'
              label: 'Twitter/X URL'
              id: 'twitterUrl'
          blocks:
            0:
              type: 'link'
              name: 'Link'
              settings:
                0:
                  type: 'text'
                  label: 'Label'
                  id: 'label'
                1:
                  type: 'url'
                  label: 'URL'
                  id: 'href'
          presets:
            0:
              name: 'Footer'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      header:
        path: 'sections/header.liquid'
        source: |-
          <div class="pn-theme"><header class="lb-header" data-section-id="{{ section.id }}" data-sticky="{% if section.settings.behavior == 'sticky' %}true{% else %}false{% endif %}" data-layout="{{ section.settings.layout | default: 'inline' }}">
            <div class="lb-header__inner">
              <lb-mobile-nav class="lb-mobile-nav" data-lb-island="mobile-nav">
                <button type="button" class="lb-header__toggle" data-lb-nav-toggle aria-expanded="false" aria-controls="lb-nav-panel-{{ section.id }}" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg><span class="lb-sr-only">Menu</span></button>
                <nav class="lb-header__nav" data-lb-nav-panel id="lb-nav-panel-{{ section.id }}" aria-label="Primary">
                  <div class="lb-header__nav-head"><span class="lb-header__nav-head-brand">{{ section.settings.storeName | default: shop.name }}</span><button type="button" class="lb-header__nav-close" data-lb-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close menu</span></button></div>
                  <div class="lb-header__nav-links">
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}
                  {% else %}
                    {% assign lb_menu_handle = section.settings.menu | default: 'main_menu' %}
                    {% assign lb_nav_links = linklists[lb_menu_handle].links %}
                    {% for link in lb_nav_links %}
                      {% if link.links.size > 0 %}
                      <details class="lb-header__nav-item" data-lb-nav-dropdown><summary{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lb-icon-chevron"><path d="M6 9l6 6 6-6"></path></svg></summary>
                        <div class="lb-header__nav-submenu">{% for child in link.links %}<a href="{{ child.url | store_url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>
                      </details>
                      {% else %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}
                    {% endfor %}
                  {% endif %}
                  </div>
                  <div class="lb-header__nav-foot">
                    {% if customer %}<a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Account</span></a>{% else %}<a href="{{ routes.customer_login_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Log in</span></a>{% endif %}
                  </div>
                </nav>
                <div class="lb-header__scrim" data-lb-nav-scrim></div>
              </lb-mobile-nav>
              <a class="lb-header__brand" href="{{ routes.root_url }}">
                {% if shop.logo_url %}<img class="lb-header__logo" src="{{ shop.logo_url | image_url }}" alt="{{ section.settings.storeName | default: shop.name }}">{% else %}{{ section.settings.storeName | default: shop.name }}{% endif %}
              </a>
              <div class="lb-header__actions">
                {% if section.settings.showSearch %}<button type="button" class="lb-header__search-toggle" data-lb-search-toggle aria-expanded="false" aria-controls="lb-search-overlay-{{ section.id }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>{% endif %}
                <a class="lb-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.customer_login_url }}{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span class="lb-sr-only">{% if customer %}Account{% else %}Log in{% endif %}</span></a>
                {% if section.settings.showCart %}<a class="lb-header__cart" href="{{ routes.cart_url }}" data-lb-cart-trigger><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2l2 12h11l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="lb-sr-only">{{ "general.cart" | t }}</span> (<span data-lb-cart-count>{{ cart.item_count | default: 0 }}</span>)</a>{% endif %}
              </div>
            </div>
            {% if section.settings.showSearch %}
            <div class="lb-header__search-overlay" id="lb-search-overlay-{{ section.id }}" data-lb-search-overlay hidden>
              <lb-predictive-search class="lb-predictive-search" data-lb-island="predictive-search" data-search-url="{{ routes.search_url }}">
                <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                  <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                  <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="Search products" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lb-search-results-{{ section.id }}" aria-autocomplete="list">
                  <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                  <button type="button" data-lb-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close search</span></button>
                </form>
                <div id="lb-search-results-{{ section.id }}" class="lb-predictive-search__results" data-lb-search-results role="listbox" aria-live="polite"></div>
              </lb-predictive-search>
            </div>
            {% endif %}
          </header>
          </div>
          {% schema %}
          {"name":"Header","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"toggle","label":"Show search","default":true,"id":"showSearch"},{"type":"toggle","label":"Show cart","default":true,"id":"showCart"},{"type":"select","label":"Header behavior","default":"sticky","options":["static","sticky"],"id":"behavior"},{"type":"select","label":"Menu","default":"main_menu","options":["main_menu","footer_menu","policy_menu"],"id":"menu"},{"type":"select","label":"Layout","default":"inline","options":["inline","centered"],"id":"layout"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Header","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Header'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Store name'
              id: 'storeName'
            1:
              type: 'toggle'
              label: 'Show search'
              default: true
              id: 'showSearch'
            2:
              type: 'toggle'
              label: 'Show cart'
              default: true
              id: 'showCart'
            3:
              type: 'select'
              label: 'Header behavior'
              default: 'sticky'
              options:
                0: 'static'
                1: 'sticky'
              id: 'behavior'
            4:
              type: 'select'
              label: 'Menu'
              default: 'main_menu'
              options:
                0: 'main_menu'
                1: 'footer_menu'
                2: 'policy_menu'
              id: 'menu'
            5:
              type: 'select'
              label: 'Layout'
              default: 'inline'
              options:
                0: 'inline'
                1: 'centered'
              id: 'layout'
          blocks:
            0:
              type: 'link'
              name: 'Link'
              settings:
                0:
                  type: 'text'
                  label: 'Label'
                  id: 'label'
                1:
                  type: 'url'
                  label: 'URL'
                  id: 'href'
          presets:
            0:
              name: 'Header'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      hero-banner:
        path: 'sections/hero-banner.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><div class="pn-hero{% if section.settings.image == blank %} pn-hero--no-media{% endif %}"><div class="pn-hero-copy"><p class="pn-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="pn-button" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>{% endif %}{% for block in section.blocks %}{% if block.type == 'note' %}<p class="pn-meta" {{ block.editor_attributes | raw }}>{{ block.settings.text }}</p>{% endif %}{% endfor %}</div>{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" class="pn-focal-{{ section.settings.focalPoint }}" fetchpriority="high" decoding="async">{% endif %}</div></div></section>
          </div>
          {% schema %}
          {"name":"Compact pantry introduction","tag":"section","settings":[{"type":"text","label":"Eyebrow","default":"THE EVERYDAY PANTRY","id":"eyebrow"},{"type":"text","label":"Heading","default":"Good things start with staples.","id":"heading"},{"type":"text","label":"Description","default":"Find your shelf, read the details, choose your pack.","id":"subheading"},{"type":"text","label":"Action label","default":"Explore pantry shelves","id":"ctaText"},{"type":"url","label":"Action destination","default":"/products","id":"ctaLink"},{"type":"image","label":"Seasonal photograph","id":"image"},{"type":"text","label":"Image description","default":"","id":"imageAlt"},{"type":"select","label":"Image focal point","default":"center","options":["center","left","right"],"id":"focalPoint"}],"blocks":[{"type":"note","name":"Introductory note","settings":[{"type":"text","label":"Note text","default":"","id":"text"}]}],"presets":[{"name":"Compact pantry introduction","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Compact pantry introduction'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Eyebrow'
              default: 'THE EVERYDAY PANTRY'
              id: 'eyebrow'
            1:
              type: 'text'
              label: 'Heading'
              default: 'Good things start with staples.'
              id: 'heading'
            2:
              type: 'text'
              label: 'Description'
              default: 'Find your shelf, read the details, choose your pack.'
              id: 'subheading'
            3:
              type: 'text'
              label: 'Action label'
              default: 'Explore pantry shelves'
              id: 'ctaText'
            4:
              type: 'url'
              label: 'Action destination'
              default: '/products'
              id: 'ctaLink'
            5:
              type: 'image'
              label: 'Seasonal photograph'
              id: 'image'
            6:
              type: 'text'
              label: 'Image description'
              default: ''
              id: 'imageAlt'
            7:
              type: 'select'
              label: 'Image focal point'
              default: 'center'
              options:
                0: 'center'
                1: 'left'
                2: 'right'
              id: 'focalPoint'
          blocks:
            0:
              type: 'note'
              name: 'Introductory note'
              settings:
                0:
                  type: 'text'
                  label: 'Note text'
                  default: ''
                  id: 'text'
          presets:
            0:
              name: 'Compact pantry introduction'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      marquee:
        path: 'sections/marquee.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-marquee" data-section-id="{{ section.id }}">
            <p>{{ section.settings.text }}</p>
          </section>
          </div>
          {% schema %}
          {"name":"Marquee","tag":"section","settings":[{"type":"text","label":"Text","default":"Featured announcement","id":"text"}],"blocks":[],"presets":[{"name":"Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Marquee'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Text'
              default: 'Featured announcement'
              id: 'text'
          blocks:
          presets:
            0:
              name: 'Marquee'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      portfolio-grid:
        path: 'sections/portfolio-grid.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-portfolio-grid" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% for block in section.blocks %}<article><h3>{{ block.settings.title }}</h3><p>{{ block.settings.summary }}</p><a href="{{ block.settings.link | store_url }}">View</a></article>{% endfor %}
          </section>
          </div>
          {% schema %}
          {"name":"Portfolio Grid","tag":"section","settings":[{"type":"text","label":"Title","default":"Portfolio","id":"title"}],"blocks":[{"type":"project","name":"Project","settings":[{"type":"text","label":"Title","id":"title"},{"type":"textarea","label":"Summary","id":"summary"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Portfolio Grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Portfolio Grid'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Portfolio'
              id: 'title'
          blocks:
            0:
              type: 'project'
              name: 'Project'
              settings:
                0:
                  type: 'text'
                  label: 'Title'
                  id: 'title'
                1:
                  type: 'textarea'
                  label: 'Summary'
                  id: 'summary'
                2:
                  type: 'url'
                  label: 'Link'
                  id: 'link'
          presets:
            0:
              name: 'Portfolio Grid'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      product-detail:
        path: 'sections/product-detail.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-product-detail" data-section-id="{{ section.id }}">
            <nav class="lb-product-detail__breadcrumb" aria-label="Breadcrumb">
              <a href="{{ routes.root_url }}">Home</a>
              <a href="{{ routes.all_products_collection_url }}">Shop</a>
              <span aria-current="page">{{ product.title }}</span>
            </nav>
            <div class="lb-product-detail__layout pn-product-layout">
            {% if section.settings.showGallery and product.images.size > 0 %}
            <lb-product-gallery class="lb-product-detail__gallery" data-lb-island="product-gallery">
              <div class="lb-product-detail__gallery-main">
                {% for image in product.images %}<img class="lb-product-detail__gallery-image" src="{{ image | image_url }}" alt="{{ product.title }}" data-lb-gallery-image data-index="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">{% endfor %}
              </div>
              {% if product.images.size > 1 %}
              <div class="lb-product-detail__gallery-thumbs" role="tablist" aria-label="Product images">
                {% for image in product.images %}<button type="button" class="lb-product-detail__gallery-thumb" data-lb-gallery-thumb data-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" aria-label="Image {{ forloop.index }} of {{ product.images.size }}"><img src="{{ image | image_url }}" alt="" aria-hidden="true" loading="lazy" decoding="async"></button>{% endfor %}
              </div>
              {% endif %}
            </lb-product-gallery>
            {% endif %}
          {% if section.settings.showGallery and product.images.size == 0 %}<div class="lb-product-detail__gallery pn-empty">Product image not supplied</div>{% endif %}<section class="pn-food-facts" id="food-facts" aria-label="Ingredients and allergen information"><p class="pn-eyebrow">Read before choosing</p><h2>Inside the pack</h2><div class="pn-food-fact"><strong>Ingredients</strong><p>{% if product.food.ingredients != blank %}{{ product.food.ingredients }}{% else %}Not supplied by the merchant.{% endif %}</p></div><div class="pn-food-fact"><strong>Allergen information</strong>{% if product.food.allergens.status == 'supplied' %}<p>{{ product.food.allergens.statement }}</p><p class="pn-meta">Source: {{ product.food.allergens.source }}</p>{% else %}<p>Not supplied by the merchant.</p><div class="pn-food-unknown"><strong>Unknown is not allergen-free</strong><p>Ask the merchant before buying if this information matters for your diet.</p></div>{% endif %}</div>{% if product.food.storage != blank %}<div class="pn-food-fact"><strong>Storage</strong><p>{{ product.food.storage }}</p></div>{% endif %}{% if product.food.preparation != blank %}<div class="pn-food-fact"><strong>Preparation</strong><p>{{ product.food.preparation }}</p></div>{% endif %}{% if section.settings.showNutrition and product.food.nutritionText != blank %}<div class="pn-food-fact"><strong>Supplied nutrition information</strong><p>{{ product.food.nutritionText }}</p></div>{% endif %}</section>
            <div class="lb-product-detail__info">
            <h1>{{ product.title }}</h1>
            {% if product.review_count > 0 %}<p class="lb-product-detail__rating" aria-label="Rated {{ product.rating }} out of 5">★ {{ product.rating }} <span class="lb-product-detail__rating-count">({{ product.review_count }})</span></p>{% endif %}
            <div class="lb-product-detail__price">
              <span class="lb-product-detail__price-current">{{ product.price | times: 100 | money_with_currency: product.currency }}</span>
              {% if product.compare_at_price and product.compare_at_price > product.price %}
              <s class="lb-product-detail__price-compare">{{ product.compare_at_price | times: 100 | money_with_currency: product.currency }}</s>
              <span class="lb-product-detail__price-save">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
              {% endif %}
            </div>
          <div class="pn-net-info" data-lb-food-presentation data-product-id="{{ product.id }}" data-facts="{{ product.facts_json }}">{% if product.options.size == 0 and product.food.netQuantityValue %}<p data-lb-food-net-quantity>{{ product.food.netQuantityValue }} {{ product.food.netQuantityUnit }} net per pack</p>{% if product.food.unitPriceMinor != nil %}<p data-lb-food-unit-price>{{ product.food.unitPriceMinor | money_with_currency: product.currency }} / {{ product.food.basisQuantity }} {{ product.food.netQuantityUnit }}</p>{% endif %}{% elsif product.options.size > 0 %}<p>Choose a pack. Net contents belong to the selected variant.</p>{% else %}<p>Net quantity not supplied.</p>{% endif %}<p>Quantity counts sellable packs. Shipping is calculated at checkout.</p></div>{% if product.options.size > 0 %}<details class="pn-pack-options"><summary>Pack facts by option</summary><ul>{% for variant in product.variants %}<li><strong>{{ variant.name | default: variant.title }}</strong>{% if variant.food.netQuantityValue %}: {{ variant.food.netQuantityValue }} {{ variant.food.netQuantityUnit }} net per pack{% else %}: net quantity not supplied{% endif %}{% if variant.food.unitPriceMinor != nil %} · {{ variant.food.unitPriceMinor | money_with_currency: product.currency }} / {{ variant.food.basisQuantity }} {{ variant.food.netQuantityUnit }}{% endif %}{% if variant.stock == 0 %} · unavailable{% endif %}</li>{% endfor %}</ul></details>{% endif %}
            {% if product.options.size > 0 %}<lb-variant-picker data-lb-island="variant-picker" data-product-id="{{ product.id }}" data-variants="{{ product.variants | json }}" class="lb-product-detail__variants">{% for option in product.options %}<div class="lb-product-detail__variant-group"><span class="lb-variant-option__name">{{ option.name }}</span><div class="lb-product-detail__variant-values">{% for value in option.values %}<button type="button" data-lb-variant-option data-variant-name="{{ option.name }}" data-variant-value="{{ value }}" aria-pressed="false">{{ value }}</button>{% endfor %}</div></div>{% endfor %}<p class="lb-product-detail__variant-status" data-lb-variant-status role="status"></p></lb-variant-picker>{% endif %}
            <div class="lb-product-detail__purchase">
              <lb-add-to-cart data-lb-island="add-to-cart" data-product-id="{{ product.id }}" data-product-name="{{ product.title }}" data-product-price="{{ product.price }}" data-product-currency="{{ product.currency }}" data-product-url="{{ product.url }}">
                <label class="pn-quantity-label" for="lb-quantity-{{ section.id }}">Number of packs</label>
                <input type="number" name="quantity" id="lb-quantity-{{ section.id }}" class="lb-product-detail__quantity" value="1" min="1" inputmode="numeric">
                <button type="button" class="lb-product-detail__cta lb-product-detail__cta--primary" data-lb-add-to-cart{% if product.available == false %} disabled{% endif %}>{% if product.available == false %}Sold out{% else %}Add to cart{% endif %}</button>
                <span data-lb-add-to-cart-status aria-live="polite"></span>
              </lb-add-to-cart>
              <lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="{% if product.in_wishlist %}true{% endif %}"{% if buyer_wishlist.authenticated %} data-authenticated="true" data-account-type="buyer" data-buyer-id="{{ buyer_wishlist.buyerId }}" data-buyer-linked="{% if buyer_wishlist.linked %}true{% endif %}" data-buyer-unavailable="{% if buyer_wishlist.unavailable or buyer_wishlist.storeAccountUnavailable %}true{% endif %}"{% elsif customer %} data-authenticated="true" data-account-type="store_customer"{% endif %} data-base-path="/store/{{ shop.subdomain }}" aria-label="Add {{ product.title }} to wishlist"></lb-wishlist-toggle>
            </div>
            {% if section.settings.showDescription and product.description %}
            <details class="lb-product-detail__accordion"><summary>Description</summary><div class="lb-product-detail__accordion-body">{{ product.description }}</div></details>
            {% endif %}
            {% if shop.policies contains 'shipping' %}
            <details class="lb-product-detail__accordion"><summary>Shipping</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/shipping">Read our shipping policy</a></div></details>
            {% endif %}
            {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}
            <details class="lb-product-detail__accordion"><summary>Returns</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/returns">Read our returns policy</a></div></details>
            {% endif %}
            </div>
            </div>
            {% if section.settings.showReviews and product.reviews.size > 0 %}<div class="lb-product-reviews" data-section-id="{{ section.id }}-reviews">
              <h2 class="lb-product-reviews__title">Customer reviews ({{ product.review_count }})</h2>
              {% for review in product.reviews %}<article class="lb-product-review">
                <header class="lb-product-review__head"><strong class="lb-product-review__author">{{ review.author }}</strong><span class="lb-product-review__stars" aria-label="Rated {{ review.rating }} out of 5">★ {{ review.rating }}</span>{% if review.is_verified %}<span class="lb-product-review__verified">Verified purchase</span>{% endif %}</header>
                {% if review.title %}<h3 class="lb-product-review__heading">{{ review.title }}</h3>{% endif %}
                {% if review.body %}<p class="lb-product-review__body">{{ review.body }}</p>{% endif %}
                {% if review.helpful_count > 0 %}<footer class="lb-product-review__helpful">{{ review.helpful_count }} found this helpful</footer>{% endif %}
              </article>{% endfor %}
            </div>{% endif %}
            {% if section.settings.showReviews %}<lb-review-form data-lb-island="review-form" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}"></lb-review-form>{% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Product Detail","tag":"section","settings":[{"type":"toggle","label":"Show gallery","default":true,"id":"showGallery"},{"type":"toggle","label":"Show description","default":true,"id":"showDescription"},{"type":"toggle","label":"Show reviews","default":true,"id":"showReviews"},{"id":"showNutrition","type":"toggle","label":"Show supplied nutrition text","default":true}],"blocks":[],"presets":[{"name":"Product Detail","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Product Detail'
          tag: 'section'
          settings:
            0:
              type: 'toggle'
              label: 'Show gallery'
              default: true
              id: 'showGallery'
            1:
              type: 'toggle'
              label: 'Show description'
              default: true
              id: 'showDescription'
            2:
              type: 'toggle'
              label: 'Show reviews'
              default: true
              id: 'showReviews'
            3:
              type: 'toggle'
              label: 'Show supplied nutrition text'
              default: true
              id: 'showNutrition'
          blocks:
          presets:
            0:
              name: 'Product Detail'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      product-grid:
        path: 'sections/product-grid.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><div class="pn-heading"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div></div>{% assign pantry_products = section.products | default: collection.products %}{% if pantry_products.size > 0 %}<div class="pn-product-list">{% for item in pantry_products limit: section.settings.productLimit %}{% assign pantry_has_options = item.has_options %}{% if item.options.size > 0 %}{% assign pantry_has_options = true %}{% endif %}<article class="pn-card"><a class="pn-card-media" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<span class="pn-card-placeholder">Product image not supplied</span>{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.title }}</a></h3>{% if pantry_has_options %}<p class="pn-card-net">Choose a pack to check its net quantity</p>{% elsif item.food.netQuantityValue %}<p class="pn-card-net">{{ item.food.netQuantityValue }} {{ item.food.netQuantityUnit }} net per pack</p>{% else %}<p class="pn-card-net">Net quantity not supplied</p>{% endif %}<p class="pn-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if pantry_has_options != true and item.food.unitPriceMinor != nil %}<p class="pn-meta">{{ item.food.unitPriceMinor | money_with_currency: item.currency }} / {{ item.food.basisQuantity }} {{ item.food.netQuantityUnit }}</p>{% endif %}<a class="pn-link" href="{{ item.url }}">Choose pack</a>{% if item.available == false %}<p class="pn-meta">Unavailable</p>{% endif %}</div></article>{% endfor %}</div><nav class="pn-pagination" aria-label="Product pages">{% if collection.pagination.previous_url != blank %}<a class="pn-link" href="{{ collection.pagination.previous_url }}">Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url != blank %}<a class="pn-link" href="{{ collection.pagination.next_url }}">Next</a>{% endif %}</nav>{% else %}<p class="pn-empty">No products found. Keep your search and broaden the shelf or clear a filter.</p>{% endif %}</div></section>
          </div>
          {% schema %}
          {"name":"Pantry shelf list","tag":"section","settings":[{"type":"text","label":"Heading","default":"Everyday staples","id":"title"},{"type":"text","label":"Description","default":"","id":"subtitle"},{"type":"range","label":"Products to show","default":6,"min":1,"max":24,"step":1,"id":"productLimit"},{"type":"collection","label":"Collection","id":"collectionId"}],"blocks":[],"presets":[{"name":"Pantry shelf list","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Pantry shelf list'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Everyday staples'
              id: 'title'
            1:
              type: 'text'
              label: 'Description'
              default: ''
              id: 'subtitle'
            2:
              type: 'range'
              label: 'Products to show'
              default: 6
              min: 1
              max: 24
              step: 1
              id: 'productLimit'
            3:
              type: 'collection'
              label: 'Collection'
              id: 'collectionId'
          blocks:
          presets:
            0:
              name: 'Pantry shelf list'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      rich-content:
        path: 'sections/rich-content.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-rich-content" data-section-id="{{ section.id }}">
            <h1>{{ section.settings.title }}</h1>
            <div>{{ section.settings.body }}</div>
          </section>
          </div>
          {% schema %}
          {"name":"Rich Content","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"richtext","label":"Body","id":"body"}],"blocks":[],"presets":[{"name":"Rich Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Rich Content'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              id: 'title'
            1:
              type: 'richtext'
              label: 'Body'
              id: 'body'
          blocks:
          presets:
            0:
              name: 'Rich Content'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      services-grid:
        path: 'sections/services-grid.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-services-grid" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% for block in section.blocks %}<article><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p><a href="{{ block.settings.link | store_url }}">Learn more</a></article>{% endfor %}
          </section>
          </div>
          {% schema %}
          {"name":"Services Grid","tag":"section","settings":[{"type":"text","label":"Title","default":"Services","id":"title"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","label":"Title","id":"title"},{"type":"textarea","label":"Description","id":"description"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Services Grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Services Grid'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Services'
              id: 'title'
          blocks:
            0:
              type: 'service'
              name: 'Service'
              settings:
                0:
                  type: 'text'
                  label: 'Title'
                  id: 'title'
                1:
                  type: 'textarea'
                  label: 'Description'
                  id: 'description'
                2:
                  type: 'url'
                  label: 'Link'
                  id: 'link'
          presets:
            0:
              name: 'Services Grid'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      skills-section:
        path: 'sections/skills-section.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-skills-section" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% if section.blocks.size > 0 %}<h3>General</h3>{% endif %}
            {% for block in section.blocks %}<span data-level="{{ block.settings.level }}">{{ block.settings.name }} {{ block.settings.level }}%</span>{% endfor %}
          </section>
          </div>
          {% schema %}
          {"name":"Skills Section","tag":"section","settings":[{"type":"text","label":"Title","default":"Skills","id":"title"}],"blocks":[{"type":"skill","name":"Skill","settings":[{"type":"text","label":"Skill","id":"name"},{"type":"range","label":"Level","min":0,"max":100,"step":5,"id":"level"}]}],"presets":[{"name":"Skills Section","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Skills Section'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Skills'
              id: 'title'
          blocks:
            0:
              type: 'skill'
              name: 'Skill'
              settings:
                0:
                  type: 'text'
                  label: 'Skill'
                  id: 'name'
                1:
                  type: 'range'
                  label: 'Level'
                  min: 0
                  max: 100
                  step: 5
                  id: 'level'
          presets:
            0:
              name: 'Skills Section'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      testimonials:
        path: 'sections/testimonials.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-testimonials" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% if section.blocks.size > 0 %}<div class="lb-testimonials__items">{% for block in section.blocks %}<blockquote><p>{{ block.settings.quote }}</p><cite>{{ block.settings.author }}</cite></blockquote>{% endfor %}</div>
            {% else %}<p class="lb-testimonials__empty">Add customer reviews to build trust.</p>{% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Testimonials","tag":"section","settings":[{"type":"text","label":"Title","default":"What customers say","id":"title"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","label":"Quote","id":"quote"},{"type":"text","label":"Author","id":"author"}]}],"presets":[{"name":"Testimonials","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Testimonials'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'What customers say'
              id: 'title'
          blocks:
            0:
              type: 'testimonial'
              name: 'Testimonial'
              settings:
                0:
                  type: 'textarea'
                  label: 'Quote'
                  id: 'quote'
                1:
                  type: 'text'
                  label: 'Author'
                  id: 'author'
          presets:
            0:
              name: 'Testimonials'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      trust-badges:
        path: 'sections/trust-badges.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-services">{% if section.settings.packText != blank %}<div><h3>Choose the right pack</h3><p>{{ section.settings.packText }}</p></div>{% endif %}{% if section.settings.factsText != blank %}<div><h3>Read the supplied details</h3><p>{{ section.settings.factsText }}</p></div>{% endif %}{% if section.settings.shippingText != blank %}<div><h3>Shipping for your address</h3><p>{{ section.settings.shippingText }}</p></div>{% endif %}</div></section>
          </div>
          {% schema %}
          {"name":"Merchant service information","tag":"section","settings":[{"type":"text","label":"Pack guidance","default":"","id":"packText"},{"type":"text","label":"Food information guidance","default":"","id":"factsText"},{"type":"text","label":"Shipping information","default":"","id":"shippingText"}],"blocks":[],"presets":[{"name":"Merchant service information","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Merchant service information'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Pack guidance'
              default: ''
              id: 'packText'
            1:
              type: 'text'
              label: 'Food information guidance'
              default: ''
              id: 'factsText'
            2:
              type: 'text'
              label: 'Shipping information'
              default: ''
              id: 'shippingText'
          blocks:
          presets:
            0:
              name: 'Merchant service information'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      newsletter-signup:
        path: 'sections/newsletter-signup.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-newsletter-signup" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            <p>{{ section.settings.subtitle }}</p>
            <form action="/contact" method="post">
              <input type="email" name="email" aria-label="Email" required>
              <button type="submit">{{ section.settings.buttonLabel }}</button>
            </form>
          </section>
          </div>
          {% schema %}
          {"name":"Newsletter Signup","tag":"section","settings":[{"type":"text","label":"Heading","default":"Get first access","id":"title"},{"type":"text","label":"Subheading","id":"subtitle"},{"type":"text","label":"Button label","default":"Sign up","id":"buttonLabel"}],"blocks":[],"presets":[{"name":"Newsletter Signup","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Newsletter Signup'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Get first access'
              id: 'title'
            1:
              type: 'text'
              label: 'Subheading'
              id: 'subtitle'
            2:
              type: 'text'
              label: 'Button label'
              default: 'Sign up'
              id: 'buttonLabel'
          blocks:
          presets:
            0:
              name: 'Newsletter Signup'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      spotlight:
        path: 'sections/spotlight.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-first-party-spotlight" data-section-id="{{ section.id }}">
            <p>{{ section.settings.subheading }}</p>
            <h2>{{ section.settings.heading }}</h2>
            <div class="lb-first-party-spotlight__blocks">
              {% for block in section.blocks %}
                {{ block.content | raw }}
              {% endfor %}
            </div>
          </section>
          </div>
          {% schema %}
          {"name":"Spotlight","tag":"section","settings":[{"type":"text","label":"Heading","default":"Made for daily buyers","id":"heading"},{"type":"text","label":"Subheading","id":"subheading"}],"blocks":[{"type":"badge","name":"Badge","settings":[]},{"type":"@app","name":"App block","settings":[]}],"presets":[{"name":"Spotlight","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Spotlight'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Made for daily buyers'
              id: 'heading'
            1:
              type: 'text'
              label: 'Subheading'
              id: 'subheading'
          blocks:
            0:
              type: 'badge'
              name: 'Badge'
              settings:
            1:
              type: '@app'
              name: 'App block'
              settings:
          presets:
            0:
              name: 'Spotlight'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      video-hero:
        path: 'sections/video-hero.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-video-hero" data-section-id="{{ section.id }}">
            <div class="lb-video-hero__copy">
              <h2 class="lb-video-hero__heading">{{ section.settings.heading }}</h2>
              {% if section.settings.subheading %}<p class="lb-video-hero__subheading">{{ section.settings.subheading }}</p>{% endif %}
            </div>
            {% if section.settings.videoUrl != blank %}<div class="lb-video-hero__embed"><iframe src="{{ section.settings.videoUrl | video_url }}" title="{{ section.settings.heading }}" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allowfullscreen></iframe></div>{% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Video Hero","tag":"section","settings":[{"type":"text","label":"Heading","default":"See the fit in motion","id":"heading"},{"type":"textarea","label":"Subheading","default":"A quick look at how each drop moves, from the box to your feet.","id":"subheading"},{"type":"url","label":"Video embed URL","info":"A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.","id":"videoUrl"}],"blocks":[],"presets":[{"name":"Video Hero","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Video Hero'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'See the fit in motion'
              id: 'heading'
            1:
              type: 'textarea'
              label: 'Subheading'
              default: 'A quick look at how each drop moves, from the box to your feet.'
              id: 'subheading'
            2:
              type: 'url'
              label: 'Video embed URL'
              info: 'A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.'
              id: 'videoUrl'
          blocks:
          presets:
            0:
              name: 'Video Hero'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
    blocks:
      badge:
        path: 'blocks/badge.liquid'
        source: '<span class="lb-badge" data-block-id="{{ block.id }}">{{ block.settings.label }}</span>'
        schema:
          name: 'Badge'
          settings:
            0:
              type: 'text'
              label: 'Label'
              default: 'New'
              id: 'label'
          presets:
    locales:
      en:
        general:
          cart: 'Cart'
    renderer:
      engine: 'liquid'
      renderer_version: '0.1.0'
      liquid_ready: true
      assets:
  actual:
    schema_version: '2026-06-liquid-sections'
    package:
      slug: 'letbuyy-refresh'
      name: 'Pantry'
      description: 'Shelf-stable pantry shopping with ingredients, supplied allergen information and explicit pack quantities.'
      author_name: 'LetBuyy'
      site_types:
        0: 'store'
      status: 'active'
      pricing_type: 'free'
      price: 0
      currency: 'INR'
      version: '2.0.0'
      version_number: 2
      release_status: 'published'
      compatibility_range: '>=2026-06-liquid-sections'
    layout:
      theme:
        path: 'layout/theme.liquid'
        source: |-
          <!doctype html>
          <html lang="{{ request.locale | default: "en" }}">
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            {% assign lb_page_title = shop.name %}
            {% assign lb_meta_description = settings.metaDescription | default: shop.description | strip_html | truncate: 160 %}
            <title>{{ lb_page_title }}</title>
            {% if lb_meta_description != blank %}<meta name="description" content="{{ lb_meta_description }}">{% endif %}
            <meta name="twitter:card" content="{% if settings.socialImageUrl != blank %}summary_large_image{% else %}summary{% endif %}">
            <meta name="twitter:title" content="{{ lb_page_title }}">
            {% if lb_meta_description != blank %}<meta name="twitter:description" content="{{ lb_meta_description }}">{% endif %}
            {% if settings.socialImageUrl != blank %}<meta name="twitter:image" content="{{ settings.socialImageUrl | image_url }}">{% endif %}
            <style data-lb-layout="1">
              :root{--lb-focus-ring-width:2px;--lb-focus-ring-color:var(--accent,#2563eb);--lb-focus-offset:2px;--lb-space-sm:0.5rem;--lb-space-md:0.75rem;--lb-space-lg:1rem;--lb-radius-sm:0.375rem;--lb-layout-max:72rem;--lb-layout-gutter:1rem;--lb-layout-breakpoint:48em;}
              .lb-theme :where(a,button,input,select,textarea,summary,details,[tabindex]):focus-visible{outline:var(--lb-focus-ring-width) solid var(--lb-focus-ring-color);outline-offset:var(--lb-focus-offset);}
              .lb-skip-link{position:absolute;left:-9999px;top:0;z-index:100;padding:var(--lb-space-md) var(--lb-space-lg);border-radius:var(--lb-radius-sm);background:var(--surface,#f8fafc);color:var(--foreground,#1a1a2e);font-weight:600;}
              .lb-skip-link:focus,.lb-skip-link:focus-visible{left:var(--lb-space-lg);top:var(--lb-space-lg);}
              .lb-layout__header,.lb-layout__footer{display:flex;flex-direction:column;align-items:flex-start;gap:var(--lb-space-md);margin-inline:auto;max-width:min(var(--lb-layout-max),calc(100vw - var(--lb-layout-gutter) * 2));padding-block:var(--lb-space-lg);padding-inline:var(--lb-layout-gutter);}
              .lb-layout__brand{font-family:var(--font-display,inherit);font-weight:700;}
              .lb-layout__nav{display:flex;flex-wrap:wrap;gap:var(--lb-space-md);}
              .lb-layout__legal{margin:0;font-size:0.875rem;}
              @media (min-width:48em){.lb-layout__header,.lb-layout__footer{flex-direction:row;align-items:center;justify-content:space-between;}}
            </style>
            {{ content_for_header | raw }}
          <style data-pantry="2">
          .pn-theme{--pn-muted:var(--pn-supporting-color,#5a624a);--pn-line:var(--pn-line-color,#d5d6c7);--pn-boundary:var(--pn-boundary-color,#707858);--pn-focus:var(--pn-focus-color,#005fcc);--pn-warning:#7a3e00;--pn-warning-surface:#fff4ce;--font-body:var(--font-main,Inter,Arial,sans-serif);--font-display:var(--font-heading,Inter,Arial,sans-serif);--footer-bg:var(--surface,#eee8d8);--footer-text:var(--foreground,#262a1d);--footer-text-muted:var(--pn-muted);background:var(--background,#fcf8ef);color:var(--foreground,#262a1d);font:16px/1.55 var(--font-body)}
          .pn-theme *{box-sizing:border-box;min-width:0}.pn-theme :where(img){max-width:100%}.pn-theme :where(a){color:inherit}.pn-theme :where(button,input,select,textarea){font:inherit;max-width:100%}.pn-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--pn-focus);outline-offset:4px}.pn-theme :where(h1,h2,h3){font-family:var(--font-display);font-weight:600;line-height:1.15;letter-spacing:-.035em;overflow-wrap:anywhere}.pn-theme h1{font-size:clamp(2rem,4vw,3rem)}.pn-theme h2{font-size:clamp(1.65rem,3vw,2rem)}.pn-theme h3{font-size:1.25rem}.pn-theme p{color:var(--pn-muted);overflow-wrap:anywhere}.pn-theme [hidden]{display:none!important}.pn-wrap{width:min(1240px,calc(100% - 96px));margin-inline:auto}.pn-section{padding-block:48px}.pn-eyebrow{text-transform:uppercase;font-size:.75rem;font-weight:600;letter-spacing:.14em}.pn-meta{font-size:.875rem}.pn-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 22px;border:1px solid var(--primary,#36533d);background:var(--primary,#36533d);color:var(--pn-action-label,#fff)!important;border-radius:var(--radius,6px);font-weight:600;text-decoration:none;overflow-wrap:anywhere;max-width:100%}.pn-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:5px}.pn-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:24px}.pn-heading h2{margin:0}.pn-empty{padding:26px;border:1px solid var(--pn-boundary);border-radius:6px}.pn-hero{display:grid;grid-template-columns:.9fr 1.1fr;background:var(--surface,#eee8d8);border-radius:8px;overflow:hidden}.pn-hero-copy{padding:44px}.pn-hero-copy h1{margin:14px 0 20px}.pn-hero-copy p{margin:0 0 24px}.pn-hero img{height:100%;width:100%;min-height:340px;object-fit:cover;object-position:var(--pn-hero-position,center)}.pn-hero img.pn-focal-left{object-position:left}.pn-hero img.pn-focal-center{object-position:center}.pn-hero img.pn-focal-right{object-position:right}.pn-hero--no-media{grid-template-columns:1fr}.pn-hero--no-media .pn-hero-copy{max-width:780px}.pn-shelves{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.pn-shelf{display:flex;justify-content:space-between;gap:15px;padding:20px;border:1px solid var(--pn-boundary);border-radius:6px;min-height:72px;text-decoration:none}.pn-shelf span{overflow-wrap:anywhere}.pn-product-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.pn-card{display:grid;grid-template-columns:130px minmax(0,1fr);gap:20px;padding:18px;border:1px solid var(--pn-line);border-radius:6px;background:var(--pn-card-surface,#fff)}.pn-card-media{display:grid;place-items:center;background:var(--surface);min-height:150px;border-radius:4px;overflow:hidden}.pn-card-media img{width:130px;height:150px;object-fit:contain}.pn-card h3{margin:0 0 8px}.pn-card h3 a{text-decoration:none}.pn-card p{margin:5px 0}.pn-card-price{font-size:1.2rem;font-weight:600;font-variant-numeric:tabular-nums}.pn-card .pn-link{font-size:.875rem}.pn-card-placeholder{font-size:.8rem;padding:14px;text-align:center}.pn-card-net{font-size:.875rem}.pn-pairing{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}.pn-pairing .pn-product-list{grid-template-columns:1fr}.pn-feature{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.pn-feature img{width:100%;height:360px;object-fit:contain;background:var(--surface)}.pn-feature--no-media{grid-template-columns:1fr}.pn-feature p{margin:16px 0}.pn-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;border-top:1px solid var(--pn-line)}.pn-services>div{padding-block:24px}.pn-services h3{margin:0 0 10px}.pn-filters{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin-top:22px}.pn-filters label{display:grid;gap:6px;font-size:.875rem}.pn-filters input,.pn-filters select{min-height:46px;border:1px solid var(--pn-boundary);border-radius:6px;background:var(--pn-card-surface,#fff);color:inherit;padding:10px 12px}.pn-pagination{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:28px}.pn-theme .pn-product-layout{display:grid;grid-template-columns:.95fr .9fr 1fr;gap:32px;align-items:start}.pn-theme .lb-product-detail{padding:24px 0 48px;width:min(1240px,calc(100% - 96px));margin-inline:auto}.pn-theme .lb-product-detail__breadcrumb{display:flex;gap:16px;flex-wrap:wrap;padding:0 0 26px;font-size:.875rem}.pn-theme .lb-product-detail__gallery{background:var(--surface);border-radius:6px;overflow:hidden}.pn-theme .lb-product-detail__gallery-main img{width:100%;aspect-ratio:1;object-fit:contain}.pn-theme .lb-product-detail__gallery-thumbs{display:flex;gap:8px;padding:10px;flex-wrap:wrap}.pn-theme .lb-product-detail__gallery-thumb{max-width:60px;min-height:44px}.pn-theme .lb-product-detail__gallery-thumb img{width:50px;height:55px;object-fit:contain}.pn-theme .lb-product-detail__info h1{font-size:2rem;margin:0 0 18px}.pn-theme .lb-product-detail__price-current{font-size:1.6rem;font-weight:600}.pn-theme .lb-product-detail__variant-group{margin:20px 0}.pn-theme .lb-product-detail__variant-values{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}.pn-theme .lb-product-detail__variant-values button{min-height:48px;min-width:44px;padding:10px 15px;border:1px solid var(--pn-boundary);background:transparent;border-radius:6px;color:inherit}.pn-theme .lb-product-detail__variant-values [aria-pressed=true]{background:var(--primary);color:var(--pn-action-label,#fff)}.pn-theme .lb-product-detail__quantity{min-height:48px;width:90px;padding:10px;border:1px solid var(--pn-boundary);border-radius:5px;background:var(--pn-card-surface,#fff);color:inherit}.pn-theme .lb-product-detail__purchase lb-add-to-cart{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.pn-theme .lb-product-detail__cta{min-height:48px;padding:12px 20px;border:1px solid var(--primary);border-radius:6px;background:var(--primary);color:var(--pn-action-label,#fff);font-weight:600}.pn-theme .lb-product-detail__accordion{border-bottom:1px solid var(--pn-line);padding-block:14px}.pn-theme .lb-product-detail__accordion summary{cursor:pointer;min-height:44px}.pn-food-facts h2{font-size:1.5rem;margin:0 0 22px}.pn-food-fact{padding-block:14px;border-bottom:1px solid var(--pn-line)}.pn-food-fact p{margin:7px 0;font-size:.875rem}.pn-food-unknown{padding:18px;background:var(--pn-warning-surface);color:var(--pn-warning);border-radius:6px;margin-block:16px}.pn-food-unknown p{color:var(--pn-warning);font-size:.875rem;margin:8px 0 0}.pn-net-info{margin-block:16px;padding:14px;background:var(--surface);border-radius:6px;font-size:.875rem}.pn-net-info p{margin:5px 0}.pn-pack-options{margin-block:16px;font-size:.875rem}.pn-pack-options summary{min-height:44px;cursor:pointer}.pn-pack-options ul{padding-left:20px}.pn-pack-options li{margin-block:12px}.pn-quantity-label{font-size:.875rem}.pn-theme :where(button:disabled){opacity:.65;cursor:not-allowed}.pn-theme :where(.lb-header,.lb-footer){font-family:var(--font-body)}.pn-theme .lb-header{background:var(--background);color:var(--foreground);border-bottom:1px solid var(--pn-line)}.pn-theme .lb-footer{background:var(--surface);color:var(--foreground)}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses,.lb-content-page){color:var(--foreground);background:var(--background);font-family:var(--font-body)}.pn-theme :where(.lb-cart__checkout,.lb-settings button,.lb-addresses button){border-radius:6px}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses) :where(input,select){min-height:44px;border-color:var(--pn-boundary)}
          .pn-theme .lb-header__brand,.pn-theme .lb-header__nav-links>a{min-height:44px;display:inline-flex;align-items:center}.pn-theme :is(.lb-header__search-toggle,.lb-header__account,.lb-header__toggle,.lb-header__nav-close){min-width:44px;min-height:44px;flex-shrink:0}.pn-theme .pn-card h3 a{display:inline-flex;align-items:center;min-height:44px;min-width:44px;max-width:100%}.pn-theme .lb-footer__col h4,.pn-theme .lb-footer__col a,.pn-theme .lb-footer__bottom{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb a{color:var(--pn-muted);min-width:44px}.pn-theme .lb-product-detail__breadcrumb span[aria-current]{overflow:visible;text-overflow:clip;white-space:normal;max-width:100%;overflow-wrap:anywhere}
          @media(max-width:767px){.pn-theme .lb-mobile-nav:not([data-open="true"]) [data-lb-nav-panel]{display:none}.pn-theme .lb-mobile-nav[data-open="true"] [data-lb-nav-panel]{display:flex}}
          @media(max-width:600px){.pn-theme .lb-header__inner{flex-wrap:wrap;gap:8px 12px}.pn-theme .lb-header__brand{order:0;flex:1 1 calc(100% - 56px);max-width:calc(100% - 56px);overflow-wrap:anywhere}.pn-theme .lb-header__toggle{order:1;flex:0 0 44px}.pn-theme .lb-header__actions{order:2;flex:0 0 100%;justify-content:flex-end}}
          @media(max-width:1100px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 64px)}.pn-theme .pn-product-layout{grid-template-columns:1fr 1fr}.pn-theme .lb-product-detail__gallery{grid-column:1;grid-row:1}.pn-food-facts{grid-column:1;grid-row:2}.pn-theme .lb-product-detail__info{grid-column:2;grid-row:1/3}.pn-card{grid-template-columns:100px minmax(0,1fr);gap:14px}.pn-card-media img{width:100px}.pn-hero-copy{padding:32px}}
          @media(max-width:900px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 48px)}.pn-shelves{grid-template-columns:repeat(2,minmax(0,1fr))}.pn-product-list{grid-template-columns:1fr}.pn-services{gap:20px}.pn-card{grid-template-columns:120px minmax(0,1fr)}.pn-card-media img{width:120px}}
          @media(max-width:600px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 40px)}.pn-section{padding-block:30px}.pn-hero,.pn-feature,.pn-pairing{grid-template-columns:1fr}.pn-hero-copy{padding:26px}.pn-hero img{min-height:0;height:220px}.pn-heading{display:block}.pn-shelf{padding:14px;min-height:72px}.pn-card{grid-template-columns:85px minmax(0,1fr);gap:13px;padding:12px}.pn-card-media img{width:85px;height:126px}.pn-card-media{min-height:126px}.pn-card h3{font-size:1.05rem}.pn-card-price{font-size:1.15rem}.pn-theme .pn-product-layout{display:flex;flex-direction:column;gap:24px}.pn-theme .pn-product-layout>*{width:100%}.pn-theme .lb-product-detail__gallery-main img{max-height:320px;aspect-ratio:1.15}.pn-theme .lb-product-detail__info h1{font-size:1.9rem}.pn-theme .lb-product-detail__cta{flex:1}.pn-services{grid-template-columns:1fr;gap:0}.pn-feature img{height:260px}.pn-filters label{width:100%}.pn-filters input,.pn-filters select{width:100%}}
          @media(max-width:350px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 32px)}.pn-card{grid-template-columns:65px minmax(0,1fr)}.pn-card-media img{width:65px}.pn-shelves{gap:8px}.pn-shelf{padding:10px}}
          @media(prefers-reduced-motion:reduce){.pn-theme *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
          </style>
          <style data-niche-order-presentation="1">.lb-order-facts{min-width:0;max-width:100%;margin-block:.75rem}.lb-order-facts>summary{min-height:44px;cursor:pointer;padding-block:.5rem}.lb-order-facts__text{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit}.lb-order-facts__missing{font-size:.875em;overflow-wrap:anywhere}</style>
