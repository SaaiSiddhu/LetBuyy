          <div class="pn-theme"><section class="lb-brand-marquee" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            <div>{% for block in section.blocks %}<span>{{ block.settings.name }}</span>{% endfor %}</div>
          </section>
          </div>
          {% schema %}
          {"name":"Brand Marquee","tag":"section","settings":[{"type":"text","label":"Title","default":"Featured brands","id":"title"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","label":"Name","id":"name"}]}],"presets":[{"name":"Brand Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
