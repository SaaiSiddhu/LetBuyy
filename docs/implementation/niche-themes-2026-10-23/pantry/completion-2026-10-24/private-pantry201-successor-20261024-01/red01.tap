              default: 'Your addresses'
              id: 'heading'
          blocks:
          presets:
            0:
              name: 'Addresses'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      policy-content:
        path: 'sections/policy-content.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-policy" data-section-id="{{ section.id }}">
            {% if page %}
            <h1 class="lb-policy__title">{{ page.title }}</h1>
            {% if page.body_html != blank %}<div class="lb-policy__body">{{ page.body_html | raw }}</div>
            {% elsif page.content != blank %}<div class="lb-policy__body">{{ page.content | raw }}</div>{% endif %}
            {% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Policy Content","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Policy Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Policy Content'
          tag: 'section'
          settings:
          blocks:
          presets:
            0:
              name: 'Policy Content'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      cart-summary:
        path: 'sections/cart-summary.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-cart-page" data-section-id="{{ section.id }}">
            <h1>{{ section.settings.heading }}</h1>
            <lb-cart data-lb-island="cart" data-base-path="/store/{{ shop.subdomain }}">
              {% if cart.item_count > 0 %}
              <ul class="lb-cart__items">{% for item in cart.items %}<li class="lb-cart__item"><span class="lb-cart__title">{{ item.title }}</span><span class="lb-cart__qty">x{{ item.quantity }}</span><span class="lb-cart__line">{{ item.line_price | money_with_currency: cart.currency }}</span></li>{% endfor %}</ul>
              <div class="lb-liquid-cart__totals">
                {% if cart.subtotal %}<div class="lb-liquid-cart__row"><span>Subtotal</span><span>{{ cart.subtotal | money_with_currency: cart.currency }}</span></div>{% endif %}
                {% if cart.coupon_codes.size > 0 %}<div class="lb-liquid-cart__row"><span>Coupons</span><span>{{ cart.coupon_codes | join: ", " }}</span></div>{% endif %}
                {% if cart.discount_total %}<div class="lb-liquid-cart__row"><span>Discounts</span><span>{{ cart.discount_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                {% if cart.shipping_total %}<div class="lb-liquid-cart__row"><span>Shipping</span><span>{{ cart.shipping_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                {% if cart.tax_total %}<div class="lb-liquid-cart__row"><span>Tax (GST)</span><span>{{ cart.tax_total | money_with_currency: cart.currency }}</span></div>{% endif %}
              </div>
              <p class="lb-cart__total">Total: {{ cart.total_price | money_with_currency: cart.currency }}</p>
              <a class="lb-cart__checkout" href="{{ cart.checkout_url }}">Checkout</a>
              {% else %}<p class="lb-cart__empty">Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>{% endif %}
            </lb-cart>
          </section>
          </div>
          {% schema %}
          {"name":"Cart","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your cart","id":"heading"}],"blocks":[],"presets":[{"name":"Cart","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Cart'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Your cart'
              id: 'heading'
          blocks:
          presets:
            0:
              name: 'Cart'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      search-box:
        path: 'sections/search-box.liquid'
        source: |-
          <div class="pn-theme">
          {% assign pantry_show_pack = false %}
          {% assign pantry_pack_value = '' %}
          {% for field in collection.discovery_query_fields %}{% if field.key == 'pack_size' %}{% assign pantry_pack_value = field.value %}{% endif %}{% endfor %}
          {% if collection.food_filters.enabled and collection.food_filters.pack_sizes.size > 0 %}
            {% if pantry_pack_value == blank %}{% assign pantry_show_pack = true %}{% endif %}
            {% for pack in collection.food_filters.pack_sizes %}{% if pack.value == pantry_pack_value %}{% assign pantry_show_pack = true %}{% endif %}{% endfor %}
          {% endif %}
          {% assign pantry_sort_options = collection.sort_options | default: collection.food_filters.sort_options %}
          <section class="pn-discovery" data-section-id="{{ section.id }}"><div class="pn-wrap pn-section">
          <p class="pn-eyebrow">Choose a shelf. Read the details.</p><h1>{{ collection.title | default: section.settings.title | default: 'Pantry products' }}</h1>
          {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
          {% if collection.total != nil %}<p class="pn-meta">{{ collection.total }} products</p>{% endif %}
          <form class="pn-filters" method="get" action="{{ request.path }}">
          {% for field in collection.discovery_query_fields %}
            {% assign pantry_preserve_field = true %}
            {% if field.key == 'page' %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'search' and section.settings.showSearch != false %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'pack_size' and pantry_show_pack %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'sort' and pantry_sort_options.size > 0 %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'min_price' or field.key == 'max_price' %}{% if collection.food_filters.enabled %}{% assign pantry_preserve_field = false %}{% endif %}
            {% endif %}
            {% if pantry_preserve_field %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endif %}
          {% endfor %}
          {% if section.settings.showSearch != false %}<label>Search products or ingredients<input type="search" name="search" value="{{ request.query.search }}" placeholder="{{ section.settings.placeholder }}" maxlength="200"></label>{% endif %}
          {% if pantry_show_pack %}<label>Pack size<select name="pack_size"><option value="">Any pack size</option>{% for pack in collection.food_filters.pack_sizes %}<option value="{{ pack.value }}"{% if pack.selected or request.query.pack_size == pack.value %} selected{% endif %}>{{ pack.label }}</option>{% endfor %}</select></label>
          {% elsif pantry_pack_value != blank %}<p class="pn-meta">The current pack filter is not among the supplied choices. Remove it to choose another pack.</p>{% endif %}
          {% if collection.food_filters.enabled %}<label>Minimum price<input name="min_price" type="number" min="0" step="0.01" value="{{ request.query.min_price }}"></label><label>Maximum price<input name="max_price" type="number" min="0" step="0.01" value="{{ request.query.max_price }}"></label>{% endif %}
          {% if pantry_sort_options.size > 0 %}<label>Sort<select name="sort">{% for option in pantry_sort_options %}<option value="{{ option.value }}"{% if option.selected or request.query.sort == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></label>{% endif %}
          <button class="pn-button" type="submit">Apply</button>
          {% for filter in collection.active_filters %}<a class="pn-link" href="{{ filter.clear_url }}" aria-label="Remove {{ filter.label }}">{% if filter.key == 'pack_size' %}Remove pack filter{% else %}Remove {{ filter.label }}{% endif %}</a>{% endfor %}
          <a class="pn-link" href="{{ collection.clear_filters_url | default: request.path }}">Clear all filters</a>
          </form></div></section>
          </div>
          {% schema %}
          {"name":"Search","tag":"section","settings":[{"type":"text","label":"Placeholder","default":"Search products","id":"placeholder"}],"blocks":[],"presets":[{"name":"Search","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Search'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Placeholder'
              default: 'Search products'
              id: 'placeholder'
          blocks:
          presets:
            0:
              name: 'Search'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      collection-banner:
        path: 'sections/collection-banner.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-collection-banner" data-section-id="{{ section.id }}">
            {% if collection.image_url != blank %}<img class="lb-collection-banner__image" src="{{ collection.image_url | image_url }}" alt="{{ collection.title }}">{% endif %}
            <h1>{{ collection.title }}</h1>
            {% if collection.products.size > 0 %}<p class="lb-collection-banner__count">{{ collection.products.size }} products</p>{% endif %}
            {% if section.settings.showDescription and collection.description %}<div class="lb-collection-banner__desc">{{ collection.description }}</div>{% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Collection Banner","tag":"section","settings":[{"type":"toggle","label":"Show description","default":true,"id":"showDescription"}],"blocks":[],"presets":[{"name":"Collection Banner","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Collection Banner'
          tag: 'section'
          settings:
            0:
              type: 'toggle'
              label: 'Show description'
              default: true
              id: 'showDescription'
          blocks:
          presets:
            0:
              name: 'Collection Banner'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      collection-product-list:
        path: 'sections/collection-product-list.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section">{% if collection.products.size > 0 %}<div class="pn-product-list">{% for item in collection.products %}{% assign pantry_has_options = item.has_options %}{% if item.options.size > 0 %}{% assign pantry_has_options = true %}{% endif %}<article class="pn-card"><a class="pn-card-media" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<span class="pn-card-placeholder">Product image not supplied</span>{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.title }}</a></h3>{% if pantry_has_options %}<p class="pn-card-net">Choose a pack to check its net quantity</p>{% elsif item.food.netQuantityValue %}<p class="pn-card-net">{{ item.food.netQuantityValue }} {{ item.food.netQuantityUnit }} net per pack</p>{% else %}<p class="pn-card-net">Net quantity not supplied</p>{% endif %}<p class="pn-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if pantry_has_options != true and item.food.unitPriceMinor != nil %}<p class="pn-meta">{{ item.food.unitPriceMinor | money_with_currency: item.currency }} / {{ item.food.basisQuantity }} {{ item.food.netQuantityUnit }}</p>{% endif %}<a class="pn-link" href="{{ item.url }}">Choose pack</a>{% if item.available == false %}<p class="pn-meta">Unavailable</p>{% endif %}</div></article>{% endfor %}</div><nav class="pn-pagination" aria-label="Product pages">{% if collection.pagination.previous_url != blank %}<a class="pn-link" href="{{ collection.pagination.previous_url }}">Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url != blank %}<a class="pn-link" href="{{ collection.pagination.next_url }}">Next</a>{% endif %}</nav>{% else %}<p class="pn-empty">No matching products. Try a broader shelf or clear a filter.</p><a class="pn-link" href="{{ routes.all_products_collection_url | default: routes.search_url }}">Explore all staples</a>{% endif %}</div></section>
          </div>
          {% schema %}
          {"name":"Pantry collection rows","tag":"section","settings":[{"type":"text","label":"Heading","default":"Everyday staples","id":"title"}],"blocks":[],"presets":[{"name":"Pantry collection rows","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Pantry collection rows'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Everyday staples'
              id: 'title'
          blocks:
          presets:
            0:
              name: 'Pantry collection rows'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      blog-listing:
        path: 'sections/blog-listing.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-blog-listing" data-section-id="{{ section.id }}">
            <h1 class="lb-blog-listing__heading">{{ section.settings.heading }}</h1>
            {% if blog.articles and blog.articles.size > 0 %}
            <div class="lb-blog-listing__articles">
              {% for article in blog.articles %}
              <article class="lb-blog-article-card">
                <h2 class="lb-blog-article-card__title"><a href="{{ routes.blog_url }}/{{ article.slug }}">{{ article.title }}</a></h2>
                {% if article.excerpt %}<p class="lb-blog-article-card__excerpt">{{ article.excerpt }}</p>{% endif %}
                {% if article.published_at %}<time class="lb-blog-article-card__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}
              </article>
              {% endfor %}
            </div>
            {% if blog.pages_count and blog.pages_count > 1 %}
            <nav class="lb-blog-listing__pagination" aria-label="Blog pagination">
              {% if blog.current_page and blog.current_page > 1 %}<a class="lb-blog-listing__prev" href="{{ routes.blog_url }}?page={{ blog.current_page | minus: 1 }}" rel="prev">Previous</a>{% endif %}
              {% assign next_page = blog.current_page | plus: 1 %}
              {% if next_page <= blog.pages_count %}<a class="lb-blog-listing__next" href="{{ routes.blog_url }}?page={{ next_page }}" rel="next">Next</a>{% endif %}
            </nav>
            {% endif %}
            {% else %}
            <p class="lb-blog-listing__empty">No posts published yet.</p>
            {% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Blog Listing","tag":"section","settings":[{"type":"text","label":"Heading","default":"Our Blog","id":"heading"}],"blocks":[],"presets":[{"name":"Blog Listing","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Blog Listing'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Our Blog'
              id: 'heading'
          blocks:
          presets:
            0:
              name: 'Blog Listing'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      article-content:
        path: 'sections/article-content.liquid'
        source: |-
          <div class="pn-theme"><section class="lb-article" data-section-id="{{ section.id }}">
            {% if article %}
            <h1 class="lb-article__title">{{ article.title }}</h1>
            {% if article.published_at %}<time class="lb-article__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}
            {% if article.image %}<img class="lb-article__image" src="{{ article.image | image_url }}" alt="{{ article.title }}">{% endif %}
            {% if article.body_html != blank %}<div class="lb-article__body">{{ article.body_html | raw }}</div>{% endif %}
            {% else %}
            <p class="lb-article__missing">Article not found.</p>
            {% endif %}
          </section>
          </div>
          {% schema %}
          {"name":"Article Content","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Article Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
