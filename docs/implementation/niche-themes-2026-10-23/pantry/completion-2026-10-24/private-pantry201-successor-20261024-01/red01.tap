      category-grid:
        path: 'sections/category-grid.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><h2>{{ section.settings.title }}</h2>{% if collections.size > 0 %}<nav class="pn-shelves" aria-label="Pantry shelves">{% for item in collections limit: 100 %}{% if section.settings.collection1 != blank or section.settings.collection2 != blank or section.settings.collection3 != blank or section.settings.collection4 != blank %}{% unless item.id == section.settings.collection1 or item.id == section.settings.collection2 or item.id == section.settings.collection3 or item.id == section.settings.collection4 %}{% continue %}{% endunless %}{% elsif forloop.index > 4 %}{% break %}{% endif %}<a class="pn-shelf" href="{{ routes.collections_url }}/{{ item.handle }}"><span>{{ item.title }}</span><span aria-hidden="true">→</span></a>{% endfor %}</nav>{% else %}<p class="pn-empty">Collections added to this store will appear here.</p>{% endif %}</div></section>
          </div>
          {% schema %}
          {"name":"Pantry shelf shortcuts","tag":"section","settings":[{"type":"text","label":"Heading","default":"Find your shelf","id":"title"},{"type":"collection","label":"Shelf 1","id":"collection1"},{"type":"collection","label":"Shelf 2","id":"collection2"},{"type":"collection","label":"Shelf 3","id":"collection3"},{"type":"collection","label":"Shelf 4","id":"collection4"}],"blocks":[],"presets":[{"name":"Pantry shelf shortcuts","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Pantry shelf shortcuts'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Find your shelf'
              id: 'title'
            1:
              type: 'collection'
              label: 'Shelf 1'
              id: 'collection1'
            2:
              type: 'collection'
              label: 'Shelf 2'
              id: 'collection2'
            3:
              type: 'collection'
              label: 'Shelf 3'
              id: 'collection3'
            4:
              type: 'collection'
              label: 'Shelf 4'
              id: 'collection4'
          blocks:
          presets:
            0:
              name: 'Pantry shelf shortcuts'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      collection-filter:
        path: 'sections/collection-filter.liquid'
        source: |-
          <div class="pn-theme">
          {% assign pantry_show_pack = false %}
          {% assign pantry_pack_value = '' %}
          {% for field in collection.discovery_query_fields %}{% if field.key == 'pack_size' %}{% assign pantry_pack_value = field.value %}{% endif %}{% endfor %}
          {% if collection.food_filters.enabled and collection.food_filters.pack_sizes.size > 0 %}
            {% if pantry_pack_value == blank %}{% assign pantry_show_pack = true %}{% endif %}
            {% for pack in collection.food_filters.pack_sizes %}{% if pack.value == pantry_pack_value %}{% assign pantry_show_pack = true %}{% endif %}{% endfor %}
          {% endif %}
          {% assign pantry_sort_options = collection.sort_options | default: collection.food_filters.sort_options %}
          <section class="pn-discovery" data-section-id="{{ section.id }}"><div class="pn-wrap pn-section">
          <p class="pn-eyebrow">Choose a shelf. Read the details.</p><h1>{{ collection.title | default: section.settings.title | default: 'Pantry products' }}</h1>
          {% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}
          {% if collection.total != nil %}<p class="pn-meta">{{ collection.total }} products</p>{% endif %}
          <form class="pn-filters" method="get" action="{{ request.path }}">
          {% for field in collection.discovery_query_fields %}
            {% assign pantry_preserve_field = true %}
            {% if field.key == 'page' %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'search' and section.settings.showSearch != false %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'pack_size' and pantry_show_pack %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'sort' and pantry_sort_options.size > 0 %}{% assign pantry_preserve_field = false %}
            {% elsif field.key == 'min_price' or field.key == 'max_price' %}{% if collection.food_filters.enabled %}{% assign pantry_preserve_field = false %}{% endif %}
            {% endif %}
            {% if pantry_preserve_field %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endif %}
          {% endfor %}
          {% if section.settings.showSearch != false %}<label>Search products or ingredients<input type="search" name="search" value="{{ request.query.search }}" placeholder="{{ section.settings.placeholder }}" maxlength="200"></label>{% endif %}
          {% if pantry_show_pack %}<label>Pack size<select name="pack_size"><option value="">Any pack size</option>{% for pack in collection.food_filters.pack_sizes %}<option value="{{ pack.value }}"{% if pack.selected or request.query.pack_size == pack.value %} selected{% endif %}>{{ pack.label }}</option>{% endfor %}</select></label>
          {% elsif pantry_pack_value != blank %}<p class="pn-meta">The current pack filter is not among the supplied choices. Remove it to choose another pack.</p>{% endif %}
          {% if collection.food_filters.enabled %}<label>Minimum price<input name="min_price" type="number" min="0" step="0.01" value="{{ request.query.min_price }}"></label><label>Maximum price<input name="max_price" type="number" min="0" step="0.01" value="{{ request.query.max_price }}"></label>{% endif %}
          {% if pantry_sort_options.size > 0 %}<label>Sort<select name="sort">{% for option in pantry_sort_options %}<option value="{{ option.value }}"{% if option.selected or request.query.sort == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></label>{% endif %}
          <button class="pn-button" type="submit">Apply</button>
          {% for filter in collection.active_filters %}<a class="pn-link" href="{{ filter.clear_url }}" aria-label="Remove {{ filter.label }}">{% if filter.key == 'pack_size' %}Remove pack filter{% else %}Remove {{ filter.label }}{% endif %}</a>{% endfor %}
          <a class="pn-link" href="{{ collection.clear_filters_url | default: request.path }}">Clear all filters</a>
          </form></div></section>
          </div>
          {% schema %}
          {"name":"Pantry discovery","tag":"section","settings":[{"type":"text","label":"Fallback heading","default":"Everyday staples","id":"title"},{"type":"toggle","label":"Show search","default":true,"id":"showSearch"}],"blocks":[],"presets":[{"name":"Pantry discovery","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Pantry discovery'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Fallback heading'
              default: 'Everyday staples'
              id: 'title'
            1:
              type: 'toggle'
              label: 'Show search'
              default: true
              id: 'showSearch'
          blocks:
          presets:
            0:
              name: 'Pantry discovery'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      contact-form:
        path: 'sections/contact-form.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-contact-form" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            <p>{{ section.settings.subtitle }}</p>
            <form action="/contact" method="post"><input name="name" aria-label="Name"><input type="email" name="email" aria-label="Email">{% if section.settings.showPhone %}<input name="phone" aria-label="Phone">{% endif %}<button type="submit">Send</button></form>
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Contact Form","tag":"section","settings":[{"type":"text","label":"Title","default":"Contact us","id":"title"},{"type":"text","label":"Subtitle","id":"subtitle"},{"type":"toggle","label":"Show phone field","default":true,"id":"showPhone"}],"blocks":[],"presets":[{"name":"Contact Form","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Contact Form'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Contact us'
              id: 'title'
            1:
              type: 'text'
              label: 'Subtitle'
              id: 'subtitle'
            2:
              type: 'toggle'
              label: 'Show phone field'
              default: true
              id: 'showPhone'
          blocks:
          presets:
            0:
              name: 'Contact Form'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      cta-section:
        path: 'sections/cta-section.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-cta-section" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.heading }}</h2>
            <p>{{ section.settings.subheading }}</p>
            <a href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Call to Action","tag":"section","settings":[{"type":"text","label":"Heading","default":"Ready to get started?","id":"heading"},{"type":"text","label":"Subheading","id":"subheading"},{"type":"text","label":"Button text","default":"Shop now","id":"ctaText"},{"type":"url","label":"Button link","default":"/products","id":"ctaLink"}],"blocks":[],"presets":[{"name":"Call to Action","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Call to Action'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Ready to get started?'
              id: 'heading'
            1:
              type: 'text'
              label: 'Subheading'
              id: 'subheading'
            2:
              type: 'text'
              label: 'Button text'
              default: 'Shop now'
              id: 'ctaText'
            3:
              type: 'url'
              label: 'Button link'
              default: '/products'
              id: 'ctaLink'
          blocks:
          presets:
            0:
              name: 'Call to Action'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      featured-products:
        path: 'sections/featured-products.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<div class="pn-wrap pn-section"><div class="pn-heading"><div><h2>{{ section.settings.title }}</h2><p>{{ section.settings.subtitle }}</p></div></div><div class="pn-product-list">{% for item in section.products limit: section.settings.productLimit %}{% assign pantry_has_options = item.has_options %}{% if item.options.size > 0 %}{% assign pantry_has_options = true %}{% endif %}<article class="pn-card"><a class="pn-card-media" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<span class="pn-card-placeholder">Product image not supplied</span>{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.title }}</a></h3>{% if pantry_has_options %}<p class="pn-card-net">Choose a pack to check its net quantity</p>{% elsif item.food.netQuantityValue %}<p class="pn-card-net">{{ item.food.netQuantityValue }} {{ item.food.netQuantityUnit }} net per pack</p>{% else %}<p class="pn-card-net">Net quantity not supplied</p>{% endif %}<p class="pn-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if pantry_has_options != true and item.food.unitPriceMinor != nil %}<p class="pn-meta">{{ item.food.unitPriceMinor | money_with_currency: item.currency }} / {{ item.food.basisQuantity }} {{ item.food.netQuantityUnit }}</p>{% endif %}<a class="pn-link" href="{{ item.url }}">Choose pack</a>{% if item.available == false %}<p class="pn-meta">Unavailable</p>{% endif %}</div></article>{% endfor %}</div></div>{% endif %}</section>
          </div>
          {% schema %}
          {"name":"Independently sold pantry pairings","tag":"section","settings":[{"type":"text","label":"Heading","default":"Also on the shelf","id":"title"},{"type":"text","label":"Description","default":"Each product is priced and sold separately.","id":"subtitle"},{"type":"toggle","label":"Only show selected products","default":true,"id":"requireSelection"},{"type":"product","label":"Independent product 1","id":"product1"},{"type":"product","label":"Independent product 2","id":"product2"},{"type":"product","label":"Independent product 3","id":"product3"},{"type":"range","label":"Products to show","default":6,"min":1,"max":24,"step":1,"id":"productLimit"}],"blocks":[],"presets":[{"name":"Independently sold pantry pairings","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Independently sold pantry pairings'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Heading'
              default: 'Also on the shelf'
              id: 'title'
            1:
              type: 'text'
              label: 'Description'
              default: 'Each product is priced and sold separately.'
              id: 'subtitle'
            2:
              type: 'toggle'
              label: 'Only show selected products'
              default: true
              id: 'requireSelection'
            3:
              type: 'product'
              label: 'Independent product 1'
              id: 'product1'
            4:
              type: 'product'
              label: 'Independent product 2'
              id: 'product2'
            5:
              type: 'product'
              label: 'Independent product 3'
              id: 'product3'
            6:
              type: 'range'
              label: 'Products to show'
              default: 6
              min: 1
              max: 24
              step: 1
              id: 'productLimit'
          blocks:
          presets:
            0:
              name: 'Independently sold pantry pairings'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      experience-timeline:
        path: 'sections/experience-timeline.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-experience-timeline" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% for block in section.blocks %}<article><h3>{{ block.settings.title }}</h3><p>{{ block.settings.company }}</p><time>{{ block.settings.period }}</time></article>{% endfor %}
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Experience Timeline","tag":"section","settings":[{"type":"text","label":"Title","default":"Experience","id":"title"}],"blocks":[{"type":"experience","name":"Experience","settings":[{"type":"text","label":"Title","id":"title"},{"type":"text","label":"Company","id":"company"},{"type":"text","label":"Period","id":"period"}]}],"presets":[{"name":"Experience Timeline","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
