              0: '*'
          disabled_on:
            templates:
      footer:
        path: 'sections/footer.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><footer class="lb-footer" data-section-id="{{ section.id }}">
            <div class="lb-footer__grid">
              <div class="lb-footer__brand">
                <h3>{{ section.settings.storeName | default: shop.name }}</h3>
                {% if section.settings.tagline %}<p>{{ section.settings.tagline }}</p>{% endif %}
                {% if section.settings.instagramUrl != blank or section.settings.facebookUrl != blank or section.settings.twitterUrl != blank %}
                <div class="lb-footer__social">
                  {% if section.settings.instagramUrl != blank %}<a href="{{ section.settings.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a>{% endif %}
                  {% if section.settings.facebookUrl != blank %}<a href="{{ section.settings.facebookUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 4h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path></svg></a>{% endif %}
                  {% if section.settings.twitterUrl != blank %}<a href="{{ section.settings.twitterUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="4" x2="20" y2="20"></line><line x1="20" y1="4" x2="4" y2="20"></line></svg></a>{% endif %}
                </div>
                {% endif %}
              </div>
              {% if section.blocks.size > 0 %}
              <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}</nav></div>
              {% elsif linklists.footer_menu.links.size > 0 %}
              <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for link in linklists.footer_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}</nav></div>
              {% endif %}
              {% if shop.policies.size > 0 %}<div class="lb-footer__col">
                <h4>Policies</h4>
                <nav>
                  {% if shop.policies contains 'privacy' %}<a href="{{ routes.root_url }}/privacy">Privacy policy</a>{% endif %}
                  {% if shop.policies contains 'terms' %}<a href="{{ routes.root_url }}/terms">Terms of service</a>{% endif %}
                  {% if shop.policies contains 'shipping' %}<a href="{{ routes.root_url }}/shipping">Shipping policy</a>{% endif %}
                  {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}<a href="{{ routes.root_url }}/returns">Returns policy</a>{% endif %}
                </nav>
              </div>{% endif %}
              <div class="lb-footer__col">
                <h4>Contact</h4>
                {% if section.settings.contactEmail != blank %}<p><a href="mailto:{{ section.settings.contactEmail }}">{{ section.settings.contactEmail }}</a></p>{% endif %}
                {% if section.settings.contactPhone != blank %}<p><a href="tel:{{ section.settings.contactPhone }}">{{ section.settings.contactPhone }}</a></p>{% endif %}
                <a href="{{ routes.contact_url }}">Contact us</a>
              </div>
            </div>
            <div class="lb-footer__bottom">
              <p>&copy; {{ shop.name }}. All rights reserved.</p>
              <a class="lb-footer__watermark" href="https://letbuyy.com" target="_blank" rel="noopener noreferrer">Powered by LetBuyy</a>
            </div>
          </footer>
          </div>
          </div>
          {% schema %}
          {"name":"Footer","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"text","label":"Tagline","id":"tagline"},{"type":"text","label":"Contact email","id":"contactEmail"},{"type":"text","label":"Contact phone","id":"contactPhone"},{"type":"url","label":"Instagram URL","id":"instagramUrl"},{"type":"url","label":"Facebook URL","id":"facebookUrl"},{"type":"url","label":"Twitter/X URL","id":"twitterUrl"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Footer","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Footer'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Store name'
              id: 'storeName'
            1:
              type: 'text'
              label: 'Tagline'
              id: 'tagline'
            2:
              type: 'text'
              label: 'Contact email'
              id: 'contactEmail'
            3:
              type: 'text'
              label: 'Contact phone'
              id: 'contactPhone'
            4:
              type: 'url'
              label: 'Instagram URL'
              id: 'instagramUrl'
            5:
              type: 'url'
              label: 'Facebook URL'
              id: 'facebookUrl'
            6:
              type: 'url'
              label: 'Twitter/X URL'
              id: 'twitterUrl'
          blocks:
            0:
              type: 'link'
              name: 'Link'
              settings:
                0:
                  type: 'text'
                  label: 'Label'
                  id: 'label'
                1:
                  type: 'url'
                  label: 'URL'
                  id: 'href'
          presets:
            0:
              name: 'Footer'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      header:
        path: 'sections/header.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><header class="lb-header" data-section-id="{{ section.id }}" data-sticky="{% if section.settings.behavior == 'sticky' %}true{% else %}false{% endif %}" data-layout="{{ section.settings.layout | default: 'inline' }}">
            <div class="lb-header__inner">
              <lb-mobile-nav class="lb-mobile-nav" data-lb-island="mobile-nav">
                <button type="button" class="lb-header__toggle" data-lb-nav-toggle aria-expanded="false" aria-controls="lb-nav-panel-{{ section.id }}" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg><span class="lb-sr-only">Menu</span></button>
                <nav class="lb-header__nav" data-lb-nav-panel id="lb-nav-panel-{{ section.id }}" aria-label="Primary">
                  <div class="lb-header__nav-head"><span class="lb-header__nav-head-brand">{{ section.settings.storeName | default: shop.name }}</span><button type="button" class="lb-header__nav-close" data-lb-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close menu</span></button></div>
                  <div class="lb-header__nav-links">
                  {% if section.blocks.size > 0 %}
                    {% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}
                  {% else %}
                    {% assign lb_menu_handle = section.settings.menu | default: 'main_menu' %}
                    {% assign lb_nav_links = linklists[lb_menu_handle].links %}
                    {% for link in lb_nav_links %}
                      {% if link.links.size > 0 %}
                      <details class="lb-header__nav-item" data-lb-nav-dropdown><summary{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lb-icon-chevron"><path d="M6 9l6 6 6-6"></path></svg></summary>
                        <div class="lb-header__nav-submenu">{% for child in link.links %}<a href="{{ child.url | store_url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>
                      </details>
                      {% else %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}
                    {% endfor %}
                  {% endif %}
                  </div>
                  <div class="lb-header__nav-foot">
                    {% if customer %}<a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Account</span></a>{% else %}<a href="{{ routes.customer_login_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Log in</span></a>{% endif %}
                  </div>
                </nav>
                <div class="lb-header__scrim" data-lb-nav-scrim></div>
              </lb-mobile-nav>
              <a class="lb-header__brand" href="{{ routes.root_url }}">
                {% if shop.logo_url %}<img class="lb-header__logo" src="{{ shop.logo_url | image_url }}" alt="{{ section.settings.storeName | default: shop.name }}">{% else %}{{ section.settings.storeName | default: shop.name }}{% endif %}
              </a>
              <div class="lb-header__actions">
                {% if section.settings.showSearch %}<button type="button" class="lb-header__search-toggle" data-lb-search-toggle aria-expanded="false" aria-controls="lb-search-overlay-{{ section.id }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>{% endif %}
                <a class="lb-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.customer_login_url }}{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span class="lb-sr-only">{% if customer %}Account{% else %}Log in{% endif %}</span></a>
                {% if section.settings.showCart %}<a class="lb-header__cart" href="{{ routes.cart_url }}" data-lb-cart-trigger><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2l2 12h11l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="lb-sr-only">{{ "general.cart" | t }}</span> (<span data-lb-cart-count>{{ cart.item_count | default: 0 }}</span>)</a>{% endif %}
              </div>
            </div>
            {% if section.settings.showSearch %}
            <div class="lb-header__search-overlay" id="lb-search-overlay-{{ section.id }}" data-lb-search-overlay hidden>
              <lb-predictive-search class="lb-predictive-search" data-lb-island="predictive-search" data-search-url="{{ routes.search_url }}">
                <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                  <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                  <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="Search products" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lb-search-results-{{ section.id }}" aria-autocomplete="list">
                  <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                  <button type="button" data-lb-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close search</span></button>
                </form>
                <div id="lb-search-results-{{ section.id }}" class="lb-predictive-search__results" data-lb-search-results role="listbox" aria-live="polite"></div>
              </lb-predictive-search>
            </div>
            {% endif %}
          </header>
          </div>
          </div>
          {% schema %}
          {"name":"Header","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"toggle","label":"Show search","default":true,"id":"showSearch"},{"type":"toggle","label":"Show cart","default":true,"id":"showCart"},{"type":"select","label":"Header behavior","default":"sticky","options":["static","sticky"],"id":"behavior"},{"type":"select","label":"Menu","default":"main_menu","options":["main_menu","footer_menu","policy_menu"],"id":"menu"},{"type":"select","label":"Layout","default":"inline","options":["inline","centered"],"id":"layout"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Header","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Header'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Store name'
              id: 'storeName'
            1:
              type: 'toggle'
              label: 'Show search'
              default: true
              id: 'showSearch'
            2:
              type: 'toggle'
              label: 'Show cart'
              default: true
              id: 'showCart'
            3:
              type: 'select'
              label: 'Header behavior'
              default: 'sticky'
              options:
                0: 'static'
                1: 'sticky'
              id: 'behavior'
            4:
              type: 'select'
              label: 'Menu'
              default: 'main_menu'
              options:
                0: 'main_menu'
                1: 'footer_menu'
                2: 'policy_menu'
              id: 'menu'
            5:
              type: 'select'
              label: 'Layout'
              default: 'inline'
              options:
                0: 'inline'
                1: 'centered'
              id: 'layout'
          blocks:
            0:
              type: 'link'
              name: 'Link'
              settings:
                0:
                  type: 'text'
                  label: 'Label'
                  id: 'label'
                1:
                  type: 'url'
                  label: 'URL'
                  id: 'href'
          presets:
            0:
              name: 'Header'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      hero-banner:
        path: 'sections/hero-banner.liquid'
        source: |-
          <div class="pn-theme"><section data-section-id="{{ section.id }}"><div class="pn-wrap pn-section"><div class="pn-hero{% if section.settings.image == blank %} pn-hero--no-media{% endif %}"><div class="pn-hero-copy"><p class="pn-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="pn-button" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>{% endif %}{% for block in section.blocks %}{% if block.type == 'note' %}<p class="pn-meta" {{ block.editor_attributes | raw }}>{{ block.settings.text }}</p>{% endif %}{% endfor %}</div>{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" class="pn-focal-{{ section.settings.focalPoint }}" fetchpriority="high" decoding="async">{% endif %}</div></div></section>
          </div>
          {% schema %}
          {"name":"Compact pantry introduction","tag":"section","settings":[{"type":"text","label":"Eyebrow","default":"THE EVERYDAY PANTRY","id":"eyebrow"},{"type":"text","label":"Heading","default":"Good things start with staples.","id":"heading"},{"type":"text","label":"Description","default":"Find your shelf, read the details, choose your pack.","id":"subheading"},{"type":"text","label":"Action label","default":"Explore pantry shelves","id":"ctaText"},{"type":"url","label":"Action destination","default":"/products","id":"ctaLink"},{"type":"image","label":"Seasonal photograph","id":"image"},{"type":"text","label":"Image description","default":"","id":"imageAlt"},{"type":"select","label":"Image focal point","default":"center","options":["center","left","right"],"id":"focalPoint"}],"blocks":[{"type":"note","name":"Introductory note","settings":[{"type":"text","label":"Note text","default":"","id":"text"}]}],"presets":[{"name":"Compact pantry introduction","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Compact pantry introduction'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Eyebrow'
              default: 'THE EVERYDAY PANTRY'
              id: 'eyebrow'
            1:
              type: 'text'
              label: 'Heading'
              default: 'Good things start with staples.'
              id: 'heading'
            2:
              type: 'text'
              label: 'Description'
              default: 'Find your shelf, read the details, choose your pack.'
              id: 'subheading'
            3:
              type: 'text'
              label: 'Action label'
              default: 'Explore pantry shelves'
              id: 'ctaText'
            4:
              type: 'url'
              label: 'Action destination'
              default: '/products'
              id: 'ctaLink'
            5:
              type: 'image'
              label: 'Seasonal photograph'
              id: 'image'
            6:
              type: 'text'
              label: 'Image description'
              default: ''
              id: 'imageAlt'
            7:
              type: 'select'
              label: 'Image focal point'
              default: 'center'
              options:
                0: 'center'
                1: 'left'
                2: 'right'
              id: 'focalPoint'
          blocks:
            0:
              type: 'note'
              name: 'Introductory note'
              settings:
                0:
                  type: 'text'
                  label: 'Note text'
                  default: ''
                  id: 'text'
          presets:
            0:
              name: 'Compact pantry introduction'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      marquee:
        path: 'sections/marquee.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-marquee" data-section-id="{{ section.id }}">
            <p>{{ section.settings.text }}</p>
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Marquee","tag":"section","settings":[{"type":"text","label":"Text","default":"Featured announcement","id":"text"}],"blocks":[],"presets":[{"name":"Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Marquee'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Text'
              default: 'Featured announcement'
              id: 'text'
          blocks:
          presets:
            0:
              name: 'Marquee'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      portfolio-grid:
        path: 'sections/portfolio-grid.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-portfolio-grid" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% for block in section.blocks %}<article><h3>{{ block.settings.title }}</h3><p>{{ block.settings.summary }}</p><a href="{{ block.settings.link | store_url }}">View</a></article>{% endfor %}
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Portfolio Grid","tag":"section","settings":[{"type":"text","label":"Title","default":"Portfolio","id":"title"}],"blocks":[{"type":"project","name":"Project","settings":[{"type":"text","label":"Title","id":"title"},{"type":"textarea","label":"Summary","id":"summary"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Portfolio Grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Portfolio Grid'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Portfolio'
              id: 'title'
          blocks:
            0:
              type: 'project'
              name: 'Project'
              settings:
                0:
                  type: 'text'
                  label: 'Title'
                  id: 'title'
                1:
                  type: 'textarea'
                  label: 'Summary'
                  id: 'summary'
                2:
                  type: 'url'
                  label: 'Link'
                  id: 'link'
          presets:
            0:
              name: 'Portfolio Grid'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
      product-detail:
        path: 'sections/product-detail.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-product-detail" data-section-id="{{ section.id }}">
            <nav class="lb-product-detail__breadcrumb" aria-label="Breadcrumb">
              <a href="{{ routes.root_url }}">Home</a>
              <a href="{{ routes.all_products_collection_url }}">Shop</a>
              <span aria-current="page">{{ product.title }}</span>
            </nav>
            <div class="lb-product-detail__layout pn-product-layout">
            {% if section.settings.showGallery and product.images.size > 0 %}
            <lb-product-gallery class="lb-product-detail__gallery" data-lb-island="product-gallery">
              <div class="lb-product-detail__gallery-main">
                {% for image in product.images %}<img class="lb-product-detail__gallery-image" src="{{ image | image_url }}" alt="{{ product.title }}" data-lb-gallery-image data-index="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">{% endfor %}
              </div>
              {% if product.images.size > 1 %}
              <div class="lb-product-detail__gallery-thumbs" role="tablist" aria-label="Product images">
                {% for image in product.images %}<button type="button" class="lb-product-detail__gallery-thumb" data-lb-gallery-thumb data-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" aria-label="Image {{ forloop.index }} of {{ product.images.size }}"><img src="{{ image | image_url }}" alt="" aria-hidden="true" loading="lazy" decoding="async"></button>{% endfor %}
              </div>
              {% endif %}
            </lb-product-gallery>
            {% endif %}
          {% if section.settings.showGallery and product.images.size == 0 %}<div class="lb-product-detail__gallery pn-empty">Product image not supplied</div>{% endif %}<section class="pn-food-facts" id="food-facts" aria-label="Ingredients and allergen information"><p class="pn-eyebrow">Read before choosing</p><h2>Inside the pack</h2><div class="pn-food-fact"><strong>Ingredients</strong><p>{% if product.food.ingredients != blank %}{{ product.food.ingredients }}{% else %}Not supplied by the merchant.{% endif %}</p></div><div class="pn-food-fact"><strong>Allergen information</strong>{% if product.food.allergens.status == 'supplied' %}<p>{{ product.food.allergens.statement }}</p><p class="pn-meta">Source: {{ product.food.allergens.source }}</p>{% else %}<p>Not supplied by the merchant.</p><div class="pn-food-unknown"><strong>Unknown is not allergen-free</strong><p>Ask the merchant before buying if this information matters for your diet.</p></div>{% endif %}</div>{% if product.food.storage != blank %}<div class="pn-food-fact"><strong>Storage</strong><p>{{ product.food.storage }}</p></div>{% endif %}{% if product.food.preparation != blank %}<div class="pn-food-fact"><strong>Preparation</strong><p>{{ product.food.preparation }}</p></div>{% endif %}{% if section.settings.showNutrition and product.food.nutritionText != blank %}<div class="pn-food-fact"><strong>Supplied nutrition information</strong><p>{{ product.food.nutritionText }}</p></div>{% endif %}</section>
          {% if section.settings.showGallery and product.images.size == 0 %}<div class="lb-product-detail__gallery pn-empty">Product image not supplied</div>{% endif %}<section class="pn-food-facts" id="food-facts" aria-label="Ingredients and allergen information"><p class="pn-eyebrow">Read before choosing</p><h2>Inside the pack</h2><div class="pn-food-fact"><strong>Ingredients</strong><p>{% if product.food.ingredients != blank %}{{ product.food.ingredients }}{% else %}Not supplied by the merchant.{% endif %}</p></div><div class="pn-food-fact"><strong>Allergen information</strong>{% if product.food.allergens.status == 'supplied' %}<p>{{ product.food.allergens.statement }}</p><p class="pn-meta">Source: {{ product.food.allergens.source }}</p>{% else %}<p>Not supplied by the merchant.</p><div class="pn-food-unknown"><strong>Unknown is not allergen-free</strong><p>Ask the merchant before buying if this information matters for your diet.</p></div>{% endif %}</div>{% if product.food.storage != blank %}<div class="pn-food-fact"><strong>Storage</strong><p>{{ product.food.storage }}</p></div>{% endif %}{% if product.food.preparation != blank %}<div class="pn-food-fact"><strong>Preparation</strong><p>{{ product.food.preparation }}</p></div>{% endif %}{% if section.settings.showNutrition and product.food.nutritionText != blank %}<div class="pn-food-fact"><strong>Supplied nutrition information</strong><p>{{ product.food.nutritionText }}</p></div>{% endif %}</section>
            <div class="lb-product-detail__info">
            <h1>{{ product.title }}</h1>
            {% if product.review_count > 0 %}<p class="lb-product-detail__rating" aria-label="Rated {{ product.rating }} out of 5">★ {{ product.rating }} <span class="lb-product-detail__rating-count">({{ product.review_count }})</span></p>{% endif %}
            <div class="lb-product-detail__price">
              <span class="lb-product-detail__price-current">{{ product.price | times: 100 | money_with_currency: product.currency }}</span>
              {% if product.compare_at_price and product.compare_at_price > product.price %}
              <s class="lb-product-detail__price-compare">{{ product.compare_at_price | times: 100 | money_with_currency: product.currency }}</s>
              <span class="lb-product-detail__price-save">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
              {% endif %}
            </div>
          <div class="pn-net-info" data-lb-food-presentation data-product-id="{{ product.id }}" data-facts="{{ product.facts_json }}">{% if product.options.size == 0 and product.food.netQuantityValue %}<p data-lb-food-net-quantity>{{ product.food.netQuantityValue }} {{ product.food.netQuantityUnit }} net per pack</p>{% if product.food.unitPriceMinor != nil %}<p data-lb-food-unit-price>{{ product.food.unitPriceMinor | money_with_currency: product.currency }} / {{ product.food.basisQuantity }} {{ product.food.netQuantityUnit }}</p>{% endif %}{% elsif product.options.size > 0 %}<p>Choose a pack. Net contents belong to the selected variant.</p>{% else %}<p>Net quantity not supplied.</p>{% endif %}<p>Quantity counts sellable packs. Shipping is calculated at checkout.</p></div>{% if product.options.size > 0 %}<details class="pn-pack-options"><summary>Pack facts by option</summary><ul>{% for variant in product.variants %}<li><strong>{{ variant.name | default: variant.title }}</strong>{% if variant.food.netQuantityValue %}: {{ variant.food.netQuantityValue }} {{ variant.food.netQuantityUnit }} net per pack{% else %}: net quantity not supplied{% endif %}{% if variant.food.unitPriceMinor != nil %} · {{ variant.food.unitPriceMinor | money_with_currency: product.currency }} / {{ variant.food.basisQuantity }} {{ variant.food.netQuantityUnit }}{% endif %}{% if variant.stock == 0 %} · unavailable{% endif %}</li>{% endfor %}</ul></details>{% endif %}
          <div class="pn-net-info" data-lb-food-presentation data-product-id="{{ product.id }}" data-facts="{{ product.facts_json }}">{% if product.options.size == 0 and product.food.netQuantityValue %}<p data-lb-food-net-quantity>{{ product.food.netQuantityValue }} {{ product.food.netQuantityUnit }} net per pack</p>{% if product.food.unitPriceMinor != nil %}<p data-lb-food-unit-price>{{ product.food.unitPriceMinor | money_with_currency: product.currency }} / {{ product.food.basisQuantity }} {{ product.food.netQuantityUnit }}</p>{% endif %}{% elsif product.options.size > 0 %}<p>Choose a pack. Net contents belong to the selected variant.</p>{% else %}<p>Net quantity not supplied.</p>{% endif %}<p>Quantity counts sellable packs. Shipping is calculated at checkout.</p></div>{% if product.options.size > 0 %}<details class="pn-pack-options"><summary>Pack facts by option</summary><ul>{% for variant in product.variants %}<li><strong>{{ variant.name | default: variant.title }}</strong>{% if variant.food.netQuantityValue %}: {{ variant.food.netQuantityValue }} {{ variant.food.netQuantityUnit }} net per pack{% else %}: net quantity not supplied{% endif %}{% if variant.food.unitPriceMinor != nil %} · {{ variant.food.unitPriceMinor | money_with_currency: product.currency }} / {{ variant.food.basisQuantity }} {{ variant.food.netQuantityUnit }}{% endif %}{% if variant.stock == 0 %} · unavailable{% endif %}</li>{% endfor %}</ul></details>{% endif %}
            {% if product.options.size > 0 %}<lb-variant-picker data-lb-island="variant-picker" data-product-id="{{ product.id }}" data-variants="{{ product.variants | json }}" class="lb-product-detail__variants">{% for option in product.options %}<div class="lb-product-detail__variant-group"><span class="lb-variant-option__name">{{ option.name }}</span><div class="lb-product-detail__variant-values">{% for value in option.values %}<button type="button" data-lb-variant-option data-variant-name="{{ option.name }}" data-variant-value="{{ value }}" aria-pressed="false">{{ value }}</button>{% endfor %}</div></div>{% endfor %}<p class="lb-product-detail__variant-status" data-lb-variant-status role="status"></p></lb-variant-picker>{% endif %}
            <div class="lb-product-detail__purchase">
              <lb-add-to-cart data-lb-island="add-to-cart" data-product-id="{{ product.id }}" data-product-name="{{ product.title }}" data-product-price="{{ product.price }}" data-product-currency="{{ product.currency }}" data-product-url="{{ product.url }}">
                <label class="pn-quantity-label" for="lb-quantity-{{ section.id }}">Number of packs</label>
                <input type="number" name="quantity" id="lb-quantity-{{ section.id }}" class="lb-product-detail__quantity" value="1" min="1" inputmode="numeric">
                <button type="button" class="lb-product-detail__cta lb-product-detail__cta--primary" data-lb-add-to-cart{% if product.available == false %} disabled{% endif %}>{% if product.available == false %}Sold out{% else %}Add to cart{% endif %}</button>
                <span data-lb-add-to-cart-status aria-live="polite"></span>
              </lb-add-to-cart>
              <lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="{% if product.in_wishlist %}true{% endif %}"{% if buyer_wishlist.authenticated %} data-authenticated="true" data-account-type="buyer" data-buyer-id="{{ buyer_wishlist.buyerId }}" data-buyer-linked="{% if buyer_wishlist.linked %}true{% endif %}" data-buyer-unavailable="{% if buyer_wishlist.unavailable or buyer_wishlist.storeAccountUnavailable %}true{% endif %}"{% elsif customer %} data-authenticated="true" data-account-type="store_customer"{% endif %} data-base-path="/store/{{ shop.subdomain }}" aria-label="Add {{ product.title }} to wishlist"></lb-wishlist-toggle>
            </div>
            {% if section.settings.showDescription and product.description %}
            <details class="lb-product-detail__accordion"><summary>Description</summary><div class="lb-product-detail__accordion-body">{{ product.description }}</div></details>
            {% endif %}
            {% if shop.policies contains 'shipping' %}
            <details class="lb-product-detail__accordion"><summary>Shipping</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/shipping">Read our shipping policy</a></div></details>
            {% endif %}
            {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}
            <details class="lb-product-detail__accordion"><summary>Returns</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/returns">Read our returns policy</a></div></details>
            {% endif %}
            </div>
            </div>
            {% if section.settings.showReviews and product.reviews.size > 0 %}<div class="lb-product-reviews" data-section-id="{{ section.id }}-reviews">
              <h2 class="lb-product-reviews__title">Customer reviews ({{ product.review_count }})</h2>
              {% for review in product.reviews %}<article class="lb-product-review">
                <header class="lb-product-review__head"><strong class="lb-product-review__author">{{ review.author }}</strong><span class="lb-product-review__stars" aria-label="Rated {{ review.rating }} out of 5">★ {{ review.rating }}</span>{% if review.is_verified %}<span class="lb-product-review__verified">Verified purchase</span>{% endif %}</header>
                {% if review.title %}<h3 class="lb-product-review__heading">{{ review.title }}</h3>{% endif %}
                {% if review.body %}<p class="lb-product-review__body">{{ review.body }}</p>{% endif %}
                {% if review.helpful_count > 0 %}<footer class="lb-product-review__helpful">{{ review.helpful_count }} found this helpful</footer>{% endif %}
              </article>{% endfor %}
            </div>{% endif %}
            {% if section.settings.showReviews %}<lb-review-form data-lb-island="review-form" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}"></lb-review-form>{% endif %}
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Product Detail","tag":"section","settings":[{"type":"toggle","label":"Show gallery","default":true,"id":"showGallery"},{"type":"toggle","label":"Show description","default":true,"id":"showDescription"},{"type":"toggle","label":"Show reviews","default":true,"id":"showReviews"},{"type":"toggle","label":"Show supplied nutrition text","default":true,"id":"showNutrition"},{"id":"showNutrition","type":"toggle","label":"Show supplied nutrition text","default":true}],"blocks":[],"presets":[{"name":"Product Detail","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'Product Detail'
          tag: 'section'
          settings:
            0:
              type: 'toggle'
              label: 'Show gallery'
              default: true
