              max: 24
              step: 1
              id: 'productLimit'
            3:
              type: 'collection'
              label: 'Collection'
              id: 'collectionId'
          blocks:
          presets:
            0:
              name: 'Pantry shelf list'
              settings:
              blocks:
          enabled_on:
            templates:
              0: '*'
          disabled_on:
            templates:
