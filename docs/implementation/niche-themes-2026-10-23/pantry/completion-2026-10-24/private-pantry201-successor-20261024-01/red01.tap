        0: 'store'
      status: 'active'
      pricing_type: 'free'
      price: 0
      currency: 'INR'
      version: '2.0.0'
      version_number: 2
      release_status: 'published'
      compatibility_range: '>=2026-06-liquid-sections'
    layout:
      theme:
        path: 'layout/theme.liquid'
        source: |-
          <!doctype html>
          <html lang="{{ request.locale | default: "en" }}">
          <head>
            <meta charset="utf-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            {% assign lb_page_title = shop.name %}
            {% assign lb_meta_description = settings.metaDescription | default: shop.description | strip_html | truncate: 160 %}
            <title>{{ lb_page_title }}</title>
            {% if lb_meta_description != blank %}<meta name="description" content="{{ lb_meta_description }}">{% endif %}
            <meta name="twitter:card" content="{% if settings.socialImageUrl != blank %}summary_large_image{% else %}summary{% endif %}">
            <meta name="twitter:title" content="{{ lb_page_title }}">
            {% if lb_meta_description != blank %}<meta name="twitter:description" content="{{ lb_meta_description }}">{% endif %}
            {% if settings.socialImageUrl != blank %}<meta name="twitter:image" content="{{ settings.socialImageUrl | image_url }}">{% endif %}
            <style data-lb-layout="1">
              :root{--lb-focus-ring-width:2px;--lb-focus-ring-color:var(--accent,#2563eb);--lb-focus-offset:2px;--lb-space-sm:0.5rem;--lb-space-md:0.75rem;--lb-space-lg:1rem;--lb-radius-sm:0.375rem;--lb-layout-max:72rem;--lb-layout-gutter:1rem;--lb-layout-breakpoint:48em;}
              .lb-theme :where(a,button,input,select,textarea,summary,details,[tabindex]):focus-visible{outline:var(--lb-focus-ring-width) solid var(--lb-focus-ring-color);outline-offset:var(--lb-focus-offset);}
              .lb-skip-link{position:absolute;left:-9999px;top:0;z-index:100;padding:var(--lb-space-md) var(--lb-space-lg);border-radius:var(--lb-radius-sm);background:var(--surface,#f8fafc);color:var(--foreground,#1a1a2e);font-weight:600;}
              .lb-skip-link:focus,.lb-skip-link:focus-visible{left:var(--lb-space-lg);top:var(--lb-space-lg);}
              .lb-layout__header,.lb-layout__footer{display:flex;flex-direction:column;align-items:flex-start;gap:var(--lb-space-md);margin-inline:auto;max-width:min(var(--lb-layout-max),calc(100vw - var(--lb-layout-gutter) * 2));padding-block:var(--lb-space-lg);padding-inline:var(--lb-layout-gutter);}
              .lb-layout__brand{font-family:var(--font-display,inherit);font-weight:700;}
              .lb-layout__nav{display:flex;flex-wrap:wrap;gap:var(--lb-space-md);}
              .lb-layout__legal{margin:0;font-size:0.875rem;}
              @media (min-width:48em){.lb-layout__header,.lb-layout__footer{flex-direction:row;align-items:center;justify-content:space-between;}}
            </style>
            {{ content_for_header | raw }}
          <style data-niche-order-presentation="1">.lb-order-facts{min-width:0;max-width:100%;margin-block:.75rem}.lb-order-facts>summary{min-height:44px;cursor:pointer;padding-block:.5rem}.lb-order-facts__text{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit}.lb-order-facts__missing{font-size:.875em;overflow-wrap:anywhere}</style>
          <style data-pantry="2">
          .pn-theme{--pn-muted:var(--pn-supporting-color,#5a624a);--pn-line:var(--pn-line-color,#d5d6c7);--pn-boundary:var(--pn-boundary-color,#707858);--pn-focus:var(--pn-focus-color,#005fcc);--pn-warning:#7a3e00;--pn-warning-surface:#fff4ce;--font-body:var(--font-main,Inter,Arial,sans-serif);--font-display:var(--font-heading,Inter,Arial,sans-serif);--footer-bg:var(--surface,#eee8d8);--footer-text:var(--foreground,#262a1d);--footer-text-muted:var(--pn-muted);background:var(--background,#fcf8ef);color:var(--foreground,#262a1d);font:16px/1.55 var(--font-body)}
          .pn-theme *{box-sizing:border-box;min-width:0}.pn-theme :where(img){max-width:100%}.pn-theme :where(a){color:inherit}.pn-theme :where(button,input,select,textarea){font:inherit;max-width:100%}.pn-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--pn-focus);outline-offset:4px}.pn-theme :where(h1,h2,h3){font-family:var(--font-display);font-weight:600;line-height:1.15;letter-spacing:-.035em;overflow-wrap:anywhere}.pn-theme h1{font-size:clamp(2rem,4vw,3rem)}.pn-theme h2{font-size:clamp(1.65rem,3vw,2rem)}.pn-theme h3{font-size:1.25rem}.pn-theme p{color:var(--pn-muted);overflow-wrap:anywhere}.pn-theme [hidden]{display:none!important}.pn-wrap{width:min(1240px,calc(100% - 96px));margin-inline:auto}.pn-section{padding-block:48px}.pn-eyebrow{text-transform:uppercase;font-size:.75rem;font-weight:600;letter-spacing:.14em}.pn-meta{font-size:.875rem}.pn-button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;padding:12px 22px;border:1px solid var(--primary,#36533d);background:var(--primary,#36533d);color:var(--pn-action-label,#fff)!important;border-radius:var(--radius,6px);font-weight:600;text-decoration:none;overflow-wrap:anywhere;max-width:100%}.pn-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:5px}.pn-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:24px}.pn-heading h2{margin:0}.pn-empty{padding:26px;border:1px solid var(--pn-boundary);border-radius:6px}.pn-hero{display:grid;grid-template-columns:.9fr 1.1fr;background:var(--surface,#eee8d8);border-radius:8px;overflow:hidden}.pn-hero-copy{padding:44px}.pn-hero-copy h1{margin:14px 0 20px}.pn-hero-copy p{margin:0 0 24px}.pn-hero img{height:100%;width:100%;min-height:340px;object-fit:cover;object-position:var(--pn-hero-position,center)}.pn-hero img.pn-focal-left{object-position:left}.pn-hero img.pn-focal-center{object-position:center}.pn-hero img.pn-focal-right{object-position:right}.pn-hero--no-media{grid-template-columns:1fr}.pn-hero--no-media .pn-hero-copy{max-width:780px}.pn-shelves{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.pn-shelf{display:flex;justify-content:space-between;gap:15px;padding:20px;border:1px solid var(--pn-boundary);border-radius:6px;min-height:72px;text-decoration:none}.pn-shelf span{overflow-wrap:anywhere}.pn-product-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.pn-card{display:grid;grid-template-columns:130px minmax(0,1fr);gap:20px;padding:18px;border:1px solid var(--pn-line);border-radius:6px;background:var(--pn-card-surface,#fff)}.pn-card-media{display:grid;place-items:center;background:var(--surface);min-height:150px;border-radius:4px;overflow:hidden}.pn-card-media img{width:130px;height:150px;object-fit:contain}.pn-card h3{margin:0 0 8px}.pn-card h3 a{text-decoration:none}.pn-card p{margin:5px 0}.pn-card-price{font-size:1.2rem;font-weight:600;font-variant-numeric:tabular-nums}.pn-card .pn-link{font-size:.875rem}.pn-card-placeholder{font-size:.8rem;padding:14px;text-align:center}.pn-card-net{font-size:.875rem}.pn-pairing{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}.pn-pairing .pn-product-list{grid-template-columns:1fr}.pn-feature{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.pn-feature img{width:100%;height:360px;object-fit:contain;background:var(--surface)}.pn-feature--no-media{grid-template-columns:1fr}.pn-feature p{margin:16px 0}.pn-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;border-top:1px solid var(--pn-line)}.pn-services>div{padding-block:24px}.pn-services h3{margin:0 0 10px}.pn-filters{display:flex;flex-wrap:wrap;gap:14px;align-items:end;margin-top:22px}.pn-filters label{display:grid;gap:6px;font-size:.875rem}.pn-filters input,.pn-filters select{min-height:46px;border:1px solid var(--pn-boundary);border-radius:6px;background:var(--pn-card-surface,#fff);color:inherit;padding:10px 12px}.pn-pagination{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:28px}.pn-theme .pn-product-layout{display:grid;grid-template-columns:.95fr .9fr 1fr;gap:32px;align-items:start}.pn-theme .lb-product-detail{padding:24px 0 48px;width:min(1240px,calc(100% - 96px));margin-inline:auto}.pn-theme .lb-product-detail__breadcrumb{display:flex;gap:16px;flex-wrap:wrap;padding:0 0 26px;font-size:.875rem}.pn-theme .lb-product-detail__gallery{background:var(--surface);border-radius:6px;overflow:hidden}.pn-theme .lb-product-detail__gallery-main img{width:100%;aspect-ratio:1;object-fit:contain}.pn-theme .lb-product-detail__gallery-thumbs{display:flex;gap:8px;padding:10px;flex-wrap:wrap}.pn-theme .lb-product-detail__gallery-thumb{max-width:60px;min-height:44px}.pn-theme .lb-product-detail__gallery-thumb img{width:50px;height:55px;object-fit:contain}.pn-theme .lb-product-detail__info h1{font-size:2rem;margin:0 0 18px}.pn-theme .lb-product-detail__price-current{font-size:1.6rem;font-weight:600}.pn-theme .lb-product-detail__variant-group{margin:20px 0}.pn-theme .lb-product-detail__variant-values{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}.pn-theme .lb-product-detail__variant-values button{min-height:48px;min-width:44px;padding:10px 15px;border:1px solid var(--pn-boundary);background:transparent;border-radius:6px;color:inherit}.pn-theme .lb-product-detail__variant-values [aria-pressed=true]{background:var(--primary);color:var(--pn-action-label,#fff)}.pn-theme .lb-product-detail__quantity{min-height:48px;width:90px;padding:10px;border:1px solid var(--pn-boundary);border-radius:5px;background:var(--pn-card-surface,#fff);color:inherit}.pn-theme .lb-product-detail__purchase lb-add-to-cart{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.pn-theme .lb-product-detail__cta{min-height:48px;padding:12px 20px;border:1px solid var(--primary);border-radius:6px;background:var(--primary);color:var(--pn-action-label,#fff);font-weight:600}.pn-theme .lb-product-detail__accordion{border-bottom:1px solid var(--pn-line);padding-block:14px}.pn-theme .lb-product-detail__accordion summary{cursor:pointer;min-height:44px}.pn-food-facts h2{font-size:1.5rem;margin:0 0 22px}.pn-food-fact{padding-block:14px;border-bottom:1px solid var(--pn-line)}.pn-food-fact p{margin:7px 0;font-size:.875rem}.pn-food-unknown{padding:18px;background:var(--pn-warning-surface);color:var(--pn-warning);border-radius:6px;margin-block:16px}.pn-food-unknown p{color:var(--pn-warning);font-size:.875rem;margin:8px 0 0}.pn-net-info{margin-block:16px;padding:14px;background:var(--surface);border-radius:6px;font-size:.875rem}.pn-net-info p{margin:5px 0}.pn-pack-options{margin-block:16px;font-size:.875rem}.pn-pack-options summary{min-height:44px;cursor:pointer}.pn-pack-options ul{padding-left:20px}.pn-pack-options li{margin-block:12px}.pn-quantity-label{font-size:.875rem}.pn-theme :where(button:disabled){opacity:.65;cursor:not-allowed}.pn-theme :where(.lb-header,.lb-footer){font-family:var(--font-body)}.pn-theme .lb-header{background:var(--background);color:var(--foreground);border-bottom:1px solid var(--pn-line)}.pn-theme .lb-footer{background:var(--surface);color:var(--foreground)}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses,.lb-content-page){color:var(--foreground);background:var(--background);font-family:var(--font-body)}.pn-theme :where(.lb-cart__checkout,.lb-settings button,.lb-addresses button){border-radius:6px}.pn-theme :where(.lb-cart,.lb-account,.lb-orders,.lb-order,.lb-settings,.lb-addresses) :where(input,select){min-height:44px;border-color:var(--pn-boundary)}
          .pn-theme .lb-header__brand,.pn-theme .lb-header__nav-links>a{min-height:44px;display:inline-flex;align-items:center}.pn-theme :is(.lb-header__search-toggle,.lb-header__account,.lb-header__toggle,.lb-header__nav-close){min-width:44px;min-height:44px;flex-shrink:0}.pn-theme .pn-card h3 a{display:inline-flex;align-items:center;min-height:44px;min-width:44px;max-width:100%}.pn-theme .lb-footer__col h4,.pn-theme .lb-footer__col a,.pn-theme .lb-footer__bottom{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb{opacity:1;color:var(--pn-muted)}.pn-theme .lb-product-detail__breadcrumb a{color:var(--pn-muted);min-width:44px}.pn-theme .lb-product-detail__breadcrumb span[aria-current]{overflow:visible;text-overflow:clip;white-space:normal;max-width:100%;overflow-wrap:anywhere}
          @media(max-width:767px){.pn-theme .lb-mobile-nav:not([data-open="true"]) [data-lb-nav-panel]{display:none}.pn-theme .lb-mobile-nav[data-open="true"] [data-lb-nav-panel]{display:flex}}
          @media(max-width:600px){.pn-theme .lb-header__inner{flex-wrap:wrap;gap:8px 12px}.pn-theme .lb-header__brand{order:0;flex:1 1 calc(100% - 56px);max-width:calc(100% - 56px);overflow-wrap:anywhere}.pn-theme .lb-header__toggle{order:1;flex:0 0 44px}.pn-theme .lb-header__actions{order:2;flex:0 0 100%;justify-content:flex-end}}
          @media(max-width:1100px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 64px)}.pn-theme .pn-product-layout{grid-template-columns:1fr 1fr}.pn-theme .lb-product-detail__gallery{grid-column:1;grid-row:1}.pn-food-facts{grid-column:1;grid-row:2}.pn-theme .lb-product-detail__info{grid-column:2;grid-row:1/3}.pn-card{grid-template-columns:100px minmax(0,1fr);gap:14px}.pn-card-media img{width:100px}.pn-hero-copy{padding:32px}}
          @media(max-width:900px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 48px)}.pn-shelves{grid-template-columns:repeat(2,minmax(0,1fr))}.pn-product-list{grid-template-columns:1fr}.pn-services{gap:20px}.pn-card{grid-template-columns:120px minmax(0,1fr)}.pn-card-media img{width:120px}}
          @media(max-width:600px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 40px)}.pn-section{padding-block:30px}.pn-hero,.pn-feature,.pn-pairing{grid-template-columns:1fr}.pn-hero-copy{padding:26px}.pn-hero img{min-height:0;height:220px}.pn-heading{display:block}.pn-shelf{padding:14px;min-height:72px}.pn-card{grid-template-columns:85px minmax(0,1fr);gap:13px;padding:12px}.pn-card-media img{width:85px;height:126px}.pn-card-media{min-height:126px}.pn-card h3{font-size:1.05rem}.pn-card-price{font-size:1.15rem}.pn-theme .pn-product-layout{display:flex;flex-direction:column;gap:24px}.pn-theme .pn-product-layout>*{width:100%}.pn-theme .lb-product-detail__gallery-main img{max-height:320px;aspect-ratio:1.15}.pn-theme .lb-product-detail__info h1{font-size:1.9rem}.pn-theme .lb-product-detail__cta{flex:1}.pn-services{grid-template-columns:1fr;gap:0}.pn-feature img{height:260px}.pn-filters label{width:100%}.pn-filters input,.pn-filters select{width:100%}}
          @media(max-width:350px){.pn-wrap,.pn-theme .lb-product-detail{width:calc(100% - 32px)}.pn-card{grid-template-columns:65px minmax(0,1fr)}.pn-card-media img{width:65px}.pn-shelves{gap:8px}.pn-shelf{padding:10px}}
          @media(prefers-reduced-motion:reduce){.pn-theme *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
          </style>
          </head>
          <body class="lb-theme lb-theme--letbuyy-core">
            <a class="lb-skip-link" href="#MainContent">Skip to content</a>
            <header class="lb-layout__header">
              <a class="lb-layout__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
              <nav class="lb-layout__nav" aria-label="Primary">
                {% if linklists.main_menu.links.size > 0 %}{% for link in linklists.main_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
                {% else %}<a href="{{ routes.all_products_collection_url }}">Products</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a><a href="{{ routes.account_url }}">Account</a>{% endif %}
              </nav>
            </header>
            <main id="MainContent">
              {{ content_for_layout | raw }}
            </main>
            <footer class="lb-layout__footer">
              {% if linklists.footer.links.size > 0 %}<nav class="lb-layout__nav" aria-label="Footer">{% for link in linklists.footer.links %}<a href="{{ link.url | store_url }}">{{ link.title }}</a>{% endfor %}</nav>{% endif %}
              <p class="lb-layout__legal">&copy; {{ shop.name }}</p>
            </footer>
            {{ content_for_footer | raw }}
          </body>
          </html>
    config:
      settings_schema:
        schema_version: '2026-05-json-contract'
        settings:
          colors:
            label: 'Colors'
            description: 'LetBuyy Core storefront color tokens.'
            fields:
              primaryColor:
                type: 'color'
                label: 'Primary color'
                default: '#8B5CF6'
              secondaryColor:
                type: 'color'
                label: 'Secondary color'
                default: '#3B82F6'
              accentColor:
                type: 'color'
                label: 'Accent color'
                default: '#F59E0B'
              backgroundColor:
                type: 'color'
                label: 'Background color'
                default: '#FFFFFF'
              textColor:
                type: 'color'
                label: 'Text color'
                default: '#1F2937'
              surfaceColor:
                type: 'color'
                label: 'Surface color'
                default: '#F8FAFC'
          typography:
            label: 'Typography'
            description: 'First-party type settings mirrored from the JSON-contract LetBuyy Core theme.'
            fields:
              headingFontFamily:
                type: 'text'
                label: 'Heading font'
                default: 'Inter'
              bodyFontFamily:
                type: 'text'
                label: 'Body font'
                default: 'Inter'
          appearance:
            label: 'Appearance'
            description: 'Layout tokens shared by every section.'
            fields:
              borderRadius:
                type: 'number'
                label: 'Corner radius'
                default: 12
          seo:
            label: 'SEO and social'
            description: 'Metadata rendered into <head> by the theme layout.'
            fields:
              metaDescription:
                type: 'textarea'
                label: 'Meta description'
                default: ''
                info: 'Falls back to the shop description. Truncated to 160 characters on output.'
                maxLength: 160
              socialImageUrl:
                type: 'url'
                label: 'Social share image URL'
                default: ''
                info: 'Used for og:image and twitter:image. Left empty until the merchant uploads one.'
              faviconUrl:
                type: 'url'
                label: 'Favicon URL'
                default: ''
                info: 'Rendered as <link rel="icon">. Left empty until the merchant uploads one.'
      settings_data:
        current:
          primaryColor: '#36533D'
          secondaryColor: '#36533D'
          accentColor: '#707858'
          backgroundColor: '#FCF8EF'
          textColor: '#262A1D'
          surfaceColor: '#EEE8D8'
          headingFontFamily: 'Inter'
          bodyFontFamily: 'Inter'
          borderRadius: 6
          metaDescription: ''
          socialImageUrl: ''
          faviconUrl: ''
        presets:
          Forge:
            primaryColor: '#1E3A5F'
            secondaryColor: '#1E40AF'
            accentColor: '#00B4D8'
            backgroundColor: '#FFFFFF'
            textColor: '#1A202C'
            surfaceColor: '#F0F4F8'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 8
          Threadline:
            primaryColor: '#713F35'
            secondaryColor: '#65574C'
            accentColor: '#005FCC'
            backgroundColor: '#FAF7F2'
            textColor: '#241E1A'
            surfaceColor: '#EFE7DC'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Playfair Display'
            borderRadius: 4
          Aura:
            primaryColor: '#C2798B'
            secondaryColor: '#9E5A6F'
            accentColor: '#D4AF7A'
            backgroundColor: '#FFFFFF'
            textColor: '#2D1B22'
            surfaceColor: '#FFF8F9'
            bodyFontFamily: 'Lato'
            headingFontFamily: 'Cormorant Garamond'
            borderRadius: 16
          Craft:
            primaryColor: '#3E2723'
            secondaryColor: '#5D3B2E'
            accentColor: '#8D6E63'
            backgroundColor: '#FFFFFF'
            textColor: '#2C1B12'
            surfaceColor: '#FFF8F0'
            bodyFontFamily: 'Source Sans Pro'
            headingFontFamily: 'Libre Baskerville'
            borderRadius: 6
          Refresh:
            primaryColor: '#2D6A4F'
            secondaryColor: '#1B4332'
            accentColor: '#F4A261'
            backgroundColor: '#FFFFFF'
            textColor: '#1B2521'
            surfaceColor: '#F8FFF4'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 10
          Ride:
            primaryColor: '#FF4D00'
            secondaryColor: '#1C1C1C'
            accentColor: '#FFD100'
            backgroundColor: '#FFFFFF'
            textColor: '#111111'
            surfaceColor: '#F5F5F5'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 6
          Dawn:
            primaryColor: '#3B4F6B'
            secondaryColor: '#2C3E50'
            accentColor: '#C0832B'
            backgroundColor: '#FFFFFF'
            textColor: '#2C2C2C'
            surfaceColor: '#FDF6EC'
            bodyFontFamily: 'Source Sans Pro'
            headingFontFamily: 'Libre Baskerville'
            borderRadius: 4
          Bloom:
            primaryColor: '#E07B39'
            secondaryColor: '#B55E24'
            accentColor: '#4CAF73'
            backgroundColor: '#FFFFFF'
            textColor: '#2C1A0A'
            surfaceColor: '#FFF9F0'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 14
          Nova:
            primaryColor: '#8B5CF6'
            secondaryColor: '#6D28D9'
            accentColor: '#F59E0B'
            backgroundColor: '#FFFFFF'
            textColor: '#1A1A2E'
            surfaceColor: '#F8FAFC'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 10
          Summit:
            primaryColor: '#00B3B3'
            secondaryColor: '#008080'
            accentColor: '#A4E500'
            backgroundColor: '#FFFFFF'
            textColor: '#1A1A2E'
            surfaceColor: '#F9FAFB'
            bodyFontFamily: 'Inter'
            headingFontFamily: 'Inter'
            borderRadius: 12
    templates:
      header:
        name: 'LetBuyy Core header'
        layout: 'theme'
        sections:
          announcement-default:
            type: 'announcement-bar'
            settings:
              text: 'Everyday staples. Ingredients in plain sight.'
              linkLabel: ''
              linkHref: ''
            blocks:
            block_order:
            disabled: false
          header-default:
            type: 'header'
            settings:
              showSearch: true
              showCart: true
              behavior: 'sticky'
            blocks:
            block_order:
            disabled: false
        order:
          0: 'announcement-default'
          1: 'header-default'
      footer:
        name: 'LetBuyy Core footer'
        layout: 'theme'
        sections:
          footer-default:
            type: 'footer'
            settings:
            blocks:
            block_order:
            disabled: false
        order:
          0: 'footer-default'
      index:
        name: 'Pantry home'
        layout: 'theme'
        sections:
          pantry-hero:
