      faq-accordion:
        path: 'sections/faq-accordion.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-faq-accordion" data-section-id="{{ section.id }}">
            <h2>{{ section.settings.title }}</h2>
            {% if section.blocks.size > 0 %}
            <div class="lb-faq-accordion__items">
              {% for block in section.blocks %}<details class="lb-faq-accordion__item"{% unless section.settings.allowMultipleOpen %} name="lb-faq-{{ section.id }}"{% endunless %}><summary class="lb-faq-accordion__question">{{ block.settings.question }}</summary><div class="lb-faq-accordion__answer">{{ block.settings.answer }}</div></details>{% endfor %}
            </div>
            {% else %}
            <p class="lb-faq-accordion__empty">No questions published yet.</p>
            {% endif %}
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"FAQ Accordion","tag":"section","settings":[{"type":"text","label":"Title","default":"Frequently asked questions","id":"title"},{"type":"toggle","label":"Allow multiple open","default":false,"id":"allowMultipleOpen"}],"blocks":[{"type":"faq-item","name":"FAQ item","settings":[{"type":"text","label":"Question","id":"question"},{"type":"richtext","label":"Answer","id":"answer"}]}],"presets":[{"name":"FAQ Accordion","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
          {% endschema %}
        schema:
          name: 'FAQ Accordion'
          tag: 'section'
          settings:
            0:
              type: 'text'
              label: 'Title'
              default: 'Frequently asked questions'
              id: 'title'
            1:
              type: 'toggle'
              label: 'Allow multiple open'
              default: false
              id: 'allowMultipleOpen'
          blocks:
            0:
              type: 'faq-item'
              name: 'FAQ item'
              settings:
                0:
                  type: 'text'
                  label: 'Question'
                  id: 'question'
                1:
                  type: 'richtext'
                  label: 'Answer'
                  id: 'answer'
