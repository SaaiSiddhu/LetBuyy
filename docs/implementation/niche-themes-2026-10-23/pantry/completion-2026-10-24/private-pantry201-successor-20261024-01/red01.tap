      announcement-bar:
        path: 'sections/announcement-bar.liquid'
        source: |-
          <div class="pn-theme"><div class="pn-theme"><section class="lb-announcement-bar" data-section-id="{{ section.id }}">
            <div class="lb-announcement-bar__inner">
              <span>{{ section.settings.text }}</span>
              {% if section.settings.linkLabel %}<a href="{{ section.settings.linkHref | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}
            </div>
          </section>
          </div>
          </div>
          {% schema %}
          {"name":"Announcement Bar","tag":"section","settings":[{"type":"text","label":"Message","default":"Discover our latest products.","id":"text"},{"type":"text","label":"Link label","default":"Shop now","id":"linkLabel"},{"type":"url","label":"Link URL","default":"/products","id":"linkHref"}],"blocks":[],"presets":[{"name":"Announcement Bar","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
