          {"name":"App Block Slot","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"text","label":"Slot","default":"storefront.home.after-hero","id":"slot"}],"blocks":[{"type":"@app","name":"App block","settings":[]}],"presets":[{"name":"App Block Slot","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
