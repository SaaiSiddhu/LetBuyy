    <style data-threadline="2">
    .tl-theme{--font-display:var(--font-heading,Georgia,serif);--font-body:var(--font-main,Inter,Arial,sans-serif);--tl-muted:var(--tl-muted-color,#65574c);--tl-border:var(--tl-boundary-color,#766657);--tl-stone:var(--surface,#efe7dc);background:var(--background);color:var(--foreground);--footer-bg:var(--surface);--footer-text:var(--foreground);--footer-text-muted:var(--tl-muted);font:16px/1.55 var(--font-body,Inter,Arial,sans-serif)}
    .tl-theme *{box-sizing:border-box}.tl-theme img{max-width:100%}.tl-theme a{color:inherit}.tl-theme h1,.tl-theme h2,.tl-theme h3{font-family:var(--font-display,Georgia,serif);font-weight:400;line-height:1.15;letter-spacing:-.025em}.tl-theme h1{font-size:clamp(2rem,4.4vw,4rem)}.tl-theme h2{font-size:clamp(1.75rem,3vw,2.4rem)}.tl-theme p{color:var(--tl-muted)}
    .tl-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--tl-focus-color,#005fcc);outline-offset:4px}.tl-wrap{width:min(1280px,calc(100% - 112px));margin-inline:auto}.tl-section{padding-block:76px}.tl-eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;color:var(--tl-muted)}.tl-button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:13px 23px;background:var(--primary);color:var(--tl-action-label,#fff)!important;border:1px solid var(--primary);border-radius:4px;text-decoration:none;font-size:.85rem}.tl-link{display:inline-flex;min-height:44px;align-items:center;border-bottom:1px solid var(--tl-border);text-decoration:none;font-size:.85rem}.tl-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px}.tl-heading h2{margin:0}.tl-empty{padding:40px 0;color:var(--tl-muted)}
    .tl-theme .lb-announcement-bar{background:var(--primary);color:var(--tl-action-label,#fff);padding:9px 20px;text-align:center;font-size:.75rem}.tl-theme .lb-announcement-bar__inner{justify-content:center}.tl-theme .lb-header{border-bottom:1px solid var(--border-color);background:var(--background);padding:14px 0}.tl-theme .lb-header__inner{padding:0;min-height:44px;max-width:1280px;width:calc(100% - 112px);margin:auto}.tl-theme .lb-header__brand{font-family:var(--font-display);font-weight:400;letter-spacing:.18em;font-size:1.5rem;text-transform:uppercase}.tl-theme .lb-header__nav-links{gap:26px}.tl-theme .lb-header__nav-links>a{font-size:.8rem;border:0}.tl-theme .lb-footer{background:var(--tl-stone);padding:55px max(28px,calc((100vw - 1280px)/2));border-top:1px solid var(--border-color)}
    .tl-hero{display:grid;grid-template-columns:1.5fr 1fr}.tl-hero-media{display:grid;grid-template-columns:1.7fr 1fr;gap:5px;min-width:0}.tl-hero-media img{width:100%;height:585px;object-fit:cover}.tl-focus-top img{object-position:center top}.tl-focus-bottom img{object-position:center bottom}.tl-hero-copy{padding:65px 56px;display:flex;flex-direction:column;align-items:start;justify-content:center}.tl-hero-copy h1{margin:22px 0}.tl-hero-copy p{margin:0 0 28px}.tl-hero-copy .tl-link{margin-top:15px}.tl-hero-empty{grid-template-columns:1fr}.tl-hero-empty .tl-hero-copy{max-width:760px;margin:auto;min-height:400px}
    .tl-categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.tl-category{text-decoration:none;min-width:0}.tl-category img,.tl-category-placeholder{display:block;width:100%;height:205px;object-fit:cover;background:var(--tl-stone)}.tl-category-placeholder{display:grid;place-items:center;color:var(--tl-muted);font-size:.8rem}.tl-category strong{display:flex;align-items:center;justify-content:space-between;font-family:var(--font-display);font-size:1.4rem;font-weight:400;margin-top:12px}
    .tl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.tl-grid[data-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-grid[data-columns="4"]{grid-template-columns:repeat(4,minmax(0,1fr))}.tl-card{min-width:0}.tl-card>a{text-decoration:none}.tl-card-media{position:relative;background:var(--tl-stone);aspect-ratio:3/4;overflow:hidden}.tl-card-media img{width:100%;height:100%;object-fit:cover;display:block}.tl-card-media span{position:absolute;bottom:10px;left:10px;background:var(--background);padding:4px 9px;font-size:.75rem}.tl-card-placeholder{height:100%;display:grid;place-items:center;font-size:.8rem;color:var(--tl-muted)}.tl-card-info{display:flex;justify-content:space-between;gap:12px;margin-top:14px}.tl-card h3{font-family:var(--font-body);font-size:.9rem;line-height:1.5;margin:0;letter-spacing:0}.tl-card-price{font-size:.85rem;white-space:nowrap;font-variant-numeric:tabular-nums}.tl-card-facts{font-size:.75rem;margin:6px 0}.tl-card .tl-link{font-size:.75rem}
    .tl-outfit{display:grid;grid-template-columns:1fr 1fr;background:var(--tl-stone)}.tl-outfit>img{width:100%;height:620px;object-fit:cover}.tl-outfit-empty{grid-template-columns:1fr}.tl-outfit-copy{padding:65px;align-self:center}.tl-outfit-copy h2{margin:15px 0}.tl-outfit-product{display:flex;align-items:center;gap:20px;padding:22px 0;border-top:1px solid var(--border-color);text-decoration:none}.tl-outfit-product img{width:72px;height:96px;object-fit:cover}.tl-outfit-product h3{font-size:1.35rem;margin:0 0 8px}.tl-outfit-product p{font-size:.8rem;margin:0}.tl-outfit-note{font-size:.8rem}.tl-fabric{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.tl-fabric>img{width:100%;aspect-ratio:3/2;object-fit:cover}.tl-fabric h2{margin:15px 0}.tl-fabric-empty{grid-template-columns:1fr}.tl-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;padding-block:35px;border-top:1px solid var(--border-color)}.tl-service h3{font-family:var(--font-body);font-size:.9rem;letter-spacing:0}.tl-service p{font-size:.8rem}.tl-services:empty{display:none}
    .tl-theme .lb-product-detail{width:min(1280px,calc(100% - 112px));margin:auto;padding-block:32px 60px}.tl-theme .lb-product-detail__layout{display:grid;grid-template-columns:1.2fr 1fr;gap:65px}.tl-theme .lb-product-detail__gallery-image{aspect-ratio:4/5;object-fit:cover;width:100%}.tl-theme .lb-product-detail__title{font-size:clamp(1.8rem,3vw,2.8rem);font-weight:400}.tl-theme .lb-product-detail__price-current{font-size:1.25rem}.tl-theme .lb-product-detail__cta{border-radius:4px;min-height:48px}.tl-theme .lb-product-detail__cta--primary{background:var(--primary);color:var(--tl-action-label,#fff)}.tl-theme .lb-product-detail__variant-values{gap:9px}.tl-theme .lb-product-detail__variant-values button{min-width:44px;min-height:44px;border:1px solid var(--tl-border);border-radius:0;background:var(--background)}.tl-theme .lb-product-detail__variant-values button[aria-pressed="true"]{background:var(--primary);color:var(--tl-action-label,#fff)}.tl-theme .lb-product-detail__variant-values button[disabled]{text-decoration:line-through}.tl-theme .lb-product-detail__info{min-width:0}.tl-fit{border-top:1px solid var(--border-color);padding-top:35px;margin-top:35px}.tl-fit h2{font-size:1.6rem}.tl-fit p{font-size:.9rem}.tl-fit table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:.8rem;margin:20px 0}.tl-fit caption{text-align:left;margin-bottom:12px}.tl-fit th,.tl-fit td{text-align:left;border-bottom:1px solid var(--border-color);padding:12px 8px;overflow-wrap:anywhere}.tl-fit thead{background:var(--tl-stone)}.tl-fit summary{min-height:44px;cursor:pointer;font-family:var(--font-display);font-size:1.35rem}.tl-filters{display:flex;align-items:end;flex-wrap:wrap;gap:16px;margin:24px 0}.tl-filters label{display:grid;gap:6px;font-size:.8rem}.tl-filters input,.tl-filters select{min-height:44px;max-width:100%;padding:10px;border:1px solid var(--tl-border);background:var(--background);color:var(--foreground)}.tl-filters input[type="number"]{width:120px}
    .tl-theme .lb-cart,.tl-theme .lb-customer-account,.tl-theme .lb-customer-orders{max-width:1280px;margin:auto}.tl-theme .lb-cart__checkout,.tl-theme .lb-cart-drawer__checkout{background:var(--primary);color:var(--tl-action-label,#fff)}
    @media(max-width:1100px){.tl-wrap{width:calc(100% - 64px)}.tl-hero-copy{padding:45px 32px}.tl-outfit-copy{padding:40px}.tl-theme .lb-product-detail__layout{gap:32px}.tl-fabric{gap:35px}}
    @media(max-width:900px){.tl-section{padding-block:55px}.tl-hero{grid-template-columns:1.1fr 1fr}.tl-hero-media{grid-template-columns:1fr}.tl-hero-media img{height:515px}.tl-hero-media img+img{display:none}.tl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-grid[data-columns="4"]{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-outfit-copy{padding:32px}.tl-outfit>img{height:540px}.tl-theme .lb-header__inner{width:calc(100% - 64px)}}
