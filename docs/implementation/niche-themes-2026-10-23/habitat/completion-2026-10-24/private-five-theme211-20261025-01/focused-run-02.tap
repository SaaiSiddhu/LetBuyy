nter;gap:0.3rem;font-size:var(--lb-text-xs);opacity:.7;}.lb-product-card__rating .lb-icon-star{width:14px;height:14px;color:var(--primary);}.lb-product-card__price{display:flex;align-items:baseline;gap:0.375rem;font-weight:700;}.lb-product-card__price s{font-weight:400;opacity:.55;}.lb-product-card__actions{display:flex;gap:0.5rem;padding:0 var(--lb-space-xs) var(--lb-space-xs);margin-top:auto;}.lb-product-card__cta{flex:1;display:inline-flex;align-items:center;justify-content:center;min-height:44px;border-radius:var(--lb-radius-md);background:var(--primary);color:#fff;font-weight:600;font-size:var(--lb-text-sm);border:0;cursor:pointer;}.lb-product-card__cta:disabled{opacity:.5;cursor:not-allowed;}.lb-product-card__actions lb-wishlist-toggle{min-width:44px;min-height:44px;}.lb-product-detail{display:block;}.lb-product-detail__breadcrumb{display:flex;flex-wrap:wrap;gap:0.4rem;font-size:var(--lb-text-xs);opacity:.7;margin-bottom:var(--lb-space-sm);}.lb-product-detail__layout{display:flex;flex-direction:column;gap:var(--lb-space-lg);}@media (min-width:64em){.lb-product-detail__layout{flex-direction:row;align-items:flex-start;}.lb-product-detail__gallery{flex:1 1 55%;position:sticky;top:var(--lb-space-sm);}.lb-product-detail__info{flex:1 1 45%;}}.lb-product-detail__gallery-main{position:relative;aspect-ratio:1;border-radius:var(--lb-radius-lg);overflow:hidden;background:var(--border-color,rgb(226 232 240));}.lb-product-detail__gallery-image,.lb-banner-carousel img{width:100%;height:100%;aspect-ratio:1;border-radius:var(--lb-radius-md);object-fit:cover;}.lb-product-detail__gallery-thumbs{display:flex;gap:var(--lb-space-2xs);margin-top:var(--lb-space-2xs);overflow-x:auto;}.lb-product-detail__gallery-thumb{flex:0 0 auto;width:56px;height:56px;padding:0;border-radius:var(--lb-radius-sm);overflow:hidden;border:2px solid transparent;background:none;cursor:pointer;}.lb-product-detail__gallery-thumb img{width:100%;height:100%;object-fit:cover;}.lb-product-detail__gallery-thumb[aria-selected="true"]{border-color:var(--primary);}.lb-product-detail__price{display:flex;align-items:baseline;gap:0.5rem;flex-wrap:wrap;margin:var(--lb-space-2xs) 0 var(--lb-space-sm);}.lb-product-detail__price-current{font-size:var(--lb-text-xl);font-weight:700;color:var(--primary);}.lb-product-detail__price-compare{font-weight:400;opacity:.55;}.lb-product-detail__price-save{font-size:var(--lb-text-xs);font-weight:700;color:#dc2626;}.lb-product-detail__purchase{display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;margin:var(--lb-space-sm) 0;}.lb-product-detail__purchase lb-add-to-cart{display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;margin-top:0;flex:1 1 100%;}.lb-product-detail__quantity{width:4.5rem;min-height:44px;border:1px solid var(--border-color,rgb(226 232 240));border-radius:var(--lb-radius-md);padding-inline:0.6rem;}.lb-product-detail__cta{flex:1 1 10rem;min-height:44px;width:auto;}.lb-product-detail__cta--secondary{background:none;border:2px solid var(--primary);color:var(--primary);}.lb-product-detail__variant-group{display:flex;flex-wrap:wrap;gap:var(--lb-space-2xs);align-items:center;}.lb-product-detail__variant-values{display:flex;flex-wrap:wrap;gap:var(--lb-space-2xs);}.lb-product-detail__variant-status{font-size:var(--lb-text-xs);color:#dc2626;min-height:1em;}.lb-product-detail__accordion{border-top:1px solid var(--border-color,rgb(226 232 240));padding-block:0.1rem;}.lb-product-detail__accordion summary{min-height:44px;display:flex;align-items:center;font-weight:700;cursor:pointer;}.lb-product-detail__accordion-body{padding-bottom:var(--lb-space-sm);opacity:.85;}.lb-product-detail__variants{display:flex;flex-direction:column;gap:var(--lb-space-2xs);margin-block:var(--lb-space-sm);}.lb-variant-option__name{font-weight:700;margin-right:var(--lb-space-3xs);}[data-lb-variant-option]{cursor:pointer;border:1px solid var(--border-color,rgb(226 232 240));background:var(--surface,#fff);border-radius:var(--lb-radius-md);padding:0.5rem 0.9re