+// Pure transport/function contracts. This evaluates the exact private worker
+// source in a denied-runtime VM, never invokes its fetch/queue/scheduled entry,
+// and replaces the existing SDK send before calling the readonly adapter.
+import assert from 'node:assert/strict';
+import test, {before,after} from 'node:test';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import {createRequire} from 'node:module';
+import {createHmac,webcrypto} from 'node:crypto';
+const require=createRequire(import.meta.url),ts=require('typescript');
+const adapter=require('@letbuyy/infrastructure/resend-adapter');
+const producer=require('../../api-gateway/src/lib/order-confirmation-email.ts');
+const source=fs.readFileSync(new URL('../src/index.ts',import.meta.url),'utf8');
+const originalFetch=globalThis.fetch;let forbiddenFetch=0;
+before(()=>{globalThis.fetch=async()=>{forbiddenFetch++;throw Error('pure delivery tests forbid network');};});
+after(()=>{globalThis.fetch=originalFetch;assert.equal(forbiddenFetch,0);});
+function worker(){
+ const module={exports:{}},logs=[];
+ const denied=()=>{throw Error('pure transport tests forbid runtime/database/queue services');};
+ const script=ts.transpileModule(source+'\nexport const __pureTransport={dispatchEmailDeliveries,normalizePayload,isDeterministicQueueError};',{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022}}).outputText;
+ const context=vm.createContext({module,exports:module.exports,require:name=>name==='@letbuyy/infrastructure/resend-adapter'?adapter:new Proxy({},{get:()=>denied}),crypto:webcrypto,TextEncoder,TextDecoder,Date,Error,JSON,console:{info:v=>logs.push(v),warn:v=>logs.push(v),error:v=>logs.push(v)}});
+ vm.runInContext(script,context,{timeout:1000});return{...module.exports.__pureTransport,logs};
+}
+function provider(t,mode='success'){
+ const key='re_synthetic_consumer_'+webcrypto.randomUUID(),client=adapter.getResendClient(key),original=client.emails.send,attempts=[],accepted=new Map();
+ client.emails.send=async(message,options)=>{
+  attempts.push({message,options});const identity=options?.idempotencyKey;
+  if(mode==='failure-once'&&attempts.length===1)return{data:null,error:{message:'synthetic provider refusal'}};
+  if(identity){const content=JSON.stringify(message);if(accepted.has(identity))assert.equal(accepted.get(identity),content);else accepted.set(identity,content);}
+  if(mode==='lost-ack-once'&&attempts.length===1)throw Error('synthetic lost provider acknowledgement');
+  return{data:{id:'synthetic-provider-message'},error:null};
+ };t.after(()=>{client.emails.send=original;});return{key,attempts,accepted};
+}
+const site='site-synthetic',order='order-synthetic',secret='synthetic-delivery-tenant-envelope';
+const env=key=>({ENVIRONMENT:'development',QUEUE_TENANT_ENVELOPE_SECRET:secret,RESEND_API_KEY:key,RESEND_FROM_EMAIL:'Synthetic <sender@example.invalid>'});
+function job(overrides={}){
+ const body={messageId:`order-confirmation:${site}:${order}`,queueName:'email',jobType:'email.order_confirmation',siteId:site,idempotencyKey:`email.order_confirmation:${site}:${order}`,requestId:'request-original',payload:{to:'buyer@example.invalid',subject:'Synthetic order confirmed',text:'Synthetic confirmed order',html:'<p>Synthetic confirmed order</p>',order_id:order,store_id:site},...overrides};
+ const issuedAt=new Date().toISOString();body.tenantEnvelope={siteId:body.siteId,issuedAt,signature:createHmac('sha256',secret).update(`${body.siteId}.${body.messageId}.${body.idempotencyKey}.${issuedAt}`).digest('hex')};return body;
+}
+async function normalized(w,e,body=job()){
+ const message={id:'synthetic-queue-message',body};const batch={queue:'email',messages:[message]};const input=await w.normalizePayload(e,message,batch);return{message,input,status:'completed',lagMilliseconds:0};
+}
+test('consumer forwards the canonical site/order delivery key to the actual readonly adapter',async t=>{
+ const w=worker(),p=provider(t),e=env(p.key);await w.dispatchEmailDeliveries(e,[await normalized(w,e)]);
+ assert.equal(p.attempts.length,1);assert.deepEqual(p.attempts[0].options,{idempotencyKey:`email.order_confirmation:${site}:${order}`});
+});
+test('duplicate and concurrent confirmation deliveries preserve one logical key and unchanged multipart message',async t=>{
+ const w=worker(),p=provider(t),e=env(p.key),d=await normalized(w,e);
+ await Promise.all([w.dispatchEmailDeliveries(e,[d]),w.dispatchEmailDeliveries(e,[d])]);
+ assert.equal(p.attempts.length,2);assert.equal(p.accepted.size,1,'fake acceptance only, no actual provider/inbox claim');assert.deepEqual(p.attempts[0],p.attempts[1]);
+});
+for(const mode of ['failure-once','lost-ack-once'])test(`consumer ${mode} remains retryable with the same delivery identity`,async t=>{
+ const w=worker(),p=provider(t,mode),e=env(p.key),d=await normalized(w,e);
+ let failure;try{await w.dispatchEmailDeliveries(e,[d]);}catch(error){failure=error;}assert.ok(failure);assert.equal(w.isDeterministicQueueError(failure),false);
+ await w.dispatchEmailDeliveries(e,[d]);assert.equal(p.attempts.length,2);assert.equal(p.accepted.size,1);assert.deepEqual(p.attempts[0].options,p.attempts[1].options);
+});
+for(const mismatch of ['site','order-key','message-key','missing-order'])test(`confirmation refuses ${mismatch} binding before a transport attempt`,async t=>{
+ const w=worker(),p=provider(t),e=env(p.key),body=job();
+ if(mismatch==='site')body.payload.store_id='foreign-site';
+ if(mismatch==='order-key')body.idempotencyKey='foreign-delivery-key';
+ if(mismatch==='message-key')body.messageId='foreign-message';
+ if(mismatch==='missing-order')delete body.payload.order_id;
+ // Re-sign declared envelope for the crafted producer; dispatch must still bind
+ // the payload's actual site/order to the normalizer's verified authority.
+ const signed=job(body),d=await normalized(w,e,signed);
+ let failure;try{await w.dispatchEmailDeliveries(e,[d]);}catch(error){failure=error;}assert.ok(failure);assert.equal(w.isDeterministicQueueError(failure),true);assert.equal(p.attempts.length,0);
+});
+for(const attack of ['missing','forged','swapped-site'])test(`existing tenant envelope rejects ${attack} proof before dispatch`,async t=>{
+ const w=worker(),p=provider(t),e=env(p.key),body=job();
+ if(attack==='missing')delete body.tenantEnvelope;
+ if(attack==='forged')body.tenantEnvelope.signature='0'.repeat(64);
+ if(attack==='swapped-site')body.siteId='foreign-site';
+ await assert.rejects(normalized(w,e,body),/Tenant/);assert.equal(p.attempts.length,0);
+});
+test('missing order-confirmation provider configuration is retryable, not silently acknowledged by dispatch',async()=>{
+ const w=worker(),e=env('SKIP_NEEDS_HUMAN_SYNTHETIC');const d=await normalized(w,e);let failure;try{await w.dispatchEmailDeliveries(e,[d]);}catch(error){failure=error;}assert.ok(failure);assert.equal(w.isDeterministicQueueError(failure),false);
+});
+for(const other of ['email.order_cancelled','email.order_refunded','email.gift_card_issued','email.employee_invite','email.contact_owner_notification'])test(`unchanged other transactional transport: ${other}`,async t=>{
+ const w=worker(),p=provider(t),e=env(p.key),d=await normalized(w,e,job({jobType:other}));await w.dispatchEmailDeliveries(e,[d]);assert.equal(p.attempts.length,1);assert.equal(p.attempts[0].options,undefined);
+});
+function db(){return{from(table){const filters={};return{select(){return this;},eq(k,v){filters[k]=v;return this;},async maybeSingle(){return{data:{id:order,store_id:site,order_number:'SYN-1',customer_name:'Synthetic',customer_email:'buyer@example.invalid',total:100,currency:'INR'}};},async order(){return{data:[{title:'Saved item',quantity:1,unit_price:100,total:100}]};}};}};}
+test('actual producer direct and signed queued paths use identical provider key and message for the same order',async t=>{
+ const w=worker(),p=provider(t),e=env(p.key),enqueued=[];
+ const input={orderId:order,storeId:site,requestId:'direct-arrival',idempotencyKey:'payment-attempt-a'};
+ await producer.enqueueOrderConfirmationEmail({...e,NOTIFICATION_QUEUE:{send:async body=>{enqueued.push(body);}}},db(),input);
+ const d=await normalized(w,e,enqueued[0]);
+ await Promise.all([producer.enqueueOrderConfirmationEmail(e,db(),{...input,idempotencyKey:'payment-attempt-b'}),w.dispatchEmailDeliveries(e,[d])]);
+ assert.equal(p.attempts.length,2);assert.deepEqual(p.attempts[0],p.attempts[1]);assert.equal(p.accepted.size,1);
+});
+test('only existing confirmation-dispatch function differs from current baseline worker source',()=>{
+ const baseline=fs.readFileSync('/Volumes/Projects/LetBuyy/services/queue-workers/src/index.ts','utf8');const strip=s=>{const start=s.indexOf('async function dispatchEmailDeliveries('),end=s.indexOf('\nasync function triggerCustomDomainReconciler',start);return s.slice(0,start)+'CONFIRMATION_DISPATCH'+s.slice(end);};assert.equal(strip(source),strip(baseline));
+});
