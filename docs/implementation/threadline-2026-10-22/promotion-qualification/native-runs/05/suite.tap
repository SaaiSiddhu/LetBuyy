                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    {% assign layout_value = section.settings.layout | default: 'left' %}
                    <section class="lb-about-section lb-about-section--layout-{{ layout_value }}" data-section-id="{{ section.id }}">
                      <div class="lb-about-section__body">
