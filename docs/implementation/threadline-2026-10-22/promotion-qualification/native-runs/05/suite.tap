            schema_version: '1.0'
          theme_preset_id: 'refresh'
          default_template:
            themeId: 'letbuyy-refresh'
            sections:
              footer:
                id: 'footer'
                type: 'footer'
                order: 100
                visible: true
                settings:
                  columns: 3
                  showLogo: true
                  showSocial: true
                  twitterUrl: ''
                  contactEmail: 'help@letbuyy.com'
                  instagramUrl: ''
                  copyrightText: ''
                  showNewsletter: true
                  showPaymentIcons: true
              header:
                id: 'header'
                type: 'header'
                order: 0
                visible: true
                settings:
                  logoUrl: ''
                  behavior: 'sticky'
                  showCart: true
                  storeName: ''
                  showSearch: true
                  displayMode: 'name'
                  showAccount: true
                  navPlacement: 'right'
                  logoPlacement: 'left'
              template:
                0:
                  id: 'announcement-default'
                  type: 'announcementBar'
                  order: 5
                  visible: true
                  settings:
                    text: 'Discover our latest products.'
                    linkHref: '/products'
                    alignment: 'center'
                    linkLabel: 'Shop now'
                    textColor: '#FFFFFF'
                    backgroundColor: '#0F172A'
                    visibleOnMobile: true
                1:
                  id: 'hero-default'
                  type: 'heroBanner'
                  order: 10
                  visible: true
                  settings:
                    image: ''
                    height: 'large'
                    ctaLink: '#products'
                    ctaText: 'Shop Now'
