                  navPlacement: 'right'
                  logoPlacement: 'left'
              template:
                0:
                  id: 'announcement-default'
                  type: 'announcementBar'
                  order: 5
                  visible: true
                  settings:
                    text: 'Discover our latest products.'
                    linkHref: '/products'
