                            {
                              "id": "layout",
                              "type": "select",
                              "label": "Layout",
                              "default": "left",
                              "options": [
                                "left",
                                "right",
                                "center"
                              ]
                            }
                          ],
                          "blocks": [],
                          "presets": [
                            {
                              "name": "About Section",
                              "settings": {},
                              "blocks": []
                            }
                          ]
                        }
                        {% endschema %}
