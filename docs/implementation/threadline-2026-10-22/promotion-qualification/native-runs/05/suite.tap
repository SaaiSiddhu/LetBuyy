                    textAlign: 'left'
                    subheading: 'Fresh drops, everyday staples, and limited pieces curated for your store.'
                2:
                  id: 'category-grid-default'
                  type: 'categoryGrid'
                  order: 20
                  blocks:
                    0:
                      id: 'category-sneakers'
                      type: 'category'
                      order: 0
                      visible: true
                      settings:
                        name: 'Sneakers'
                        slug: 'sneakers'
                        tagline: 'Fresh pairs'
                    1:
                      id: 'category-apparel'
                      type: 'category'
                      order: 1
                      visible: true
