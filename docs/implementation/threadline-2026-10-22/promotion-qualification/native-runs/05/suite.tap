                        placeholder: 'Search products'
                      block_order:
                article:
                  name: 'Article'
                  order:
                    0: 'article-content-default'
                  layout: 'theme'
                  sections:
                    article-content-default:
                      type: 'article-content'
                      blocks:
                      disabled: false
                      settings:
                      block_order:
                contact:
                  name: 'Contact'
                  order:
                    0: 'contact-form-default'
                  layout: 'theme'
                  sections:
                    contact-form-default:
                      type: 'contact-form'
