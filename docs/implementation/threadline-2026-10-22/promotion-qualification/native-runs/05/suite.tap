                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="tl-theme" data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<div class="tl-outfit{% unless section.settings.image != blank %} tl-outfit-empty{% endunless %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.title }}" loading="lazy">{% endif %}<div class="tl-outfit-copy"><span class="tl-eyebrow">THE EVERYDAY PAIRING</span><h2>{{ section.settings.title }}</h2><p>{{ section.settings.subtitle }}</p><p class="tl-outfit-note">Each piece is sold separately.</p>{% for item in section.products limit: section.settings.productLimit %}<a class="tl-outfit-product" href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy">{% endif %}<div><h3>{{ item.title }}</h3><p>{{ item.price | times: 100 | money_with_currency: item.currency }}</p><span class="tl-link">Choose your size →</span></div></a>{% endfor %}</div></div>{% endif %}</section>
                    {% schema %}
                    {"name":"Curated outfit links","tag":"section","settings":[{"type":"toggle","label":"Only show selected products","default":true,"id":"requireSelection"},{"type":"text","label":"Heading","default":"Wear it your way.","id":"title"},{"type":"text","label":"Description","default":"Every piece, individually chosen.","id":"subtitle"},{"type":"image","label":"Outfit photograph","id":"image"},{"type":"product","label":"First independently sold product","id":"product1"},{"type":"product","label":"Second independently sold product","id":"product2"},{"type":"product","label":"Third independently sold product","id":"product3"},{"type":"range","label":"Products to show","default":2,"min":1,"max":8,"step":1,"id":"productLimit"}],"blocks":[],"presets":[{"name":"Curated outfit links","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
