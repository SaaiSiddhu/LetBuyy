                  source: |-
                    <section class="tl-theme" data-section-id="{{ section.id }}"><div class="tl-wrap tl-section"><div class="tl-heading"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div></div>{% assign apparel_products = section.products | default: collection.products %}{% if apparel_products.size > 0 %}<div class="tl-grid" data-columns="{{ section.settings.columns }}">{% for item in apparel_products limit: section.settings.productLimit %}<article class="tl-card"><a href="{{ item.url }}"><div class="tl-card-media">{% if item.featured_image %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<div class="tl-card-placeholder">Product image not supplied</div>{% endif %}{% if item.available == false %}<span>Unavailable</span>{% endif %}</div><div class="tl-card-info"><h3>{{ item.title }}</h3><span class="tl-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</span></div></a>{% for option in item.option_summaries %}<p class="tl-card-facts">{{ option.name }}: {{ option.summary }}</p>{% endfor %}<a class="tl-link" href="{{ item.url }}">{% if item.options.size > 0 %}Choose your size{% else %}View product{% endif %} →</a></article>{% endfor %}</div><nav class="tl-heading" aria-label="Product pages">{% if collection.pagination.previous_url %}<a class="tl-link" href="{{ collection.pagination.previous_url }}">← Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url %}<a class="tl-link" href="{{ collection.pagination.next_url }}">Next →</a>{% endif %}</nav>{% else %}<p class="tl-empty">No products found. Try a broader collection or clear your filters.</p>{% endif %}</div></section>
