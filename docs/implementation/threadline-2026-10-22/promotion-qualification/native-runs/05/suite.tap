              schema_version: '2026-06-liquid-sections'
            themeSettings:
              isDark: false
              textColor: '#1A1A2E'
              fontFamily: 'Inter'
              accentColor: '#F59E0B'
              borderRadius: 10
              primaryColor: '#8B5CF6'
              surfaceColor: '#F8FAFC'
              enableShadows: true
              bodyFontFamily: 'Inter'
              secondaryColor: '#6D28D9'
              backgroundColor: '#FFFFFF'
              enableAnimations: true
              headingFontFamily: 'Inter'
            rendererEngine: 'liquid'
          long_description: 'Bold and contemporary for direct-to-consumer brands and general merchandise. Deep violet and amber — brand-forward for any product category.'
          owned_by_site_id: ~
          renderer_version: '1.0.0'
          letbuyy_price_inr: 0
          letbuyy_price_usd: 0
          renderer_manifest:
            engine: 'theme-engine-v1'
            sections:
              0: 'header'
              1: 'announcementBar'
              2: 'heroBanner'
              3: 'categoryGrid'
              4: 'featuredProducts'
              5: 'productGrid'
              6: 'newsletter'
              7: 'footer'
            provenance:
              mode: 'insert'
              migration: '197_letbuyy_core_first_class_theme'
          shopify_price_usd: ~
          performance_report:
          supported_platforms:
            0: 'letbuyy'
          wordpress_price_usd: ~
          accessibility_report:
          letbuyy_pricing_type: 'free'
          supported_site_types:
            0: 'store'
