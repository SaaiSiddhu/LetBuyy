                    blocks:
                    presets:
                      0:
                        name: 'Category Grid'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Heading'
                        default: 'Shop by style'
                      1:
                        id: 'subtitle'
