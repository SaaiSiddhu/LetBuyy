              schema_version: '2026-06-liquid-sections'
            themeSettings:
              isDark: false
              textColor: '#1A1A2E'
              fontFamily: 'Inter'
              accentColor: '#A4E500'
              borderRadius: 12
              primaryColor: '#00B3B3'
              surfaceColor: '#F9FAFB'
              enableShadows: true
              bodyFontFamily: 'Inter'
              secondaryColor: '#008080'
              backgroundColor: '#FFFFFF'
              enableAnimations: true
              headingFontFamily: 'Inter'
            rendererEngine: 'liquid'
          long_description: 'Clean and professional for multi-category stores and general retail. Teal and lime — a versatile, safe baseline for any type of online store.'
