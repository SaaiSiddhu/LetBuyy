                    {% schema %}
                    {"name":"Newsletter Signup","tag":"section","settings":[{"type":"text","label":"Heading","default":"Get first access","id":"title"},{"type":"text","label":"Subheading","id":"subtitle"},{"type":"text","label":"Button label","default":"Sign up","id":"buttonLabel"}],"blocks":[],"presets":[{"name":"Newsletter Signup","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                customer-addresses:
                  path: 'sections/customer-addresses.liquid'
                  schema:
                    tag: 'section'
                    name: 'Addresses'
                    blocks:
                    presets:
                      0:
                        name: 'Addresses'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Your addresses'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-addresses" data-section-id="{{ section.id }}">
                      <h1>{{ section.settings.heading }}</h1>
                      {% if buyer %}
                      <lb-address-manager data-lb-island="address-manager" data-account-type="buyer" data-base-path="/store/{{ shop.subdomain }}" data-authenticated="true"></lb-address-manager>
                      {% elsif buyer_unavailable %}<p class="lb-addresses__unavailable" role="status">We could not load your LetBuyy addresses right now. Please refresh and try again.</p>
                      {% elsif customer %}
                      {% if customer.addresses and customer.addresses.size > 0 %}
                      <div class="lb-addresses__grid">
                        {% for addr in customer.addresses %}<div class="lb-address-card{% if addr.is_default %} lb-address-card--default{% endif %}"><span class="lb-address-card__label">{{ addr.label | default: "address" }}</span>{% if addr.is_default %}<span class="lb-address-card__default-badge">Default</span>{% endif %}<p class="lb-address-card__address">{{ addr.address1 }}{% if addr.address2 %}, {{ addr.address2 }}{% endif %}</p><p class="lb-address-card__city">{{ addr.city }}, {{ addr.province }} {{ addr.zip }}</p></div>{% endfor %}
                      </div>
                      {% else %}
                      <p class="lb-addresses__empty">No saved addresses.</p>
                      {% endif %}
                      <lb-address-manager
                        data-lb-island="address-manager"
                        data-base-path="/store/{{ shop.subdomain }}"
                        data-authenticated="true"
                      ></lb-address-manager>
                      {% else %}
                      <p class="lb-addresses__guest">Please <a href="{{ routes.customer_login_url }}">sign in</a> to manage your addresses.</p>
                      {% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Addresses","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your addresses","id":"heading"}],"blocks":[],"presets":[{"name":"Addresses","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                experience-timeline:
                  path: 'sections/experience-timeline.liquid'
                  schema:
                    tag: 'section'
                    name: 'Experience Timeline'
                    blocks:
                      0:
                        name: 'Experience'
                        type: 'experience'
                        settings:
                          0:
                            id: 'title'
                            type: 'text'
                            label: 'Title'
                          1:
                            id: 'company'
                            type: 'text'
                            label: 'Company'
                          2:
                            id: 'period'
                            type: 'text'
                            label: 'Period'
                    presets:
                      0:
                        name: 'Experience Timeline'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Title'
                        default: 'Experience'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-experience-timeline" data-section-id="{{ section.id }}">
                      <h2>{{ section.settings.title }}</h2>
                      {% for block in section.blocks %}<article><h3>{{ block.settings.title }}</h3><p>{{ block.settings.company }}</p><time>{{ block.settings.period }}</time></article>{% endfor %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Experience Timeline","tag":"section","settings":[{"type":"text","label":"Title","default":"Experience","id":"title"}],"blocks":[{"type":"experience","name":"Experience","settings":[{"type":"text","label":"Title","id":"title"},{"type":"text","label":"Company","id":"company"},{"type":"text","label":"Period","id":"period"}]}],"presets":[{"name":"Experience Timeline","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                customer-order-detail:
                  path: 'sections/customer-order-detail.liquid'
                  schema:
                    tag: 'section'
                    name: 'Order Detail'
                    blocks:
                    presets:
                      0:
                        name: 'Order Detail'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Order'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-order-detail" data-section-id="{{ section.id }}">
                      {% if buyer_unavailable %}<p class="lb-order-detail__error" role="alert">This order is temporarily unavailable. Please try again.</p>{% elsif buyer %}
                      {% if order %}
                      <h1>Order #{{ order.number }}</h1>
                      <p class="lb-order-detail__status">Status: {{ order.status }}</p>
                      <ul class="lb-order-detail__items">{% for item in order.line_items %}<li><span class="lb-order-detail__title">{{ item.title }}</span><span class="lb-order-detail__qty">{{ item.quantity }}</span><span class="lb-order-detail__line">{{ item.line_price | money_with_currency: order.currency }}</span></li>{% endfor %}</ul>
                      <p class="lb-order-detail__total">Total: {{ order.total | money_with_currency: order.currency }}</p>
                      {% if order.gst_invoice_number != blank %}<p class="lb-order-detail__invoice">GST Invoice: {{ order.gst_invoice_number }} (Tax: {{ order.tax_total | money_with_currency: order.currency }})</p>{% endif %}
                      <ol class="lb-order-detail__timeline">{% for step in order.timeline %}<li class="lb-order-detail__step{% if step.reached %} is-reached{% endif %}">{{ step.label }}</li>{% endfor %}</ol>
                      {% if order.tracking_number != blank %}<p class="lb-order-detail__tracking">Tracking: {{ order.tracking_number }}{% if order.carrier != blank %} ({{ order.carrier }}){% endif %}</p>{% endif %}
                      {% else %}<p class="lb-order-detail__missing">Order not found.</p>{% endif %}
                      {% else %}<p class="lb-order-detail__guest">Please <a href="/api/buyer-auth/start?return_to={{ routes.account_orders_url }}">sign in with LetBuyy</a> to view this order.</p>{% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Order Detail","tag":"section","settings":[{"type":"text","label":"Heading","default":"Order","id":"heading"}],"blocks":[],"presets":[{"name":"Order Detail","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                collection-product-list:
                  path: 'sections/collection-product-list.liquid'
                  schema:
                    tag: 'section'
                    name: 'Apparel collection'
                    blocks:
                    presets:
                      0:
                        name: 'Apparel collection'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Heading'
                        default: 'Clothing'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="tl-theme" data-section-id="{{ section.id }}"><div class="tl-wrap tl-section"><h1>{{ collection.title | default: 'Clothing' }}</h1>{% if collection.products.size > 0 %}<div class="tl-grid">{% for item in collection.products %}<article class="tl-card"><a href="{{ item.url }}"><div class="tl-card-media">{% if item.featured_image %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<div class="tl-card-placeholder">Product image not supplied</div>{% endif %}{% if item.available == false %}<span>Unavailable</span>{% endif %}</div><div class="tl-card-info"><h3>{{ item.title }}</h3><span class="tl-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</span></div></a>{% for option in item.option_summaries %}<p class="tl-card-facts">{{ option.name }}: {{ option.summary }}</p>{% endfor %}<a class="tl-link" href="{{ item.url }}">{% if item.options.size > 0 %}Choose your size{% else %}View product{% endif %} →</a></article>{% endfor %}</div>{% else %}<p>No products found.</p><a class="tl-link" href="{{ routes.all_products_collection_url | default: routes.search_url }}">Explore all products</a>{% endif %}</div></section>
                    {% schema %}
                    {"name":"Apparel collection","tag":"section","settings":[{"type":"text","label":"Heading","default":"Clothing","id":"title"}],"blocks":[],"presets":[{"name":"Apparel collection","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
