                      block_order:
                    product-grid-default:
                      type: 'product-grid'
                      blocks:
                      disabled: false
                      settings:
                        title: 'Featured Products'
                        columns: 4
                        subtitle: 'Products selected from your catalog.'
                        productLimit: 8
                      block_order:
                    testimonials-default:
                      type: 'testimonials'
                      blocks:
                      disabled: false
                      settings:
                        title: 'What our buyers say'
                      block_order:
                    category-grid-default:
                      type: 'category-grid'
                      blocks:
                      disabled: false
                      settings:
                        title: 'Shop by style'
                        subtitle: 'Launch-ready groupings for daily buyers.'
                      block_order:
                    banner-carousel-default:
                      type: 'banner-carousel'
                      blocks:
                        carousel-apparel:
                          type: 'slide'
                          blocks:
                          disabled: false
                          settings:
                            link: '/products'
                            heading: 'Apparel drop: up to 30% off'
                          block_order:
                        carousel-monsoon:
                          type: 'slide'
                          blocks:
                          disabled: false
                          settings:
                            link: '/collections/new-arrivals'
                            heading: 'Monsoon-ready sneakers, restocked'
                          block_order:
                      disabled: false
                      settings:
                        title: 'This week'
                        autoplay: true
                      block_order:
                        0: 'carousel-monsoon'
                        1: 'carousel-apparel'
                    featured-collection-default:
                      type: 'featured-products'
                      blocks:
                      disabled: false
                      settings:
                        title: 'Drop-ready collection'
                        subtitle: 'Curated items for the first storefront launch.'
                        viewAllHref: '/collections/new-arrivals'
                        productLimit: 3
                        viewAllLabel: 'View collection'
                      block_order:
                footer:
                  name: 'LetBuyy Core footer'
                  order:
                    0: 'footer-default'
                  layout: 'theme'
                  sections:
                    footer-default:
                      type: 'footer'
                      blocks:
                      disabled: false
                      settings:
                      block_order:
                header:
                  name: 'LetBuyy Core header'
                  order:
                    0: 'announcement-default'
                    1: 'header-default'
                  layout: 'theme'
                  sections:
                    header-default:
                      type: 'header'
                      blocks:
                      disabled: false
                      settings:
                        behavior: 'sticky'
                        showCart: true
                        showSearch: true
                      block_order:
                    announcement-default:
                      type: 'announcement-bar'
                      blocks:
                      disabled: false
                      settings:
                        text: 'Discover our latest products.'
                        linkHref: '/products'
                        linkLabel: 'Shop now'
                      block_order:
                policy:
                  name: 'Policy page'
                  order:
                    0: 'policy-content-default'
                  layout: 'theme'
                  sections:
                    policy-content-default:
                      type: 'policy-content'
                      blocks:
                      disabled: false
                      settings:
                      block_order:
                search:
                  name: 'LetBuyy Core search'
                  order:
                    0: 'search-box-default'
                    1: 'search-results'
                  layout: 'theme'
                  sections:
                    search-results:
                      type: 'collection-product-list'
                      blocks:
                      disabled: false
