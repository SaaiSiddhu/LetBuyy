              schema_version: '2026-06-liquid-sections'
            themeSettings:
              isDark: false
              textColor: '#2C1B12'
              fontFamily: 'Source Sans Pro'
              accentColor: '#8D6E63'
              borderRadius: 6
              primaryColor: '#3E2723'
              surfaceColor: '#FFF8F0'
              enableShadows: true
              bodyFontFamily: 'Source Sans Pro'
              secondaryColor: '#5D3B2E'
              backgroundColor: '#FFFFFF'
              enableAnimations: true
              headingFontFamily: 'Libre Baskerville'
            rendererEngine: 'liquid'
          long_description: 'Warm, artisanal aesthetics for furniture, home decor, and handcrafted goods. Rich walnut earth tones that convey quality and longevity.'
          owned_by_site_id: ~
          renderer_version: '1.0.0'
          letbuyy_price_inr: 0
          letbuyy_price_usd: 0
          renderer_manifest:
            engine: 'theme-engine-v1'
            sections:
              0: 'header'
              1: 'announcementBar'
              2: 'heroBanner'
              3: 'categoryGrid'
              4: 'featuredProducts'
              5: 'productGrid'
              6: 'newsletter'
              7: 'footer'
            provenance:
              mode: 'insert'
              migration: '197_letbuyy_core_first_class_theme'
          shopify_price_usd: ~
          performance_report:
          supported_platforms:
            0: 'letbuyy'
          wordpress_price_usd: ~
          accessibility_report:
          letbuyy_pricing_type: 'free'
          supported_site_types:
            0: 'store'
        3:
          id: '7b669c70-0000-4000-8000-000000000007'
          name: 'Dawn'
          slug: 'letbuyy-dawn'
          tags:
            0: 'first-party'
            1: 'dawn'
          price: 0
          author: 'LetBuyy'
          config:
            colors:
              text: '#2C2C2C'
              accent: '#C0832B'
              primary: '#3B4F6B'
              background: '#FFFFFF'
            preset_id: 'dawn'
          layout: 'standard'
          version: '1.0.0'
          category: 'books'
          demo_url: ~
          features:
