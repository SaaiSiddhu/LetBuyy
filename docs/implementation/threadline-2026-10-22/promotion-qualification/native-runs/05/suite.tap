                              "default": "Shop now"
                            },
                            {
                              "id": "ctaLink",
                              "type": "url",
                              "label": "Button link",
                              "default": "/products"
                            }
                          ],
                          "blocks": [],
                          "presets": [
                            {
                              "name": "Call to Action",
                              "settings": {},
                              "blocks": []
