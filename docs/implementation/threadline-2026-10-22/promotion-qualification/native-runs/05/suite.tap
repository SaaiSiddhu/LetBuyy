                    about-section:
                      path: 'sections/about-section.liquid'
                      schema:
                        tag: 'section'
                        name: 'About Section'
                        blocks:
                        presets:
                          0:
                            name: 'About Section'
                            blocks:
                            settings:
                        settings:
                          0:
                            id: 'title'
                            type: 'text'
                            label: 'Title'
                            default: 'About us'
                          1:
                            id: 'content'
                            type: 'richtext'
                            label: 'Content'
                          2:
                            id: 'imageUrl'
                            type: 'image'
                            label: 'Image'
                          3:
                            id: 'layout'
                            type: 'select'
                            label: 'Layout'
                            default: 'left'
                            options:
                              0: 'left'
                              1: 'right'
                              2: 'center'
                        enabled_on:
                          templates:
                            0: '*'
                        disabled_on:
                          templates:
                      source: |-
                        {% assign layout_value = section.settings.layout | default: 'left' %}
                        <section class="lb-about-section lb-about-section--layout-{{ layout_value }}" data-section-id="{{ section.id }}">
