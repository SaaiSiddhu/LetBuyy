                        name: 'Apparel'
                        slug: 'apparel'
                        tagline: 'Daily fits'
                    2:
                      id: 'category-accessories'
                      type: 'category'
                      order: 2
                      visible: true
                      settings:
                        name: 'Accessories'
                        slug: 'accessories'
                        tagline: 'Finish the look'
                  visible: true
                  settings:
                    title: 'Shop by style'
                    columns: 3
                    subtitle: 'Launch-ready groupings for daily buyers.'
                    cardStyle: 'overlay'
                3:
                  id: 'featured-collection-default'
                  type: 'featuredProducts'
                  order: 30
                  visible: true
                  settings:
                    limit: 4
                    title: 'Drop-ready collection'
                    columns: 4
                    subtitle: 'Curated items for the first storefront launch.'
                    showViewAll: true
                    viewAllLabel: 'View collection'
                    collectionHandle: 'new-arrivals'
                    productCardStyle: 'editorial'
                4:
                  id: 'product-grid-default'
                  type: 'productGrid'
                  order: 40
                  visible: true
                  settings:
                    rows: 2
                    title: 'Featured Products'
                    sortBy: 'newest'
                    columns: 4
                    subtitle: 'Products selected from your catalog'
                    cardStyle: 'minimal'
                    showPrice: true
                    showTitle: true
                    showRating: true
                    columnsMobile: 2
                    columnsTablet: 3
                    showAddToCart: true
                5:
                  id: 'newsletter-default'
                  type: 'newsletter'
                  order: 50
                  visible: true
                  settings:
                    title: 'Stay in the Loop'
                    subtitle: 'Get early access to new drops and exclusive discounts.'
                    buttonText: 'Subscribe'
                    placeholder: 'Enter your email'
                    successMessage: 'Thanks for subscribing!'
            experienceId: 'dawn'
            liquidBundle:
              blocks:
                badge:
                  path: 'blocks/badge.liquid'
                  schema:
                    name: 'Badge'
                    presets:
                    settings:
                      0:
                        id: 'label'
                        type: 'text'
                        label: 'Label'
                        default: 'New'
                  source: '<span class="lb-badge" data-block-id="{{ block.id }}">{{ block.settings.label }}</span>'
              config:
                settings_data:
                  current:
                    textColor: '#2C2C2C'
                    faviconUrl: ''
                    fontFamily: 'Source Sans Pro'
                    accentColor: '#C0832B'
                    borderRadius: 4
                    primaryColor: '#3B4F6B'
                    surfaceColor: '#FDF6EC'
                    bodyFontFamily: 'Source Sans Pro'
                    secondaryColor: '#2C3E50'
                    socialImageUrl: ''
                    backgroundColor: '#FFFFFF'
                    metaDescription: ''
                    headingFontFamily: 'Libre Baskerville'
                  presets:
                    Aura:
                      textColor: '#2D1B22'
                      accentColor: '#D4AF7A'
                      borderRadius: 16
                      primaryColor: '#C2798B'
                      surfaceColor: '#FFF8F9'
                      bodyFontFamily: 'Lato'
                      secondaryColor: '#9E5A6F'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Cormorant Garamond'
                    Dawn:
                      textColor: '#2C2C2C'
                      accentColor: '#C0832B'
                      borderRadius: 4
                      primaryColor: '#3B4F6B'
                      surfaceColor: '#FDF6EC'
                      bodyFontFamily: 'Source Sans Pro'
                      secondaryColor: '#2C3E50'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Libre Baskerville'
                    Nova:
                      textColor: '#1A1A2E'
                      accentColor: '#F59E0B'
                      borderRadius: 10
                      primaryColor: '#8B5CF6'
                      surfaceColor: '#F8FAFC'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#6D28D9'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Ride:
                      textColor: '#111111'
                      accentColor: '#FFD100'
                      borderRadius: 6
                      primaryColor: '#FF4D00'
                      surfaceColor: '#F5F5F5'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1C1C1C'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Bloom:
                      textColor: '#2C1A0A'
                      accentColor: '#4CAF73'
                      borderRadius: 14
                      primaryColor: '#E07B39'
                      surfaceColor: '#FFF9F0'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#B55E24'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Craft:
                      textColor: '#2C1B12'
                      accentColor: '#8D6E63'
                      borderRadius: 6
                      primaryColor: '#3E2723'
                      surfaceColor: '#FFF8F0'
                      bodyFontFamily: 'Source Sans Pro'
                      secondaryColor: '#5D3B2E'
