                  order:
                    0: 'page-content-default'
                  layout: 'theme'
                  sections:
                    page-content-default:
                      type: 'page-content'
                      blocks:
                      disabled: false
                      settings:
                      block_order:
                index:
                  name: 'LetBuyy Core home page'
                  order:
                    0: 'banner-carousel-default'
                    1: 'hero-default'
                    2: 'category-grid-default'
                    3: 'featured-collection-default'
                    4: 'product-grid-default'
                    5: 'video-hero-default'
                    6: 'spotlight-default'
                    7: 'testimonials-default'
                    8: 'newsletter-default'
                  layout: 'theme'
                  sections:
                    hero-default:
                      type: 'hero-banner'
                      blocks:
                      disabled: false
                      settings:
                        height: 'full'
