                        default: true
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-collection-banner" data-section-id="{{ section.id }}">
                      {% if collection.image_url != blank %}<img class="lb-collection-banner__image" src="{{ collection.image_url | image_url }}" alt="{{ collection.title }}">{% endif %}
                      <h1>{{ collection.title }}</h1>
                      {% if collection.products.size > 0 %}<p class="lb-collection-banner__count">{{ collection.products.size }} products</p>{% endif %}
                      {% if section.settings.showDescription and collection.description %}<div class="lb-collection-banner__desc">{{ collection.description }}</div>{% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Collection Banner","tag":"section","settings":[{"type":"toggle","label":"Show description","default":true,"id":"showDescription"}],"blocks":[],"presets":[{"name":"Collection Banner","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                collection-filter:
                  path: 'sections/collection-filter.liquid'
                  schema:
                    tag: 'section'
                    name: 'Apparel discovery'
                    blocks:
                    presets:
                      0:
                        name: 'Apparel discovery'
                        blocks:
                        settings:
                    settings:
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="tl-theme" data-section-id="{{ section.id }}"><div class="tl-wrap tl-section"><span class="tl-eyebrow">THE EVERYDAY COLLECTION</span><h1>{{ collection.title | default: 'Clothing' }}</h1>{% if collection.total != nil %}<p>{{ collection.total }} products</p>{% endif %}<form class="tl-filters" method="get" action="{{ request.path }}"><label>Size<input type="text" name="size" value="{{ request.query.size }}" maxlength="100" placeholder="Size label"></label><label>Color<input type="text" name="color" value="{{ request.query.color }}" maxlength="100" placeholder="Color name"></label><label>Minimum price<input type="number" min="0" step="0.01" name="min_price" value="{{ request.query.min_price }}"></label><label>Maximum price<input type="number" min="0" step="0.01" name="max_price" value="{{ request.query.max_price }}"></label><label>Sort<select name="sort"><option value="display_order"{% if request.query.sort == 'display_order' %} selected{% endif %}>Featured</option><option value="price-asc"{% if request.query.sort == 'price-asc' %} selected{% endif %}>Price: low to high</option><option value="price-desc"{% if request.query.sort == 'price-desc' %} selected{% endif %}>Price: high to low</option><option value="newest"{% if request.query.sort == 'newest' %} selected{% endif %}>Newest</option><option value="name"{% if request.query.sort == 'name' %} selected{% endif %}>Name</option></select></label>{% if request.query.search %}<input type="hidden" name="search" value="{{ request.query.search }}">{% endif %}{% if request.query.category %}<input type="hidden" name="category" value="{{ request.query.category }}">{% endif %}{% if request.query.country_of_origin %}<input type="hidden" name="country_of_origin" value="{{ request.query.country_of_origin }}">{% endif %}<button class="tl-button" type="submit">Apply filters</button><a class="tl-link" href="{{ request.path }}">Clear filters</a></form><p class="tl-outfit-note">Size and color match the same available variant.</p></div></section>
                    {% schema %}
                    {"name":"Apparel discovery","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Apparel discovery","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                customer-register:
                  path: 'sections/customer-register.liquid'
                  schema:
                    tag: 'section'
                    name: 'Customer Register'
