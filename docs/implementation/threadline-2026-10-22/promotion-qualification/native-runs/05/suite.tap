          id: '7b669c70-0000-4000-8000-000000000005'
          name: 'Refresh'
          slug: 'letbuyy-refresh'
          tags:
            0: 'first-party'
            1: 'refresh'
          price: 0
          author: 'LetBuyy'
          config:
            colors:
              text: '#1B2521'
              accent: '#F4A261'
              primary: '#2D6A4F'
              background: '#FFFFFF'
            preset_id: 'refresh'
          layout: 'standard'
          version: '1.0.0'
          category: 'food'
          demo_url: ~
          features:
            0: 'Responsive layouts'
            1: 'Visual editor'
