                      headingFontFamily: 'Libre Baskerville'
                    Forge:
                      textColor: '#1A202C'
                      accentColor: '#00B4D8'
                      borderRadius: 8
                      primaryColor: '#1E3A5F'
                      surfaceColor: '#F0F4F8'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1E40AF'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Sense:
                      textColor: '#1A1A2E'
                      accentColor: '#E63946'
                      borderRadius: 4
                      primaryColor: '#1A1A2E'
                      surfaceColor: '#FAFAFA'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#2D2D44'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Playfair Display'
                    Summit:
                      textColor: '#1A1A2E'
                      accentColor: '#A4E500'
                      borderRadius: 12
                      primaryColor: '#00B3B3'
                      surfaceColor: '#F9FAFB'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#008080'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Refresh:
                      textColor: '#1B2521'
                      accentColor: '#F4A261'
                      borderRadius: 10
                      primaryColor: '#2D6A4F'
                      surfaceColor: '#F8FFF4'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1B4332'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                settings_schema:
                  settings:
                    seo:
                      label: 'SEO and social'
                      fields:
                        faviconUrl:
                          info: 'Rendered as <link rel="icon">. Left empty until the merchant uploads one.'
                          type: 'url'
                          label: 'Favicon URL'
                          default: ''
                        socialImageUrl:
                          info: 'Used for og:image and twitter:image. Left empty until the merchant uploads one.'
                          type: 'url'
                          label: 'Social share image URL'
                          default: ''
                        metaDescription:
                          info: 'Falls back to the shop description. Truncated to 160 characters on output.'
                          type: 'textarea'
                          label: 'Meta description'
                          default: ''
                          maxLength: 160
                      description: 'Metadata rendered into <head> by the theme layout.'
                    colors:
                      label: 'Colors'
                      fields:
                        textColor:
                          type: 'color'
                          label: 'Text color'
                          default: '#1F2937'
                        accentColor:
                          type: 'color'
                          label: 'Accent color'
                          default: '#F59E0B'
                        primaryColor:
                          type: 'color'
                          label: 'Primary color'
                          default: '#8B5CF6'
                        surfaceColor:
                          type: 'color'
                          label: 'Surface color'
                          default: '#F8FAFC'
                        secondaryColor:
                          type: 'color'
                          label: 'Secondary color'
                          default: '#3B82F6'
                        backgroundColor:
                          type: 'color'
                          label: 'Background color'
                          default: '#FFFFFF'
                      description: 'LetBuyy Core storefront color tokens.'
                    appearance:
                      label: 'Appearance'
                      fields:
                        borderRadius:
                          type: 'number'
                          label: 'Corner radius'
                          default: 12
                      description: 'Layout tokens shared by every section.'
                    typography:
                      label: 'Typography'
                      fields:
                        bodyFontFamily:
                          type: 'text'
                          label: 'Body font'
                          default: 'Inter'
                        headingFontFamily:
                          type: 'text'
                          label: 'Heading font'
                          default: 'Inter'
                      description: 'First-party type settings mirrored from the JSON-contract LetBuyy Core theme.'
                  schema_version: '2026-05-json-contract'
              layout:
                theme:
                  path: 'layout/theme.liquid'
                  source: |-
                    <!doctype html>
                    <html lang="{{ request.locale | default: "en" }}">
                    <head>
                      <meta charset="utf-8">
                      <meta name="viewport" content="width=device-width, initial-scale=1">
                      {% assign lb_page_title = shop.name %}
                      {% assign lb_meta_description = settings.metaDescription | default: shop.description | strip_html | truncate: 160 %}
                      <title>{{ lb_page_title }}</title>
                      {% if lb_meta_description != blank %}<meta name="description" content="{{ lb_meta_description }}">{% endif %}
                      <meta name="twitter:card" content="{% if settings.socialImageUrl != blank %}summary_large_image{% else %}summary{% endif %}">
                      <meta name="twitter:title" content="{{ lb_page_title }}">
                      {% if lb_meta_description != blank %}<meta name="twitter:description" content="{{ lb_meta_description }}">{% endif %}
                      {% if settings.socialImageUrl != blank %}<meta name="twitter:image" content="{{ settings.socialImageUrl | image_url }}">{% endif %}
                      <style data-lb-layout="1">
                        :root{--lb-focus-ring-width:2px;--lb-focus-ring-color:var(--accent,#2563eb);--lb-focus-offset:2px;--lb-space-sm:0.5rem;--lb-space-md:0.75rem;--lb-space-lg:1rem;--lb-radius-sm:0.375rem;--lb-layout-max:72rem;--lb-layout-gutter:1rem;--lb-layout-breakpoint:48em;}
                        .lb-theme :where(a,button,input,select,textarea,summary,details,[tabindex]):focus-visible{outline:var(--lb-focus-ring-width) solid var(--lb-focus-ring-color);outline-offset:var(--lb-focus-offset);}
                        .lb-skip-link{position:absolute;left:-9999px;top:0;z-index:100;padding:var(--lb-space-md) var(--lb-space-lg);border-radius:var(--lb-radius-sm);background:var(--surface,#f8fafc);color:var(--foreground,#1a1a2e);font-weight:600;}
                        .lb-skip-link:focus,.lb-skip-link:focus-visible{left:var(--lb-space-lg);top:var(--lb-space-lg);}
                        .lb-layout__header,.lb-layout__footer{display:flex;flex-direction:column;align-items:flex-start;gap:var(--lb-space-md);margin-inline:auto;max-width:min(var(--lb-layout-max),calc(100vw - var(--lb-layout-gutter) * 2));padding-block:var(--lb-space-lg);padding-inline:var(--lb-layout-gutter);}
                        .lb-layout__brand{font-family:var(--font-display,inherit);font-weight:700;}
                        .lb-layout__nav{display:flex;flex-wrap:wrap;gap:var(--lb-space-md);}
                        .lb-layout__legal{margin:0;font-size:0.875rem;}
                        @media (min-width:48em){.lb-layout__header,.lb-layout__footer{flex-direction:row;align-items:center;justify-content:space-between;}}
                      </style>
                      {{ content_for_header | raw }}
                    </head>
                    <body class="lb-theme lb-theme--letbuyy-core">
                      <a class="lb-skip-link" href="#MainContent">Skip to content</a>
                      <header class="lb-layout__header">
                        <a class="lb-layout__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
                        <nav class="lb-layout__nav" aria-label="Primary">
                          {% if linklists.main_menu.links.size > 0 %}{% for link in linklists.main_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
                          {% else %}<a href="{{ routes.all_products_collection_url }}">Products</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a><a href="{{ routes.account_url }}">Account</a>{% endif %}
                        </nav>
                      </header>
                      <main id="MainContent">
                        {{ content_for_layout | raw }}
                      </main>
                      <footer class="lb-layout__footer">
                        {% if linklists.footer.links.size > 0 %}<nav class="lb-layout__nav" aria-label="Footer">{% for link in linklists.footer.links %}<a href="{{ link.url | store_url }}">{{ link.title }}</a>{% endfor %}</nav>{% endif %}
                        <p class="lb-layout__legal">&copy; {{ shop.name }}</p>
                      </footer>
                      {{ content_for_footer | raw }}
                    </body>
                    </html>
              locales:
                en:
                  general:
                    cart: 'Cart'
              package:
                name: 'Dawn'
                slug: 'letbuyy-dawn'
                price: 0
                status: 'active'
                version: '1.0.0'
                currency: 'INR'
                site_types:
                  0: 'store'
                author_name: 'LetBuyy'
                description: 'First-party LetBuyy Core storefront converted to portable Liquid sections and blocks.'
                pricing_type: 'free'
                release_status: 'published'
                version_number: 1
                compatibility_range: '>=2026-06-liquid-sections'
              renderer:
                assets:
                engine: 'liquid'
                liquid_ready: true
                renderer_version: '0.1.0'
              sections:
                footer:
                  path: 'sections/footer.liquid'
                  schema:
                    tag: 'section'
                    name: 'Footer'
                    blocks:
                      0:
                        name: 'Link'
                        type: 'link'
                        settings:
                          0:
                            id: 'label'
                            type: 'text'
                            label: 'Label'
                          1:
                            id: 'href'
                            type: 'url'
                            label: 'URL'
                    presets:
                      0:
                        name: 'Footer'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'storeName'
                        type: 'text'
                        label: 'Store name'
                      1:
                        id: 'tagline'
                        type: 'text'
                        label: 'Tagline'
                      2:
                        id: 'contactEmail'
                        type: 'text'
                        label: 'Contact email'
                      3:
                        id: 'contactPhone'
                        type: 'text'
                        label: 'Contact phone'
                      4:
                        id: 'instagramUrl'
                        type: 'url'
                        label: 'Instagram URL'
                      5:
                        id: 'facebookUrl'
                        type: 'url'
                        label: 'Facebook URL'
                      6:
                        id: 'twitterUrl'
                        type: 'url'
                        label: 'Twitter/X URL'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <footer class="lb-footer" data-section-id="{{ section.id }}">
                      <div class="lb-footer__grid">
                        <div class="lb-footer__brand">
                          <h3>{{ section.settings.storeName | default: shop.name }}</h3>
                          {% if section.settings.tagline %}<p>{{ section.settings.tagline }}</p>{% endif %}
                          {% if section.settings.instagramUrl != blank or section.settings.facebookUrl != blank or section.settings.twitterUrl != blank %}
                          <div class="lb-footer__social">
                            {% if section.settings.instagramUrl != blank %}<a href="{{ section.settings.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a>{% endif %}
                            {% if section.settings.facebookUrl != blank %}<a href="{{ section.settings.facebookUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 4h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path></svg></a>{% endif %}
                            {% if section.settings.twitterUrl != blank %}<a href="{{ section.settings.twitterUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="4" x2="20" y2="20"></line><line x1="20" y1="4" x2="4" y2="20"></line></svg></a>{% endif %}
                          </div>
                          {% endif %}
                        </div>
                        {% if section.blocks.size > 0 %}
                        <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}</nav></div>
                        {% elsif linklists.footer_menu.links.size > 0 %}
                        <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for link in linklists.footer_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}</nav></div>
                        {% endif %}
                        {% if shop.policies.size > 0 %}<div class="lb-footer__col">
                          <h4>Policies</h4>
                          <nav>
                            {% if shop.policies contains 'privacy' %}<a href="{{ routes.root_url }}/privacy">Privacy policy</a>{% endif %}
                            {% if shop.policies contains 'terms' %}<a href="{{ routes.root_url }}/terms">Terms of service</a>{% endif %}
                            {% if shop.policies contains 'shipping' %}<a href="{{ routes.root_url }}/shipping">Shipping policy</a>{% endif %}
                            {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}<a href="{{ routes.root_url }}/returns">Returns policy</a>{% endif %}
                          </nav>
                        </div>{% endif %}
                        <div class="lb-footer__col">
                          <h4>Contact</h4>
                          {% if section.settings.contactEmail != blank %}<p><a href="mailto:{{ section.settings.contactEmail }}">{{ section.settings.contactEmail }}</a></p>{% endif %}
                          {% if section.settings.contactPhone != blank %}<p><a href="tel:{{ section.settings.contactPhone }}">{{ section.settings.contactPhone }}</a></p>{% endif %}
                          <a href="{{ routes.contact_url }}">Contact us</a>
                        </div>
                      </div>
                      <div class="lb-footer__bottom">
                        <p>&copy; {{ shop.name }}. All rights reserved.</p>
                        <a class="lb-footer__watermark" href="https://letbuyy.com" target="_blank" rel="noopener noreferrer">Powered by LetBuyy</a>
                      </div>
                    </footer>
                    {% schema %}
                    {
                      "name": "Footer",
                      "settings": [
                        {
                          "id": "storeName",
                          "type": "text",
                          "label": "Store name"
                        },
                        {
                          "id": "tagline",
                          "type": "text",
                          "label": "Tagline"
                        },
                        {
                          "id": "contactEmail",
                          "type": "text",
                          "label": "Contact email"
                        },
                        {
                          "id": "contactPhone",
                          "type": "text",
                          "label": "Contact phone"
                        },
                        {
                          "id": "instagramUrl",
                          "type": "url",
                          "label": "Instagram URL"
                        },
                        {
                          "id": "facebookUrl",
                          "type": "url",
                          "label": "Facebook URL"
                        },
                        {
                          "id": "twitterUrl",
                          "type": "url",
                          "label": "Twitter/X URL"
                        }
                      ],
                      "blocks": [
                        {
                          "type": "link",
                          "name": "Link",
                          "settings": [
                            {
                              "id": "label",
                              "type": "text",
                              "label": "Label"
                            },
                            {
                              "id": "href",
                              "type": "url",
                              "label": "URL"
                            }
                          ]
                        }
                      ],
                      "presets": [
                        {
                          "name": "Footer",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                header:
                  path: 'sections/header.liquid'
                  schema:
                    tag: 'section'
                    name: 'Header'
                    blocks:
                      0:
                        name: 'Link'
                        type: 'link'
                        settings:
                          0:
                            id: 'label'
                            type: 'text'
                            label: 'Label'
                          1:
                            id: 'href'
                            type: 'url'
                            label: 'URL'
                    presets:
                      0:
                        name: 'Header'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'storeName'
                        type: 'text'
                        label: 'Store name'
                      1:
                        id: 'showSearch'
                        type: 'toggle'
                        label: 'Show search'
                        default: true
                      2:
                        id: 'showCart'
                        type: 'toggle'
                        label: 'Show cart'
                        default: true
                      3:
                        id: 'behavior'
                        type: 'select'
                        label: 'Header behavior'
                        default: 'sticky'
                        options:
                          0: 'static'
                          1: 'sticky'
                      4:
                        id: 'menu'
                        type: 'select'
                        label: 'Menu'
                        default: 'main_menu'
                        options:
                          0: 'main_menu'
                          1: 'footer_menu'
                          2: 'policy_menu'
                      5:
                        id: 'layout'
                        type: 'select'
                        label: 'Layout'
                        default: 'inline'
                        options:
                          0: 'inline'
                          1: 'centered'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <header class="lb-header" data-section-id="{{ section.id }}" data-sticky="{% if section.settings.behavior == 'sticky' %}true{% else %}false{% endif %}" data-layout="{{ section.settings.layout | default: 'inline' }}">
                      <div class="lb-header__inner">
                        <lb-mobile-nav class="lb-mobile-nav" data-lb-island="mobile-nav">
                          <button type="button" class="lb-header__toggle" data-lb-nav-toggle aria-expanded="false" aria-controls="lb-nav-panel-{{ section.id }}" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg><span class="lb-sr-only">Menu</span></button>
                          <nav class="lb-header__nav" data-lb-nav-panel id="lb-nav-panel-{{ section.id }}" aria-label="Primary">
                            <div class="lb-header__nav-head"><span class="lb-header__nav-head-brand">{{ section.settings.storeName | default: shop.name }}</span><button type="button" class="lb-header__nav-close" data-lb-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close menu</span></button></div>
                            <div class="lb-header__nav-links">
                            {% if section.blocks.size > 0 %}
                              {% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}
                            {% else %}
                              {% assign lb_menu_handle = section.settings.menu | default: 'main_menu' %}
                              {% assign lb_nav_links = linklists[lb_menu_handle].links %}
                              {% for link in lb_nav_links %}
                                {% if link.links.size > 0 %}
                                <details class="lb-header__nav-item" data-lb-nav-dropdown><summary{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lb-icon-chevron"><path d="M6 9l6 6 6-6"></path></svg></summary>
                                  <div class="lb-header__nav-submenu">{% for child in link.links %}<a href="{{ child.url | store_url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>
                                </details>
                                {% else %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}
                              {% endfor %}
                            {% endif %}
                            </div>
                            <div class="lb-header__nav-foot">
                              {% if customer %}<a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Account</span></a>{% else %}<a href="{{ routes.customer_login_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Log in</span></a>{% endif %}
                            </div>
                          </nav>
                          <div class="lb-header__scrim" data-lb-nav-scrim></div>
                        </lb-mobile-nav>
                        <a class="lb-header__brand" href="{{ routes.root_url }}">
                          {% if shop.logo_url %}<img class="lb-header__logo" src="{{ shop.logo_url | image_url }}" alt="{{ section.settings.storeName | default: shop.name }}">{% else %}{{ section.settings.storeName | default: shop.name }}{% endif %}
                        </a>
                        <div class="lb-header__actions">
                          {% if section.settings.showSearch %}<button type="button" class="lb-header__search-toggle" data-lb-search-toggle aria-expanded="false" aria-controls="lb-search-overlay-{{ section.id }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>{% endif %}
                          <a class="lb-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.customer_login_url }}{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span class="lb-sr-only">{% if customer %}Account{% else %}Log in{% endif %}</span></a>
                          {% if section.settings.showCart %}<a class="lb-header__cart" href="{{ routes.cart_url }}" data-lb-cart-trigger><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2l2 12h11l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="lb-sr-only">{{ "general.cart" | t }}</span> (<span data-lb-cart-count>{{ cart.item_count | default: 0 }}</span>)</a>{% endif %}
                        </div>
                      </div>
                      {% if section.settings.showSearch %}
                      <div class="lb-header__search-overlay" id="lb-search-overlay-{{ section.id }}" data-lb-search-overlay hidden>
                        <lb-predictive-search class="lb-predictive-search" data-lb-island="predictive-search" data-search-url="{{ routes.search_url }}">
                          <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                            <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                            <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="Search products" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lb-search-results-{{ section.id }}" aria-autocomplete="list">
                            <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                            <button type="button" data-lb-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close search</span></button>
                          </form>
                          <div id="lb-search-results-{{ section.id }}" class="lb-predictive-search__results" data-lb-search-results role="listbox" aria-live="polite"></div>
                        </lb-predictive-search>
                      </div>
                      {% endif %}
                    </header>
                    {% schema %}
                    {
                      "name": "Header",
                      "settings": [
                        {
                          "id": "storeName",
                          "type": "text",
                          "label": "Store name"
                        },
                        {
                          "id": "showSearch",
                          "type": "toggle",
                          "label": "Show search",
                          "default": true
                        },
                        {
                          "id": "showCart",
                          "type": "toggle",
                          "label": "Show cart",
                          "default": true
                        },
                        {
                          "id": "behavior",
                          "type": "select",
                          "label": "Header behavior",
                          "default": "sticky",
                          "options": [
                            "static",
                            "sticky"
                          ]
                        },
                        {
                          "id": "menu",
                          "type": "select",
                          "label": "Menu",
                          "default": "main_menu",
                          "options": [
                            "main_menu",
                            "footer_menu",
                            "policy_menu"
                          ]
                        },
                        {
                          "id": "layout",
                          "type": "select",
                          "label": "Layout",
                          "default": "inline",
                          "options": [
                            "inline",
                            "centered"
                          ]
                        }
                      ],
                      "blocks": [
                        {
                          "type": "link",
                          "name": "Link",
                          "settings": [
                            {
                              "id": "label",
                              "type": "text",
                              "label": "Label"
                            },
                            {
                              "id": "href",
                              "type": "url",
                              "label": "URL"
                            }
                          ]
                        }
                      ],
                      "presets": [
                        {
                          "name": "Header",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                marquee:
                  path: 'sections/marquee.liquid'
                  schema:
                    tag: 'section'
                    name: 'Marquee'
                    blocks:
                    presets:
                      0:
                        name: 'Marquee'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'text'
                        type: 'text'
                        label: 'Text'
                        default: 'Featured announcement'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-marquee" data-section-id="{{ section.id }}">
                      <p>{{ section.settings.text }}</p>
                    </section>
                    {% schema %}
                    {
                      "name": "Marquee",
                      "settings": [
                        {
                          "id": "text",
                          "type": "text",
                          "label": "Text",
                          "default": "Featured announcement"
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Marquee",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                404-page:
                  path: 'sections/404-page.liquid'
                  schema:
                    tag: 'section'
                    name: '404 Not Found'
                    blocks:
                    presets:
                      0:
                        name: '404 Not Found'
                        blocks:
                        settings:
                    settings:
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-404" data-section-id="{{ section.id }}">
                      <h1 class="lb-404__code">404</h1>
                      <p class="lb-404__message">Page not found</p>
                      <a class="lb-404__home" href="{{ routes.root_url }}">Back to home</a>
                    </section>
                    {% schema %}
                    {
                      "name": "404 Not Found",
                      "settings": [],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "404 Not Found",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                spotlight:
                  path: 'sections/spotlight.liquid'
                  schema:
                    tag: 'section'
                    name: 'Spotlight'
                    blocks:
                      0:
                        name: 'Badge'
                        type: 'badge'
                        settings:
                      1:
                        name: 'App block'
                        type: '@app'
                        settings:
                    presets:
                      0:
                        name: 'Spotlight'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Made for daily buyers'
                      1:
                        id: 'subheading'
                        type: 'text'
                        label: 'Subheading'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-first-party-spotlight" data-section-id="{{ section.id }}">
                      <p>{{ section.settings.subheading }}</p>
                      <h2>{{ section.settings.heading }}</h2>
                      <div class="lb-first-party-spotlight__blocks">
                        {% for block in section.blocks %}
                          {{ block.content | raw }}
                        {% endfor %}
                      </div>
                    </section>
                    {% schema %}
                    {
                      "name": "Spotlight",
                      "settings": [
                        { "id": "heading", "type": "text", "label": "Heading", "default": "Made for daily buyers" },
                        { "id": "subheading", "type": "text", "label": "Subheading" }
                      ],
                      "blocks": [
                        { "type": "badge", "name": "Badge" },
                        { "type": "@app", "name": "App block" }
                      ],
                      "presets": [{ "name": "Spotlight" }]
                    }
                    {% endschema %}
                search-box:
                  path: 'sections/search-box.liquid'
                  schema:
                    tag: 'section'
                    name: 'Search'
                    blocks:
                    presets:
                      0:
                        name: 'Search'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'placeholder'
                        type: 'text'
                        label: 'Placeholder'
                        default: 'Search products'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-search" data-section-id="{{ section.id }}">
                      <lb-search data-lb-island="search" data-search-url="{{ routes.search_url }}">
                        <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                          <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                          <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="{{ section.settings.placeholder }}" aria-label="Search products" value="{{ search.terms }}">
                          <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                        </form>
                      </lb-search>
                      {% if search.terms %}<p class="lb-search__terms">Results for "{{ search.terms }}"</p>{% endif %}
                    </section>
                    {% schema %}
                    {
                      "name": "Search",
                      "settings": [
                        {
                          "id": "placeholder",
                          "type": "text",
                          "label": "Placeholder",
                          "default": "Search products"
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Search",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                video-hero:
                  path: 'sections/video-hero.liquid'
                  schema:
                    tag: 'section'
                    name: 'Video Hero'
                    blocks:
                    presets:
                      0:
                        name: 'Video Hero'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'See the fit in motion'
                      1:
                        id: 'subheading'
                        type: 'textarea'
                        label: 'Subheading'
                        default: 'A quick look at how each drop moves, from the box to your feet.'
                      2:
                        id: 'videoUrl'
                        info: 'A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.'
                        type: 'url'
                        label: 'Video embed URL'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-video-hero" data-section-id="{{ section.id }}">
                      <div class="lb-video-hero__copy">
                        <h2 class="lb-video-hero__heading">{{ section.settings.heading }}</h2>
                        {% if section.settings.subheading %}<p class="lb-video-hero__subheading">{{ section.settings.subheading }}</p>{% endif %}
                      </div>
                      {% if section.settings.videoUrl != blank %}<div class="lb-video-hero__embed"><iframe src="{{ section.settings.videoUrl | video_url }}" title="{{ section.settings.heading }}" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allowfullscreen></iframe></div>{% endif %}
                    </section>
                    {% schema %}
                    {
                      "name": "Video Hero",
                      "settings": [
                        {
                          "id": "heading",
                          "type": "text",
                          "label": "Heading",
                          "default": "See the fit in motion"
                        },
                        {
                          "id": "subheading",
                          "type": "textarea",
                          "label": "Subheading",
                          "default": "A quick look at how each drop moves, from the box to your feet."
                        },
                        {
                          "id": "videoUrl",
                          "type": "url",
                          "label": "Video embed URL",
                          "info": "A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video."
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Video Hero",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                cta-section:
                  path: 'sections/cta-section.liquid'
                  schema:
                    tag: 'section'
                    name: 'Call to Action'
                    blocks:
                    presets:
                      0:
                        name: 'Call to Action'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Ready to get started?'
                      1:
                        id: 'subheading'
                        type: 'text'
                        label: 'Subheading'
                      2:
                        id: 'ctaText'
                        type: 'text'
                        label: 'Button text'
                        default: 'Shop now'
                      3:
                        id: 'ctaLink'
                        type: 'url'
                        label: 'Button link'
                        default: '/products'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-cta-section" data-section-id="{{ section.id }}">
                      <h2>{{ section.settings.heading }}</h2>
                      <p>{{ section.settings.subheading }}</p>
                      <a href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>
                    </section>
                    {% schema %}
                    {
                      "name": "Call to Action",
                      "settings": [
                        {
                          "id": "heading",
                          "type": "text",
                          "label": "Heading",
                          "default": "Ready to get started?"
                        },
                        {
                          "id": "subheading",
                          "type": "text",
                          "label": "Subheading"
                        },
                        {
                          "id": "ctaText",
                          "type": "text",
                          "label": "Button text",
                          "default": "Shop now"
                        },
                        {
                          "id": "ctaLink",
                          "type": "url",
                          "label": "Button link",
                          "default": "/products"
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Call to Action",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                hero-banner:
                  path: 'sections/hero-banner.liquid'
                  schema:
                    tag: 'section'
                    name: 'Hero Banner'
                    blocks:
                    presets:
                      0:
                        name: 'Hero Banner'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'eyebrow'
                        type: 'text'
                        label: 'Eyebrow'
                        default: 'New season essentials'
                      1:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Fresh drops for daily buyers'
                      2:
                        id: 'subheading'
                        type: 'textarea'
                        label: 'Subheading'
                      3:
                        id: 'ctaText'
                        type: 'text'
                        label: 'Button text'
                        default: 'Shop Now'
                      4:
                        id: 'ctaLink'
                        type: 'url'
                        label: 'Button link'
                        default: '/products'
                      5:
                        id: 'image'
                        type: 'image'
                        label: 'Background Image'
                      6:
                        id: 'overlay'
                        max: 1
                        min: 0
                        step: 0.1
                        type: 'range'
                        label: 'Overlay Opacity'
                        default: 0.4
                      7:
                        id: 'height'
                        type: 'select'
                        label: 'Height'
                        default: 'full'
                        options:
                          0: 'full'
                          1: 'large'
                          2: 'medium'
                          3: 'small'
                      8:
                        id: 'textAlign'
                        type: 'select'
                        label: 'Text Alignment'
                        default: 'center'
                        options:
                          0: 'left'
                          1: 'center'
                          2: 'right'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    {% assign overlay_value = section.settings.overlay | default: 0.4 %}
                    {% assign height_value = section.settings.height | default: 'full' %}
                    {% assign align_value = section.settings.textAlign | default: 'center' %}
                    <section class="lb-hero-banner lb-hero-banner--height-{{ height_value }} lb-hero-banner--align-{{ align_value }}" data-section-id="{{ section.id }}" data-height="{{ height_value }}" data-text-align="{{ align_value }}">
                      {% if section.settings.image %}<img class="lb-hero-banner__bg-image" src="{{ section.settings.image | image_url }}" data-image-url="{{ section.settings.image | image_url }}" data-overlay="{{ overlay_value }}" alt="">{% endif %}
                      {% if section.settings.eyebrow %}<p class="lb-hero-banner__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
                      <h1 class="lb-hero-banner__heading">{{ section.settings.heading }}</h1>
                      {% if section.settings.subheading %}<p class="lb-hero-banner__subheading">{{ section.settings.subheading }}</p>{% endif %}
                      <a href="{{ section.settings.ctaLink | store_url }}" class="lb-hero-banner__cta">{{ section.settings.ctaText }}</a>
                    </section>
                    {% schema %}
                    {
                      "name": "Hero Banner",
                      "settings": [
                        { "id": "eyebrow", "type": "text", "label": "Eyebrow", "default": "New season essentials" },
                        { "id": "heading", "type": "text", "label": "Heading", "default": "Fresh drops for daily buyers" },
                        { "id": "subheading", "type": "textarea", "label": "Subheading" },
                        { "id": "ctaText", "type": "text", "label": "Button text", "default": "Shop Now" },
                        { "id": "ctaLink", "type": "url", "label": "Button link", "default": "/products" },
                        { "id": "image", "type": "image", "label": "Background Image" },
                        { "id": "overlay", "type": "range", "label": "Overlay Opacity", "default": 0.4, "min": 0, "max": 1, "step": 0.1 },
                        { "id": "height", "type": "select", "label": "Height", "options": ["full", "large", "medium", "small"], "default": "full" },
                        { "id": "textAlign", "type": "select", "label": "Text Alignment", "options": ["left", "center", "right"], "default": "center" }
                      ],
                      "blocks": [],
                      "presets": [{ "name": "Hero Banner" }]
                    }
                    {% endschema %}
                blog-listing:
                  path: 'sections/blog-listing.liquid'
                  schema:
                    tag: 'section'
                    name: 'Blog Listing'
                    blocks:
                    presets:
                      0:
                        name: 'Blog Listing'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Our Blog'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-blog-listing" data-section-id="{{ section.id }}">
                      <h1 class="lb-blog-listing__heading">{{ section.settings.heading }}</h1>
                      {% if blog.articles and blog.articles.size > 0 %}
                      <div class="lb-blog-listing__articles">
                        {% for article in blog.articles %}
                        <article class="lb-blog-article-card">
                          <h2 class="lb-blog-article-card__title"><a href="{{ routes.blog_url }}/{{ article.slug }}">{{ article.title }}</a></h2>
                          {% if article.excerpt %}<p class="lb-blog-article-card__excerpt">{{ article.excerpt }}</p>{% endif %}
                          {% if article.published_at %}<time class="lb-blog-article-card__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}
                        </article>
                        {% endfor %}
                      </div>
                      {% if blog.pages_count and blog.pages_count > 1 %}
                      <nav class="lb-blog-listing__pagination" aria-label="Blog pagination">
                        {% if blog.current_page and blog.current_page > 1 %}<a class="lb-blog-listing__prev" href="{{ routes.blog_url }}?page={{ blog.current_page | minus: 1 }}" rel="prev">Previous</a>{% endif %}
                        {% assign next_page = blog.current_page | plus: 1 %}
                        {% if next_page <= blog.pages_count %}<a class="lb-blog-listing__next" href="{{ routes.blog_url }}?page={{ next_page }}" rel="next">Next</a>{% endif %}
                      </nav>
                      {% endif %}
                      {% else %}
                      <p class="lb-blog-listing__empty">No posts published yet.</p>
                      {% endif %}
                    </section>
                    {% schema %}
                    {
                      "name": "Blog Listing",
                      "settings": [
                        {
                          "id": "heading",
                          "type": "text",
                          "label": "Heading",
                          "default": "Our Blog"
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Blog Listing",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                cart-summary:
                  path: 'sections/cart-summary.liquid'
                  schema:
                    tag: 'section'
                    name: 'Cart'
                    blocks:
                    presets:
                      0:
                        name: 'Cart'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Your cart'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-cart-page" data-section-id="{{ section.id }}">
                      <h1>{{ section.settings.heading }}</h1>
                      <lb-cart data-lb-island="cart" data-base-path="/store/{{ shop.subdomain }}">
                        {% if cart.item_count > 0 %}
                        <ul class="lb-cart__items">{% for item in cart.items %}<li class="lb-cart__item"><span class="lb-cart__title">{{ item.title }}</span><span class="lb-cart__qty">x{{ item.quantity }}</span><span class="lb-cart__line">{{ item.line_price | money_with_currency: cart.currency }}</span></li>{% endfor %}</ul>
                        <div class="lb-liquid-cart__totals">
                          {% if cart.subtotal %}<div class="lb-liquid-cart__row"><span>Subtotal</span><span>{{ cart.subtotal | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.coupon_codes.size > 0 %}<div class="lb-liquid-cart__row"><span>Coupons</span><span>{{ cart.coupon_codes | join: ", " }}</span></div>{% endif %}
                          {% if cart.discount_total %}<div class="lb-liquid-cart__row"><span>Discounts</span><span>{{ cart.discount_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.shipping_total %}<div class="lb-liquid-cart__row"><span>Shipping</span><span>{{ cart.shipping_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.tax_total %}<div class="lb-liquid-cart__row"><span>Tax (GST)</span><span>{{ cart.tax_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                        </div>
                        <p class="lb-cart__total">Total: {{ cart.total_price | money_with_currency: cart.currency }}</p>
                        <a class="lb-cart__checkout" href="{{ cart.checkout_url }}">Checkout</a>
                        {% else %}<p class="lb-cart__empty">Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>{% endif %}
                      </lb-cart>
                    </section>
                    {% schema %}
                    {
                      "name": "Cart",
                      "settings": [
                        {
                          "id": "heading",
                          "type": "text",
                          "label": "Heading",
                          "default": "Your cart"
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Cart",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                contact-form:
                  path: 'sections/contact-form.liquid'
                  schema:
                    tag: 'section'
                    name: 'Contact Form'
                    blocks:
                    presets:
                      0:
                        name: 'Contact Form'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Title'
                        default: 'Contact us'
                      1:
                        id: 'subtitle'
                        type: 'text'
                        label: 'Subtitle'
                      2:
                        id: 'showPhone'
                        type: 'toggle'
                        label: 'Show phone field'
                        default: true
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-contact-form" data-section-id="{{ section.id }}">
                      <h2>{{ section.settings.title }}</h2>
                      <p>{{ section.settings.subtitle }}</p>
                      <form action="/contact" method="post"><input name="name" aria-label="Name"><input type="email" name="email" aria-label="Email">{% if section.settings.showPhone %}<input name="phone" aria-label="Phone">{% endif %}<button type="submit">Send</button></form>
                    </section>
                    {% schema %}
                    {
                      "name": "Contact Form",
                      "settings": [
                        {
                          "id": "title",
                          "type": "text",
                          "label": "Title",
                          "default": "Contact us"
                        },
                        {
                          "id": "subtitle",
                          "type": "text",
                          "label": "Subtitle"
                        },
                        {
                          "id": "showPhone",
                          "type": "toggle",
                          "label": "Show phone field",
                          "default": true
                        }
                      ],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Contact Form",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                page-content:
                  path: 'sections/page-content.liquid'
                  schema:
                    tag: 'section'
                    name: 'Page Content'
                    blocks:
                    presets:
                      0:
                        name: 'Page Content'
                        blocks:
                        settings:
                    settings:
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-page" data-section-id="{{ section.id }}">
                      {% if page %}
                      <h1 class="lb-page__title">{{ page.title }}</h1>
                      {% if page.body_html != blank %}<div class="lb-page__body">{{ page.body_html | raw }}</div>
                      {% else %}<p class="lb-page__empty">No content yet.</p>{% endif %}
                      {% else %}
                      <p class="lb-page__missing">Page not found.</p>
                      {% endif %}
                    </section>
                    {% schema %}
                    {
                      "name": "Page Content",
                      "settings": [],
                      "blocks": [],
                      "presets": [
                        {
                          "name": "Page Content",
                          "settings": {},
                          "blocks": []
                        }
                      ]
                    }
                    {% endschema %}
                product-grid:
                  path: 'sections/product-grid.liquid'
                  schema:
                    tag: 'section'
                    name: 'Product Grid'
                    blocks:
                    presets:
                      0:
                        name: 'Product Grid'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Heading'
                        default: 'Featured Products'
                      1:
                        id: 'subtitle'
                        type: 'text'
                        label: 'Subheading'
                      2:
                        id: 'columns'
                        max: 4
                        min: 2
                        step: 1
                        type: 'range'
                        label: 'Columns'
                        default: 4
                      3:
                        id: 'productLimit'
                        max: 24
                        min: 1
                        step: 1
                        type: 'range'
                        label: 'Products to show'
                        default: 8
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-product-grid" data-section-id="{{ section.id }}">
                      <h2>{{ section.settings.title }}</h2>
                      <p>{{ section.settings.subtitle }}</p>
                      {% if collection.products.size > 0 %}
                      <div class="lb-product-grid__items" data-columns="{{ section.settings.columns }}">{% for item in collection.products limit: section.settings.productLimit %}<article class="lb-product-card">  <a class="lb-product-card__link" href="{{ item.url }}">    <div class="lb-product-card__media">      {% if item.featured_image %}      <img class="lb-product-card__image lb-product-card__image--primary" src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async" sizes="(min-width: 64em) 25vw, (min-width: 48em) 33vw, 50vw">      {% if item.images.size > 1 %}<img class="lb-product-card__image lb-product-card__image--hover" src="{{ item.images[1] | image_url }}" alt="" aria-hidden="true" loading="lazy" decoding="async">{% endif %}      {% else %}      <span class="lb-product-card__placeholder">No image yet</span>      {% endif %}      {% if item.available == false %}      <span class="lb-product-card__badges"><span class="lb-product-card__badge lb-product-card__badge--sold-out">Sold out</span></span>      {% elsif item.compare_at_price and item.compare_at_price > item.price %}      <span class="lb-product-card__badges"><span class="lb-product-card__badge lb-product-card__badge--sale">Sale</span></span>      {% elsif item.stock > 0 and item.stock <= 5 %}      <span class="lb-product-card__badges"><span class="lb-product-card__badge lb-product-card__badge--low-stock">Only {{ item.stock }} left</span></span>      {% endif %}    </div>    <div class="lb-product-card__body">      <h3 class="lb-product-card__title">{{ item.title }}</h3>      {% if item.review_count > 0 %}      <div class="lb-product-card__rating" aria-label="Rated {{ item.rating }} out of 5 from {{ item.review_count }} reviews"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" class="lb-icon-star"><path d="M12 2.5l2.9 6.4 6.9.7-5.2 4.8 1.5 6.9L12 17.8l-6.1 3.5 1.5-6.9-5.2-4.8 6.9-.7z"></path></svg><span class="lb-product-card__rating-value">{{ item.rating }}</span><span class="lb-product-card__rating-count">({{ item.review_count }})</span></div>      {% endif %}      <div class="lb-product-card__price">        <span>{{ item.price | times: 100 | money_with_currency: item.currency }}</span>        {% if item.compare_at_price and item.compare_at_price > item.price %}<s>{{ item.compare_at_price | times: 100 | money_with_currency: item.currency }}</s>{% endif %}      </div>    </div>  </a>  <div class="lb-product-card__actions">    <lb-add-to-cart data-lb-island="add-to-cart" data-product-id="{{ item.id }}" data-product-name="{{ item.title }}" data-product-price="{{ item.price }}" data-product-currency="{{ item.currency }}" data-product-url="{{ item.url }}">      <button type="button" class="lb-product-card__cta" data-lb-add-to-cart{% if item.available == false %} disabled{% endif %}>{% if item.available == false %}Sold out{% else %}Quick add{% endif %}</button>    </lb-add-to-cart>    <lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ item.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="{% if item.in_wishlist %}true{% endif %}"{% if buyer_wishlist.authenticated %} data-authenticated="true" data-account-type="buyer" data-buyer-id="{{ buyer_wishlist.buyerId }}" data-buyer-linked="{% if buyer_wishlist.linked %}true{% endif %}" data-buyer-unavailable="{% if buyer_wishlist.unavailable or buyer_wishlist.storeAccountUnavailable %}true{% endif %}"{% elsif customer %} data-authenticated="true" data-account-type="store_customer"{% endif %} data-base-path="/store/{{ shop.subdomain }}" aria-label="Add {{ item.title }} to wishlist"></lb-wishlist-toggle>  </div></article>{% endfor %}</div>
                      {% else %}
                      <div class="lb-product-grid__empty"><h2>No products found</h2><p>Products added to this store will appear here.</p></div>
                      {% endif %}
                    </section>
                    {% schema %}
                    {
                      "name": "Product Grid",
                      "settings": [
                        { "id": "title", "type": "text", "label": "Heading", "default": "Featured Products" },
                        { "id": "subtitle", "type": "text", "label": "Subheading" },
                        { "id": "columns", "type": "range", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
                        { "id": "productLimit", "type": "range", "label": "Products to show", "min": 1, "max": 24, "step": 1, "default": 8 }
                      ],
                      "blocks": [],
                      "presets": [{ "name": "Product Grid" }]
                    }
                    {% endschema %}
                rich-content:
                  path: 'sections/rich-content.liquid'
                  schema:
                    tag: 'section'
                    name: 'Rich Content'
                    blocks:
                    presets:
                      0:
                        name: 'Rich Content'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
