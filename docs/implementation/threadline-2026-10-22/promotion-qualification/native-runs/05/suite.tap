                            <div>{{ section.settings.content }}</div>
                          </div>
                          {% if section.settings.imageUrl %}<img class="lb-about-section__image" src="{{ section.settings.imageUrl | image_url }}" alt="{{ section.settings.title }}">{% endif %}
                        </section>
                        {% schema %}
                        {
                          "name": "About Section",
