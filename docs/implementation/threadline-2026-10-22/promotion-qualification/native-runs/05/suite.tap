                    spotlight:
                      path: 'sections/spotlight.liquid'
                      schema:
                        tag: 'section'
                        name: 'Spotlight'
                        blocks:
                          0:
                            name: 'Badge'
                            type: 'badge'
                            settings:
                          1:
                            name: 'App block'
                            type: '@app'
                            settings:
                        presets:
                          0:
                            name: 'Spotlight'
                            blocks:
                            settings:
                        settings:
                          0:
                            id: 'heading'
                            type: 'text'
                            label: 'Heading'
                            default: 'Made for daily buyers'
                          1:
                            id: 'subheading'
                            type: 'text'
                            label: 'Subheading'
                        enabled_on:
                          templates:
                            0: '*'
                        disabled_on:
                          templates:
                      source: |-
                        <section class="lb-first-party-spotlight" data-section-id="{{ section.id }}">
                          <p>{{ section.settings.subheading }}</p>
                          <h2>{{ section.settings.heading }}</h2>
                          <div class="lb-first-party-spotlight__blocks">
                            {% for block in section.blocks %}
                              {{ block.content | raw }}
                            {% endfor %}
                          </div>
                        </section>
                        {% schema %}
                        {
                          "name": "Spotlight",
                          "settings": [
                            { "id": "heading", "type": "text", "label": "Heading", "default": "Made for daily buyers" },
                            { "id": "subheading", "type": "text", "label": "Subheading" }
                          ],
                          "blocks": [
                            { "type": "badge", "name": "Badge" },
                            { "type": "@app", "name": "App block" }
                          ],
                          "presets": [{ "name": "Spotlight" }]
                        }
                        {% endschema %}
                    search-box:
                      path: 'sections/search-box.liquid'
                      schema:
                        tag: 'section'
                        name: 'Search'
                        blocks:
                        presets:
                          0:
                            name: 'Search'
                            blocks:
                            settings:
                        settings:
                          0:
                            id: 'placeholder'
                            type: 'text'
                            label: 'Placeholder'
                            default: 'Search products'
                        enabled_on:
                          templates:
                            0: '*'
                        disabled_on:
                          templates:
                      source: |-
                        <section class="lb-search" data-section-id="{{ section.id }}">
                          <lb-search data-lb-island="search" data-search-url="{{ routes.search_url }}">
                            <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                              <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                              <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="{{ section.settings.placeholder }}" aria-label="Search products" value="{{ search.terms }}">
                              <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                            </form>
                          </lb-search>
                          {% if search.terms %}<p class="lb-search__terms">Results for "{{ search.terms }}"</p>{% endif %}
                        </section>
                        {% schema %}
                        {
                          "name": "Search",
                          "settings": [
                            {
                              "id": "placeholder",
                              "type": "text",
                              "label": "Placeholder",
                              "default": "Search products"
                            }
                          ],
                          "blocks": [],
                          "presets": [
                            {
                              "name": "Search",
                              "settings": {},
                              "blocks": []
                            }
                          ]
                        }
                        {% endschema %}
                    video-hero:
                      path: 'sections/video-hero.liquid'
                      schema:
                        tag: 'section'
                        name: 'Video Hero'
                        blocks:
                        presets:
                          0:
                            name: 'Video Hero'
                            blocks:
                            settings:
                        settings:
                          0:
                            id: 'heading'
                            type: 'text'
                            label: 'Heading'
                            default: 'See the fit in motion'
                          1:
                            id: 'subheading'
                            type: 'textarea'
                            label: 'Subheading'
                            default: 'A quick look at how each drop moves, from the box to your feet.'
                          2:
                            id: 'videoUrl'
                            info: 'A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.'
                            type: 'url'
                            label: 'Video embed URL'
                        enabled_on:
                          templates:
                            0: '*'
                        disabled_on:
                          templates:
                      source: |-
                        <section class="lb-video-hero" data-section-id="{{ section.id }}">
                          <div class="lb-video-hero__copy">
                            <h2 class="lb-video-hero__heading">{{ section.settings.heading }}</h2>
                            {% if section.settings.subheading %}<p class="lb-video-hero__subheading">{{ section.settings.subheading }}</p>{% endif %}
                          </div>
                          {% if section.settings.videoUrl != blank %}<div class="lb-video-hero__embed"><iframe src="{{ section.settings.videoUrl | video_url }}" title="{{ section.settings.heading }}" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allowfullscreen></iframe></div>{% endif %}
                        </section>
                        {% schema %}
                        {
                          "name": "Video Hero",
                          "settings": [
                            {
                              "id": "heading",
                              "type": "text",
                              "label": "Heading",
                              "default": "See the fit in motion"
                            },
                            {
                              "id": "subheading",
                              "type": "textarea",
                              "label": "Subheading",
                              "default": "A quick look at how each drop moves, from the box to your feet."
                            },
                            {
                              "id": "videoUrl",
                              "type": "url",
                              "label": "Video embed URL",
                              "info": "A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video."
                            }
                          ],
                          "blocks": [],
                          "presets": [
                            {
                              "name": "Video Hero",
                              "settings": {},
                              "blocks": []
                            }
                          ]
                        }
                        {% endschema %}
                    cta-section:
                      path: 'sections/cta-section.liquid'
                      schema:
                        tag: 'section'
                        name: 'Call to Action'
                        blocks:
                        presets:
                          0:
                            name: 'Call to Action'
                            blocks:
                            settings:
                        settings:
                          0:
                            id: 'heading'
