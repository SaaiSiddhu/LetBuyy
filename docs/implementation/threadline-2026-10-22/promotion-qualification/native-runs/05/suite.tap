                    surfaceColor: '#EFE7DC'
                    bodyFontFamily: 'Inter'
                    secondaryColor: '#65574C'
                    socialImageUrl: ''
                    backgroundColor: '#FAF7F2'
                    metaDescription: ''
                    headingFontFamily: 'Playfair Display'
                  presets:
                    Aura:
                      textColor: '#2D1B22'
                      accentColor: '#D4AF7A'
                      borderRadius: 16
                      primaryColor: '#C2798B'
                      surfaceColor: '#FFF8F9'
                      bodyFontFamily: 'Lato'
                      secondaryColor: '#9E5A6F'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Cormorant Garamond'
                    Dawn:
                      textColor: '#2C2C2C'
                      accentColor: '#C0832B'
                      borderRadius: 4
                      primaryColor: '#3B4F6B'
                      surfaceColor: '#FDF6EC'
                      bodyFontFamily: 'Source Sans Pro'
                      secondaryColor: '#2C3E50'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Libre Baskerville'
                    Nova:
                      textColor: '#1A1A2E'
                      accentColor: '#F59E0B'
                      borderRadius: 10
                      primaryColor: '#8B5CF6'
                      surfaceColor: '#F8FAFC'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#6D28D9'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Ride:
                      textColor: '#111111'
                      accentColor: '#FFD100'
                      borderRadius: 6
                      primaryColor: '#FF4D00'
                      surfaceColor: '#F5F5F5'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1C1C1C'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Bloom:
                      textColor: '#2C1A0A'
                      accentColor: '#4CAF73'
                      borderRadius: 14
                      primaryColor: '#E07B39'
                      surfaceColor: '#FFF9F0'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#B55E24'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Craft:
                      textColor: '#2C1B12'
                      accentColor: '#8D6E63'
                      borderRadius: 6
                      primaryColor: '#3E2723'
                      surfaceColor: '#FFF8F0'
                      bodyFontFamily: 'Source Sans Pro'
                      secondaryColor: '#5D3B2E'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Libre Baskerville'
                    Forge:
                      textColor: '#1A202C'
                      accentColor: '#00B4D8'
                      borderRadius: 8
                      primaryColor: '#1E3A5F'
                      surfaceColor: '#F0F4F8'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1E40AF'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Summit:
                      textColor: '#1A1A2E'
                      accentColor: '#A4E500'
                      borderRadius: 12
                      primaryColor: '#00B3B3'
                      surfaceColor: '#F9FAFB'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#008080'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Refresh:
                      textColor: '#1B2521'
                      accentColor: '#F4A261'
                      borderRadius: 10
                      primaryColor: '#2D6A4F'
                      surfaceColor: '#F8FFF4'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#1B4332'
                      backgroundColor: '#FFFFFF'
                      headingFontFamily: 'Inter'
                    Threadline:
                      textColor: '#241E1A'
                      accentColor: '#005FCC'
                      borderRadius: 4
                      primaryColor: '#713F35'
                      surfaceColor: '#EFE7DC'
                      bodyFontFamily: 'Inter'
                      secondaryColor: '#65574C'
                      backgroundColor: '#FAF7F2'
                      headingFontFamily: 'Playfair Display'
                settings_schema:
                  settings:
                    seo:
                      label: 'SEO and social'
                      fields:
                        faviconUrl:
                          info: 'Rendered as <link rel="icon">. Left empty until the merchant uploads one.'
                          type: 'url'
                          label: 'Favicon URL'
                          default: ''
                        socialImageUrl:
                          info: 'Used for og:image and twitter:image. Left empty until the merchant uploads one.'
                          type: 'url'
                          label: 'Social share image URL'
                          default: ''
                        metaDescription:
                          info: 'Falls back to the shop description. Truncated to 160 characters on output.'
                          type: 'textarea'
                          label: 'Meta description'
                          default: ''
                          maxLength: 160
                      description: 'Metadata rendered into <head> by the theme layout.'
                    colors:
                      label: 'Colors'
                      fields:
                        textColor:
                          type: 'color'
                          label: 'Text color'
                          default: '#1F2937'
                        accentColor:
                          type: 'color'
                          label: 'Accent color'
                          default: '#F59E0B'
                        primaryColor:
                          type: 'color'
                          label: 'Primary color'
                          default: '#8B5CF6'
                        surfaceColor:
                          type: 'color'
                          label: 'Surface color'
                          default: '#F8FAFC'
                        secondaryColor:
                          type: 'color'
                          label: 'Secondary color'
                          default: '#3B82F6'
                        backgroundColor:
                          type: 'color'
                          label: 'Background color'
                          default: '#FFFFFF'
                      description: 'LetBuyy Core storefront color tokens.'
                    appearance:
                      label: 'Appearance'
                      fields:
                        borderRadius:
                          type: 'number'
                          label: 'Corner radius'
                          default: 12
                      description: 'Layout tokens shared by every section.'
                    typography:
                      label: 'Typography'
                      fields:
                        bodyFontFamily:
                          type: 'text'
                          label: 'Body font'
                          default: 'Inter'
                        headingFontFamily:
                          type: 'text'
                          label: 'Heading font'
                          default: 'Inter'
                      description: 'First-party type settings mirrored from the JSON-contract LetBuyy Core theme.'
                  schema_version: '2026-05-json-contract'
              layout:
                theme:
                  path: 'layout/theme.liquid'
                  source: |-
                    <!doctype html>
                    <html lang="{{ request.locale | default: "en" }}">
                    <head>
                      <meta charset="utf-8">
                      <meta name="viewport" content="width=device-width, initial-scale=1">
                      {% assign lb_page_title = shop.name %}
                      {% assign lb_meta_description = settings.metaDescription | default: shop.description | strip_html | truncate: 160 %}
                      <title>{{ lb_page_title }}</title>
                      {% if lb_meta_description != blank %}<meta name="description" content="{{ lb_meta_description }}">{% endif %}
                      <meta name="twitter:card" content="{% if settings.socialImageUrl != blank %}summary_large_image{% else %}summary{% endif %}">
                      <meta name="twitter:title" content="{{ lb_page_title }}">
                      {% if lb_meta_description != blank %}<meta name="twitter:description" content="{{ lb_meta_description }}">{% endif %}
                      {% if settings.socialImageUrl != blank %}<meta name="twitter:image" content="{{ settings.socialImageUrl | image_url }}">{% endif %}
                      <style data-lb-layout="1">
                        :root{--lb-focus-ring-width:2px;--lb-focus-ring-color:var(--accent,#2563eb);--lb-focus-offset:2px;--lb-space-sm:0.5rem;--lb-space-md:0.75rem;--lb-space-lg:1rem;--lb-radius-sm:0.375rem;--lb-layout-max:72rem;--lb-layout-gutter:1rem;--lb-layout-breakpoint:48em;}
                        .lb-theme :where(a,button,input,select,textarea,summary,details,[tabindex]):focus-visible{outline:var(--lb-focus-ring-width) solid var(--lb-focus-ring-color);outline-offset:var(--lb-focus-offset);}
                        .lb-skip-link{position:absolute;left:-9999px;top:0;z-index:100;padding:var(--lb-space-md) var(--lb-space-lg);border-radius:var(--lb-radius-sm);background:var(--surface,#f8fafc);color:var(--foreground,#1a1a2e);font-weight:600;}
                        .lb-skip-link:focus,.lb-skip-link:focus-visible{left:var(--lb-space-lg);top:var(--lb-space-lg);}
                        .lb-layout__header,.lb-layout__footer{display:flex;flex-direction:column;align-items:flex-start;gap:var(--lb-space-md);margin-inline:auto;max-width:min(var(--lb-layout-max),calc(100vw - var(--lb-layout-gutter) * 2));padding-block:var(--lb-space-lg);padding-inline:var(--lb-layout-gutter);}
                        .lb-layout__brand{font-family:var(--font-display,inherit);font-weight:700;}
                        .lb-layout__nav{display:flex;flex-wrap:wrap;gap:var(--lb-space-md);}
                        .lb-layout__legal{margin:0;font-size:0.875rem;}
                        @media (min-width:48em){.lb-layout__header,.lb-layout__footer{flex-direction:row;align-items:center;justify-content:space-between;}}
                      </style>
                      {{ content_for_header | raw }}
                    <style data-threadline="2">
                    .tl-theme{--font-display:var(--font-heading,Georgia,serif);--font-body:var(--font-main,Inter,Arial,sans-serif);--tl-muted:var(--tl-muted-color,#65574c);--tl-border:var(--tl-boundary-color,#766657);--tl-stone:var(--surface,#efe7dc);background:var(--background);color:var(--foreground);--footer-bg:var(--surface);--footer-text:var(--foreground);--footer-text-muted:var(--tl-muted);font:16px/1.55 var(--font-body,Inter,Arial,sans-serif)}
                    .tl-theme *{box-sizing:border-box}.tl-theme img{max-width:100%}.tl-theme a{color:inherit}.tl-theme h1,.tl-theme h2,.tl-theme h3{font-family:var(--font-display,Georgia,serif);font-weight:400;line-height:1.15;letter-spacing:-.025em}.tl-theme h1{font-size:clamp(2rem,4.4vw,4rem)}.tl-theme h2{font-size:clamp(1.75rem,3vw,2.4rem)}.tl-theme p{color:var(--tl-muted)}
                    .tl-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--tl-focus-color,#005fcc);outline-offset:4px}.tl-wrap{width:min(1280px,calc(100% - 112px));margin-inline:auto}.tl-section{padding-block:76px}.tl-eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;color:var(--tl-muted)}.tl-button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:13px 23px;background:var(--primary);color:var(--tl-action-label,#fff)!important;border:1px solid var(--primary);border-radius:4px;text-decoration:none;font-size:.85rem}.tl-link{display:inline-flex;min-height:44px;align-items:center;border-bottom:1px solid var(--tl-border);text-decoration:none;font-size:.85rem}.tl-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:30px}.tl-heading h2{margin:0}.tl-empty{padding:40px 0;color:var(--tl-muted)}
                    .tl-theme .lb-announcement-bar{background:var(--primary);color:var(--tl-action-label,#fff);padding:9px 20px;text-align:center;font-size:.75rem}.tl-theme .lb-announcement-bar__inner{justify-content:center}.tl-theme .lb-header{border-bottom:1px solid var(--border-color);background:var(--background);padding:14px 0}.tl-theme .lb-header__inner{padding:0;min-height:44px;max-width:1280px;width:calc(100% - 112px);margin:auto}.tl-theme .lb-header__brand{font-family:var(--font-display);font-weight:400;letter-spacing:.18em;font-size:1.5rem;text-transform:uppercase}.tl-theme .lb-header__nav-links{gap:26px}.tl-theme .lb-header__nav-links>a{font-size:.8rem;border:0}.tl-theme .lb-footer{background:var(--tl-stone);padding:55px max(28px,calc((100vw - 1280px)/2));border-top:1px solid var(--border-color)}
                    .tl-hero{display:grid;grid-template-columns:1.5fr 1fr}.tl-hero-media{display:grid;grid-template-columns:1.7fr 1fr;gap:5px;min-width:0}.tl-hero-media img{width:100%;height:585px;object-fit:cover}.tl-focus-top img{object-position:center top}.tl-focus-bottom img{object-position:center bottom}.tl-hero-copy{padding:65px 56px;display:flex;flex-direction:column;align-items:start;justify-content:center}.tl-hero-copy h1{margin:22px 0}.tl-hero-copy p{margin:0 0 28px}.tl-hero-copy .tl-link{margin-top:15px}.tl-hero-empty{grid-template-columns:1fr}.tl-hero-empty .tl-hero-copy{max-width:760px;margin:auto;min-height:400px}
                    .tl-categories{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.tl-category{text-decoration:none;min-width:0}.tl-category img,.tl-category-placeholder{display:block;width:100%;height:205px;object-fit:cover;background:var(--tl-stone)}.tl-category-placeholder{display:grid;place-items:center;color:var(--tl-muted);font-size:.8rem}.tl-category strong{display:flex;align-items:center;justify-content:space-between;font-family:var(--font-display);font-size:1.4rem;font-weight:400;margin-top:12px}
                    .tl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.tl-grid[data-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-grid[data-columns="4"]{grid-template-columns:repeat(4,minmax(0,1fr))}.tl-card{min-width:0}.tl-card>a{text-decoration:none}.tl-card-media{position:relative;background:var(--tl-stone);aspect-ratio:3/4;overflow:hidden}.tl-card-media img{width:100%;height:100%;object-fit:cover;display:block}.tl-card-media span{position:absolute;bottom:10px;left:10px;background:var(--background);padding:4px 9px;font-size:.75rem}.tl-card-placeholder{height:100%;display:grid;place-items:center;font-size:.8rem;color:var(--tl-muted)}.tl-card-info{display:flex;justify-content:space-between;gap:12px;margin-top:14px}.tl-card h3{font-family:var(--font-body);font-size:.9rem;line-height:1.5;margin:0;letter-spacing:0}.tl-card-price{font-size:.85rem;white-space:nowrap;font-variant-numeric:tabular-nums}.tl-card-facts{font-size:.75rem;margin:6px 0}.tl-card .tl-link{font-size:.75rem}
                    .tl-outfit{display:grid;grid-template-columns:1fr 1fr;background:var(--tl-stone)}.tl-outfit>img{width:100%;height:620px;object-fit:cover}.tl-outfit-empty{grid-template-columns:1fr}.tl-outfit-copy{padding:65px;align-self:center}.tl-outfit-copy h2{margin:15px 0}.tl-outfit-product{display:flex;align-items:center;gap:20px;padding:22px 0;border-top:1px solid var(--border-color);text-decoration:none}.tl-outfit-product img{width:72px;height:96px;object-fit:cover}.tl-outfit-product h3{font-size:1.35rem;margin:0 0 8px}.tl-outfit-product p{font-size:.8rem;margin:0}.tl-outfit-note{font-size:.8rem}.tl-fabric{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.tl-fabric>img{width:100%;aspect-ratio:3/2;object-fit:cover}.tl-fabric h2{margin:15px 0}.tl-fabric-empty{grid-template-columns:1fr}.tl-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;padding-block:35px;border-top:1px solid var(--border-color)}.tl-service h3{font-family:var(--font-body);font-size:.9rem;letter-spacing:0}.tl-service p{font-size:.8rem}.tl-services:empty{display:none}
                    .tl-theme .lb-product-detail{width:min(1280px,calc(100% - 112px));margin:auto;padding-block:32px 60px}.tl-theme .lb-product-detail__layout{display:grid;grid-template-columns:1.2fr 1fr;gap:65px}.tl-theme .lb-product-detail__gallery-image{aspect-ratio:4/5;object-fit:cover;width:100%}.tl-theme .lb-product-detail__title{font-size:clamp(1.8rem,3vw,2.8rem);font-weight:400}.tl-theme .lb-product-detail__price-current{font-size:1.25rem}.tl-theme .lb-product-detail__cta{border-radius:4px;min-height:48px}.tl-theme .lb-product-detail__cta--primary{background:var(--primary);color:var(--tl-action-label,#fff)}.tl-theme .lb-product-detail__variant-values{gap:9px}.tl-theme .lb-product-detail__variant-values button{min-width:44px;min-height:44px;border:1px solid var(--tl-border);border-radius:0;background:var(--background)}.tl-theme .lb-product-detail__variant-values button[aria-pressed="true"]{background:var(--primary);color:var(--tl-action-label,#fff)}.tl-theme .lb-product-detail__variant-values button[disabled]{text-decoration:line-through}.tl-theme .lb-product-detail__info{min-width:0}.tl-fit{border-top:1px solid var(--border-color);padding-top:35px;margin-top:35px}.tl-fit h2{font-size:1.6rem}.tl-fit p{font-size:.9rem}.tl-fit table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:.8rem;margin:20px 0}.tl-fit caption{text-align:left;margin-bottom:12px}.tl-fit th,.tl-fit td{text-align:left;border-bottom:1px solid var(--border-color);padding:12px 8px;overflow-wrap:anywhere}.tl-fit thead{background:var(--tl-stone)}.tl-fit summary{min-height:44px;cursor:pointer;font-family:var(--font-display);font-size:1.35rem}.tl-filters{display:flex;align-items:end;flex-wrap:wrap;gap:16px;margin:24px 0}.tl-filters label{display:grid;gap:6px;font-size:.8rem}.tl-filters input,.tl-filters select{min-height:44px;max-width:100%;padding:10px;border:1px solid var(--tl-border);background:var(--background);color:var(--foreground)}.tl-filters input[type="number"]{width:120px}
                    .tl-theme .lb-cart,.tl-theme .lb-customer-account,.tl-theme .lb-customer-orders{max-width:1280px;margin:auto}.tl-theme .lb-cart__checkout,.tl-theme .lb-cart-drawer__checkout{background:var(--primary);color:var(--tl-action-label,#fff)}
                    @media(max-width:1100px){.tl-wrap{width:calc(100% - 64px)}.tl-hero-copy{padding:45px 32px}.tl-outfit-copy{padding:40px}.tl-theme .lb-product-detail__layout{gap:32px}.tl-fabric{gap:35px}}
                    @media(max-width:900px){.tl-section{padding-block:55px}.tl-hero{grid-template-columns:1.1fr 1fr}.tl-hero-media{grid-template-columns:1fr}.tl-hero-media img{height:515px}.tl-hero-media img+img{display:none}.tl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-grid[data-columns="4"]{grid-template-columns:repeat(2,minmax(0,1fr))}.tl-outfit-copy{padding:32px}.tl-outfit>img{height:540px}.tl-theme .lb-header__inner{width:calc(100% - 64px)}}
                    @media(max-width:640px){.tl-wrap{width:calc(100% - 48px)}.tl-section{padding-block:38px}.tl-heading{align-items:start;gap:12px}.tl-heading .tl-link{font-size:.75rem}.tl-hero{grid-template-columns:1fr}.tl-hero-media img{height:400px}.tl-hero-copy{padding:38px 28px;align-items:center;text-align:center}.tl-hero-copy h1{font-size:2.3rem;max-width:310px;margin:18px 0}.tl-hero-copy p{font-size:.9rem}.tl-categories{gap:12px}.tl-category img,.tl-category-placeholder{height:135px}.tl-category strong{font-size:1rem;gap:6px}.tl-grid,.tl-grid[data-columns="2"],.tl-grid[data-columns="4"]{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 12px}.tl-card-info{display:block}.tl-card-price{margin-top:5px}.tl-card h3{font-size:.8rem}.tl-card-facts{font-size:.7rem}.tl-outfit{grid-template-columns:1fr}.tl-outfit>img{height:auto;aspect-ratio:4/5}.tl-outfit-copy{padding:32px 24px}.tl-fabric{grid-template-columns:1fr;gap:25px}.tl-services{grid-template-columns:1fr;gap:20px}.tl-theme .lb-product-detail{width:calc(100% - 48px);padding-block:24px}.tl-theme .lb-product-detail__layout{grid-template-columns:1fr;gap:30px}.tl-theme .lb-product-detail__title{font-size:1.9rem}.tl-theme .lb-header__inner{width:calc(100% - 40px)}.tl-theme .lb-header__brand{font-size:1.2rem}.tl-fit th,.tl-fit td{padding:10px 4px}.tl-filters{gap:12px}.tl-filters label{max-width:100%}.tl-filters input[type="number"]{width:105px}.tl-theme .lb-footer{padding:36px 24px}}
                    @media(prefers-reduced-motion:reduce){.tl-theme *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
                    </style>
                    </head>
                    <body class="lb-theme lb-theme--letbuyy-core">
                      <a class="lb-skip-link" href="#MainContent">Skip to content</a>
                      <header class="lb-layout__header">
                        <a class="lb-layout__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
                        <nav class="lb-layout__nav" aria-label="Primary">
                          {% if linklists.main_menu.links.size > 0 %}{% for link in linklists.main_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
                          {% else %}<a href="{{ routes.all_products_collection_url }}">Products</a><a href="{{ routes.search_url }}">Search</a><a href="{{ routes.cart_url }}">Cart</a><a href="{{ routes.account_url }}">Account</a>{% endif %}
                        </nav>
                      </header>
                      <main id="MainContent">
                        {{ content_for_layout | raw }}
                      </main>
                      <footer class="lb-layout__footer">
                        {% if linklists.footer.links.size > 0 %}<nav class="lb-layout__nav" aria-label="Footer">{% for link in linklists.footer.links %}<a href="{{ link.url | store_url }}">{{ link.title }}</a>{% endfor %}</nav>{% endif %}
                        <p class="lb-layout__legal">&copy; {{ shop.name }}</p>
                      </footer>
                      {{ content_for_footer | raw }}
                    </body>
                    </html>
              locales:
                en:
                  general:
                    cart: 'Cart'
              package:
                name: 'Threadline'
                slug: 'letbuyy-sense'
                price: 0
                status: 'active'
                version: '2.0.0'
                currency: 'INR'
                site_types:
                  0: 'store'
                author_name: 'LetBuyy'
                description: 'Editorial apparel storefront with silhouette discovery, garment facts and size-aware shopping.'
                pricing_type: 'free'
                release_status: 'published'
                version_number: 2
                compatibility_range: '>=2026-06-liquid-sections'
              renderer:
                assets:
                engine: 'liquid'
                liquid_ready: true
                renderer_version: '0.1.0'
              sections:
                footer:
                  path: 'sections/footer.liquid'
                  schema:
                    tag: 'section'
                    name: 'Footer'
                    blocks:
                      0:
                        name: 'Link'
                        type: 'link'
                        settings:
                          0:
                            id: 'label'
                            type: 'text'
                            label: 'Label'
                          1:
                            id: 'href'
                            type: 'url'
                            label: 'URL'
                    presets:
                      0:
                        name: 'Footer'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'storeName'
                        type: 'text'
                        label: 'Store name'
                      1:
                        id: 'tagline'
                        type: 'text'
                        label: 'Tagline'
                      2:
                        id: 'contactEmail'
                        type: 'text'
                        label: 'Contact email'
                      3:
                        id: 'contactPhone'
                        type: 'text'
                        label: 'Contact phone'
                      4:
                        id: 'instagramUrl'
                        type: 'url'
                        label: 'Instagram URL'
                      5:
                        id: 'facebookUrl'
                        type: 'url'
                        label: 'Facebook URL'
                      6:
                        id: 'twitterUrl'
                        type: 'url'
                        label: 'Twitter/X URL'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><footer class="lb-footer" data-section-id="{{ section.id }}">
                      <div class="lb-footer__grid">
                        <div class="lb-footer__brand">
                          <h3>{{ section.settings.storeName | default: shop.name }}</h3>
                          {% if section.settings.tagline != blank %}<p>{{ section.settings.tagline }}</p>{% endif %}
                          {% if section.settings.instagramUrl != blank or section.settings.facebookUrl != blank or section.settings.twitterUrl != blank %}
                          <div class="lb-footer__social">
                            {% if section.settings.instagramUrl != blank %}<a href="{{ section.settings.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a>{% endif %}
                            {% if section.settings.facebookUrl != blank %}<a href="{{ section.settings.facebookUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 4h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path></svg></a>{% endif %}
                            {% if section.settings.twitterUrl != blank %}<a href="{{ section.settings.twitterUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="4" x2="20" y2="20"></line><line x1="20" y1="4" x2="4" y2="20"></line></svg></a>{% endif %}
                          </div>
                          {% endif %}
                        </div>
                        {% if section.blocks.size > 0 %}
                        <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}</nav></div>
                        {% elsif linklists.footer_menu.links.size > 0 %}
                        <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for link in linklists.footer_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}</nav></div>
                        {% endif %}
                        {% if shop.policies.size > 0 %}<div class="lb-footer__col">
                          <h4>Policies</h4>
                          <nav>
                            {% if shop.policies contains 'privacy' %}<a href="{{ routes.root_url }}/privacy">Privacy policy</a>{% endif %}
                            {% if shop.policies contains 'terms' %}<a href="{{ routes.root_url }}/terms">Terms of service</a>{% endif %}
                            {% if shop.policies contains 'shipping' %}<a href="{{ routes.root_url }}/shipping">Shipping policy</a>{% endif %}
                            {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}<a href="{{ routes.root_url }}/returns">Returns policy</a>{% endif %}
                          </nav>
                        </div>{% endif %}
                        <div class="lb-footer__col">
                          <h4>Contact</h4>
                          {% if section.settings.contactEmail != blank %}<p><a href="mailto:{{ section.settings.contactEmail }}">{{ section.settings.contactEmail }}</a></p>{% endif %}
                          {% if section.settings.contactPhone != blank %}<p><a href="tel:{{ section.settings.contactPhone }}">{{ section.settings.contactPhone }}</a></p>{% endif %}
                          <a href="{{ routes.contact_url }}">Contact us</a>
                        </div>
                      </div>
                      <div class="lb-footer__bottom">
                        <p>&copy; {{ shop.name }}. All rights reserved.</p>
                        <a class="lb-footer__watermark" href="https://letbuyy.com" target="_blank" rel="noopener noreferrer">Powered by LetBuyy</a>
                      </div>
                    </footer>
                    </div>
                    {% schema %}
                    {"name":"Footer","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"text","label":"Tagline","id":"tagline"},{"type":"text","label":"Contact email","id":"contactEmail"},{"type":"text","label":"Contact phone","id":"contactPhone"},{"type":"url","label":"Instagram URL","id":"instagramUrl"},{"type":"url","label":"Facebook URL","id":"facebookUrl"},{"type":"url","label":"Twitter/X URL","id":"twitterUrl"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Footer","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                header:
                  path: 'sections/header.liquid'
                  schema:
                    tag: 'section'
                    name: 'Header'
                    blocks:
                      0:
                        name: 'Link'
                        type: 'link'
                        settings:
                          0:
                            id: 'label'
                            type: 'text'
                            label: 'Label'
                          1:
                            id: 'href'
                            type: 'url'
                            label: 'URL'
                    presets:
                      0:
                        name: 'Header'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'storeName'
                        type: 'text'
                        label: 'Store name'
                      1:
                        id: 'showSearch'
                        type: 'toggle'
                        label: 'Show search'
                        default: true
                      2:
                        id: 'showCart'
                        type: 'toggle'
                        label: 'Show cart'
                        default: true
                      3:
                        id: 'behavior'
                        type: 'select'
                        label: 'Header behavior'
                        default: 'sticky'
                        options:
                          0: 'static'
                          1: 'sticky'
                      4:
                        id: 'menu'
                        type: 'select'
                        label: 'Menu'
                        default: 'main_menu'
                        options:
                          0: 'main_menu'
                          1: 'footer_menu'
                          2: 'policy_menu'
                      5:
                        id: 'layout'
                        type: 'select'
                        label: 'Layout'
                        default: 'inline'
                        options:
                          0: 'inline'
                          1: 'centered'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><header class="lb-header" data-section-id="{{ section.id }}" data-sticky="{% if section.settings.behavior == 'sticky' %}true{% else %}false{% endif %}" data-layout="{{ section.settings.layout | default: 'inline' }}">
                      <div class="lb-header__inner">
                        <lb-mobile-nav class="lb-mobile-nav" data-lb-island="mobile-nav">
                          <button type="button" class="lb-header__toggle" data-lb-nav-toggle aria-expanded="false" aria-controls="lb-nav-panel-{{ section.id }}" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg><span class="lb-sr-only">Menu</span></button>
                          <nav class="lb-header__nav" data-lb-nav-panel id="lb-nav-panel-{{ section.id }}" aria-label="Primary">
                            <div class="lb-header__nav-head"><span class="lb-header__nav-head-brand">{{ section.settings.storeName | default: shop.name }}</span><button type="button" class="lb-header__nav-close" data-lb-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close menu</span></button></div>
                            <div class="lb-header__nav-links">
                            {% if section.blocks.size > 0 %}
                              {% for block in section.blocks %}<a href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}
                            {% else %}
                              {% assign lb_menu_handle = section.settings.menu | default: 'main_menu' %}
                              {% assign lb_nav_links = linklists[lb_menu_handle].links %}
                              {% for link in lb_nav_links %}
                                {% if link.links.size > 0 %}
                                <details class="lb-header__nav-item" data-lb-nav-dropdown><summary{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lb-icon-chevron"><path d="M6 9l6 6 6-6"></path></svg></summary>
                                  <div class="lb-header__nav-submenu">{% for child in link.links %}<a href="{{ child.url | store_url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>
                                </details>
                                {% else %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}
                              {% endfor %}
                            {% endif %}
                            </div>
                            <div class="lb-header__nav-foot">
                              {% if customer %}<a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Account</span></a>{% else %}<a href="{{ routes.customer_login_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Log in</span></a>{% endif %}
                            </div>
                          </nav>
                          <div class="lb-header__scrim" data-lb-nav-scrim></div>
                        </lb-mobile-nav>
                        <a class="lb-header__brand" href="{{ routes.root_url }}">
                          {% if shop.logo_url %}<img class="lb-header__logo" src="{{ shop.logo_url | image_url }}" alt="{{ section.settings.storeName | default: shop.name }}">{% else %}{{ section.settings.storeName | default: shop.name }}{% endif %}
                        </a>
                        <div class="lb-header__actions">
                          {% if section.settings.showSearch %}<button type="button" class="lb-header__search-toggle" data-lb-search-toggle aria-expanded="false" aria-controls="lb-search-overlay-{{ section.id }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>{% endif %}
                          <a class="lb-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.customer_login_url }}{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span class="lb-sr-only">{% if customer %}Account{% else %}Log in{% endif %}</span></a>
                          {% if section.settings.showCart %}<a class="lb-header__cart" href="{{ routes.cart_url }}" data-lb-cart-trigger><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2l2 12h11l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="lb-sr-only">{{ "general.cart" | t }}</span> (<span data-lb-cart-count>{{ cart.item_count | default: 0 }}</span>)</a>{% endif %}
                        </div>
                      </div>
                      {% if section.settings.showSearch %}
                      <div class="lb-header__search-overlay" id="lb-search-overlay-{{ section.id }}" data-lb-search-overlay hidden>
                        <lb-predictive-search class="lb-predictive-search" data-lb-island="predictive-search" data-search-url="{{ routes.search_url }}">
                          <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                            <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                            <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="Search products" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lb-search-results-{{ section.id }}" aria-autocomplete="list">
                            <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                            <button type="button" data-lb-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close search</span></button>
                          </form>
                          <div id="lb-search-results-{{ section.id }}" class="lb-predictive-search__results" data-lb-search-results role="listbox" aria-live="polite"></div>
                        </lb-predictive-search>
                      </div>
                      {% endif %}
                    </header>
                    </div>
                    {% schema %}
                    {"name":"Header","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"toggle","label":"Show search","default":true,"id":"showSearch"},{"type":"toggle","label":"Show cart","default":true,"id":"showCart"},{"type":"select","label":"Header behavior","default":"sticky","options":["static","sticky"],"id":"behavior"},{"type":"select","label":"Menu","default":"main_menu","options":["main_menu","footer_menu","policy_menu"],"id":"menu"},{"type":"select","label":"Layout","default":"inline","options":["inline","centered"],"id":"layout"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Header","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                marquee:
                  path: 'sections/marquee.liquid'
                  schema:
                    tag: 'section'
                    name: 'Marquee'
                    blocks:
                    presets:
                      0:
                        name: 'Marquee'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'text'
                        type: 'text'
                        label: 'Text'
                        default: 'Featured announcement'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-marquee" data-section-id="{{ section.id }}">
                      <p>{{ section.settings.text }}</p>
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Marquee","tag":"section","settings":[{"type":"text","label":"Text","default":"Featured announcement","id":"text"}],"blocks":[],"presets":[{"name":"Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                404-page:
                  path: 'sections/404-page.liquid'
                  schema:
                    tag: 'section'
                    name: '404 Not Found'
                    blocks:
                    presets:
                      0:
                        name: '404 Not Found'
                        blocks:
                        settings:
                    settings:
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-404" data-section-id="{{ section.id }}">
                      <h1 class="lb-404__code">404</h1>
                      <p class="lb-404__message">Page not found</p>
                      <a class="lb-404__home" href="{{ routes.root_url }}">Back to home</a>
                    </section>
                    </div>
                    {% schema %}
                    {"name":"404 Not Found","tag":"section","settings":[],"blocks":[],"presets":[{"name":"404 Not Found","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                spotlight:
                  path: 'sections/spotlight.liquid'
                  schema:
                    tag: 'section'
                    name: 'Spotlight'
                    blocks:
                      0:
                        name: 'Badge'
                        type: 'badge'
                        settings:
                      1:
                        name: 'App block'
                        type: '@app'
                        settings:
                    presets:
                      0:
                        name: 'Spotlight'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Made for daily buyers'
                      1:
                        id: 'subheading'
                        type: 'text'
                        label: 'Subheading'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-first-party-spotlight" data-section-id="{{ section.id }}">
                      <p>{{ section.settings.subheading }}</p>
                      <h2>{{ section.settings.heading }}</h2>
                      <div class="lb-first-party-spotlight__blocks">
                        {% for block in section.blocks %}
                          {{ block.content | raw }}
                        {% endfor %}
                      </div>
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Spotlight","tag":"section","settings":[{"type":"text","label":"Heading","default":"Made for daily buyers","id":"heading"},{"type":"text","label":"Subheading","id":"subheading"}],"blocks":[{"type":"badge","name":"Badge","settings":[]},{"type":"@app","name":"App block","settings":[]}],"presets":[{"name":"Spotlight","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                search-box:
                  path: 'sections/search-box.liquid'
                  schema:
                    tag: 'section'
                    name: 'Search'
                    blocks:
                    presets:
                      0:
                        name: 'Search'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'placeholder'
                        type: 'text'
                        label: 'Placeholder'
                        default: 'Search products'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-search" data-section-id="{{ section.id }}">
                      <lb-search data-lb-island="search" data-search-url="{{ routes.search_url }}">
                        <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>
                          <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>
                          <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="{{ section.settings.placeholder }}" aria-label="Search products" value="{{ search.terms }}">
                          <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>
                        </form>
                      </lb-search>
                      {% if search.terms %}<p class="lb-search__terms">Results for "{{ search.terms }}"</p>{% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Search","tag":"section","settings":[{"type":"text","label":"Placeholder","default":"Search products","id":"placeholder"}],"blocks":[],"presets":[{"name":"Search","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                video-hero:
                  path: 'sections/video-hero.liquid'
                  schema:
                    tag: 'section'
                    name: 'Video Hero'
                    blocks:
                    presets:
                      0:
                        name: 'Video Hero'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'See the fit in motion'
                      1:
                        id: 'subheading'
                        type: 'textarea'
                        label: 'Subheading'
                        default: 'A quick look at how each drop moves, from the box to your feet.'
                      2:
                        id: 'videoUrl'
                        info: 'A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.'
                        type: 'url'
                        label: 'Video embed URL'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-video-hero" data-section-id="{{ section.id }}">
                      <div class="lb-video-hero__copy">
                        <h2 class="lb-video-hero__heading">{{ section.settings.heading }}</h2>
                        {% if section.settings.subheading != blank %}<p class="lb-video-hero__subheading">{{ section.settings.subheading }}</p>{% endif %}
                      </div>
                      {% if section.settings.videoUrl != blank %}<div class="lb-video-hero__embed"><iframe src="{{ section.settings.videoUrl | video_url }}" title="{{ section.settings.heading }}" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allowfullscreen></iframe></div>{% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Video Hero","tag":"section","settings":[{"type":"text","label":"Heading","default":"See the fit in motion","id":"heading"},{"type":"textarea","label":"Subheading","default":"A quick look at how each drop moves, from the box to your feet.","id":"subheading"},{"type":"url","label":"Video embed URL","info":"A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.","id":"videoUrl"}],"blocks":[],"presets":[{"name":"Video Hero","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                cta-section:
                  path: 'sections/cta-section.liquid'
                  schema:
                    tag: 'section'
                    name: 'Call to Action'
                    blocks:
                    presets:
                      0:
                        name: 'Call to Action'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Ready to get started?'
                      1:
                        id: 'subheading'
                        type: 'text'
                        label: 'Subheading'
                      2:
                        id: 'ctaText'
                        type: 'text'
                        label: 'Button text'
                        default: 'Shop now'
                      3:
                        id: 'ctaLink'
                        type: 'url'
                        label: 'Button link'
                        default: '/products'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-cta-section" data-section-id="{{ section.id }}">
                      <h2>{{ section.settings.heading }}</h2>
                      <p>{{ section.settings.subheading }}</p>
                      <a href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Call to Action","tag":"section","settings":[{"type":"text","label":"Heading","default":"Ready to get started?","id":"heading"},{"type":"text","label":"Subheading","id":"subheading"},{"type":"text","label":"Button text","default":"Shop now","id":"ctaText"},{"type":"url","label":"Button link","default":"/products","id":"ctaLink"}],"blocks":[],"presets":[{"name":"Call to Action","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                hero-banner:
                  path: 'sections/hero-banner.liquid'
                  schema:
                    tag: 'section'
                    name: 'Editorial hero'
                    blocks:
                    presets:
                      0:
                        name: 'Editorial hero'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'eyebrow'
                        type: 'text'
                        label: 'Eyebrow'
                        default: 'THE EVERYDAY EDIT'
                      1:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Made to move with you.'
                      2:
                        id: 'subheading'
                        type: 'text'
                        label: 'Description'
                        default: 'Considered clothing for your everyday.'
                      3:
                        id: 'ctaText'
                        type: 'text'
                        label: 'Primary button'
                        default: 'Explore new arrivals'
                      4:
                        id: 'ctaLink'
                        type: 'url'
                        label: 'Primary destination'
                        default: '/products'
                      5:
                        id: 'secondaryText'
                        type: 'text'
                        label: 'Secondary link'
                        default: 'Find your fit'
                      6:
                        id: 'secondaryLink'
                        type: 'url'
                        label: 'Secondary destination'
                        default: '/products'
                      7:
                        id: 'image'
                        type: 'image'
                        label: 'Main campaign image'
                      8:
                        id: 'secondImage'
                        type: 'image'
                        label: 'Supporting campaign image'
                      9:
                        id: 'imageFocus'
                        type: 'select'
                        label: 'Image focal position'
                        default: 'center'
                        options:
                          0: 'center'
                          1: 'top'
                          2: 'bottom'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="tl-theme tl-hero tl-focus-{{ section.settings.imageFocus }}{% unless section.settings.image != blank %} tl-hero-empty{% endunless %}" data-section-id="{{ section.id }}">{% if section.settings.image != blank %}<div class="tl-hero-media"><img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.heading }}" fetchpriority="high" decoding="async">{% if section.settings.secondImage != blank %}<img src="{{ section.settings.secondImage | image_url }}" alt="" decoding="async">{% endif %}</div>{% endif %}<div class="tl-hero-copy"><span class="tl-eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="tl-button" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>{% endif %}{% if section.settings.secondaryText != blank and section.settings.secondaryLink != blank %}<a class="tl-link" href="{{ section.settings.secondaryLink | store_url }}">{{ section.settings.secondaryText }}</a>{% endif %}</div></section>
                    {% schema %}
                    {"name":"Editorial hero","tag":"section","settings":[{"type":"text","label":"Eyebrow","default":"THE EVERYDAY EDIT","id":"eyebrow"},{"type":"text","label":"Heading","default":"Made to move with you.","id":"heading"},{"type":"text","label":"Description","default":"Considered clothing for your everyday.","id":"subheading"},{"type":"text","label":"Primary button","default":"Explore new arrivals","id":"ctaText"},{"type":"url","label":"Primary destination","default":"/products","id":"ctaLink"},{"type":"text","label":"Secondary link","default":"Find your fit","id":"secondaryText"},{"type":"url","label":"Secondary destination","default":"/products","id":"secondaryLink"},{"type":"image","label":"Main campaign image","id":"image"},{"type":"image","label":"Supporting campaign image","id":"secondImage"},{"type":"select","label":"Image focal position","default":"center","options":["center","top","bottom"],"id":"imageFocus"}],"blocks":[],"presets":[{"name":"Editorial hero","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                blog-listing:
                  path: 'sections/blog-listing.liquid'
                  schema:
                    tag: 'section'
                    name: 'Blog Listing'
                    blocks:
                    presets:
                      0:
                        name: 'Blog Listing'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Our Blog'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-blog-listing" data-section-id="{{ section.id }}">
                      <h1 class="lb-blog-listing__heading">{{ section.settings.heading }}</h1>
                      {% if blog.articles and blog.articles.size > 0 %}
                      <div class="lb-blog-listing__articles">
                        {% for article in blog.articles %}
                        <article class="lb-blog-article-card">
                          <h2 class="lb-blog-article-card__title"><a href="{{ routes.blog_url }}/{{ article.slug }}">{{ article.title }}</a></h2>
                          {% if article.excerpt %}<p class="lb-blog-article-card__excerpt">{{ article.excerpt }}</p>{% endif %}
                          {% if article.published_at %}<time class="lb-blog-article-card__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}
                        </article>
                        {% endfor %}
                      </div>
                      {% if blog.pages_count and blog.pages_count > 1 %}
                      <nav class="lb-blog-listing__pagination" aria-label="Blog pagination">
                        {% if blog.current_page and blog.current_page > 1 %}<a class="lb-blog-listing__prev" href="{{ routes.blog_url }}?page={{ blog.current_page | minus: 1 }}" rel="prev">Previous</a>{% endif %}
                        {% assign next_page = blog.current_page | plus: 1 %}
                        {% if next_page <= blog.pages_count %}<a class="lb-blog-listing__next" href="{{ routes.blog_url }}?page={{ next_page }}" rel="next">Next</a>{% endif %}
                      </nav>
                      {% endif %}
                      {% else %}
                      <p class="lb-blog-listing__empty">No posts published yet.</p>
                      {% endif %}
                    </section>
                    </div>
                    {% schema %}
                    {"name":"Blog Listing","tag":"section","settings":[{"type":"text","label":"Heading","default":"Our Blog","id":"heading"}],"blocks":[],"presets":[{"name":"Blog Listing","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}
                    {% endschema %}
                cart-summary:
                  path: 'sections/cart-summary.liquid'
                  schema:
                    tag: 'section'
                    name: 'Cart'
                    blocks:
                    presets:
                      0:
                        name: 'Cart'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'heading'
                        type: 'text'
                        label: 'Heading'
                        default: 'Your cart'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <div class="tl-theme"><section class="lb-cart-page" data-section-id="{{ section.id }}">
                      <h1>{{ section.settings.heading }}</h1>
                      <lb-cart data-lb-island="cart" data-base-path="/store/{{ shop.subdomain }}">
                        {% if cart.item_count > 0 %}
                        <ul class="lb-cart__items">{% for item in cart.items %}<li class="lb-cart__item"><span class="lb-cart__title">{{ item.title }}</span><span class="lb-cart__qty">x{{ item.quantity }}</span><span class="lb-cart__line">{{ item.line_price | money_with_currency: cart.currency }}</span></li>{% endfor %}</ul>
                        <div class="lb-liquid-cart__totals">
                          {% if cart.subtotal %}<div class="lb-liquid-cart__row"><span>Subtotal</span><span>{{ cart.subtotal | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.coupon_codes.size > 0 %}<div class="lb-liquid-cart__row"><span>Coupons</span><span>{{ cart.coupon_codes | join: ", " }}</span></div>{% endif %}
                          {% if cart.discount_total %}<div class="lb-liquid-cart__row"><span>Discounts</span><span>{{ cart.discount_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.shipping_total %}<div class="lb-liquid-cart__row"><span>Shipping</span><span>{{ cart.shipping_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                          {% if cart.tax_total %}<div class="lb-liquid-cart__row"><span>Tax (GST)</span><span>{{ cart.tax_total | money_with_currency: cart.currency }}</span></div>{% endif %}
                        </div>
                        <p class="lb-cart__total">Total: {{ cart.total_price | money_with_currency: cart.currency }}</p>
                        <a class="lb-cart__checkout" href="{{ cart.checkout_url }}">Checkout</a>
                        {% else %}<p class="lb-cart__empty">Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>{% endif %}
                      </lb-cart>
                    </section>
                    </div>
