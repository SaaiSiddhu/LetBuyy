                about-section:
                  path: 'sections/about-section.liquid'
                  schema:
                    tag: 'section'
                    name: 'About Section'
                    blocks:
                    presets:
                      0:
                        name: 'About Section'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Title'
                        default: 'About us'
                      1:
                        id: 'content'
                        type: 'richtext'
                        label: 'Content'
                      2:
                        id: 'imageUrl'
                        type: 'image'
                        label: 'Image'
                      3:
