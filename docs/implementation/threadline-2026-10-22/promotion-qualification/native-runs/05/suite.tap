                about-section:
                  path: 'sections/about-section.liquid'
                  schema:
                    tag: 'section'
                    name: 'About Section'
                    blocks:
                    presets:
                      0:
                        name: 'About Section'
                        blocks:
                        settings:
                    settings:
                      0:
                        id: 'title'
                        type: 'text'
                        label: 'Title'
                        default: 'About us'
                      1:
                        id: 'content'
                        type: 'richtext'
                        label: 'Content'
                      2:
                        id: 'imageUrl'
                        type: 'image'
                        label: 'Image'
                      3:
                        id: 'layout'
                        type: 'select'
                        label: 'Layout'
                        default: 'left'
                        options:
                          0: 'left'
                          1: 'right'
                          2: 'center'
                    enabled_on:
                      templates:
                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    {% assign layout_value = section.settings.layout | default: 'left' %}
                    <section class="lb-about-section lb-about-section--layout-{{ layout_value }}" data-section-id="{{ section.id }}">
                      <div class="lb-about-section__body">
                        <h2>{{ section.settings.title }}</h2>
                        <div>{{ section.settings.content }}</div>
                      </div>
                      {% if section.settings.imageUrl %}<img class="lb-about-section__image" src="{{ section.settings.imageUrl | image_url }}" alt="{{ section.settings.title }}">{% endif %}
                    </section>
                    {% schema %}
