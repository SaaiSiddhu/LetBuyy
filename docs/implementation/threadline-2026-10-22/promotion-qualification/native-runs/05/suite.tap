                        0: '*'
                    disabled_on:
                      templates:
                  source: |-
                    <section class="lb-trust-badges" data-section-id="{{ section.id }}">
                      {% if section.settings.title %}<h2>{{ section.settings.title }}</h2>{% endif %}
