                          "settings": [
                            {
                              "id": "title",
                              "type": "text",
                              "label": "Title"
                            },
                            {
                              "id": "description",
                              "type": "textarea",
                              "label": "Description"
                            },
                            {
                              "id": "link",
                              "type": "url",
                              "label": "Link"
                            }
                          ]
                        }
                      ],
                      "presets": [
