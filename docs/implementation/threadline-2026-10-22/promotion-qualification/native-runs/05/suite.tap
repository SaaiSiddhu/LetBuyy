                          block_order:
                        carousel-monsoon:
                          type: 'slide'
                          blocks:
                          disabled: false
                          settings:
                            link: '/collections/new-arrivals'
                            heading: 'Monsoon-ready sneakers, restocked'
                          block_order:
                      disabled: false
                      settings:
                        title: 'This week'
                        autoplay: true
                      block_order:
                        0: 'carousel-monsoon'
                        1: 'carousel-apparel'
                    featured-collection-default:
                      type: 'featured-products'
                      blocks:
                      disabled: false
                      settings:
                        title: 'Drop-ready collection'
                        subtitle: 'Curated items for the first storefront launch.'
                        viewAllHref: '/collections/new-arrivals'
                        productLimit: 3
                        viewAllLabel: 'View collection'
                      block_order:
                footer:
                  name: 'LetBuyy Core footer'
                  order:
                    0: 'footer-default'
                  layout: 'theme'
                  sections:
                    footer-default:
                      type: 'footer'
                      blocks:
                      disabled: false
                      settings:
                      block_order:
                header:
                  name: 'LetBuyy Core header'
                  order:
                    0: 'announcement-default'
                    1: 'header-default'
                  layout: 'theme'
                  sections:
                    header-default:
                      type: 'header'
                      blocks:
                      disabled: false
                      settings:
                        behavior: 'sticky'
                        showCart: true
                        showSearch: true
                      block_order:
                    announcement-default:
                      type: 'announcement-bar'
                      blocks:
                      disabled: false
