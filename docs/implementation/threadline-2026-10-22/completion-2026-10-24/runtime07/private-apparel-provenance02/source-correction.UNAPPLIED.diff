+    return result;
+}
+test('canonical apparel schema produces an immutable garment and exact selected options', async () => {
+    const metadata = { apparel: structuredClone(garment), private_supplier_token: 'PRIVATE', unknown_app: { secret: 'PRIVATE' } };
