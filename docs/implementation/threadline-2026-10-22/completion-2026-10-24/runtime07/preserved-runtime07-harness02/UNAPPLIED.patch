+export async function qualifyPreservedRuntimeRestore(t:TestContext,owned:OwnedDatabase,saved:PreservedSaved) {
+  const tools=createRequire(import.meta.url)('../../../../../scripts/governance/owned-database-provision.mjs') as {measurePreservedDatabase(query:(sql:string)=>Promise<string>):Promise<Witness>};
