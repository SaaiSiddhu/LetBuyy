+    assert.notEqual(owned.runId,saved.capsule.application.fixtureId);
+    assert.equal(owned.psql('SELECT current_setting(\'letbuyy.fixture_run_id\');').trim(),owned.runId);
+    assert.equal(owned.psql(`SELECT count(*) FROM public.sites WHERE id='${saved.capsule.application.site.siteId}' AND subdomain='${saved.capsule.application.site.subdomain}';`).trim(),'1');
+  });
+  await t.test('positive populated state, every original accepted order retained',()=>{
+    assert(saved.capsule.witness.acceptedOrderIds.length>=7);
+    const ids=JSON.parse(owned.psql(`SELECT jsonb_agg(id::text ORDER BY id) FROM public.orders WHERE store_id='${saved.capsule.application.site.siteId}';`)) as string[];
+    assert.deepEqual(ids,saved.capsule.witness.acceptedOrderIds);
+    assert(Number(owned.psql('SELECT count(*) FROM public.theme_instances;'))>=10,'All installed theme instances must survive');
+  });
+  await t.test('full row, sequence, owner, ACL, function and RLS conservation',async()=>{
+    const actual=await tools.measurePreservedDatabase(async sql=>owned.scriptLarge(sql));
+    for(const key of ['dataSha256','profileSha256','sequenceSha256','acceptedOrderIds'] as const)assert.deepEqual(actual[key],saved.capsule.witness[key]);
+  });
+  await t.test('logical sequence definitions and permanent preservation classification are present',()=>{
+    const fixture=createRequire(import.meta.url)('../../../../../scripts/governance/executable-pg-fixture.mjs') as {inspectContainer(name:string):{Config:{Labels:Record<string,string>}};PRESERVATION_LABEL:string;PRESERVATION_VALUE:string};
+    assert.equal(fixture.inspectContainer(owned.container).Config.Labels[fixture.PRESERVATION_LABEL],fixture.PRESERVATION_VALUE);
+    assert(Number(owned.psql("SELECT count(*) FROM pg_sequence q JOIN pg_class c ON c.oid=q.seqrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public';"))>0,'Populated positive sequence definition control');
+    // Full logical state/definition/owner/ACL comparison is part of measurePreservedDatabase above.
+    // Do not mutate nextval/setval merely to qualify a preserved clone.
+  });
+  await t.test('internal foreign-key enforcement remains populated after logical restoration',()=>{
+    assert(Number(owned.psql("SELECT count(*) FROM pg_trigger t JOIN pg_constraint k ON k.oid=t.tgconstraint WHERE t.tgisinternal AND k.contype='f';"))>0,'Internal FK positive control');
+    // Exact expected full profile above includes count, enabled/event/function/constraint/
+    // reference/deferral/arguments and exact user-trigger definitions. Only generated
+    // internal physical OID naming is normalized; no trigger is omitted or rewritten.
+  });
+  await t.test('PG16 global role settings join resolves without exporting passwords',()=>{
+    assert.equal(owned.psql("SELECT count(*) FROM pg_authid a LEFT JOIN pg_db_role_setting s ON s.setrole=a.oid AND s.setdatabase=0 WHERE a.rolname='postgres';").trim(),'1');
+    // The complete profile comparison checks role/global settings and password hash
+    // conservation internally. No raw role secrets enter the TAP output.
+  });
+  // No browser/SSO/TLS/prebuilt/provider claim is made by this DB-only rehearsal.
+  // Those require a separate staged-build and controlled-cutover admission.
