// PREPARATION ONLY until root reviews the exact391 drafts and allocates a fresh
// through390 owned DB lease. This suite never uses an existing developer store.
// Real mounted worker + owned PostgreSQL/PostgREST; no app imports or mock router.
import assert from 'node:assert/strict';
import test, { after } from 'node:test';
import { randomUUID, createHash } from 'node:crypto';
import { readFileSync, writeFileSync, mkdtempSync, readdirSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { z } from 'zod';
import { closePooledSqlClients } from '@letbuyy/infrastructure/pooled-sql-adapter';
import { LiquidThemePackageBundleSchema, compilePortableToLiquidBundle } from '@letbuyy/theme-engine';
import { Gateway, gatewayEnv, newIdentityKeys, signedIdentityHeaders } from './gateway-harness';
import { requireOwnedDatabase, startOwnedPooledSqlProxy, type OwnedPooledSqlProxy } from './owned-db-support';
import { newSyntheticTenant, seedSyntheticTenant } from './synthetic-tenant';

const owned = requireOwnedDatabase();
const root = new URL('../../../../../', import.meta.url);
const docs = 'docs/implementation/threadline-2026-10-22/shared-group-durability/';
const read = (path: string) => readFileSync(new URL(path, root), 'utf8');
const sha = (value: string) => createHash('sha256').update(value).digest('hex');
const q = (value: string) => "'" + value.replaceAll("'", "''") + "'";
const record = (value: unknown): Record<string, unknown> => {
  assert(value && typeof value === 'object' && !Array.isArray(value));
  return value as Record<string, unknown>;
};
const canonical = (value: unknown): string => JSON.stringify(value, (_, item: unknown) =>
  item && typeof item === 'object' && !Array.isArray(item)
    ? Object.fromEntries(Object.entries(item).sort(([a], [b]) => a.localeCompare(b))) : item);
const signature = 'public.mutate_owned_theme_draft_v1(uuid,uuid,text,text,integer,text,text,jsonb,jsonb,uuid,text,jsonb)';
const oldBody = '2a6e74135720d0557ba921d517e88a13';
const newBody = 'f14f2252157119e56f6614decef4c4aa';
const upSha = '27fa0234ad98c4b924fb0d1ecec22e9f592ab533f438ca348f99e4c6bb17a17c';
const downSha = '7fea9fbf09df7f8f3af189ce3e406d3f7582ae2c371bf4dde225b59f91f25b54';
const up = read(docs + '391_shared_group_durability.up.draft.sql');
const down = read(docs + '391_shared_group_durability.down.draft.sql');
const hash = z.string().regex(/^[a-f0-9]{64}$/);
const admissionSchema = z.object({
  status: z.literal('ROOT_REVIEWED_FOR_OWNED_NATIVE_QUALIFICATION'),
  migration: z.literal(391), throughMigration: z.literal(390),
  upSha256: hash, downSha256: hash, suiteSha256: hash,
  rootReceiptPath: z.string().regex(/^docs\/implementation\/[a-zA-Z0-9_./-]+\.json$/),
  rootReceiptSha256: hash,
}).strict();

// PROPOSED392 dependency: inert until qualified native receipt and revised source
// are explicitly root-admitted. Never infer qualification from a draft.
const search392Signature = 'public.browse_storefront_products_v1(uuid,jsonb,uuid[])';
const search390Body = '95cda4d15f36172c5457ad5045600cde';
const search392Body = 'bdaec8db8f836e94294e4bdd9c449346';
const editor391Signature = 'public.mutate_owned_theme_draft_v1(uuid,uuid,text,text,integer,text,text,jsonb,jsonb,uuid,text,jsonb)';
const editor384Body = '2a6e74135720d0557ba921d517e88a13';
const editor391Body = 'f14f2252157119e56f6614decef4c4aa';
function qualified392Dependency(consumerPath: string) {
  const pin = z.string().regex(/^[a-f0-9]{64}$/);
  const admission = z.object({
    status: z.literal('ROOT_QUALIFIED392_DEPENDENT_CONSUMER_SOURCE_ADMITTED'), migration: z.literal(392),
    qualifiedRunId: z.string().regex(/^[a-f0-9]{12}$/),
    upPath: z.literal('docs/implementation/niche-themes-2026-10-23/circuit/discovery/search392/392_electronics_search.up.draft.sql'), downPath: z.literal('docs/implementation/niche-themes-2026-10-23/circuit/discovery/search392/392_electronics_search.down.draft.sql'),
    upSha256: z.literal('f17f659b8d037c34f02b9cc1cda912ede406bda7950f99310ebae5ca77c61171'), downSha256: z.literal('b66f348b56f8f45c60eacf1ba63e1f10177a2be6c0e9d33eb829649838d6a73e'),
    rootNativeReceiptPath: z.string().regex(/^docs\/implementation\/niche-theme-programme\/[a-zA-Z0-9_.-]+\.json$/),
    rootNativeReceiptSha256: pin,
    rootNativeReceiptStatus: z.enum(['ROOT_NATIVE392_QUALIFIED_THROUGH391_SOURCE_CONSERVATION_VERIFIED', 'ROOT_NATIVE392_QUALIFIED_SOURCE_CONSERVATION_VERIFIED']),
    historicalSuitePins: z.object({ 'services/api-gateway/src/__tests__/owned-db/theme-shared-groups.postgres.test.ts': z.literal('d549131349081802288196440f21bf1f7387543da126a1e5460cc44117a6044c'), 'services/api-gateway/src/__tests__/owned-db/niche-theme-promotion.postgres.test.ts': z.literal('c162f341fae53183bb73606322ebb291e339700562cd5f499918dd8602376739') }).strict(),
    revisedSuitePins: z.object({ 'services/api-gateway/src/__tests__/owned-db/theme-shared-groups.postgres.test.ts': pin, 'services/api-gateway/src/__tests__/owned-db/niche-theme-promotion.postgres.test.ts': pin }).strict(),
  }).strict().parse(JSON.parse(read('docs/implementation/threadline-2026-10-22/shared-group-durability/dependent-latest392/admission.json')));
  const up = read(admission.upPath), down = read(admission.downPath);
  assert.equal(sha(up), admission.upSha256); assert.equal(sha(down), admission.downSha256);
  const nativeBytes = read(admission.rootNativeReceiptPath); assert.equal(sha(nativeBytes), admission.rootNativeReceiptSha256);
  const native = record(JSON.parse(nativeBytes)); assert.equal(native.status, admission.rootNativeReceiptStatus);
  assert.equal(native.migration, 392); assert.equal(native.runId, admission.qualifiedRunId);
  const revisedPins: Record<string, string> = admission.revisedSuitePins;
  assert.equal(sha(readFileSync(new URL(import.meta.url), 'utf8')), revisedPins[consumerPath], 'new source requires its own root-qualified392 admission; old receipts remain immutable');
  return { admission, up, down };
}
function search392Profile(withoutBrowseBody = false) {
  return owned.psql(`SELECT coalesce(jsonb_agg(jsonb_build_object(
    'row',CASE WHEN ${withoutBrowseBody ? 'true' : 'false'} AND p.oid=${q(search392Signature)}::regprocedure THEN to_jsonb(p)-'prosrc' ELSE to_jsonb(p) END,
    'comment',obj_description(p.oid,'pg_proc'),
    'dependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_depend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid),
    'sharedDependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_shdepend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid AND d.dbid=(SELECT oid FROM pg_database WHERE datname=current_database()))) ORDER BY p.proname),'[]')
    FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='public' AND(p.proname LIKE 'storefront_discovery_%_v1' OR p.proname IN('browse_storefront_products_v1','browse_storefront_apparel_v1'));`);
}
function fullEditor391Profile() {
  return owned.psql(`SELECT jsonb_build_object('row',to_jsonb(p),'comment',obj_description(p.oid,'pg_proc'),
    'dependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_depend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid),
    'sharedDependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_shdepend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid AND d.dbid=(SELECT oid FROM pg_database WHERE datname=current_database())))
    FROM pg_proc p WHERE p.oid=${q(editor391Signature)}::regprocedure;`);
}
function dependent392Rows() {
  const tables = ['products','product_variants','product_options','inventory_levels','collections','collection_products',
    'orders','order_items','carts','themes','theme_packages','theme_package_versions','theme_schema_manifests','theme_renderer_manifests',
    'sites','store_themes','theme_instances','theme_instance_drafts','theme_editor_drafts','theme_draft_patches','theme_releases',
    'idempotency_keys','audit_activity_events','outbox_events'];
  return owned.psql(`SELECT md5(jsonb_build_object(${tables.flatMap(table => [q(table), `(SELECT coalesce(jsonb_agg(to_jsonb(t) ORDER BY to_jsonb(t)::text),'[]') FROM public.${table} t)`]).join(',')})::text);`);
}
function assertActual392Emission(dependency: { up: string; down: string }) {
  for (const [directory, expected] of [['migrations', dependency.up], ['rollback', dependency.down]] as const) {
    const prefix = `database/supabase/${directory}/`;
    const files = readdirSync(new URL(prefix, root)).filter(name => /^392_[^/]+\.sql$/.test(name));
    assert.equal(files.length, 1, 'known392 entry must name the exact paired emitted source, never guess a later migration');
    assert.equal(read(prefix + files[0]), expected);
  }
}

let gateway: Gateway, proxy: OwnedPooledSqlProxy, evidenceDirectory: string;
after(async () => { await gateway?.settle(); await closePooledSqlClients(); await proxy?.stop(); });

function pinnedThreadlineInput(manifest: Record<string, unknown>) {
  const pin = record(record(manifest.protected).threadline);
  const path = 'database/supabase/migrations/382_threadline_catalog_v2.sql';
  assert.equal(pin.path, path); assert.equal(pin.excludedFromPromotion, true);
  const sql = read(path); assert.equal(sha(sql), pin.fileSha256);
  assert.equal(pin.fileSha256, '475717e0f7afd78327ce89b55768e0a13347394a98a2bfcf8bfad19ed088b9dc');
  const payloadBytes = sql.match(/\$liquidbundle\$([\s\S]*?)\$liquidbundle\$::jsonb/)?.[1]; assert(payloadBytes);
  assert.equal(sha(payloadBytes), pin.payloadSha256);
  assert.equal(pin.payloadSha256, 'e3b97f84ac1d2472eebd853946e548002fde1f2daf6bb5277004a6b8884aac8a');
  const artifact = record(JSON.parse(payloadBytes)), document = record(artifact.document);
  const bundle = LiquidThemePackageBundleSchema.parse(document.liquidBundle);
  assert.equal(bundle.package.slug, 'letbuyy-sense'); assert.equal(bundle.package.version, '2.0.0');
  assert.equal(sha(JSON.stringify(bundle)), pin.bundleSha256);
  assert.equal(sha(JSON.stringify(document.liquidBundle)), pin.rawBundleJsonSha256);
  assert.equal(pin.bundleSha256, '61082be647eadae9b6e42002be241a82ba6c3627427568f6e64e2cf961c3742e');
  return { slug: 'letbuyy-sense', artifact, bytesSha256: sha(payloadBytes),
    sourcePath: path, sourceSha256: sha(sql), sourceKind: 'QUALIFIED382_PINNED_DESCRIPTOR' };
}
function admittedInputs() {
  assert.equal(sha(up), upSha); assert.equal(sha(down), downSha);
  assert.equal(sha(read('database/supabase/migrations/384_theme_editor_template_keys.sql')),
    'e7304c2306956dd3784175d4f735e3d8f9029ddc1631f97b9d396d1ee9f55cca');
  const admission = admissionSchema.parse(JSON.parse(read(docs + 'admission.json')));
  assert.equal(admission.upSha256, upSha); assert.equal(admission.downSha256, downSha);
  assert.equal(admission.suiteSha256, 'd549131349081802288196440f21bf1f7387543da126a1e5460cc44117a6044c', 'historical qualified391 source identity stays immutable');
  const dependency392 = qualified392Dependency('services/api-gateway/src/__tests__/owned-db/theme-shared-groups.postgres.test.ts');
  assert(!admission.rootReceiptPath.split('/').includes('..'));
  const receiptBytes = read(admission.rootReceiptPath);
  assert.equal(sha(receiptBytes), admission.rootReceiptSha256);
  const receipt = record(JSON.parse(receiptBytes));
  assert.equal(receipt.status, admission.status); assert.equal(receipt.migration, 391);
  assert.equal(receipt.throughMigration, 390); assert.equal(receipt.upSha256, upSha);
  assert.equal(receipt.downSha256, downSha); assert.equal(receipt.suiteSha256, admission.suiteSha256);
  const manifestPath = 'docs/implementation/niche-theme-programme/release-v2/proposals/81e91859ebc8c497a49da337d064e1885a76964839d14e39f4a0a3de2283f47f/';
  const manifestBytes = read(manifestPath + 'manifest.json');
  assert.equal(sha(manifestBytes), 'c0e8d5b7338a70a797a2acc24976700a146f8df4f9a3716d55fab4c03e8cf515');
  const manifest = record(JSON.parse(manifestBytes));
  assert.equal(manifest.manifestSha256, '81e91859ebc8c497a49da337d064e1885a76964839d14e39f4a0a3de2283f47f');
  assert(Array.isArray(manifest.artifacts)); assert.equal(manifest.artifacts.length, 9);
  const artifacts = manifest.artifacts.map(value => {
    const row = record(value); assert.equal(row.file, `${row.slug}-2.0.0.json`);
    const bytes = read(manifestPath + row.file); assert.equal(sha(bytes), row.fileSha256);
    const artifact = record(JSON.parse(bytes)); assert.equal(artifact.slug, row.slug); assert.equal(artifact.version, '2.0.0');
    return { slug: String(row.slug), artifact, bytesSha256: sha(bytes),
      sourcePath: manifestPath + row.file, sourceSha256: sha(bytes), sourceKind: 'ADMITTED389_DISK_ARTIFACT' };
  });
  assert.equal(new Set(artifacts.map(a => a.slug)).size, 9);
  artifacts.push(pinnedThreadlineInput(manifest));
  assert.equal(artifacts.length, 10); assert.equal(new Set(artifacts.map(a => a.slug)).size, 10);
  return { admission, artifacts, dependency392 };
}
function proof(name: string, value: unknown) {
  const bytes = JSON.stringify(value, null, 2) + '\n';
  const path = join(evidenceDirectory, name + '.json');
  writeFileSync(path, bytes, { mode: 0o600, flag: 'wx' });
  console.info('SHARED_GROUP391_PROVENANCE', JSON.stringify({ path, sha256: sha(bytes) }));
}
const parse = (sql: string): unknown => JSON.parse(owned.scriptLarge(sql));
function digest(tables: readonly string[]) {
  for (const table of tables) assert.match(table, /^[a-z_]+$/);
  return owned.psql(`SELECT md5(jsonb_build_object(${tables.flatMap(table => [q(table),
    `(SELECT coalesce(jsonb_agg(to_jsonb(x) ORDER BY x.id),'[]') FROM public.${table} x)`]).join(',')})::text);`);
}
const immutable = () => digest(['theme_packages', 'theme_package_versions', 'theme_schema_manifests', 'theme_renderer_manifests']);
const state = () => digest(['themes', 'theme_packages', 'theme_package_versions', 'theme_schema_manifests', 'theme_renderer_manifests',
  'sites', 'store_themes', 'theme_instances', 'theme_instance_drafts', 'theme_editor_drafts', 'theme_draft_patches',
  'theme_releases', 'idempotency_keys', 'audit_activity_events', 'outbox_events']);
const bodyHash = () => owned.psql(`SELECT md5(prosrc) FROM pg_proc WHERE oid=${q(signature)}::regprocedure;`);
function profile(withBody = true) {
  return owned.psql(`SELECT jsonb_build_object('row',${withBody ? 'to_jsonb(p)' : "to_jsonb(p)-'prosrc'"},
    'comment',obj_description(p.oid,'pg_proc'),
    'dependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_depend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid),
    'sharedDependencies',(SELECT coalesce(jsonb_agg(to_jsonb(d) ORDER BY to_jsonb(d)::text),'[]') FROM pg_shdepend d WHERE d.classid='pg_proc'::regclass AND d.objid=p.oid AND d.dbid=(SELECT oid FROM pg_database WHERE datname=current_database())))
    FROM pg_proc p WHERE p.oid=${q(signature)}::regprocedure;`);
}
function privateRoles() {
  for (const role of ['anon', 'authenticated', 'app_tenant', 'authenticator']) {
    assert.equal(owned.psql(`SELECT has_function_privilege(${q(role)},${q(signature)},'EXECUTE');`), 'f');
    assert.match(owned.psqlExpectError(`SET ROLE ${role};SELECT public.mutate_owned_theme_draft_v1(NULL,NULL,NULL,'index',0,'native391-denied','save');`), /permission denied for function/);
  }
  assert.equal(owned.psql(`SELECT has_function_privilege('service_role',${q(signature)},'EXECUTE');`), 't');
  assert.equal(owned.psql(`SELECT has_function_privilege(proowner,oid,'EXECUTE') FROM pg_proc WHERE oid=${q(signature)}::regprocedure;`), 't');
}
function profileRefusals(script: string) {
  assert.equal(script.match(/^BEGIN;$/gm)?.length, 1); assert.equal(script.match(/^COMMIT;$/gm)?.length, 1);
  const inner = script.replace(/^BEGIN;$/m, '').replace(/^COMMIT;$/m, '');
  const mutations = [
    `ALTER FUNCTION ${signature} COST 101;`,
    `ALTER FUNCTION ${signature} SET search_path=public,pg_temp;`,
    `UPDATE pg_proc SET prosrc=prosrc||E'\\n-- unknown391 body' WHERE oid=${q(signature)}::regprocedure;`,
    `GRANT EXECUTE ON FUNCTION ${signature} TO anon;`,
    `UPDATE pg_proc p SET proacl=(SELECT array_agg(makeaclitem(a.grantee,CASE WHEN a.grantee='service_role'::regrole THEN 'anon'::regrole::oid ELSE a.grantor END,a.privilege_type,a.is_grantable) ORDER BY a.grantee,a.grantor) FROM aclexplode(p.proacl) a) WHERE p.oid=${q(signature)}::regprocedure;`,
    'REVOKE app_tenant FROM service_role; GRANT service_role TO app_tenant WITH INHERIT TRUE;',
    'GRANT service_role TO authenticator WITH INHERIT TRUE;',
  ];
  for (const mutation of mutations) {
    const before = profile(), rows = state();
    const error = owned.psqlScriptExpectError(`BEGIN;${mutation}\n${inner}\nROLLBACK;`);
    assert.match(error, /Draft391 refuses changed draft definition, owner, grantor or effective privileges/);
    assert.equal(profile(), before, 'real refused transaction restores exact profile/ACL/default AST/dependencies');
    assert.equal(state(), rows, 'refused admission never rewrites business rows');
  }
  privateRoles();
}
type Field = { template: string; section: string; key: string };
function chooseField(config: Record<string, unknown>, schemas: Record<string, unknown>, template: string): Field {
  const sections = record(record(record(config.templates)[template]).sections);
  const preferences = template === 'header' ? ['text', 'storeName'] : template === 'footer' ? ['storeName'] : ['heading', 'title', 'eyebrow', 'text'];
  for (const key of preferences) for (const [id, value] of Object.entries(sections)) {
    const section = record(value), schema = record(record(schemas.sections)[String(section.type)]);
    const field = record(schema.settings_schema)[key];
    if (field && ['text', 'textarea'].includes(String(record(field).type))) return { template, section: id, key };
  }
  assert.fail(`No declared editable text field in actual ${template} schema`);
}
function setField(config: Record<string, unknown>, field: Field, value: string) {
  const section = record(record(record(record(config.templates)[field.template]).sections)[field.section]);
  section.settings = { ...record(section.settings || {}), [field.key]: value };
}
function fieldValue(config: Record<string, unknown>, field: Field): unknown {
  return record(record(record(record(record(config.templates)[field.template]).sections)[field.section]).settings || {})[field.key];
}
function projected(config: Record<string, unknown>) {
  return compilePortableToLiquidBundle(config, { baseBundle: LiquidThemePackageBundleSchema.parse(config.liquidBundle) }).bundle;
}

test('reviewed391 preserves changed shared groups across all ten actual themes with missing-group coverage and exact rollback', async t => {
  let preservedDiscoveryBaseline = "";
  const stage = async (name: string, work: () => void | Promise<void>) => {
    let passed = false; await t.test(name, async () => { await work(); assert(preservedDiscoveryBaseline); assert.equal(search392Profile(), preservedDiscoveryBaseline, 'every existing391 phase conserves the exact390 discovery catalog'); passed = true; });
    assert(passed, `Stopped dependent qualification after failed phase: ${name}`);
  };
  const { admission, artifacts, dependency392 } = admittedInputs();
  evidenceDirectory = mkdtempSync(join(tmpdir(), `letbuyy-shared391-${owned.runId}-`));
  const entryBody = bodyHash();
  assert([oldBody, newBody].includes(entryBody), 'unknown editor body refuses before any DDL');
  const browseEntryBody = owned.psql(`SELECT md5(prosrc) FROM pg_proc WHERE oid=${q(search392Signature)}::regprocedure;`);
  assert([search390Body, search392Body].includes(browseEntryBody), 'unknown browse body refuses before any DDL');
  const entryMode = browseEntryBody === search392Body ? 'LATEST_EXACT_ROOT_QUALIFIED392' : entryBody === newBody ? 'LATEST_EXACT_ROOT_REVIEWED391' : 'FRESH_THROUGH390';
  const entryProfile = profile(), entryNonBodyProfile = profile(false), entryRows = state();
  const entryDiscoveryProfile = search392Profile(), entryDiscoveryNonBody = search392Profile(true);
  const entryDependencyRows = dependent392Rows();
  if (browseEntryBody === search392Body) {
    assert.equal(entryBody, newBody, '392 requires the exact391 predecessor'); assertActual392Emission(dependency392);
    owned.script(dependency392.down);
    assert.equal(owned.psql(`SELECT md5(prosrc) FROM pg_proc WHERE oid=${q(search392Signature)}::regprocedure;`), search390Body);
    assert.equal(search392Profile(true), entryDiscoveryNonBody); assert.equal(profile(), entryProfile);
    assert.equal(dependent392Rows(), entryDependencyRows);
  }
  preservedDiscoveryBaseline = search392Profile();
  if (entryBody === newBody) {
    // A default-LATEST run may already contain the exact admitted391 body.
    // The strict paired DOWN establishes the same complete baseline phases;
    // no skipped acceptance, profile normalization, or data rewrite is allowed.
    owned.script(down); assert.equal(bodyHash(), oldBody);
    assert.equal(profile(false), entryNonBodyProfile); assert.equal(state(), entryRows);
  }
  assert.equal(owned.psql("SELECT md5(prosrc) FROM pg_proc WHERE oid='public.browse_storefront_products_v1(uuid,jsonb,uuid[])'::regprocedure;"), '95cda4d15f36172c5457ad5045600cde');
  const a = newSyntheticTenant('shared391-a'), b = newSyntheticTenant('shared391-b');
  seedSyntheticTenant(owned.psql, a); seedSyntheticTenant(owned.psql, b);
  const actor = randomUUID(), foreign = randomUUID(), email = `shared-${actor}@example.invalid`, foreignEmail = `shared-${foreign}@example.invalid`;
  owned.psql(`INSERT INTO users_custom(id,email,email_verified) VALUES(${q(actor)},${q(email)},true),(${q(foreign)},${q(foreignEmail)},true);
    UPDATE sites SET custom_user_id=${q(actor)},theme_id='letbuyy-core' WHERE id=${q(a.siteId)};
    UPDATE sites SET custom_user_id=${q(foreign)},theme_id='letbuyy-core' WHERE id=${q(b.siteId)};
    INSERT INTO subscriptions(user_id,store_id,plan,status) VALUES(${q(actor)},${q(a.siteId)},'enterprise','active'),(${q(foreign)},${q(b.siteId)},'enterprise','active');`);
  proxy = await startOwnedPooledSqlProxy(owned); gateway = new Gateway(gatewayEnv(owned, await newIdentityKeys(), proxy.env()));
  const request = async (path: string, method = 'GET', value?: unknown, other = false) => {
    // Drain socket-close notifications after synchronous native SQL; no retry.
    await new Promise<void>(resolve => setImmediate(resolve));
    const response = await gateway.request(path, { method,
      headers: await signedIdentityHeaders(other ? foreign : actor, other ? foreignEmail : email, other ? b.siteId : a.siteId),
      ...(value === undefined ? {} : { body: JSON.stringify(value) }) });
    await gateway.settle(); return response;
  };
  type Response = Awaited<ReturnType<typeof request>>;
  const data = (response: Response) => record(response.json?.data);
  const load = async (slug: string, key = 'index') => {
    const response = await request(`/v1/themes/${slug}/editor?store_id=${a.siteId}&template_key=${encodeURIComponent(key)}`);
    assert.equal(response.status, 200, response.text); return data(response);
  };
  const save = (slug: string, config: unknown, version: unknown, key = 'index', intent = randomUUID(), other = false) =>
    request(`/v1/themes/${slug}/editor/draft`, 'PUT', { store_id: a.siteId, template_key: key,
      template_config: config, base_version: version, idempotency_key: intent }, other);
  const capture = (slug: string) => {
    const value = record(parse(`SELECT jsonb_build_object('package_id',p.id,'version_id',v.id,'document',t.default_template,'version',v.version)
      FROM themes t JOIN theme_packages p ON p.slug=t.slug AND p.legacy_theme_id=t.id
      JOIN theme_package_versions v ON v.theme_package_id=p.id AND v.version='2.0.0' AND v.deleted_at IS NULL
      WHERE t.slug=${q(slug)} AND p.status='active' AND v.release_status='published';`));
    assert.equal(value.version, '2.0.0'); return value;
  };
  const install = async (slug: string) => {
    const selected = capture(slug);
    const response = await request(`/v1/themes/${slug}/install`, 'POST', { store_id: a.siteId, expected_version: '2.0.0',
      expected_package_id: selected.package_id, expected_package_version_id: selected.version_id });
    assert.equal(response.status, 201, response.text); assert.equal(data(response).theme_package_version_id, selected.version_id);
    return selected;
  };
  // A schema read may materialize the pinned382 version via the canonical
  // registry. Establish its actual capture before freezing the immutable digest.
  const threadlineSchema = await request('/v1/themes/letbuyy-sense/schema');
  assert.equal(threadlineSchema.status, 200, threadlineSchema.text);
  for (const item of artifacts) assert.equal(canonical(capture(item.slug).document), canonical(item.artifact.document));
  const capturesBefore = immutable();
  const protectedThreadlineRow = record(parse("SELECT to_jsonb(t) FROM themes t WHERE slug='letbuyy-sense';"));
  const protectedThreadline = sha(canonical(protectedThreadlineRow));
  const assertThreadlineCatalog = () => {
    const current = record(parse("SELECT jsonb_build_object('row',to_jsonb(t),'activeCount',(SELECT count(*) FROM store_themes st WHERE st.theme_id=t.id AND st.is_active), 'lastInstallUpdate',(SELECT max(updated_at) FROM store_themes st WHERE st.theme_id=t.id)) FROM themes t WHERE slug='letbuyy-sense';"));
    // Actual merchant installation necessarily drives the existing baseline
    // update_theme_install_count() trigger. Prove its exact count/timestamp,
    // then compare every other catalog field to the protected382 row.
    const expected = { ...protectedThreadlineRow, install_count: current.activeCount,
      updated_at: current.lastInstallUpdate ?? protectedThreadlineRow.updated_at };
    assert.equal(canonical(current.row), canonical(expected), 'only exact native active-install trigger fields may change; all382 catalog content remains protected');
    return { rowSha256: sha(canonical(current.row)), activeCount: current.activeCount,
      lastInstallUpdate: current.lastInstallUpdate, protectedContentSha256: sha(canonical(record(current.row).default_template)) };
  };
  const baselineProfile = profile(), nonBodyProfile = profile(false);
  proof('entry', { runId: owned.runId, admission, entryMode, entryBody, entryProfile: JSON.parse(entryProfile),
    entryStateDigest: entryRows, pairedEntryDownConservedState: entryBody === newBody,
    browseEntryBody, entryDiscoveryProfile: JSON.parse(entryDiscoveryProfile), paired392EntryDown: browseEntryBody === search392Body,
    baselineProfile: JSON.parse(baselineProfile),
    immutableDigest: capturesBefore, artifacts: artifacts.map(({ slug, bytesSha256, sourcePath, sourceSha256, sourceKind }) => ({ slug, bytesSha256, sourcePath, sourceSha256, sourceKind })) });

  await stage('actual qualified384 worker save reproduces changed shared groups being overwritten while selected page persists', async () => {
    await install('letbuyy-aura'); let loaded = await load('letbuyy-aura');
    const first = await save('letbuyy-aura', loaded.template_config, loaded.version); assert.equal(first.status, 200, first.text);
    loaded = await load('letbuyy-aura'); const before = structuredClone(record(loaded.template_config));
    const config = structuredClone(before), schemas = record(loaded.schemas);
    const header = chooseField(config, schemas, 'header'), footer = chooseField(config, schemas, 'footer'), local = chooseField(config, schemas, 'index');
    setField(config, header, 'Native391 before header'); setField(config, footer, 'Native391 before footer'); setField(config, local, 'Native391 before local');
    const changed = await save('letbuyy-aura', config, loaded.version); assert.equal(changed.status, 200, changed.text);
    const reloaded = record((await load('letbuyy-aura')).template_config);
    assert.equal(fieldValue(reloaded, header), fieldValue(before, header)); assert.equal(fieldValue(reloaded, footer), fieldValue(before, footer));
    assert.equal(fieldValue(reloaded, local), 'Native391 before local');
    assert.equal(canonical(reloaded.liquidBundle), canonical(before.liquidBundle));
    proof('baseline-real-worker-defect', { acknowledgementVersion: data(changed).version,
      submittedHeader: fieldValue(config, header), reloadedHeader: fieldValue(reloaded, header),
      submittedFooter: fieldValue(config, footer), reloadedFooter: fieldValue(reloaded, footer), selectedLocal: fieldValue(reloaded, local) });
  });
  await stage('UP rejects profile/ACL/grantor/inherited drift, then changes only the known body and replays without data writes', () => {
    privateRoles(); profileRefusals(up); const rows = state();
    owned.script(up); assert.equal(bodyHash(), newBody); assert.equal(profile(false), nonBodyProfile); assert.equal(state(), rows);
    const upgraded = profile(); owned.script(up); assert.equal(profile(), upgraded); assert.equal(state(), rows); privateRoles();
    proof('profile-current-proposed', { currentSourceProfile: JSON.parse(baselineProfile), proposedProfile: JSON.parse(upgraded),
      currentProsrcMd5: oldBody, proposedProsrcMd5: newBody, conservedNonBodyProfile: JSON.parse(nonBodyProfile) });
  });
  await stage('all ten changed groups and omitted groups survive reload, page preservation, concurrency, denials and publication', async () => {
    const ownB = await request(`/v1/themes?store_id=${b.siteId}`, 'GET', undefined, true); assert.equal(ownB.status, 200, ownB.text);
    for (const { slug } of artifacts) {
      const selected = await install(slug); let loaded = await load(slug);
      const original = structuredClone(record(loaded.template_config)), baseBundle = canonical(original.liquidBundle);
      const originalTemplates = structuredClone(record(original.templates));
      // Only root templates are edited. The captured Liquid package stays immutable.
      let config = structuredClone(original); record(record(config.templates).page).name = `Native391 saved page ${slug}`;
      let saved = await save(slug, config, loaded.version, 'page'); assert.equal(saved.status, 200, saved.text);
      loaded = await load(slug, 'page'); config = structuredClone(record(loaded.template_config));
      record(config.templates)['page.fixture391'] = { ...structuredClone(record(record(config.templates).page)), name: `Native391 saved alternate ${slug}` };
      saved = await save(slug, config, loaded.version, 'page.fixture391'); assert.equal(saved.status, 200, saved.text);
      loaded = await load(slug); config = structuredClone(record(loaded.template_config));
      const previous = structuredClone(config), schemas = record(loaded.schemas);
      const header = chooseField(config, schemas, 'header'), footer = chooseField(config, schemas, 'footer'), local = chooseField(config, schemas, 'index');
      const markers = { header: `Native391 header ${slug}`, footer: `Native391 footer ${slug}`, local: `Native391 local ${slug}` };
      setField(config, header, markers.header); setField(config, footer, markers.footer); setField(config, local, markers.local);
      // A stale editor tab cannot replace any unselected saved page/alternate.
      record(config.templates).page = structuredClone(originalTemplates.page);
      record(config.templates)['page.fixture391'] = { ...structuredClone(record(originalTemplates.page)), name: 'Stale incoming alternate must lose' };
      const intent = randomUUID(), beforePatch = Number(owned.psql(`SELECT count(*) FROM theme_draft_patches WHERE store_id=${q(a.siteId)};`));
      const beforeOutbox = Number(owned.psql(`SELECT count(*) FROM outbox_events WHERE store_id=${q(a.siteId)} AND event_type='theme.draft.saved';`));
      const concurrent = await Promise.all([save(slug, config, loaded.version, 'index', intent), save(slug, config, loaded.version, 'index', intent), save(slug, config, loaded.version, 'index', intent)]);
      for (const response of concurrent) assert.equal(response.status, 200, response.text);
      let version = data(concurrent[0]).version; assert.equal(version, Number(loaded.version) + 1);
      assert(concurrent.every(response => data(response).version === version));
      assert.equal(concurrent.filter(response => data(response).replayed === true).length, 2);
      assert.equal(Number(owned.psql(`SELECT count(*) FROM theme_draft_patches WHERE store_id=${q(a.siteId)};`)), beforePatch + 1);
      assert.equal(Number(owned.psql(`SELECT count(*) FROM outbox_events WHERE store_id=${q(a.siteId)} AND event_type='theme.draft.saved';`)), beforeOutbox + 1);
      const reloaded = await load(slug); let result = record(reloaded.template_config);
      assert.equal(reloaded.version, version); assert.equal(fieldValue(result, header), markers.header);
      assert.equal(fieldValue(result, footer), markers.footer); assert.equal(fieldValue(result, local), markers.local);
      for (const [key, template] of Object.entries(record(previous.templates))) if (!['header', 'footer', 'index'].includes(key))
        assert.equal(canonical(record(result.templates)[key]), canonical(template), `unselected ${key} retained`);
      assert.equal(canonical(result.liquidBundle), baseBundle, 'unchanged immutable base is expected');
      const compiled = projected(result);
      for (const [field, marker] of [[header, markers.header], [footer, markers.footer], [local, markers.local]] as const)
        assert.equal(fieldValue({ templates: compiled.templates }, field), marker);
      const rows = state();
      const retry = await save(slug, config, loaded.version, 'index', intent); assert.equal(retry.status, 200, retry.text); assert.equal(data(retry).replayed, true); assert.equal(state(), rows);
      const stale = await save(slug, config, loaded.version); assert.equal(stale.status, 409, stale.text); assert.equal(state(), rows);
      const reused = structuredClone(config); setField(reused, local, 'Changed content reuses same key');
      assert.equal((await save(slug, reused, version, 'index', intent)).status, 409); assert.equal(state(), rows);
      const foreignSave = await save(slug, config, version, 'index', randomUUID(), true);
      assert([403, 404].includes(foreignSave.status), foreignSave.text); assert.equal(state(), rows);
      const invalid = structuredClone(config); record(record(invalid.templates).header).sections = { unapproved: { type: 'unapproved-native391', settings: {} } };
      assert.equal((await save(slug, invalid, version)).status, 400); assert.equal(state(), rows);
      const omissionProofs: Array<Record<string, unknown>> = [];
      for (const omitted of [['header'], ['footer'], ['header', 'footer']]) {
        const prior = structuredClone(result), partial = structuredClone(result), localMarker = `${markers.local} omitted-${omitted.join('-')}`;
        for (const key of omitted) delete record(partial.templates)[key];
        setField(partial, local, localMarker);
        record(partial.templates).page = structuredClone(originalTemplates.page);
        record(partial.templates)['page.fixture391'] = { ...structuredClone(record(originalTemplates.page)), name: 'Stale incoming alternate must lose' };
        const changed = await save(slug, partial, version); assert.equal(changed.status, 200, changed.text);
        const readback = await load(slug), retained = record(readback.template_config);
        assert.equal(readback.version, Number(version) + 1); assert.equal(data(changed).version, readback.version);
        assert.equal(fieldValue(retained, header), markers.header); assert.equal(fieldValue(retained, footer), markers.footer);
        assert.equal(fieldValue(retained, local), localMarker);
        for (const [key, template] of Object.entries(record(prior.templates))) if (key !== 'index')
          assert.equal(canonical(record(retained.templates)[key]), canonical(template), `missing ${omitted.join('/')} preserves saved ${key}`);
        assert.equal(canonical(retained.liquidBundle), baseBundle);
        omissionProofs.push({ omitted, acknowledgedVersion: data(changed).version, reloadedVersion: readback.version,
          header: fieldValue(retained, header), footer: fieldValue(retained, footer), selectedLocal: fieldValue(retained, local) });
        version = readback.version; result = retained; markers.local = localMarker;
      }
      const published = await request(`/v1/themes/${slug}/publish`, 'POST', { store_id: a.siteId,
        base_version: version, idempotency_key: randomUUID(), make_store_live: true });
      assert.equal(published.status, 200, published.text);
      const release = record(parse(`SELECT to_jsonb(r) FROM sites s JOIN theme_releases r ON r.id=s.current_theme_release_id WHERE s.id=${q(a.siteId)};`));
      assert.equal(release.theme_package_version_id, selected.version_id);
      assert.equal(canonical(release.template_snapshot), canonical(result));
      await new Promise<void>(resolve => setImmediate(resolve));
      const publishedRead = await gateway.request(`/v1/storefront/${a.subdomain}?projection=render-v1`);
      await gateway.settle(); assert.equal(publishedRead.status, 200, publishedRead.text);
      const publicConfig = record(record(publishedRead.json?.data).template_config);
      assert.equal(canonical(publicConfig), canonical(result));
      for (const [field, marker] of [[header, markers.header], [footer, markers.footer], [local, markers.local]] as const)
        assert.equal(fieldValue(publicConfig, field), marker);
      assert.equal(immutable(), capturesBefore, 'edit/save/publish never changes accepted package/version/schema/renderer captures');
      const protectedCatalog = assertThreadlineCatalog();
      proof(slug, { version, fields: { header, footer, local }, markers,
        packageId: selected.package_id, packageVersionId: selected.version_id, releaseId: release.id,
        rootSha256: sha(canonical(result)), immutableBaseSha256: sha(baseBundle),
        projectedSha256: sha(canonical(projected(result))), publicStatus: publishedRead.status, omissionProofs, protectedCatalog });
    }
  });
  await stage('a real late outbox failure rolls back shared edits, draft revision, patch, audit and receipt atomically', async () => {
    const slug = 'letbuyy-aura', loaded = await load(slug), config = structuredClone(record(loaded.template_config));
    const header = chooseField(config, record(loaded.schemas), 'header'); setField(config, header, 'Native391 must roll back');
    const rows = state(), functionName = 'native391_outbox_fault_' + owned.runId.replaceAll('-', '_');
    assert.match(functionName, /^[a-z0-9_]+$/);
    owned.script(`CREATE FUNCTION public.${functionName}() RETURNS trigger LANGUAGE plpgsql AS $fault$ BEGIN
      IF NEW.store_id=${q(a.siteId)}::uuid AND NEW.event_type='theme.draft.saved' THEN RAISE EXCEPTION 'synthetic391 late outbox failure'; END IF;
      RETURN NEW; END $fault$;
      CREATE TRIGGER ${functionName} BEFORE INSERT ON outbox_events FOR EACH ROW EXECUTE FUNCTION public.${functionName}();`);
    try {
      const denied = await save(slug, config, loaded.version); assert.equal(denied.status, 503, denied.text);
      assert.doesNotMatch(denied.text, /synthetic391 late outbox failure/); assert.equal(state(), rows);
    } finally { owned.script(`DROP TRIGGER ${functionName} ON outbox_events; DROP FUNCTION public.${functionName}();`); }
    assert.equal(state(), rows); const reloaded = await load(slug);
    assert.equal(reloaded.version, loaded.version); assert.equal(canonical(reloaded.template_config), canonical(loaded.template_config));
  });
  await stage('DOWN/UP and replay preserve all captured edits/releases/data and raw catalog fields while restoring each exact body', () => {
    const rows = state(), upgraded = profile(); profileRefusals(down);
    owned.script(down); assert.equal(bodyHash(), oldBody); assert.equal(profile(), baselineProfile); assert.equal(state(), rows);
    owned.script(down); assert.equal(profile(), baselineProfile); assert.equal(state(), rows);
    owned.script(up); assert.equal(bodyHash(), newBody); assert.equal(profile(), upgraded); assert.equal(state(), rows); privateRoles();
    assert.equal(immutable(), capturesBefore);
    const protectedCatalog = assertThreadlineCatalog();
    proof('qualified-restoration', { runId: owned.runId, stateDigest: rows, baselineProfileSha256: sha(baselineProfile),
      upgradedProfileSha256: sha(upgraded), conservedNonBodyProfileSha256: sha(nonBodyProfile),
      immutableCaptureDigest: capturesBefore, protectedThreadline, protectedCatalog, oldBody, newBody });
  });
  if (browseEntryBody === search392Body) {
    const rows = dependent392Rows(), editor = profile();
    assert.equal(search392Profile(), preservedDiscoveryBaseline); owned.script(dependency392.up);
    assert.equal(search392Profile(), entryDiscoveryProfile); assert.equal(profile(), editor);
    assert.equal(dependent392Rows(), rows); assert.equal(bodyHash(), newBody);
    proof('dependent392-restoration', { runId: owned.runId, browseEntryBody, fullOriginalDiscoveryProfileRestored: true,
      rootQualified392Run: dependency392.admission.qualifiedRunId, conservedBusinessDigest: rows, final391Body: bodyHash() });
  }
  console.info('SHARED_GROUP391_OWNED_QUALIFICATION', JSON.stringify({ runId: owned.runId,
    artifacts: artifacts.length, entryMode, evidenceDirectory, upSha, downSha, scope: 'native SQL and real mounted API; browser acceptance remains separate' }));
});
