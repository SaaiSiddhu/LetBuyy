/**
 * Phase AB — theme version update (Lane B gateway) tests.
 *
 * ALL tests are logic-level with mocked DB (no real database connection required).
 * Source-pattern assertions read the adapter/route source to confirm structural
 * properties (authMiddleware registration order, cross-tenant isolation ordering,
 * diff-hash mismatch behaviour, idempotency pre-check filter order).
 *
 * Key invariants proved here:
 *   1. authMiddleware registered for /:slug/update-preview and /:slug/update BEFORE
 *      any /:slug/* catch-all — HS256 customer tokens are rejected at the edge.
 *   2. Cross-tenant isolation: verifySiteOwnership (Site B merchant → Site A store_id)
 *      fires BEFORE any theme_releases write. ForbiddenError thrown, no release row
 *      inserted.
 *   3. UpdateVersionRejectedError from planThemeSafeUpdate propagates as 422
 *      (source-pattern assertion that the catch block handles it).
 *   4. confirm_diff_hash mismatch → ConflictError before publishVersionUpdateRelease is
 *      called (CAS guard fires before the DB write).
 *   5. Idempotency pre-check: store_id is the FIRST eq() filter on theme_releases
 *      (cross-tenant impossibility proof — source-pattern assertion on adapter source).
 *   6. NO-DATA-LOSS: planThemeSafeUpdate is called with both currentDocument and
 *      nextBundle before any publish path (source-pattern assertion).
 */

import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { test } from 'node:test';
import path from 'node:path';
import { parseLiquidThemePackageBundle, createMinimalLiquidThemeBundleFixture, toThemeDocumentV2, fromThemeDocumentV2, computeThemeUpdateDiff, planThemeSafeUpdate } from '@letbuyy/theme-engine';
import type { PooledSqlClient } from '@letbuyy/infrastructure/pooled-sql-adapter';
import { themeUpdateConfirmationHash } from '../routes/themes/theme-update-route';

import { AppError, ForbiddenError, ConflictError, ValidationError, NotFoundError } from '../lib/errors';

// ─── Source paths ──────────────────────────────────────────────────────────────

const ADAPTER_SRC = readFileSync(
    path.resolve(__dirname, '../execution/theme-execution.adapter.ts'),
    'utf8',
);
const ROUTE_SRC = readFileSync(
    path.resolve(__dirname, '../routes/themes/theme-update-route.ts'),
    'utf8',
);
const THEMES_SRC = readFileSync(
    path.resolve(__dirname, '../routes/themes.ts'),
    'utf8',
);

// ─── Mock helpers ──────────────────────────────────────────────────────────────

type MockResult = { data: unknown; error: unknown };

function makeChain(result: MockResult): Record<string, unknown> {
    const chain: Record<string, (...args: unknown[]) => unknown> = {};
    const methods = [
        'select', 'eq', 'or', 'is', 'neq', 'update', 'insert', 'upsert', 'delete',
        'order', 'limit', 'maybeSingle', 'single',
    ];
    for (const m of methods) {
        chain[m] = (..._args: unknown[]) => {
            if (m === 'single' || m === 'maybeSingle') return Promise.resolve(result);
            return chain;
        };
    }
    return chain;
}

function makeMockDb(tableResults: Record<string, MockResult>) {
    const calls: Array<{ table: string; method: string; args: unknown[] }> = [];

    function makeTableChain(table: string, result: MockResult): Record<string, unknown> {
        const chain: Record<string, (...args: unknown[]) => unknown> = {};
        const methods = [
            'select', 'eq', 'or', 'is', 'neq', 'update', 'insert', 'upsert', 'delete',
            'order', 'limit', 'maybeSingle', 'single',
        ];
        for (const m of methods) {
            chain[m] = (...args: unknown[]) => {
                calls.push({ table, method: m, args });
                if (m === 'single' || m === 'maybeSingle') return Promise.resolve(result);
                return chain;
            };
        }
        return chain;
    }

    const db = {
        from: (table: string) => {
            calls.push({ table, method: 'from', args: [table] });
            const result = tableResults[table] ?? { data: null, error: null };
            return makeTableChain(table, result);
        },
        rpc: (_fn: string, _args: unknown) => {
            calls.push({ table: '__rpc__', method: _fn as string, args: [_args] });
            return Promise.resolve({
                data: null,
                error: { message: 'Could not find the function publish_theme_release' },
            });
        },
    };

    return { db, calls };
}

// Fixed UUIDs for tenant isolation tests
const VALID_STORE_UUID = 'a0000000-0000-4000-8000-000000000001';
const TARGET_ID = 'c0000000-0000-4000-8000-000000000003';
const PACKAGE_ID = 'b0000000-0000-4000-8000-000000000002';
const UPDATE_SCOPE = { themeSlug: 'letbuyy-bloom', storeId: VALID_STORE_UUID, userId: 'f0000000-0000-4000-8000-000000000001' };
const receiptDiff = () => {const bundle=createMinimalLiquidThemeBundleFixture();return computeThemeUpdateDiff(toThemeDocumentV2(bundle),bundle);};
test('confirmation contract: digest binds the exact diff, current release and selected UUID independently',async()=>{
    const diff=receiptDiff(),hash=await themeUpdateConfirmationHash(diff,'current-a',TARGET_ID);
    assert.match(hash,/^[0-9a-f]{64}$/);assert.equal(await themeUpdateConfirmationHash(diff,'current-a',TARGET_ID),hash);
    assert.notEqual(await themeUpdateConfirmationHash(diff,'current-b',TARGET_ID),hash);
    assert.notEqual(await themeUpdateConfirmationHash(diff,'current-a','another-target'),hash);
    assert.notEqual(await themeUpdateConfirmationHash({...diff,summary:{...diff.summary,sectionsAdded:1}},'current-a',TARGET_ID),hash);
});
const capturedTarget = () => parseLiquidThemePackageBundle(JSON.parse(readFileSync(new URL('../../../../docs/implementation/niche-theme-programme/release-playfield201/proposals/6bd27e70ca6f0a2169a15c3fe850d07bebb948a276002a483f730ac1f690885c/letbuyy-bloom-2.0.1.json', import.meta.url), 'utf8')).document.liquidBundle);
function targetRows() {
    const bundle = capturedTarget();
    return {
        theme_package_versions: { data: { id: TARGET_ID, theme_package_id: PACKAGE_ID, version: bundle.package.version, version_number: bundle.package.version_number, schema_version: bundle.schema_version, renderer_version: bundle.renderer.renderer_version, release_status: 'published', deleted_at: null as string|null, package_manifest: { liquidBundle: bundle } }, error: null },
        theme_packages: { data: { id: PACKAGE_ID, slug: bundle.package.slug, status: 'active', deleted_at: null as string|null, legacy_theme_id: '7b669c70-0000-4000-8000-000000000008' }, error: null },
        themes: { data: { id: '7b669c70-0000-4000-8000-000000000008', slug: bundle.package.slug, is_active: true, is_site_private: false, owned_by_site_id: null as string|null }, error: null },
    };
}

test('target selection: exact captured published package is a read-only positive control', async () => {
    const { db, calls } = makeMockDb(targetRows()), { ThemeExecutionAdapter } = await import('../execution/theme-execution.adapter');
    const bundle = await new ThemeExecutionAdapter(db as never).loadTargetPackageVersionBundle(TARGET_ID, UPDATE_SCOPE);
    assert.equal(bundle.package.version, '2.0.1');
    assert(!calls.some(c => ['update','insert','upsert','delete'].includes(c.method) || c.table === '__rpc__'));
});
test('target selection: a private package owned by this verified store is a positive control', async () => {
    const rows=targetRows();rows.themes.data.is_site_private=true;rows.themes.data.owned_by_site_id=VALID_STORE_UUID;
    const {db}=makeMockDb(rows),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    assert.equal((await new ThemeExecutionAdapter(db as never).loadTargetPackageVersionBundle(TARGET_ID,UPDATE_SCOPE)).package.version,'2.0.1');
});
for (const change of ['deleted-version', 'revoked-version', 'disabled-package', 'deleted-package', 'wrong-package', 'identity-mismatch', 'unsupported-schema', 'private-other-store']) test(`target selection: ${change} refuses without writes`, async () => {
    const { ThemeExecutionAdapter } = await import('../execution/theme-execution.adapter');
        const rows = targetRows();
        if (change === 'deleted-version') rows.theme_package_versions.data.deleted_at = '2026-10-24T00:00:00Z';
        if (change === 'revoked-version') rows.theme_package_versions.data.release_status = 'revoked';
        if (change === 'disabled-package') rows.theme_packages.data.status = 'disabled';
        if (change === 'deleted-package') rows.theme_packages.data.deleted_at = '2026-10-24T00:00:00Z';
        if (change === 'wrong-package') rows.theme_packages.data.slug = 'another-package';
        if (change === 'identity-mismatch') rows.theme_package_versions.data.version_number = 44;
        if (change === 'unsupported-schema') rows.theme_package_versions.data.package_manifest.liquidBundle.schema_version = 'unsupported-future-schema';
        if (change === 'private-other-store') { rows.themes.data.is_site_private = true; rows.themes.data.owned_by_site_id = 'a0000000-0000-4000-8000-000000000099'; }
        const { db, calls } = makeMockDb(rows);
        await assert.rejects(() => new ThemeExecutionAdapter(db as never).loadTargetPackageVersionBundle(TARGET_ID, UPDATE_SCOPE), error => error instanceof ValidationError || error instanceof NotFoundError || error instanceof ForbiddenError, change);
        assert(!calls.some(c => ['update','insert','upsert','delete'].includes(c.method) || c.table === '__rpc__'), change);
});

// Exercise the production adapter's transaction control flow with injected SQL results.
// This is not PostgreSQL/RLS/commit/fault acceptance; the separately admitted native lane is required for those.
function updateInput() {
    const previous=parseLiquidThemePackageBundle(JSON.parse(readFileSync(new URL('../../../../docs/implementation/niche-theme-programme/release-v2/proposals/81e91859ebc8c497a49da337d064e1885a76964839d14e39f4a0a3de2283f47f/letbuyy-bloom-2.0.0.json',import.meta.url),'utf8')).document.liquidBundle);
    const plan=planThemeSafeUpdate({currentDocument:toThemeDocumentV2(previous),nextBundle:capturedTarget()});
    return {storeId:VALID_STORE_UUID,themeSlug:'letbuyy-bloom',targetPackageVersionId:TARGET_ID,currentReleaseId:'d0000000-0000-4000-8000-000000000001',
        mergedBundle:fromThemeDocumentV2(plan.updatedDoc),currentReleaseConfig:{liquidBundle:previous},userId:UPDATE_SCOPE.userId,
        idempotencyKey:'synthetic-reviewed-update',requestHash:'a'.repeat(64),confirmedDiffHash:'b'.repeat(64),
        diff:plan.diff,requiresConfirmation:plan.requiresConfirmation,makeStoreLive:true};
}
function sqlControl(mode: 'success'|'success-date'|'foreign'|'stale'|'changed-key'|'replay'|'replay-date'|'late-fault'='success') {
    const calls:Array<{query:string;parameters:unknown[]}>=[],rows=targetRows(),input=updateInput(),releaseId='e0000000-0000-4000-8000-000000000001';
    const unsafe=async(query:string,parameters:unknown[]=[])=>{
        calls.push({query,parameters});
        if(query.includes('SELECT id FROM public.sites'))return mode==='foreign'?[]:[{id:VALID_STORE_UUID}];
        if(query.includes('to_jsonb(v) AS version'))return[{version:rows.theme_package_versions.data,package:rows.theme_packages.data,catalog:rows.themes.data}];
        if(query.includes('idempotency_key=$3'))return mode==='changed-key'||mode==='replay'||mode==='replay-date'?[{id:releaseId,release_version:8,published_at:mode==='replay-date'?new Date('2026-10-24T00:00:00Z'):'2026-10-24T00:00:00Z',metadata:{theme_version_update:{request_hash:mode==='changed-key'?'different':input.requestHash,diff:input.diff,requires_confirmation:false}}}]:[];
        if(query.includes('SELECT id,theme_instance_id'))return mode==='stale'?[]:[{id:input.currentReleaseId,theme_instance_id:'f0000000-0000-4000-8000-000000000002'}];
        if(query.includes('SELECT id FROM public.theme_instances'))return[{id:'f0000000-0000-4000-8000-000000000002'}];
        if(query.includes('SELECT * FROM public.publish_theme_release'))return[{release_id:releaseId,release_version:8,published_at:mode==='success-date'?new Date('2026-10-24T00:00:00Z'):'2026-10-24T00:00:00Z'}];
        if(query.includes('UPDATE public.theme_releases')){if(mode==='late-fault')throw Object.assign(new Error('PRIVATE_SQL_DIAGNOSTIC'),{code:'P0001'});return[{id:releaseId}];}
        return[];
    };
    let transactions=0;
    const sql={begin:async(callback:(tx:{unsafe:typeof unsafe})=>Promise<unknown>)=>{transactions++;return callback({unsafe});}} as unknown as PooledSqlClient;
    return{sql,calls,input,transactions:()=>transactions,releaseId};
}
test('confirmed update control flow: one existing publisher call and receipt inside the same transaction with selected IDs',async()=>{
    const fixture=sqlControl(),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    const result=await new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>fixture.sql).publishVersionUpdateRelease(fixture.input);
    assert.equal(result.release_id,fixture.releaseId);assert.equal(result.idempotent,false);assert.equal(fixture.transactions(),1);
    assert.equal(fixture.calls.filter(c=>c.query.includes('SELECT * FROM public.publish_theme_release')).length,1);
    const pin=fixture.calls.find(c=>c.query.startsWith('UPDATE public.theme_instances'))!;assert.equal(pin.parameters[0],VALID_STORE_UUID);assert.equal(pin.parameters[2],TARGET_ID);
    const receipt=fixture.calls.find(c=>c.query.startsWith('UPDATE public.theme_releases'))!;
    const manifest=JSON.parse(String(receipt.parameters[4]));assert.equal(manifest.theme_package_version_id,TARGET_ID);assert.equal(manifest.liquidBundle.package.version,'2.0.1');
    assert.equal(JSON.parse(String(receipt.parameters[8])).request_hash,fixture.input.requestHash);
    assert(!fixture.calls.some(c=>/UPDATE\s+(?:public\.)?theme_(?:instance_drafts|editor_drafts|draft_patches)/i.test(c.query)));
});
for(const mode of ['foreign','stale','changed-key'] as const)test(`confirmed update control flow: ${mode} refuses before any mutation`,async()=>{
    const fixture=sqlControl(mode),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    await assert.rejects(()=>new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>fixture.sql).publishVersionUpdateRelease(fixture.input),error=>error instanceof ForbiddenError||error instanceof ConflictError);
    assert(!fixture.calls.some(c=>/^UPDATE |SELECT \* FROM public\.publish_theme_release/.test(c.query)));
});
test('confirmed update control flow: receipt replay under the site lock has no second publisher or mutation',async()=>{
    const fixture=sqlControl('replay'),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    const replay=await new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>fixture.sql).publishVersionUpdateRelease(fixture.input);assert.equal(replay.idempotent,true);
    assert(!fixture.calls.some(c=>/^UPDATE |SELECT \* FROM public\.publish_theme_release/.test(c.query)));
});
for(const mode of ['success-date','replay-date'] as const)test(`confirmed update control flow: actual driver Date timestamps work for ${mode}`,async()=>{
    const fixture=sqlControl(mode),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    const result=await new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>fixture.sql).publishVersionUpdateRelease(fixture.input);
    assert.equal(result.published_at,'2026-10-24T00:00:00.000Z');assert.equal(result.idempotent,mode==='replay-date');
});
test('confirmed update control flow: missing transactional transport refuses',async()=>{
    const fixture=sqlControl('late-fault'),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    await assert.rejects(()=>new ThemeExecutionAdapter(db as never).publishVersionUpdateRelease(fixture.input),error=>error instanceof AppError&&error.statusCode===503);
});
test('confirmed update unexpected failure: one structured safe log and sanitized INTERNAL_ERROR, no raw SQL/message/request leakage',async t=>{
    const log:unknown[][]=[];t.mock.method(console,'error',(...args:unknown[])=>{log.push(args);});
    const fixture=sqlControl('late-fault'),{db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    await assert.rejects(()=>new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>fixture.sql).publishVersionUpdateRelease({...fixture.input,requestId:'bad\nSYNTHETIC_SECRET'}),
        error=>error instanceof AppError&&error.statusCode===500&&error.code==='INTERNAL_ERROR'&&error.message==='An internal error occurred');
    assert.equal(log.length,1);const event=JSON.parse(String(log[0][0]));assert.equal(event.operation,'theme.version_update');assert.equal(event.sqlstate,'P0001');assert(!Object.hasOwn(event,'request_id'));
    assert.equal(event.classification,'unexpected_transaction_failure');assert.doesNotMatch(JSON.stringify(log),/PRIVATE_SQL_DIAGNOSTIC|SYNTHETIC_SECRET|\b(?:SELECT|UPDATE)\s+|liquidBundle|idempotency/i);
});
test('confirmed update unexpected transport failure: safe request ID retained, non-SQLSTATE code and raw connection text omitted',async t=>{
    const log:unknown[][]=[];t.mock.method(console,'error',(...args:unknown[])=>{log.push(args);});
    const {db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    await assert.rejects(()=>new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>{throw Object.assign(new Error('SYNTHETIC_URI_SECRET'),{code:'SYNTHETIC_CODE_SECRET'});})
        .publishVersionUpdateRelease({...updateInput(),requestId:'synthetic-request:123'}),error=>error instanceof AppError&&error.code==='INTERNAL_ERROR'&&error.statusCode===500);
    assert.equal(log.length,1);const event=JSON.parse(String(log[0][0]));assert.equal(event.request_id,'synthetic-request:123');assert(!Object.hasOwn(event,'sqlstate'));
    assert.doesNotMatch(JSON.stringify(log),/SYNTHETIC_URI_SECRET|SYNTHETIC_CODE_SECRET/);
});
test('confirmed update known concurrency failure: conflict remains409 and emits no unexpected-error log',async t=>{
    const log:unknown[][]=[];t.mock.method(console,'error',(...args:unknown[])=>{log.push(args);});
    const {db}=makeMockDb({}),{ThemeExecutionAdapter}=await import('../execution/theme-execution.adapter');
    const sql={begin:async()=>{throw Object.assign(new Error('Synthetic concurrency'),{code:'40001'});}} as unknown as PooledSqlClient;
    await assert.rejects(()=>new ThemeExecutionAdapter(db as never,VALID_STORE_UUID,()=>sql).publishVersionUpdateRelease(updateInput()),error=>error instanceof ConflictError&&error.statusCode===409);
    assert.equal(log.length,0);
});

// ─── Source-pattern assertions ─────────────────────────────────────────────────

test('authMiddleware registered for /:slug/update-preview and /:slug/update (HS256 rejection)', () => {
    // themes.ts must register authMiddleware for both AB routes BEFORE any /:slug/* catch-all
    assert.ok(
        THEMES_SRC.includes("router.use('/:slug/update-preview', authMiddleware)"),
        "authMiddleware must be registered for /:slug/update-preview — primary HS256 defence",
    );
    assert.ok(
        THEMES_SRC.includes("router.use('/:slug/update', authMiddleware)"),
        "authMiddleware must be registered for /:slug/update — primary HS256 defence",
    );
});

test('update routes registered before /:slug catch-alls in themes.ts (route ordering)', () => {
    const updatePreviewPos = THEMES_SRC.indexOf("router.use('/:slug/update-preview', authMiddleware)");
    const slugEditorPos = THEMES_SRC.indexOf("router.use('/:slug/editor', authMiddleware)");
    // update-preview and update should appear before the general /:slug/editor catch-all
    // (or at the same relative position in the middleware chain)
    assert.ok(updatePreviewPos > -1, "update-preview middleware must exist in themes.ts");
    assert.ok(slugEditorPos > -1, "/:slug/editor middleware must exist in themes.ts");
    // The AB middleware must appear before the /:slug/editor group to prevent shadowing
    assert.ok(
        updatePreviewPos < slugEditorPos,
        "AB route middleware must be registered before /:slug/editor catch-all middleware",
    );
});

test('mountThemeUpdateRoutes is imported and called in themes.ts', () => {
    assert.ok(
        THEMES_SRC.includes("import { mountThemeUpdateRoutes } from './themes/theme-update-route'"),
        "themes.ts must import mountThemeUpdateRoutes from theme-update-route",
    );
    assert.ok(
        THEMES_SRC.includes('mountThemeUpdateRoutes(router)'),
        "themes.ts must call mountThemeUpdateRoutes(router)",
    );
});

test('UpdateVersionRejectedError propagated as 422 in route handler (source assertion)', () => {
    assert.ok(
        ROUTE_SRC.includes('UpdateVersionRejectedError'),
        "route must import UpdateVersionRejectedError",
    );
    assert.ok(
        ROUTE_SRC.includes("err instanceof UpdateVersionRejectedError"),
        "route catch block must handle UpdateVersionRejectedError",
    );
    assert.ok(
        ROUTE_SRC.includes('422'),
        "route must return 422 for UpdateVersionRejectedError",
    );
});

test('UpdateDowngradeError propagated as 422 in route handler (source assertion)', () => {
    assert.ok(
        ROUTE_SRC.includes('UpdateDowngradeError'),
        "route must import UpdateDowngradeError",
    );
    assert.ok(
        ROUTE_SRC.includes("err instanceof UpdateDowngradeError"),
        "route catch block must handle UpdateDowngradeError",
    );
});

test('confirm_diff_hash mismatch throws ConflictError before publish (source assertion)', () => {
    // The CAS guard must appear BEFORE publishVersionUpdateRelease in the POST handler.
    const casGuardPos = ROUTE_SRC.indexOf('computedHash !== confirmDiffHash');
    const publishCallPos = ROUTE_SRC.indexOf('publishVersionUpdateRelease');
    assert.ok(casGuardPos > -1, "CAS guard (computedHash !== confirmDiffHash) must exist in route");
    assert.ok(publishCallPos > -1, "publishVersionUpdateRelease call must exist in route");
    assert.ok(
        casGuardPos < publishCallPos,
        "CAS guard must appear before publishVersionUpdateRelease call (no write before hash verification)",
    );
});

test('planThemeSafeUpdate called before any publish path (NO-DATA-LOSS source assertion)', () => {
    // planThemeSafeUpdate must appear before fromThemeDocumentV2 and before publishVersionUpdateRelease
    const planPos = ROUTE_SRC.indexOf('planThemeSafeUpdate(');
    const fromDocPos = ROUTE_SRC.indexOf('fromThemeDocumentV2(');
    const publishPos = ROUTE_SRC.indexOf('publishVersionUpdateRelease');
    assert.ok(planPos > -1, "planThemeSafeUpdate must be called in route");
    assert.ok(fromDocPos > -1, "fromThemeDocumentV2 must be called in route");
    assert.ok(planPos < fromDocPos, "planThemeSafeUpdate must be called before fromThemeDocumentV2");
    assert.ok(fromDocPos < publishPos, "fromThemeDocumentV2 must be called before publishVersionUpdateRelease");
});

test('idempotency pre-check: store_id is FIRST eq() filter on theme_releases (cross-tenant proof)', () => {
    // In publishVersionUpdateRelease, the idempotency query must scope by store_id first.
    // Source-pattern: the adapter source must have .eq('store_id', ...) before .eq('idempotency_key', ...)
    // in the publishVersionUpdateRelease method body.
    const methodStart = ADAPTER_SRC.indexOf('async findVersionUpdateReplay');
    assert.ok(methodStart > -1, "findVersionUpdateReplay method must exist in adapter");

    // Extract the method body (between the method start and its closing brace)
    const methodSlice = ADAPTER_SRC.slice(methodStart, methodStart + 2000);
    const storeIdEqPos = methodSlice.indexOf(".eq('store_id'");
    const idempotencyEqPos = methodSlice.indexOf(".eq('idempotency_key'");
    assert.ok(storeIdEqPos > -1, "idempotency query must filter by store_id");
    assert.ok(idempotencyEqPos > -1, "idempotency query must filter by idempotency_key");
    assert.ok(
        storeIdEqPos < idempotencyEqPos,
        "store_id must be the FIRST filter in the idempotency pre-check query (cross-tenant isolation)",
    );
});

// ─── Logic-level tests ─────────────────────────────────────────────────────────

test('loadCurrentReleaseBundle: ForbiddenError when site not found (cross-tenant isolation)', async () => {
    // sites table returns no row → verifyStoreOwner throws ForbiddenError BEFORE any
    // theme_releases query. This is the cross-tenant isolation guarantee for the update path.
    const { db, calls } = makeMockDb({
        sites: { data: null, error: null },
    });

    const { ThemeExecutionAdapter } = await import('../execution/theme-execution.adapter');
    const adapter = new ThemeExecutionAdapter(db as never);

    await assert.rejects(
        () => adapter.verifyStoreOwner(VALID_STORE_UUID, 'site-b-user-id'),
        (err: unknown) => {
            assert.ok(
                err instanceof ForbiddenError,
                `Expected ForbiddenError, got ${(err as Error)?.constructor?.name}`,
            );
            return true;
        },
    );

    // No theme_releases query should have fired — auth short-circuited
    const releaseQueries = calls.filter((c) => c.table === 'theme_releases');
    assert.equal(releaseQueries.length, 0, 'theme_releases must not be queried when auth fails');
});

test('loadCurrentReleaseBundle: NotFoundError when no current release exists', async () => {
    const { db } = makeMockDb({
        theme_releases: { data: null, error: null }, // maybeSingle returns null
    });

    const { ThemeExecutionAdapter } = await import('../execution/theme-execution.adapter');
    const adapter = new ThemeExecutionAdapter(db as never);

    await assert.rejects(
        () => adapter.loadCurrentReleaseBundle(VALID_STORE_UUID, 'urban-kicks'),
        (err: unknown) => {
            assert.ok(
                err instanceof NotFoundError,
                `Expected NotFoundError, got ${(err as Error)?.constructor?.name}`,
            );
            return true;
        },
    );
});

test('loadTargetPackageVersionBundle: NotFoundError when package version not found', async () => {
    const { db } = makeMockDb({
        theme_package_versions: { data: null, error: null },
