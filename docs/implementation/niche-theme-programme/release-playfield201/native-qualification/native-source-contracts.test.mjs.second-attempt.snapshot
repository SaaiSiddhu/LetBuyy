// Source contracts only. Never import/evaluate the owned suite or call its DB handle.
import test from 'node:test';
import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, readdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { fileURLToPath } from 'node:url';
const require = createRequire(import.meta.url), ts = require('typescript');
const root = new URL('../../../../../', import.meta.url);
const { z } = createRequire(new URL('services/api-gateway/package.json', root))('zod');
const folder = 'docs/implementation/niche-theme-programme/release-playfield201/native-qualification/';
const suitePath = 'services/api-gateway/src/__tests__/owned-db/playfield201-promotion.postgres.test.ts';
const read = path => readFileSync(new URL(path, root), 'utf8');
const sha = source => createHash('sha256').update(source).digest('hex');
const source = read(suitePath), ast = ts.createSourceFile(suitePath, source, ts.ScriptTarget.Latest, true);
function nodes(predicate) { const result = []; function walk(node) { if (predicate(node)) result.push(node); ts.forEachChild(node, walk); } walk(ast); return result; }

test('native source has eight ordered child phases and an owned, non-skipping execution boundary', () => {
  assert.equal(ast.parseDiagnostics.length, 0);
  const calls = nodes(n => ts.isCallExpression(n));
  assert.equal(calls.filter(n => ts.isIdentifier(n.expression) && n.expression.text === 'test').length, 1);
  const stages = calls.filter(n => ts.isIdentifier(n.expression) && n.expression.text === 'stage');
  assert.equal(stages.length, 8);
  stages.forEach((n, i) => assert(n.arguments[0].text.startsWith(`${i + 1} `)));
  assert(!calls.some(n => ts.isPropertyAccessExpression(n.expression) && ['skip', 'todo', 'only'].includes(n.expression.name.text)));
  const admissionIndex = source.indexOf('const inputs = admittedInputs();'), ownedIndex = source.indexOf('const owned = requireOwnedDatabase();');
  assert(admissionIndex > 0 && ownedIndex > admissionIndex);
  assert(!/DISABLE\s+(?:TRIGGER|ROW)|session_replication_role|\.dev\.vars|SUPABASE_(?:URL|SERVICE_ROLE_KEY)\s*=|execSync\(|spawn\(/i.test(source));
  for (const n of nodes(n => ts.isImportDeclaration(n))) assert(!/apps\/|legacy\/|\.next|\/dist\//.test(n.moduleSpecifier.text));
});

test('native phase assertions retain real API install/update, private history, rollback picker and exact profile gates', () => {
  const calls = nodes(n => ts.isCallExpression(n));
  assert(calls.some(n => ts.isPropertyAccessExpression(n.expression) && n.expression.name.text === 'request'));
  for (const path of ['/install', '/editor/draft', '/publish', '/update-preview?', '/update', '/preview-session']) assert(source.includes(path), path);
  for (const witness of ['diff.diff_hash', 'current.theme_package_version_id,newChoice.versionId', 'version update preserves unpublished draft B', 'retained201 capture must not win actual fresh schema API selection', 'EXISTING_CONSTRAINT_DENIAL_BEFORE393_NOT_GUARD_CREDIT', 'SYNTHETIC393_LATE_OUTBOX', 'permission denied for function', 'allCurrentProfilesExact:true']) assert(source.includes(witness), witness);
  assert(!source.includes("owned.psql(`UPDATE theme_releases"));
  assert(source.includes('assert.equal(fullState(),committed)'));
  assert(source.includes('admittedInputs();\n    proof(\'final-restoration\''));
});

// Extract only the pure admission prefix, ending before const inputs. The suite module,
// its imports, test registration, gateway, hooks and ownedDatabase code are never evaluated.
const prefix = source.slice(source.indexOf('const root = '), source.indexOf('const inputs = admittedInputs();'));
assert(!/requireOwnedDatabase|new Gateway|owned\./.test(prefix));
const javascript = ts.transpileModule(prefix.replace("new URL('../../../../../', import.meta.url)", `new URL(${JSON.stringify(root.href)})`) + '\nreturn admittedInputs();', { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.None } }).outputText;
const evaluate = new Function('readFileSync', 'readdirSync', 'createHash', 'z', 'LiquidThemePackageBundleSchema', 'buildLiquidThemePackagePersistencePayload', javascript);
const engine = require(fileURLToPath(new URL('packages/theme-engine/src/index.ts', root)));
const closure = read(folder + 'source-input-closure.json');
const simulatedAdmission = {
  status: 'ROOT_PLAYFIELD201_NATIVE_SOURCE_ADMITTED_FOR_ONE_DEFAULT_LATEST392_CANDIDATE393', suitePath, suiteSha256: sha(source),
  rootProposalPath: 'docs/implementation/niche-theme-programme/playfield201-proposal-admission.json', rootProposalSha256: 'fafc7990283a89725841ce672b3136e034d33c72bc5ba66729beaf019d520a51',
  manifestSha256: '6bd27e70ca6f0a2169a15c3fe850d07bebb948a276002a483f730ac1f690885c', sourceMigrationMaximum: 392, migrationCeiling: null,
  candidateMigration: 393, candidateOutsideMigrationScan: true, inputClosurePath: folder + 'source-input-closure.json', inputClosureSha256: sha(closure),
  nativeLease: 'GRANTED_ONE_FRESH_DEFAULT_LATEST392_JOBS1_NO_REAP_PREPARED2_600S',
};
const admissionPath = fileURLToPath(new URL(folder + 'admission.json', root));
function check({ admission = simulatedAdmission, mutateRead, mutateDirectory } = {}) {
  const safeRead = (path, encoding) => {
    const name = fileURLToPath(path);
    if (name === admissionPath) {
      if (admission === null) throw Object.assign(new Error('No real admission exists'), { code: 'ENOENT' });
      return JSON.stringify(admission);
    }
    const value = readFileSync(path, encoding); return mutateRead ? mutateRead(name, value) : value;
  };
  const safeDirectory = path => { const value = readdirSync(path); return mutateDirectory ? mutateDirectory(fileURLToPath(path), value) : value; };
  return evaluate(safeRead, safeDirectory, createHash, z, engine.LiquidThemePackageBundleSchema, engine.buildLiquidThemePackagePersistencePayload);
}

test('pure admission prefix accepts the exact immutable source closure using an in-memory simulated admission only', () => {
  const result = check(); assert.equal(result.bundle.package.version, '2.0.1'); assert.equal(result.oldBundle.package.version, '2.0.0');
  assert.equal(result.sourceCount, JSON.parse(closure).files.length);
});
test('missing/pending/wrong-source admission refuses before any owned database code', () => {
  assert.throws(() => check({ admission: null }), /No real admission/);
  assert.throws(() => check({ admission: { ...simulatedAdmission, status: 'PENDING' } }));
  assert.throws(() => check({ admission: { ...simulatedAdmission, suiteSha256: '0'.repeat(64) } }));
  assert.throws(() => check({ admission: { ...simulatedAdmission, inputClosureSha256: '0'.repeat(64) } }));
});
test('tampered dependencies or newly emitted393 migration refuse in the pure prefix', () => {
  assert.throws(() => check({ mutateRead: (name, value) => name.endsWith('/packages/theme-engine/src/niche-order-presentation.ts') ? value + '\n// mutation' : value }));
  assert.throws(() => check({ mutateDirectory: (name, names) => name.endsWith('/migrations/') ? [...names, '393_forbidden.sql'] : names }));
  assert.throws(() => check({ mutateDirectory: (name, names) => name.endsWith('/rollback/') ? [...names, '393_forbidden.rollback.sql'] : names }));
});
test('actual safe-update probe remains explicitly source-only and records the observed package-version blocker', () => {
  const result = JSON.parse(read(folder + 'existing-update-source-probe.json'));
  assert.equal(result.status, 'SOURCE_BLOCKER_CONFIRMED_PACKAGE_PATCH_UPGRADE_IS_NOOP');
  assert.equal(result.current.packageVersion, '2.0.0'); assert.equal(result.target.packageVersion, '2.0.1');
  assert.equal(result.output.packageVersion, '2.0.0'); assert.equal(result.output.productSourceMatchesTarget, false);
  assert.equal(result.downgradeProbe.rejected, false); assert.equal(result.nativeTestRun, false);
  for (const file of result.sourceFiles) assert.equal(sha(read(file.path)), file.sha256);
});
