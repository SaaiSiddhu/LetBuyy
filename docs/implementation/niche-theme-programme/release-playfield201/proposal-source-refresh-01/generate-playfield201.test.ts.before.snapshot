import assert from 'node:assert/strict';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import test from 'node:test';
import { buildProposal, assertProposal, renderPair, writeProposal, ID, SLUG, VERSION } from './generate-playfield201';
import { canonicalJson, sha256 } from '../release-v2/generate-release';

const proposal = buildProposal();

test('one admitted Playfield201 capture has exact stable identity, publication metadata and canonical wire payload', () => {
  assertProposal(proposal);
  const { artifact, manifest } = proposal;
  assert.equal(artifact.id, ID); assert.equal(artifact.slug, SLUG); assert.equal(artifact.version, VERSION);
  assert.equal(artifact.persistence.themePackageVersion.version_number, 3);
  assert.equal(artifact.persistence.themePackageVersion.release_status, 'published');
  assert.equal(manifest.rawFactorySha256, 'c8a1defdf97a0d8d9bf1060c86d5a1727d458747e56353db88f44b456a8bfc5d');
  assert.deepEqual(manifest.semanticDifferencePaths, ['/package/version', '/package/version_number', '/sections/product-detail/source']);
  assert.deepEqual(artifact.document.liquidBundle, artifact.persistence.themePackageVersion.package_manifest.liquidBundle);
});

test('capture protects historical20 outputs, nine artifacts and excludes moving hydration source from dependency closure', () => {
  assert.equal(proposal.manifest.historicalBuilderOutputsPreserved, 20);
  assert.equal(proposal.manifest.previousNineArtifactFilesPreserved, 9);
  assert.equal(proposal.previous.version, '2.0.0');
  assert.equal(Object.hasOwn(proposal.manifest.sourceHashes, 'apps/commerce/web/src/lib/theme-engine/liquid-hydration-islands.tsx'), false);
  assert.equal(proposal.manifest.persistedDatabaseCapturesChecked, false);
  assert.equal(proposal.manifest.migration, 393);
});

test('changed identity, captured version, schema, renderer and descriptor bytes all refuse before SQL or writes', () => {
  for (const mutate of [
    (p: typeof proposal) => { p.artifact.id = '7b669c70-0000-4000-8000-000000000007'; },
    (p: typeof proposal) => { p.artifact.version = '2.0.0'; },
    (p: typeof proposal) => { p.artifact.persistence.schemaManifest.template_schema = {}; },
    (p: typeof proposal) => { p.artifact.persistence.rendererManifest.asset_manifest = { replaced: true }; },
    (p: typeof proposal) => { p.previous.document = {}; },
    (p: typeof proposal) => { p.manifest.artifact.fileSha256 = '0'.repeat(64); },
  ]) {
    const changed = structuredClone(proposal); mutate(changed);
    assert.throws(() => assertProposal(changed)); assert.throws(() => renderPair(changed));
  }
});

test('SQL pair appends only version/schema/renderer and moves the one catalog row; no historical or merchant row writes', () => {
  const { up, down } = renderPair(proposal);
  const operations = (sql: string) => sql.split('\n').filter(line => /^\s*(INSERT INTO|UPDATE|DELETE FROM|ALTER |DROP |CREATE )/i.test(line)).map(line => line.trim());
  assert.deepEqual(operations(up).map(line => line.match(/^(?:INSERT INTO|UPDATE) public\.([a-z_]+)/)?.[1]),
    ['theme_package_versions', 'theme_schema_manifests', 'theme_renderer_manifests', 'themes']);
  assert.deepEqual(operations(down).map(line => line.match(/^UPDATE public\.([a-z_]+)/)?.[1]), ['themes']);
  assert.match(up, new RegExp(`WHERE id='${ID}'::uuid AND slug='${SLUG}'`));
  assert.match(up, /captured->>'version'='2\.0\.1'/);
  assert.doesNotMatch(up + down, /t\.deleted_at|DISABLE TRIGGER|session_replication_role|DELETE FROM|ALTER FUNCTION|GRANT |REVOKE /);
});

test('both legs refuse capture and package drift; replay/rollback require exact catalog and intact prior checkpoint', () => {
  const { up, down } = renderPair(proposal);
  for (const sql of [up, down]) {
    for (const refusal of ['immutable version conflict','immutable schema conflict','immutable renderer conflict','ambiguous canonical package','package metadata conflict','stale or corrupted rollback checkpoint','catalog changed after promotion']) {
      assert.ok(sql.includes(refusal), refusal);
    }
    assert.match(sql, /previousSha256/); assert.match(sql, /sha256\(convert_to\(saved::text/);
    assert.match(sql, /FOR UPDATE/); assert.match(sql, /^BEGIN;$/m); assert.match(sql, /^COMMIT;$/m);
  }
  assert.match(up, /IF t.version='2\.0\.1' THEN RETURN; END IF/);
  assert.match(down, /IF saved IS NULL THEN RETURN; END IF/);
  assert.match(down, /config=t.config,updated_at=now\(\)/);
});

test('proposal writer uses content addressing, permits exact replay and refuses divergent existing evidence', () => {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'letbuyy-playfield201-proposal-'));
  try {
    const directory = writeProposal(proposal, tmp);
    assert.equal(path.basename(directory), proposal.manifestSha256);
    assert.equal(writeProposal(proposal, tmp), directory);
    const artifact = path.join(directory, `${SLUG}-${VERSION}.json`);
    assert.equal(sha256(fs.readFileSync(artifact)), proposal.manifest.artifact.fileSha256);
    const manifest = JSON.parse(fs.readFileSync(path.join(directory, 'manifest.json'), 'utf8'));
    assert.equal(manifest.manifestSha256, proposal.manifestSha256);
    assert.equal(canonicalJson(JSON.parse(fs.readFileSync(artifact, 'utf8'))), canonicalJson(proposal.artifact));
    fs.writeFileSync(artifact, 'changed evidence');
    assert.throws(() => writeProposal(proposal, tmp), /Immutable proposal differs/);
  } finally { fs.rmSync(tmp, { recursive: true, force: true }); }
});
