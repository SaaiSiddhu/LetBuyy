dius:7px;padding:10px;background:var(--background,#fff9ee);color:inherit}.pf-finder>.pf-button,.pf-finder>.pf-note{grid-column:1/-1;margin:0}.pf-bento{display:grid;grid-template-columns:1.65fr 1fr;gap:18px}.pf-bento a{text-decoration:none;color:inherit;min-width:0;border-radius:18px;overflow:hidden}.pf-bento-main{display:flex;flex-direction:column;background:var(--surface,#f3e6c8)}.pf-bento-main img{width:100%;aspect-ratio:1.8;object-fit:cover;display:block}.pf-bento-caption{padding:24px 28px}.pf-bento-caption h2{margin:8px 0}.pf-bento-side{display:grid;grid-template-rows:repeat(2,1fr);gap:18px}.pf-bento-small{display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:12px;gap:12px;background:var(--pf-coral)}.pf-bento-small:last-child{background:var(--pf-sage)}.pf-bento-small img{width:100%;aspect-ratio:1;object-fit:contain;border-radius:10px}.pf-bento-small h3{margin:0 0 12px}.pf-bento-small span{font-size:.85rem}.pf-no-image{min-height:180px;display:grid;place-items:center;padding:24px;color:var(--pf-muted);background:var(--surface,#f3e6c8)}.pf-ages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pf-ages .pf-link{border:1px solid var(--pf-essential);border-radius:10px;min-height:76px;padding:16px 22px;text-decoration:none;font-size:1.7rem;font-weight:700;gap:8px}.pf-ages small{font-size:.85rem;font-weight:400}.pf-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.pf-grid[data-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr))}.pf-grid[data-columns="4"]{grid-template-columns:repeat(4,minmax(0,1fr))}.pf-card{min-width:0}.pf-card>a{text-decoration:none;color:inherit}.pf-card-media{position:relative;background:var(--surface,#f3e6c8);border-radius:16px;overflow:hidden;aspect-ratio:1}.pf-card-media img{display:block;width:100%;height:100%;object-fit:contain}.pf-card-media>.pf-no-image{height:100%;font-size:.85rem}.pf-card-badge{position:absolute;left:12px;top:12px;padding:6px 9px;background:var(--background,