        sections: {
          'customer-orders': {
            path: 'sections/customer-orders.liquid',
            source: '<div class="pf-theme"><section class="lb-orders" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  {% if buyer_unavailable %}<p class="lb-orders__error" role="alert">Orders are temporarily unavailable. Please try again.</p>{% elsif buyer %}\n' +
              '  <form class="lb-orders__claim" method="post" action="/api/buyer/orders"><input type="hidden" name="return_to" value="{{ routes.account_orders_url }}"><p>Find past orders from this store placed with your verified LetBuyy email.</p><button type="submit">Find past orders</button></form>\n' +
              '  {% if request.query.buyer_claim == "complete" %}<p role="status" aria-live="polite">The verified orders for this store have been checked and linked.</p>{% elsif request.query.buyer_claim == "partial" %}<p role="status" aria-live="polite">Some eligible orders could not be linked. Contact the store for help.</p>{% elsif request.query.buyer_claim == "unverified" %}<p role="status" aria-live="polite">Verify your LetBuyy email before claiming historical orders.</p>{% elsif request.query.buyer_claim == "unavailable" %}<p role="status" aria-live="polite">Historical orders could not be checked right now. Please try again.</p>{% elsif request.query.buyer_claim == "unauthorized" %}<p role="status" aria-live="polite">Sign in to LetBuyy before claiming past orders.</p>{% endif %}\n' +
              '  {% if buyer.orders and buyer.orders.size > 0 %}\n' +
              '  <ul class="lb-orders__list">{% for order in buyer.orders %}<li class="lb-orders__row"><a href="{{ routes.account_orders_url }}/{{ order.id }}"><span class="lb-orders__num">#{{ order.number }}</span><span class="lb-orders__status">{{ order.status }}</span><span class="lb-orders__total">{{ order.total | money_with_currency: order.currency }}</span></a></li>{% endfor %}</ul>\n' +
              '  {% if buyer.has_more and buyer.next_cursor %}<a class="lb-orders__next" href="{{ routes.account_orders_url }}?cursor={{ buyer.next_cursor }}">Older orders</a>{% endif %}\n' +
              '  {% else %}<p class="lb-orders__empty">No orders yet.</p>{% endif %}\n' +
              '  {% else %}\n' +
              '  <p class="lb-orders__guest">Please <a href="/api/buyer-auth/start?return_to={{ routes.account_orders_url }}">sign in with LetBuyy</a> to view your orders.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Order History","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your orders","id":"heading"}],"blocks":[],"presets":[{"name":"Order History","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-order-detail': {
            path: 'sections/customer-order-detail.liquid',
            source: '<div class="pf-theme"><section class="lb-order-detail" data-section-id="{{ section.id }}">\n' +
              '  {% if buyer_unavailable %}<p class="lb-order-detail__error" role="alert">This order is temporarily unavailable. Please try again.</p>{% elsif buyer %}\n' +
              '  {% if order %}\n' +
              '  <h1>Order #{{ order.number }}</h1>\n' +
              '  <p class="lb-order-detail__status">Status: {{ order.status }}</p>\n' +
              '  <ul class="lb-order-detail__items">{% for item in order.line_items %}<li><span class="lb-order-detail__title">{{ item.title }}</span><span class="lb-order-detail__qty">{{ item.quantity }}</span><span class="lb-order-detail__line">{{ item.line_price | money_with_currency: order.currency }}</span><!-- lb:niche-order-presentation:v1 -->{% if item.niche_facts_text != blank %}<details class="lb-order-facts"><summary>Saved product details</summary><p class="lb-order-facts__text">{{ item.niche_facts_text }}</p></details>{% else %}<p class="lb-order-facts__missing">Product details were not recorded with this order.</p>{% endif %}</li>{% endfor %}</ul>\n' +
              '  <p class="lb-order-detail__total">Total: {{ order.total | money_with_currency: order.currency }}</p>\n' +
              '  {% if order.gst_invoice_number != blank %}<p class="lb-order-detail__invoice">GST Invoice: {{ order.gst_invoice_number }} (Tax: {{ order.tax_total | money_with_currency: order.currency }})</p>{% endif %}\n' +
              '  <ol class="lb-order-detail__timeline">{% for step in order.timeline %}<li class="lb-order-detail__step{% if step.reached %} is-reached{% endif %}">{{ step.label }}</li>{% endfor %}</ol>\n' +
              '  {% if order.tracking_number != blank %}<p class="lb-order-detail__tracking">Tracking: {{ order.tracking_number }}{% if order.carrier != blank %} ({{ order.carrier }}){% endif %}</p>{% endif %}\n' +
              '  {% else %}<p class="lb-order-detail__missing">Order not found.</p>{% endif %}\n' +
              '  {% else %}<p class="lb-order-detail__guest">Please <a href="/api/buyer-auth/start?return_to={{ routes.account_orders_url }}">sign in with LetBuyy</a> to view this order.</p>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Order Detail","tag":"section","settings":[{"type":"text","label":"Heading","default":"Order","id":"heading"}],"blocks":[],"presets":[{"name":"Order Detail","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-account': {
            path: 'sections/customer-account.liquid',
            source: '<div class="pf-theme"><section class="lb-account" data-section-id="{{ section.id }}">\n' +
              '  {% if buyer %}\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <p class="lb-account__hello">Signed in to LetBuyy as {{ buyer.full_name | default: buyer.email }}</p>\n' +
              '  <nav class="lb-account__nav"><a href="{{ routes.account_orders_url }}">Orders</a><a href="{{ routes.account_addresses_url }}">Addresses</a><a href="{{ routes.account_url }}/loyalty">Rewards</a><a href="{{ routes.account_settings_url }}">Settings</a><form method="post" action="/api/buyer-auth/logout?return_to={{ routes.account_url }}"><button type="submit" class="lb-account__nav-link">Sign out at this store</button></form></nav>\n' +
              '  {% elsif buyer_unavailable %}<p class="lb-account__unavailable" role="status">We could not load your LetBuyy account right now. Please refresh and try again.</p>\n' +
              '  {% elsif customer %}\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <p class="lb-account__hello">Signed in as {{ customer.name | default: customer.email }}</p>\n' +
              '  <nav class="lb-account__nav"><a href="{{ routes.account_orders_url }}">Orders</a><a href="{{ routes.account_addresses_url }}">Addresses</a><a href="{{ routes.account_settings_url }}">Settings</a><lb-logout data-logout-url="{{ routes.account_logout_url }}"><form method="post" action="{{ routes.account_logout_url }}"><button type="submit" class="lb-account__nav-link">Sign out</button></form></lb-logout></nav>\n' +
              '  {% else %}\n' +
              '  <p class="lb-account__guest">Please <a href="{{ routes.customer_login_url }}">sign in</a> to view your account.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Customer Account","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your account","id":"heading"}],"blocks":[],"presets":[{"name":"Customer Account","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-login': {
            path: 'sections/customer-login.liquid',
            source: '<div class="pf-theme"><section class="lb-auth lb-auth--login" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  {% if request.error %}<p class="lb-auth__error" role="alert">{% case request.error %}{% when "missing_fields" %}Please fill in all required fields.{% when "invalid_credentials" %}Incorrect email or password.{% when "account_exists" %}An account with this email already exists. Please sign in.{% when "rate_limited" %}Too many attempts. Please try again shortly.{% when "bot_verification" %}We could not verify you are not a robot. Please try again.{% else %}Something went wrong. Please try again.{% endcase %}</p>{% endif %}\n' +
              '  <form class="lb-auth__form" method="post" action="/api/customer/login">\n' +
              '    <input type="hidden" name="storeId" value="{{ shop.id }}">\n' +
              '    <input type="hidden" name="turnstileToken" value="">\n' +
              '    <lb-turnstile data-lb-island="turnstile"></lb-turnstile>\n' +
              '    <label>Email<input type="email" name="email" autocomplete="email" required></label>\n' +
              '    <label>Password<input type="password" name="password" autocomplete="current-password" required></label>\n' +
              '    <button type="submit">Sign in</button>\n' +
              '  </form>\n' +
              '  <a href="{{ routes.customer_register_url }}">Create an account</a>\n' +
              '  <p class="lb-auth__letbuyy"><a href="/api/buyer-auth/start?return_to={{ routes.account_url }}">Continue with LetBuyy</a></p>\n' +
              '  <p>Have an older store account? Connect it with your verified LetBuyy account.</p>\n' +
              '  <form class="lb-auth__link-store" method="post" action="/api/buyer-auth/start">\n' +
              '    <input type="hidden" name="intent" value="link_store_customer">\n' +
              '    <input type="hidden" name="return_to" value="{{ routes.account_url }}">\n' +
              '    <button type="submit">Connect my store account</button>\n' +
              '  </form>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Customer Login","tag":"section","settings":[{"type":"text","label":"Heading","default":"Sign in","id":"heading"}],"blocks":[],"presets":[{"name":"Customer Login","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-register': {
            path: 'sections/customer-register.liquid',
            source: '<div class="pf-theme"><section class="lb-auth lb-auth--register" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <p>Create one LetBuyy account to use across participating storefronts.</p>\n' +
              '  <p class="lb-auth__letbuyy"><a href="/api/buyer-auth/start?return_to={{ routes.account_url }}">Create or sign in with LetBuyy</a></p>\n' +
              '  <p>Have an older store-only account? <a href="{{ routes.customer_login_url }}">Sign in to connect it with your verified LetBuyy account</a>.</p>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Customer Register","tag":"section","settings":[{"type":"text","label":"Heading","default":"Create account","id":"heading"}],"blocks":[],"presets":[{"name":"Customer Register","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-settings': {
            path: 'sections/customer-settings.liquid',
            source: '<div class="pf-theme"><section class="lb-settings" data-section-id="{{ section.id }}">\n' +
              '  {% if buyer %}\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <div class="lb-settings__current"><p class="lb-settings__email">{{ buyer.email }}</p>{% if buyer.full_name %}<p class="lb-settings__name">{{ buyer.full_name }}</p>{% endif %}{% if buyer.phone %}<p class="lb-settings__phone">{{ buyer.phone }}</p>{% endif %}</div>\n' +
              '  <lb-customer-settings data-lb-island="customer-settings" data-account-type="buyer" data-base-path="/store/{{ shop.subdomain }}" data-authenticated="true"></lb-customer-settings>\n' +
              '  {% elsif buyer_unavailable %}<p class="lb-settings__unavailable" role="status">We could not load your LetBuyy profile right now. Please refresh and try again.</p>\n' +
              '  {% elsif customer %}\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <div class="lb-settings__current">\n' +
              '    <p class="lb-settings__email">{{ customer.email }}</p>\n' +
              '    {% if customer.name %}<p class="lb-settings__name">{{ customer.name }}</p>{% endif %}\n' +
              '    {% if customer.phone %}<p class="lb-settings__phone">{{ customer.phone }}</p>{% endif %}\n' +
              '  </div>\n' +
              '  <lb-customer-settings\n' +
              '    data-lb-island="customer-settings"\n' +
              '    data-email="{{ customer.email | escape }}"\n' +
              '    data-name="{{ customer.name | default: "" | escape }}"\n' +
              '    data-phone="{{ customer.phone | default: "" | escape }}"\n' +
              '    data-base-path="/store/{{ shop.subdomain }}"\n' +
              '    data-authenticated="true"\n' +
              '  ></lb-customer-settings>\n' +
              '  {% else %}\n' +
              '  <p class="lb-settings__guest">Please <a href="{{ routes.customer_login_url }}">sign in</a> to manage your settings.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Account Settings","tag":"section","settings":[{"type":"text","label":"Heading","default":"Account settings","id":"heading"}],"blocks":[],"presets":[{"name":"Account Settings","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-wishlist': {
            path: 'sections/customer-wishlist.liquid',
            source: '<div class="pf-theme"><section class="lb-wishlist" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}{% if customer.wishlist_products.size > 0 %} <span class="lb-wishlist__count">({{ customer.wishlist_products.size }})</span>{% elsif buyer_wishlist.products.size > 0 %} <span class="lb-wishlist__count">({{ buyer_wishlist.products.size }})</span>{% endif %}</h1>\n' +
              '  {% if buyer_wishlist.authenticated %}\n' +
              '    {% if buyer_wishlist.unavailable %}<p class="lb-wishlist__unavailable" role="status">Your wishlist is temporarily unavailable. Please try again.</p>\n' +
              '    {% elsif buyer_wishlist.storeAccountUnavailable %}<p class="lb-wishlist__unavailable" role="status">This store account is unavailable. Contact the store for help.</p>\n' +
              '    {% elsif buyer_wishlist.linked and buyer_wishlist.products.size > 0 %}\n' +
              '      <div class="lb-product-grid__items">{% for item in buyer_wishlist.products %}<article class="lb-product-card"><a href="{{ item.url }}"><strong>{{ item.title }}</strong><span>{{ item.price | times: 100 | money_with_currency: item.currency }}</span></a><lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ item.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="true" data-authenticated="true" data-account-type="buyer" data-buyer-id="{{ buyer_wishlist.buyerId }}" data-buyer-linked="true" data-base-path="/store/{{ shop.subdomain }}"></lb-wishlist-toggle></article>{% endfor %}</div>\n' +
              '    {% elsif buyer_wishlist.linked %}<p class="lb-wishlist__empty">Your wishlist is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>\n' +
              '    {% else %}<p class="lb-wishlist__guest">Connect your verified store account in <a href="{{ routes.account_settings_url }}">account settings</a> to use this store wishlist.</p>{% endif %}\n' +
              '  {% elsif customer.wishlist_products and customer.wishlist_products.size > 0 %}\n' +
              '  <div class="lb-product-grid__items">\n' +
              '    {% for item in customer.wishlist_products %}<article class="lb-product-card"><a href="{{ item.url }}"><strong>{{ item.title }}</strong><span>{{ item.price | times: 100 | money_with_currency: item.currency }}</span></a><lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ item.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="true" data-authenticated="true" data-account-type="store_customer" data-base-path="/store/{{ shop.subdomain }}"></lb-wishlist-toggle></article>{% endfor %}\n' +
              '  </div>\n' +
              '  {% elsif customer %}\n' +
              '  <p class="lb-wishlist__empty">Your wishlist is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>\n' +
              '  {% else %}\n' +
              '  <p class="lb-wishlist__guest">Please <a href="{{ routes.customer_login_url }}">sign in</a> to view your wishlist.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Wishlist","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your wishlist","id":"heading"}],"blocks":[],"presets":[{"name":"Wishlist","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'customer-addresses': {
            path: 'sections/customer-addresses.liquid',
            source: '<div class="pf-theme"><section class="lb-addresses" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  {% if buyer %}\n' +
              '  <lb-address-manager data-lb-island="address-manager" data-account-type="buyer" data-base-path="/store/{{ shop.subdomain }}" data-authenticated="true"></lb-address-manager>\n' +
              '  {% elsif buyer_unavailable %}<p class="lb-addresses__unavailable" role="status">We could not load your LetBuyy addresses right now. Please refresh and try again.</p>\n' +
              '  {% elsif customer %}\n' +
              '  {% if customer.addresses and customer.addresses.size > 0 %}\n' +
              '  <div class="lb-addresses__grid">\n' +
              '    {% for addr in customer.addresses %}<div class="lb-address-card{% if addr.is_default %} lb-address-card--default{% endif %}"><span class="lb-address-card__label">{{ addr.label | default: "address" }}</span>{% if addr.is_default %}<span class="lb-address-card__default-badge">Default</span>{% endif %}<p class="lb-address-card__address">{{ addr.address1 }}{% if addr.address2 %}, {{ addr.address2 }}{% endif %}</p><p class="lb-address-card__city">{{ addr.city }}, {{ addr.province }} {{ addr.zip }}</p></div>{% endfor %}\n' +
              '  </div>\n' +
              '  {% else %}\n' +
              '  <p class="lb-addresses__empty">No saved addresses.</p>\n' +
              '  {% endif %}\n' +
              '  <lb-address-manager\n' +
              '    data-lb-island="address-manager"\n' +
              '    data-base-path="/store/{{ shop.subdomain }}"\n' +
              '    data-authenticated="true"\n' +
              '  ></lb-address-manager>\n' +
              '  {% else %}\n' +
              '  <p class="lb-addresses__guest">Please <a href="{{ routes.customer_login_url }}">sign in</a> to manage your addresses.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Addresses","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your addresses","id":"heading"}],"blocks":[],"presets":[{"name":"Addresses","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'policy-content': {
            path: 'sections/policy-content.liquid',
            source: '<div class="pf-theme"><section class="lb-policy" data-section-id="{{ section.id }}">\n' +
              '  {% if page %}\n' +
              '  <h1 class="lb-policy__title">{{ page.title }}</h1>\n' +
              '  {% if page.body_html != blank %}<div class="lb-policy__body">{{ page.body_html | raw }}</div>\n' +
              '  {% elsif page.content != blank %}<div class="lb-policy__body">{{ page.content | raw }}</div>{% endif %}\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Policy Content","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Policy Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'cart-summary': {
            path: 'sections/cart-summary.liquid',
            source: '<div class="pf-theme"><section class="lb-cart-page" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.heading }}</h1>\n' +
              '  <lb-cart data-lb-island="cart" data-base-path="/store/{{ shop.subdomain }}">\n' +
              '    {% if cart.item_count > 0 %}\n' +
              '    <ul class="lb-cart__items">{% for item in cart.items %}<li class="lb-cart__item"><span class="lb-cart__title">{{ item.title }}</span><span class="lb-cart__qty">x{{ item.quantity }}</span><span class="lb-cart__line">{{ item.line_price | money_with_currency: cart.currency }}</span></li>{% endfor %}</ul>\n' +
              '    <div class="lb-liquid-cart__totals">\n' +
              '      {% if cart.subtotal %}<div class="lb-liquid-cart__row"><span>Subtotal</span><span>{{ cart.subtotal | money_with_currency: cart.currency }}</span></div>{% endif %}\n' +
              '      {% if cart.coupon_codes.size > 0 %}<div class="lb-liquid-cart__row"><span>Coupons</span><span>{{ cart.coupon_codes | join: ", " }}</span></div>{% endif %}\n' +
              '      {% if cart.discount_total %}<div class="lb-liquid-cart__row"><span>Discounts</span><span>{{ cart.discount_total | money_with_currency: cart.currency }}</span></div>{% endif %}\n' +
              '      {% if cart.shipping_total %}<div class="lb-liquid-cart__row"><span>Shipping</span><span>{{ cart.shipping_total | money_with_currency: cart.currency }}</span></div>{% endif %}\n' +
              '      {% if cart.tax_total %}<div class="lb-liquid-cart__row"><span>Tax (GST)</span><span>{{ cart.tax_total | money_with_currency: cart.currency }}</span></div>{% endif %}\n' +
              '    </div>\n' +
              '    <p class="lb-cart__total">Total: {{ cart.total_price | money_with_currency: cart.currency }}</p>\n' +
              '    <a class="lb-cart__checkout" href="{{ cart.checkout_url }}">Checkout</a>\n' +
              '    {% else %}<p class="lb-cart__empty">Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Browse products</a></p>{% endif %}\n' +
              '  </lb-cart>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Cart","tag":"section","settings":[{"type":"text","label":"Heading","default":"Your cart","id":"heading"}],"blocks":[],"presets":[{"name":"Cart","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'search-box': {
            path: 'sections/search-box.liquid',
            source: '<div class="pf-theme"><section class="lb-search" data-section-id="{{ section.id }}">\n' +
              '  <lb-search data-lb-island="search" data-search-url="{{ routes.search_url }}">\n' +
              '    <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>\n' +
              '      <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>\n' +
              '      <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="{{ section.settings.placeholder }}" aria-label="Search products" value="{{ search.terms }}">\n' +
              '      <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>\n' +
              `    {% for field in collection.discovery_query_fields %}{% unless field.key == 'page' or field.key == 'search' %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endfor %}</form>\n` +
              '  </lb-search>\n' +
              '  {% if search.terms %}<p class="lb-search__terms">Results for "{{ search.terms }}"</p>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Search","tag":"section","settings":[{"type":"text","label":"Placeholder","default":"Search products","id":"placeholder"}],"blocks":[],"presets":[{"name":"Search","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'collection-banner': {
            path: 'sections/collection-banner.liquid',
            source: '<div class="pf-theme"><section class="lb-collection-banner" data-section-id="{{ section.id }}">\n' +
              '  {% if collection.image_url != blank %}<img class="lb-collection-banner__image" src="{{ collection.image_url | image_url }}" alt="{{ collection.title }}">{% endif %}\n' +
              '  <h1>{{ collection.title }}</h1>\n' +
              '  {% if collection.products.size > 0 %}<p class="lb-collection-banner__count">{{ collection.products.size }} products</p>{% endif %}\n' +
              '  {% if section.settings.showDescription and collection.description %}<div class="lb-collection-banner__desc">{{ collection.description }}</div>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Collection Banner","tag":"section","settings":[{"type":"toggle","label":"Show description","default":true,"id":"showDescription"}],"blocks":[],"presets":[{"name":"Collection Banner","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'collection-product-list': {
            path: 'sections/collection-product-list.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap" data-section-id="{{ section.id }}">{% if collection.products.size > 0 %}<div class="pf-grid">{% for item in collection.products %}<article class="pf-card"><a href="{{ item.url }}"><div class="pf-card-media">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<div class="pf-no-image">Product image not supplied</div>{% endif %}<span class="pf-card-badge">{% if item.toys_card.ageLabel != blank %}{{ item.toys_card.ageLabel }}{% else %}Age information not supplied{% endif %}</span></div><h3>{{ item.title }}</h3></a><p class="pf-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if item.toys_card.contentsLabel != blank %}<p>{{ item.toys_card.contentsLabel }}{% unless item.toys_card.contentsComplete == true %} · Partial contents list{% endunless %}</p>{% else %}<p>Contents not supplied</p>{% endif %}{% if item.available == false %}<p>Unavailable</p>{% endif %}<a class="pf-link" href="{{ item.url }}">{% if item.toys_card.hasOptions %}Choose an edition{% else %}View product{% endif %} →</a></article>{% endfor %}</div><nav class="pf-pagination" aria-label="Product pages">{% if collection.pagination.previous_url %}<a class="pf-link" href="{{ collection.pagination.previous_url }}">Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url %}<a class="pf-link" href="{{ collection.pagination.next_url }}">Next</a>{% endif %}</nav>{% else %}<h2>No activities match this choice.</h2><p>Try another age or interest, or explore all activities.</p><a class="pf-link" href="{{ routes.all_products_collection_url }}">Explore all activities</a>{% endif %}</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Activity results","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Activity results","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'blog-listing': {
            path: 'sections/blog-listing.liquid',
            source: '<div class="pf-theme"><section class="lb-blog-listing" data-section-id="{{ section.id }}">\n' +
              '  <h1 class="lb-blog-listing__heading">{{ section.settings.heading }}</h1>\n' +
              '  {% if blog.articles and blog.articles.size > 0 %}\n' +
              '  <div class="lb-blog-listing__articles">\n' +
              '    {% for article in blog.articles %}\n' +
              '    <article class="lb-blog-article-card">\n' +
              '      <h2 class="lb-blog-article-card__title"><a href="{{ routes.blog_url }}/{{ article.slug }}">{{ article.title }}</a></h2>\n' +
              '      {% if article.excerpt %}<p class="lb-blog-article-card__excerpt">{{ article.excerpt }}</p>{% endif %}\n' +
              '      {% if article.published_at %}<time class="lb-blog-article-card__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}\n' +
              '    </article>\n' +
              '    {% endfor %}\n' +
              '  </div>\n' +
              '  {% if blog.pages_count and blog.pages_count > 1 %}\n' +
              '  <nav class="lb-blog-listing__pagination" aria-label="Blog pagination">\n' +
              '    {% if blog.current_page and blog.current_page > 1 %}<a class="lb-blog-listing__prev" href="{{ routes.blog_url }}?page={{ blog.current_page | minus: 1 }}" rel="prev">Previous</a>{% endif %}\n' +
              '    {% assign next_page = blog.current_page | plus: 1 %}\n' +
              '    {% if next_page <= blog.pages_count %}<a class="lb-blog-listing__next" href="{{ routes.blog_url }}?page={{ next_page }}" rel="next">Next</a>{% endif %}\n' +
              '  </nav>\n' +
              '  {% endif %}\n' +
              '  {% else %}\n' +
              '  <p class="lb-blog-listing__empty">No posts published yet.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Blog Listing","tag":"section","settings":[{"type":"text","label":"Heading","default":"Our Blog","id":"heading"}],"blocks":[],"presets":[{"name":"Blog Listing","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'article-content': {
            path: 'sections/article-content.liquid',
            source: '<div class="pf-theme"><section class="lb-article" data-section-id="{{ section.id }}">\n' +
              '  {% if article %}\n' +
              '  <h1 class="lb-article__title">{{ article.title }}</h1>\n' +
              '  {% if article.published_at %}<time class="lb-article__date" datetime="{{ article.published_at }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>{% endif %}\n' +
              '  {% if article.image %}<img class="lb-article__image" src="{{ article.image | image_url }}" alt="{{ article.title }}">{% endif %}\n' +
              '  {% if article.body_html != blank %}<div class="lb-article__body">{{ article.body_html | raw }}</div>{% endif %}\n' +
              '  {% else %}\n' +
              '  <p class="lb-article__missing">Article not found.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Article Content","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Article Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'page-content': {
            path: 'sections/page-content.liquid',
            source: '<div class="pf-theme"><section class="lb-page" data-section-id="{{ section.id }}">\n' +
              '  {% if page %}\n' +
              '  <h1 class="lb-page__title">{{ page.title }}</h1>\n' +
              '  {% if page.body_html != blank %}<div class="lb-page__body">{{ page.body_html | raw }}</div>\n' +
              '  {% else %}<p class="lb-page__empty">No content yet.</p>{% endif %}\n' +
              '  {% else %}\n' +
              '  <p class="lb-page__missing">Page not found.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Page Content","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Page Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          '404-page': {
            path: 'sections/404-page.liquid',
            source: '<div class="pf-theme"><section class="lb-404" data-section-id="{{ section.id }}">\n' +
              '  <h1 class="lb-404__code">404</h1>\n' +
              '  <p class="lb-404__message">Page not found</p>\n' +
              '  <a class="lb-404__home" href="{{ routes.root_url }}">Back to home</a>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"404 Not Found","tag":"section","settings":[],"blocks":[],"presets":[{"name":"404 Not Found","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'password-gate': {
            path: 'sections/password-gate.liquid',
            source: '<div class="pf-theme"><!-- password gate rendering requires proxy routing update (Phase F) -->\n' +
              '<section class="lb-password-gate" data-section-id="{{ section.id }}">\n' +
              '  <h1 class="lb-password-gate__heading">{{ shop.name }}</h1>\n' +
              '  <p class="lb-password-gate__message">{{ section.settings.heading }}</p>\n' +
              '  <p class="lb-password-gate__info">This store is password protected.</p>\n' +
              '  <form class="lb-password-gate__form" method="post" action="/store-access/password">\n' +
              '    <label class="lb-password-gate__label">Enter password<input class="lb-password-gate__input" type="password" name="password" autocomplete="current-password" required></label>\n' +
              '    <button type="submit" class="lb-password-gate__btn">Enter</button>\n' +
              '  </form>\n' +
              '  {% if shop.access_message and shop.access_message != blank %}<p class="lb-password-gate__access-message">{{ shop.access_message }}</p>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Password Gate","tag":"section","settings":[{"type":"text","label":"Heading","default":"Coming Soon","id":"heading"}],"blocks":[],"presets":[{"name":"Password Gate","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'announcement-bar': {
            path: 'sections/announcement-bar.liquid',
            source: '<div class="pf-theme"><section class="lb-announcement-bar" data-section-id="{{ section.id }}">\n' +
              '  <div class="lb-announcement-bar__inner">\n' +
              '    <span>{{ section.settings.text }}</span>\n' +
              '    {% if section.settings.linkLabel != blank and section.settings.linkHref != blank %}<a href="{{ section.settings.linkHref | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}\n' +
              '  </div>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Announcement Bar","tag":"section","settings":[{"type":"text","label":"Message","default":"Discover our latest products.","id":"text"},{"type":"text","label":"Link label","default":"Shop now","id":"linkLabel"},{"type":"url","label":"Link URL","default":"/products","id":"linkHref"}],"blocks":[],"presets":[{"name":"Announcement Bar","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'about-section': {
            path: 'sections/about-section.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap pf-section" data-section-id="{{ section.id }}">{% if section.settings.content != blank or section.settings.image != blank %}<div class="pf-editorial">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy">{% endif %}<div><p class="pf-eyebrow">A LITTLE SPACE TO EXPLORE</p><h2>{{ section.settings.title }}</h2><p>{{ section.settings.content }}</p>{% if section.settings.linkLabel != blank and section.settings.linkUrl != blank %}<a class="pf-link" href="{{ section.settings.linkUrl | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}</div></div>{% endif %}</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Activity editorial","tag":"section","settings":[{"type":"text","label":"Heading","default":"One kit. Many starting points.","id":"title"},{"type":"text","label":"Merchant editorial text","default":"","id":"content"},{"type":"image","label":"Activity image","id":"image"},{"type":"text","label":"Image description","default":"","id":"imageAlt"},{"type":"text","label":"Link label","default":"","id":"linkLabel"},{"type":"url","label":"Link destination","default":"","id":"linkUrl"}],"blocks":[],"presets":[{"name":"Activity editorial","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'app-block-slot': {
            path: 'sections/app-block-slot.liquid',
            source: '<div class="pf-theme"><section class="lb-app-block-slot" data-section-id="{{ section.id }}">\n' +
              '  {% if section.settings.title %}<h2>{{ section.settings.title }}</h2>{% endif %}\n' +
              '  {% for block in section.blocks %}{{ block.content | raw }}{% endfor %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"App Block Slot","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"text","label":"Slot","default":"storefront.home.after-hero","id":"slot"}],"blocks":[{"type":"@app","name":"App block","settings":[]}],"presets":[{"name":"App Block Slot","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'banner-carousel': {
            path: 'sections/banner-carousel.liquid',
            source: '<div class="pf-theme"><section class="lb-banner-carousel" data-section-id="{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}">\n' +
              '  {% if section.settings.title %}<h2>{{ section.settings.title }}</h2>{% endif %}\n' +
              '  <div class="lb-banner-carousel__slides">\n' +
              '    {% for block in section.blocks %}<a {{ block.editor_attributes | raw }} href="{{ block.settings.link | store_url }}">{% if block.settings.image %}<img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading }}">{% endif %}<h3>{{ block.settings.heading }}</h3></a>{% endfor %}\n' +
              '  </div>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Banner Carousel","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"toggle","label":"Autoplay","default":true,"id":"autoplay"}],"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"text","label":"Heading","id":"heading"},{"type":"image","label":"Image","id":"image"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Banner Carousel","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'brand-marquee': {
            path: 'sections/brand-marquee.liquid',
            source: '<div class="pf-theme"><section class="lb-brand-marquee" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  <div>{% for block in section.blocks %}<span {{ block.editor_attributes | raw }}>{{ block.settings.name }}</span>{% endfor %}</div>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Brand Marquee","tag":"section","settings":[{"type":"text","label":"Title","default":"Featured brands","id":"title"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","label":"Name","id":"name"}]}],"presets":[{"name":"Brand Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'category-grid': {
            path: 'sections/category-grid.liquid',
            source: '<div class="pf-theme">{% assign pf_age_available = false %}{% assign pf_interest_available = false %}{% if collection.capabilities.discovery == true and collection.capabilities.toys_filters == true %}{% if collection.capabilities.toys_age_band == true and collection.toy_facets.age_bands.size > 0 %}{% assign pf_age_available = true %}{% endif %}{% if collection.capabilities.toys_interest == true and collection.toy_facets.interests.size > 0 %}{% assign pf_interest_available = true %}{% endif %}{% endif %}<section class="pf-wrap pf-section" data-section-id="{{ section.id }}">{% if pf_age_available %}<h2>{{ section.settings.title }}</h2><div class="pf-ages">{% for choice in collection.toy_facets.age_bands %}<a class="pf-link" href="{{ routes.all_products_collection_url }}?age_band={{ choice.value | url_encode }}">{{ choice.label }} →</a>{% endfor %}</div><p class="pf-note">These are merchant recommendations. Read each product’s information before choosing.</p>{% else %}<h2>Explore their next activity.</h2><a class="pf-link" href="{{ routes.all_products_collection_url }}">Browse all activities →</a>{% endif %}</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Age entry points","tag":"section","settings":[{"type":"text","label":"Heading","default":"Start with their age.","id":"title"}],"blocks":[],"presets":[{"name":"Age entry points","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'collection-filter': {
            path: 'sections/collection-filter.liquid',
            source: `<div class="pf-theme">{% assign pf_age_available = false %}{% assign pf_interest_available = false %}{% if collection.capabilities.discovery == true and collection.capabilities.toys_filters == true %}{% if collection.capabilities.toys_age_band == true and collection.toy_facets.age_bands.size > 0 %}{% assign pf_age_available = true %}{% endif %}{% if collection.capabilities.toys_interest == true and collection.toy_facets.interests.size > 0 %}{% assign pf_interest_available = true %}{% endif %}{% endif %}<section class="pf-wrap pf-section" data-section-id="{{ section.id }}"><p class="pf-eyebrow">FOLLOW THEIR CURIOSITY</p><h1>{{ collection.title | default: 'Find their next activity.' }}</h1>{% if collection.total != nil %}<p>{{ collection.total }} products</p>{% endif %}<form class="pf-filters" method="get" action="{{ request.path }}"><label>Search activities<input type="search" name="search" maxlength="200" value="{{ request.query.search }}"></label>{% if pf_age_available %}<label>Choose an age<select name="age_band"><option value="">Any age</option>{% for choice in collection.toy_facets.age_bands %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}{% assign pf_selected_choices = collection.toy_facets.age_bands | where: 'selected', true %}{% if pf_selected_choices.size == 0 %}{% for field in collection.discovery_query_fields %}{% if field.key == 'age_band' %}<option value="{{ field.value }}" selected>{{ field.value }} (selected)</option>{% endif %}{% endfor %}{% endif %}</select></label>{% endif %}{% if pf_interest_available %}<label>Follow an interest<select name="interest"><option value="">Any interest</option>{% for choice in collection.toy_facets.interests %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}{% assign pf_selected_choices = collection.toy_facets.interests | where: 'selected', true %}{% if pf_selected_choices.size == 0 %}{% for field in collection.discovery_query_fields %}{% if field.key == 'interest' %}<option value="{{ field.value }}" selected>{{ field.value }} (selected)</option>{% endif %}{% endfor %}{% endif %}</select></label>{% endif %}<label>Sort<select name="sort"><option value="display_order"{% if request.query.sort == 'display_order' %} selected{% endif %}>Featured</option><option value="price-asc"{% if request.query.sort == 'price-asc' %} selected{% endif %}>Price: low to high</option><option value="price-desc"{% if request.query.sort == 'price-desc' %} selected{% endif %}>Price: high to low</option><option value="newest"{% if request.query.sort == 'newest' %} selected{% endif %}>Newest</option><option value="name"{% if request.query.sort == 'name' %} selected{% endif %}>Name</option></select></label>{% for field in collection.discovery_query_fields %}{% unless field.key == 'page' or field.key == 'search' or field.key == 'sort' %}{% unless field.key == 'age_band' and pf_age_available %}{% unless field.key == 'interest' and pf_interest_available %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endunless %}{% endunless %}{% endfor %}<button class="pf-button" type="submit">Apply filters</button></form><div class="pf-active-filters">{% for filter in collection.active_filters %}<a class="pf-link" href="{{ filter.clear_url }}">Remove {{ filter.label }} ×</a>{% endfor %}<a class="pf-link" href="{{ collection.clear_filters_url | default: request.path }}">Clear all filters</a></div>{% if pf_age_available %}<p class="pf-note">Age ranges are merchant recommendations. Read each product’s information before choosing.</p>{% elsif pf_interest_available == false %}<p>Browse all activities or search this store’s products.</p>{% endif %}</section>\n` +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Age and interest discovery","tag":"section","settings":[],"blocks":[],"presets":[{"name":"Age and interest discovery","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'contact-form': {
            path: 'sections/contact-form.liquid',
            source: '<div class="pf-theme"><section class="lb-contact-form" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  <p>{{ section.settings.subtitle }}</p>\n' +
              '  <form action="/contact" method="post"><input name="name" aria-label="Name"><input type="email" name="email" aria-label="Email">{% if section.settings.showPhone %}<input name="phone" aria-label="Phone">{% endif %}<button type="submit">Send</button></form>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Contact Form","tag":"section","settings":[{"type":"text","label":"Title","default":"Contact us","id":"title"},{"type":"text","label":"Subtitle","id":"subtitle"},{"type":"toggle","label":"Show phone field","default":true,"id":"showPhone"}],"blocks":[],"presets":[{"name":"Contact Form","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'cta-section': {
            path: 'sections/cta-section.liquid',
            source: '<div class="pf-theme"><section class="lb-cta-section" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.heading }}</h2>\n' +
              '  <p>{{ section.settings.subheading }}</p>\n' +
              '  <a href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Call to Action","tag":"section","settings":[{"type":"text","label":"Heading","default":"Ready to get started?","id":"heading"},{"type":"text","label":"Subheading","id":"subheading"},{"type":"text","label":"Button text","default":"Shop now","id":"ctaText"},{"type":"url","label":"Button link","default":"/products","id":"ctaLink"}],"blocks":[],"presets":[{"name":"Call to Action","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'featured-products': {
            path: 'sections/featured-products.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap pf-section" data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<h2>{{ section.settings.title }}</h2><div class="pf-grid" data-columns="{{ section.settings.columns }}">{% for item in section.products limit: section.settings.productLimit %}<article class="pf-card"><a href="{{ item.url }}"><div class="pf-card-media">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<div class="pf-no-image">Product image not supplied</div>{% endif %}<span class="pf-card-badge">{% if item.toys_card.ageLabel != blank %}{{ item.toys_card.ageLabel }}{% else %}Age information not supplied{% endif %}</span></div><h3>{{ item.title }}</h3></a><p class="pf-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if item.toys_card.contentsLabel != blank %}<p>{{ item.toys_card.contentsLabel }}{% unless item.toys_card.contentsComplete == true %} · Partial contents list{% endunless %}</p>{% else %}<p>Contents not supplied</p>{% endif %}{% if item.available == false %}<p>Unavailable</p>{% endif %}<a class="pf-link" href="{{ item.url }}">{% if item.toys_card.hasOptions %}Choose an edition{% else %}View product{% endif %} →</a></article>{% endfor %}</div>{% endif %}</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Related activity cards","tag":"section","settings":[{"type":"text","label":"Heading","default":"For curious afternoons.","id":"title"},{"type":"text","label":"Description","default":"","id":"subtitle"},{"type":"range","label":"Desktop columns","default":3,"min":2,"max":4,"step":1,"id":"columns"},{"type":"range","label":"Products to show","default":6,"min":1,"max":24,"step":1,"id":"productLimit"},{"type":"collection","label":"Collection","id":"collectionId"}],"blocks":[],"presets":[{"name":"Related activity cards","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'experience-timeline': {
            path: 'sections/experience-timeline.liquid',
            source: '<div class="pf-theme"><section class="lb-experience-timeline" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% for block in section.blocks %}<article {{ block.editor_attributes | raw }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.company }}</p><time>{{ block.settings.period }}</time></article>{% endfor %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Experience Timeline","tag":"section","settings":[{"type":"text","label":"Title","default":"Experience","id":"title"}],"blocks":[{"type":"experience","name":"Experience","settings":[{"type":"text","label":"Title","id":"title"},{"type":"text","label":"Company","id":"company"},{"type":"text","label":"Period","id":"period"}]}],"presets":[{"name":"Experience Timeline","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'faq-accordion': {
            path: 'sections/faq-accordion.liquid',
            source: '<div class="pf-theme"><section class="lb-faq-accordion" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% if section.blocks.size > 0 %}\n' +
              '  <div class="lb-faq-accordion__items">\n' +
              '    {% for block in section.blocks %}<details {{ block.editor_attributes | raw }} class="lb-faq-accordion__item"{% unless section.settings.allowMultipleOpen %} name="lb-faq-{{ section.id }}"{% endunless %}><summary class="lb-faq-accordion__question">{{ block.settings.question }}</summary><div class="lb-faq-accordion__answer">{{ block.settings.answer }}</div></details>{% endfor %}\n' +
              '  </div>\n' +
              '  {% else %}\n' +
              '  <p class="lb-faq-accordion__empty">No questions published yet.</p>\n' +
              '  {% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"FAQ Accordion","tag":"section","settings":[{"type":"text","label":"Title","default":"Frequently asked questions","id":"title"},{"type":"toggle","label":"Allow multiple open","default":false,"id":"allowMultipleOpen"}],"blocks":[{"type":"faq-item","name":"FAQ item","settings":[{"type":"text","label":"Question","id":"question"},{"type":"richtext","label":"Answer","id":"answer"}]}],"presets":[{"name":"FAQ Accordion","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          footer: {
            path: 'sections/footer.liquid',
            source: '<div class="pf-theme"><footer class="lb-footer" data-section-id="{{ section.id }}">\n' +
              '  <div class="lb-footer__grid">\n' +
              '    <div class="lb-footer__brand">\n' +
              '      <h3>{{ section.settings.storeName | default: shop.name }}</h3>\n' +
              '      {% if section.settings.tagline %}<p>{{ section.settings.tagline }}</p>{% endif %}\n' +
              '      {% if section.settings.instagramUrl != blank or section.settings.facebookUrl != blank or section.settings.twitterUrl != blank %}\n' +
              '      <div class="lb-footer__social">\n' +
              '        {% if section.settings.instagramUrl != blank %}<a href="{{ section.settings.instagramUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a>{% endif %}\n' +
              '        {% if section.settings.facebookUrl != blank %}<a href="{{ section.settings.facebookUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 4h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V8a1 1 0 0 1 1-1h3z"></path></svg></a>{% endif %}\n' +
              '        {% if section.settings.twitterUrl != blank %}<a href="{{ section.settings.twitterUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="4" x2="20" y2="20"></line><line x1="20" y1="4" x2="4" y2="20"></line></svg></a>{% endif %}\n' +
              '      </div>\n' +
              '      {% endif %}\n' +
              '    </div>\n' +
              '    {% if section.blocks.size > 0 %}\n' +
              '    <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for block in section.blocks %}<a {{ block.editor_attributes | raw }} href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}</nav></div>\n' +
              '    {% elsif linklists.footer_menu.links.size > 0 %}\n' +
              '    <div class="lb-footer__col"><h4>Quick links</h4><nav>{% for link in linklists.footer_menu.links %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}</nav></div>\n' +
              '    {% endif %}\n' +
              '    {% if shop.policies.size > 0 %}<div class="lb-footer__col">\n' +
              '      <h4>Policies</h4>\n' +
              '      <nav>\n' +
              `        {% if shop.policies contains 'privacy' %}<a href="{{ routes.root_url }}/privacy">Privacy policy</a>{% endif %}\n` +
              `        {% if shop.policies contains 'terms' %}<a href="{{ routes.root_url }}/terms">Terms of service</a>{% endif %}\n` +
              `        {% if shop.policies contains 'shipping' %}<a href="{{ routes.root_url }}/shipping">Shipping policy</a>{% endif %}\n` +
              `        {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}<a href="{{ routes.root_url }}/returns">Returns policy</a>{% endif %}\n` +
              '      </nav>\n' +
              '    </div>{% endif %}\n' +
              '    <div class="lb-footer__col">\n' +
              '      <h4>Contact</h4>\n' +
              '      {% if section.settings.contactEmail != blank %}<p><a href="mailto:{{ section.settings.contactEmail }}">{{ section.settings.contactEmail }}</a></p>{% endif %}\n' +
              '      {% if section.settings.contactPhone != blank %}<p><a href="tel:{{ section.settings.contactPhone }}">{{ section.settings.contactPhone }}</a></p>{% endif %}\n' +
              '      <a href="{{ routes.contact_url }}">Contact us</a>\n' +
              '    </div>\n' +
              '  </div>\n' +
              '  <div class="lb-footer__bottom">\n' +
              '    <p>&copy; {{ shop.name }}. All rights reserved.</p>\n' +
              '    <a class="lb-footer__watermark" href="https://letbuyy.com" target="_blank" rel="noopener noreferrer">Powered by LetBuyy</a>\n' +
              '  </div>\n' +
              '</footer>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Footer","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"text","label":"Tagline","id":"tagline"},{"type":"text","label":"Contact email","id":"contactEmail"},{"type":"text","label":"Contact phone","id":"contactPhone"},{"type":"url","label":"Instagram URL","id":"instagramUrl"},{"type":"url","label":"Facebook URL","id":"facebookUrl"},{"type":"url","label":"Twitter/X URL","id":"twitterUrl"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Footer","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          header: {
            path: 'sections/header.liquid',
            source: `<div class="pf-theme"><header class="lb-header" data-section-id="{{ section.id }}" data-sticky="{% if section.settings.behavior == 'sticky' %}true{% else %}false{% endif %}" data-layout="{{ section.settings.layout | default: 'inline' }}">\n` +
              '  <div class="lb-header__inner">\n' +
              '    <lb-mobile-nav class="lb-mobile-nav" data-lb-island="mobile-nav">\n' +
              '      <button type="button" class="lb-header__toggle" data-lb-nav-toggle aria-expanded="false" aria-controls="lb-nav-panel-{{ section.id }}" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg><span class="lb-sr-only">Menu</span></button>\n' +
              '      <nav class="lb-header__nav" data-lb-nav-panel id="lb-nav-panel-{{ section.id }}" aria-label="Primary">\n' +
              '        <div class="lb-header__nav-head"><span class="lb-header__nav-head-brand">{{ section.settings.storeName | default: shop.name }}</span><button type="button" class="lb-header__nav-close" data-lb-nav-close aria-label="Close menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close menu</span></button></div>\n' +
              '        <div class="lb-header__nav-links">\n' +
              '        {% if section.blocks.size > 0 %}\n' +
              '          {% for block in section.blocks %}<a {{ block.editor_attributes | raw }} href="{{ block.settings.href | store_url }}">{{ block.settings.label }}</a>{% endfor %}\n' +
              '        {% else %}\n' +
              "          {% assign lb_menu_handle = section.settings.menu | default: 'main_menu' %}\n" +
              '          {% assign lb_nav_links = linklists[lb_menu_handle].links %}\n' +
              '          {% for link in lb_nav_links %}\n' +
              '            {% if link.links.size > 0 %}\n' +
              '            <details class="lb-header__nav-item" data-lb-nav-dropdown><summary{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="lb-icon-chevron"><path d="M6 9l6 6 6-6"></path></svg></summary>\n' +
              '              <div class="lb-header__nav-submenu">{% for child in link.links %}<a href="{{ child.url | store_url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>\n' +
              '            </details>\n' +
              '            {% else %}<a href="{{ link.url | store_url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}\n' +
              '          {% endfor %}\n' +
              '        {% endif %}\n' +
              '        </div>\n' +
              '        <div class="lb-header__nav-foot">\n' +
              '          {% if customer %}<a href="{{ routes.account_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Account</span></a>{% else %}<a href="{{ routes.customer_login_url }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span>Log in</span></a>{% endif %}\n' +
              '        </div>\n' +
              '      </nav>\n' +
              '      <div class="lb-header__scrim" data-lb-nav-scrim></div>\n' +
              '    </lb-mobile-nav>\n' +
              '    <a class="lb-header__brand" href="{{ routes.root_url }}">\n' +
              '      {% if shop.logo_url %}<img class="lb-header__logo" src="{{ shop.logo_url | image_url }}" alt="{{ section.settings.storeName | default: shop.name }}">{% else %}{{ section.settings.storeName | default: shop.name }}{% endif %}\n' +
              '    </a>\n' +
              '    <div class="lb-header__actions">\n' +
              '      {% if section.settings.showSearch %}<button type="button" class="lb-header__search-toggle" data-lb-search-toggle aria-expanded="false" aria-controls="lb-search-overlay-{{ section.id }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>{% endif %}\n' +
              '      <a class="lb-header__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.customer_login_url }}{% endif %}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"></circle><path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path></svg><span class="lb-sr-only">{% if customer %}Account{% else %}Log in{% endif %}</span></a>\n' +
              '      {% if section.settings.showCart %}<a class="lb-header__cart" href="{{ routes.cart_url }}" data-lb-cart-trigger><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4h2l2 12h11l2-8H6"></path><circle cx="9" cy="20" r="1"></circle><circle cx="17" cy="20" r="1"></circle></svg><span class="lb-sr-only">{{ "general.cart" | t }}</span> (<span data-lb-cart-count>{{ cart.item_count | default: 0 }}</span>)</a>{% endif %}\n' +
              '    </div>\n' +
              '  </div>\n' +
              '  {% if section.settings.showSearch %}\n' +
              '  <div class="lb-header__search-overlay" id="lb-search-overlay-{{ section.id }}" data-lb-search-overlay hidden>\n' +
              '    <lb-predictive-search class="lb-predictive-search" data-lb-island="predictive-search" data-search-url="{{ routes.search_url }}">\n' +
              '      <form role="search" method="get" action="{{ routes.search_url }}" data-lb-search-form>\n' +
              '        <label class="lb-sr-only" for="lb-search-input-{{ section.id }}">Search products</label>\n' +
              '        <input type="search" name="search" id="lb-search-input-{{ section.id }}" data-lb-search-input placeholder="Search products" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="lb-search-results-{{ section.id }}" aria-autocomplete="list">\n' +
              '        <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg><span class="lb-sr-only">Search</span></button>\n' +
              '        <button type="button" data-lb-search-close aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg><span class="lb-sr-only">Close search</span></button>\n' +
              '      </form>\n' +
              '      <div id="lb-search-results-{{ section.id }}" class="lb-predictive-search__results" data-lb-search-results role="listbox" aria-live="polite"></div>\n' +
              '    </lb-predictive-search>\n' +
              '  </div>\n' +
              '  {% endif %}\n' +
              '</header>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Header","tag":"section","settings":[{"type":"text","label":"Store name","id":"storeName"},{"type":"toggle","label":"Show search","default":true,"id":"showSearch"},{"type":"toggle","label":"Show cart","default":true,"id":"showCart"},{"type":"select","label":"Header behavior","default":"sticky","options":["static","sticky"],"id":"behavior"},{"type":"select","label":"Menu","default":"main_menu","options":["main_menu","footer_menu","policy_menu"],"id":"menu"},{"type":"select","label":"Layout","default":"inline","options":["inline","centered"],"id":"layout"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","label":"Label","id":"label"},{"type":"url","label":"URL","id":"href"}]}],"presets":[{"name":"Header","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'hero-banner': {
            path: 'sections/hero-banner.liquid',
            source: `<div class="pf-theme"><section class="pf-wrap pf-opening" data-section-id="{{ section.id }}"><div><p class="pf-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p></div>{% assign pf_age_available = false %}{% assign pf_interest_available = false %}{% if collection.capabilities.discovery == true and collection.capabilities.toys_filters == true %}{% if collection.capabilities.toys_age_band == true and collection.toy_facets.age_bands.size > 0 %}{% assign pf_age_available = true %}{% endif %}{% if collection.capabilities.toys_interest == true and collection.toy_facets.interests.size > 0 %}{% assign pf_interest_available = true %}{% endif %}{% endif %}{% if pf_age_available or pf_interest_available %}<form class="pf-finder" method="get" action="{{ routes.all_products_collection_url }}">{% if pf_age_available %}<label>Choose an age<select name="age_band"><option value="">Any age</option>{% for choice in collection.toy_facets.age_bands %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}{% assign pf_selected_choices = collection.toy_facets.age_bands | where: 'selected', true %}{% if pf_selected_choices.size == 0 %}{% for field in collection.discovery_query_fields %}{% if field.key == 'age_band' %}<option value="{{ field.value }}" selected>{{ field.value }} (selected)</option>{% endif %}{% endfor %}{% endif %}</select></label>{% endif %}{% if pf_interest_available %}<label>Follow an interest<select name="interest"><option value="">Any interest</option>{% for choice in collection.toy_facets.interests %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}{% assign pf_selected_choices = collection.toy_facets.interests | where: 'selected', true %}{% if pf_selected_choices.size == 0 %}{% for field in collection.discovery_query_fields %}{% if field.key == 'interest' %}<option value="{{ field.value }}" selected>{{ field.value }} (selected)</option>{% endif %}{% endfor %}{% endif %}</select></label>{% endif %}{% for field in collection.discovery_query_fields %}{% unless field.key == 'page' %}{% unless field.key == 'age_band' and pf_age_available %}{% unless field.key == 'interest' and pf_interest_available %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endunless %}{% endunless %}{% endfor %}<button class="pf-button" type="submit">{{ section.settings.buttonLabel }} →</button>{% if pf_age_available %}<p class="pf-note">Shopping for a young person? Age ranges come from the merchant.</p>{% endif %}</form>{% else %}<form class="pf-finder" method="get" action="{{ routes.search_url }}"><label>Search activities<input type="search" name="search" maxlength="200" value="{{ request.query.search }}"></label>{% for field in collection.discovery_query_fields %}{% unless field.key == 'page' or field.key == 'search' %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endfor %}<button class="pf-button" type="submit">Search products →</button><a class="pf-link" href="{{ routes.all_products_collection_url }}">Browse all activities →</a></form>{% endif %}</section>\n` +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Age and interest opening","tag":"section","settings":[{"type":"text","label":"Eyebrow","default":"SMALL HANDS. BIG IDEAS.","id":"eyebrow"},{"type":"text","label":"Heading","default":"What will they make today?","id":"heading"},{"type":"text","label":"Description","default":"Follow a curiosity. Find their next activity.","id":"subheading"},{"type":"text","label":"Finder button","default":"Find an activity","id":"buttonLabel"}],"blocks":[],"presets":[{"name":"Age and interest opening","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          marquee: {
            path: 'sections/marquee.liquid',
            source: '<div class="pf-theme"><section class="lb-marquee" data-section-id="{{ section.id }}">\n' +
              '  <p>{{ section.settings.text }}</p>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Marquee","tag":"section","settings":[{"type":"text","label":"Text","default":"Featured announcement","id":"text"}],"blocks":[],"presets":[{"name":"Marquee","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'portfolio-grid': {
            path: 'sections/portfolio-grid.liquid',
            source: '<div class="pf-theme"><section class="lb-portfolio-grid" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% for block in section.blocks %}<article {{ block.editor_attributes | raw }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.summary }}</p><a href="{{ block.settings.link | store_url }}">View</a></article>{% endfor %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Portfolio Grid","tag":"section","settings":[{"type":"text","label":"Title","default":"Portfolio","id":"title"}],"blocks":[{"type":"project","name":"Project","settings":[{"type":"text","label":"Title","id":"title"},{"type":"textarea","label":"Summary","id":"summary"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Portfolio Grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'product-detail': {
            path: 'sections/product-detail.liquid',
            source: '<div class="pf-theme"><section class="lb-product-detail" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-lb-variant-facts data-lb-facts-namespace="toys" data-lb-toy-presentation="1" data-lb-toy-facts-enabled="{{ section.settings.showToyFacts }}" data-toys-facts="{{ product.toys_resolved_json }}">\n' +
              '  <nav class="lb-product-detail__breadcrumb" aria-label="Breadcrumb">\n' +
              '    <a href="{{ routes.root_url }}">Home</a>\n' +
              '    <a href="{{ routes.all_products_collection_url }}">Shop</a>\n' +
              '    <span aria-current="page">{{ product.title }}</span>\n' +
              '  </nav>\n' +
              '  <div class="lb-product-detail__layout">\n' +
              '  {% if section.settings.showGallery and product.images.size > 0 %}\n' +
              '  <lb-product-gallery class="lb-product-detail__gallery" data-lb-island="product-gallery">\n' +
              '    <div class="lb-product-detail__gallery-main">\n' +
              '      {% for image in product.images %}<img class="lb-product-detail__gallery-image" src="{{ image | image_url }}" alt="{{ product.title }}" data-lb-gallery-image data-index="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %} loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">{% endfor %}\n' +
              '    </div>\n' +
              '    {% if product.images.size > 1 %}\n' +
              '    <div class="lb-product-detail__gallery-thumbs" role="tablist" aria-label="Product images">\n' +
              '      {% for image in product.images %}<button type="button" class="lb-product-detail__gallery-thumb" data-lb-gallery-thumb data-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" aria-label="Image {{ forloop.index }} of {{ product.images.size }}"><img src="{{ image | image_url }}" alt="" aria-hidden="true" loading="lazy" decoding="async"></button>{% endfor %}\n' +
              '    </div>\n' +
              '    {% endif %}\n' +
              '  </lb-product-gallery>\n' +
              '  {% endif %}\n' +
              '  {% if section.settings.showGallery and product.images.size == 0 %}<div class="pf-no-image">Product image not supplied</div>{% endif %}<div class="lb-product-detail__info">\n' +
              '  <h1>{{ product.title }}</h1>\n' +
              '  {% if product.review_count > 0 %}<p class="lb-product-detail__rating" aria-label="Rated {{ product.rating }} out of 5">★ {{ product.rating }} <span class="lb-product-detail__rating-count">({{ product.review_count }})</span></p>{% endif %}\n' +
              '  <div class="lb-product-detail__price">\n' +
              '    <span class="lb-product-detail__price-current">{{ product.price | times: 100 | money_with_currency: product.currency }}</span>\n' +
              '    {% if product.compare_at_price and product.compare_at_price > product.price %}\n' +
              '    <s class="lb-product-detail__price-compare">{{ product.compare_at_price | times: 100 | money_with_currency: product.currency }}</s>\n' +
              '    <span class="lb-product-detail__price-save">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>\n' +
              '    {% endif %}\n' +
              '  </div>\n' +
              '  {% assign pf201_ready = true %}{% if product.options.size > 0 %}{% assign pf201_ready = false %}{% endif %}{% if section.settings.showToyFacts %}<div class="pf-product-quick"><p data-lb-toy-field="age">{% if pf201_ready %}{% if product.toys.ageStatement != blank %}{{ product.toys.ageStatement }}{% elsif product.toys.ageBands.size > 0 %}{% for age in product.toys.ageBands %}{{ age }}{% unless forloop.last %}, {% endunless %}{% endfor %} years{% else %}Age information not supplied.{% endif %}{% else %}Choose an edition for age information.{% endif %}</p><a class="pf-link" href="#playfield-product-facts-{{ section.id }}">Contents, dimensions &amp; materials</a><p class="pf-note" data-lb-toy-status role="status" aria-live="polite">{% if pf201_ready %}Product facts supplied by the merchant.{% else %}Choose all options to see facts for the selected edition.{% endif %}</p></div><aside class="pf-warning" data-lb-toy-warnings aria-label="Merchant supplied warnings"{% if pf201_ready and product.toys.warnings.size > 0 %}{% else %} hidden{% endif %}>{% if pf201_ready and product.toys.warnings.size > 0 %}<h2>Read before choosing</h2>{% for warning in product.toys.warnings %}<p>{{ warning.text }}</p><p class="pf-note">Source: {{ warning.sourceLabel }}{% if warning.editionLabel != blank %} · {{ warning.editionLabel }}{% endif %}</p>{% endfor %}{% endif %}</aside>{% endif %}\n' +
              '  {% if product.options.size > 0 %}<lb-variant-picker data-lb-island="variant-picker" data-product-id="{{ product.id }}" data-variants="{{ product.variants | json }}" class="lb-product-detail__variants">{% for option in product.options %}<div class="lb-product-detail__variant-group"><span class="lb-variant-option__name">{{ option.name }}</span><div class="lb-product-detail__variant-values">{% for value in option.values %}<button type="button" data-lb-variant-option data-variant-name="{{ option.name }}" data-variant-value="{{ value }}" aria-pressed="false">{{ value }}</button>{% endfor %}</div></div>{% endfor %}<p class="lb-product-detail__variant-status" data-lb-variant-status role="status"></p></lb-variant-picker>{% endif %}\n' +
              '  <div class="lb-product-detail__purchase">\n' +
              '    <lb-add-to-cart data-lb-island="add-to-cart" data-product-id="{{ product.id }}" data-product-name="{{ product.title }}" data-product-price="{{ product.price }}" data-product-currency="{{ product.currency }}" data-product-url="{{ product.url }}">\n' +
              '      <label class="lb-sr-only" for="lb-quantity-{{ section.id }}">Quantity</label>\n' +
              '      <input type="number" name="quantity" id="lb-quantity-{{ section.id }}" class="lb-product-detail__quantity" value="1" min="1" inputmode="numeric">\n' +
              '      <button type="button" class="lb-product-detail__cta lb-product-detail__cta--primary" data-lb-add-to-cart{% if product.available == false %} disabled{% endif %}>{% if product.available == false %}Sold out{% else %}Add to cart{% endif %}</button>\n' +
              '      {% if section.settings.showBuyNow %}<button type="button" class="lb-product-detail__cta lb-product-detail__cta--secondary" data-lb-buy-now{% if product.available == false %} disabled{% endif %}>Buy now</button>{% endif %}\n' +
              '      <span data-lb-add-to-cart-status aria-live="polite"></span>\n' +
              '    </lb-add-to-cart>\n' +
              '    <lb-wishlist-toggle data-lb-island="wishlist-toggle" data-product-id="{{ product.id }}" data-store-id="{{ shop.id }}" data-in-wishlist="{% if product.in_wishlist %}true{% endif %}"{% if buyer_wishlist.authenticated %} data-authenticated="true" data-account-type="buyer" data-buyer-id="{{ buyer_wishlist.buyerId }}" data-buyer-linked="{% if buyer_wishlist.linked %}true{% endif %}" data-buyer-unavailable="{% if buyer_wishlist.unavailable or buyer_wishlist.storeAccountUnavailable %}true{% endif %}"{% elsif customer %} data-authenticated="true" data-account-type="store_customer"{% endif %} data-base-path="/store/{{ shop.subdomain }}" aria-label="Add {{ product.title }} to wishlist"></lb-wishlist-toggle>\n' +
              '  </div>\n' +
              '  {% if section.settings.showDescription and product.description %}\n' +
              '  <details class="lb-product-detail__accordion"><summary>Description</summary><div class="lb-product-detail__accordion-body">{{ product.description }}</div></details>\n' +
              '  {% endif %}\n' +
              "  {% if shop.policies contains 'shipping' %}\n" +
              '  <details class="lb-product-detail__accordion"><summary>Shipping</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/shipping">Read our shipping policy</a></div></details>\n' +
              '  {% endif %}\n' +
              "  {% if shop.policies contains 'refund' or shop.policies contains 'returns' %}\n" +
              '  <details class="lb-product-detail__accordion"><summary>Returns</summary><div class="lb-product-detail__accordion-body"><a href="{{ routes.root_url }}/returns">Read our returns policy</a></div></details>\n' +
              '  {% endif %}\n' +
              '  </div>\n' +
              '  </div>\n' +
              '  {% if section.settings.showToyFacts %}<section class="pf-facts" id="playfield-product-facts-{{ section.id }}" aria-label="Product contents and facts"><p class="pf-eyebrow">THE DETAILS, BEFORE YOU BUY</p><div class="pf-facts-layout"><div><h2>What’s in the box?</h2><div data-lb-toy-contents>{% if pf201_ready and product.toys.contents.size > 0 %}<ul class="pf-contents">{% assign pf201_total = 0 %}{% for content in product.toys.contents %}{% assign pf201_total = pf201_total | plus: content.quantity %}<li><strong>{{ content.quantity }}</strong><span>{{ content.label }}</span></li>{% endfor %}</ul><p data-lb-toy-contents-completeness>{% if product.toys.contentsComplete %}{{ pf201_total }} items in total, according to the merchant.{% else %}This is a partial contents list supplied by the merchant.{% endif %}</p>{% elsif pf201_ready %}<p>Contents have not been supplied.</p>{% else %}<p>Choose an edition for its included contents.</p>{% endif %}</div></div><div><h2>Know the object.</h2><dl data-lb-toy-details>{% if pf201_ready %}<div><dt>Dimensions</dt><dd data-lb-toy-field="dimensions">{% if product.toys.dimensions %}{% if product.toys.dimensions.label != blank %}<strong>{{ product.toys.dimensions.label }}</strong><br>{% endif %}{% if product.toys.dimensions.length %}Length {{ product.toys.dimensions.length }} {{ product.toys.dimensions.unit }}{% endif %}{% if product.toys.dimensions.width %}{% if product.toys.dimensions.length %} · {% endif %}Width {{ product.toys.dimensions.width }} {{ product.toys.dimensions.unit }}{% endif %}{% if product.toys.dimensions.height %}{% if product.toys.dimensions.length or product.toys.dimensions.width %} · {% endif %}Height {{ product.toys.dimensions.height }} {{ product.toys.dimensions.unit }}{% endif %}{% else %}Dimensions have not been supplied.{% endif %}</dd></div>{% for measured in product.toys.additionalDimensions %}<div><dt>{{ measured.label }}</dt><dd data-lb-toy-field="additional-dimensions">{% if measured.length %}Length {{ measured.length }} {{ measured.unit }}{% endif %}{% if measured.width %}{% if measured.length %} · {% endif %}Width {{ measured.width }} {{ measured.unit }}{% endif %}{% if measured.height %}{% if measured.length or measured.width %} · {% endif %}Height {{ measured.height }} {{ measured.unit }}{% endif %}</dd></div>{% endfor %}<div><dt>Materials<'... 2632 more characters,
            schema: [Object]
          },
          'product-grid': {
            path: 'sections/product-grid.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap pf-section" data-section-id="{{ section.id }}"><div class="pf-heading"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div><a class="pf-link" href="{{ routes.all_products_collection_url }}">Explore all activities →</a></div>{% assign activity_products = section.products | default: collection.products %}{% if activity_products.size > 0 %}<div class="pf-grid" data-columns="{{ section.settings.columns }}">{% for item in activity_products limit: section.settings.productLimit %}<article class="pf-card"><a href="{{ item.url }}"><div class="pf-card-media">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<div class="pf-no-image">Product image not supplied</div>{% endif %}<span class="pf-card-badge">{% if item.toys_card.ageLabel != blank %}{{ item.toys_card.ageLabel }}{% else %}Age information not supplied{% endif %}</span></div><h3>{{ item.title }}</h3></a><p class="pf-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</p>{% if item.toys_card.contentsLabel != blank %}<p>{{ item.toys_card.contentsLabel }}{% unless item.toys_card.contentsComplete == true %} · Partial contents list{% endunless %}</p>{% else %}<p>Contents not supplied</p>{% endif %}{% if item.available == false %}<p>Unavailable</p>{% endif %}<a class="pf-link" href="{{ item.url }}">{% if item.toys_card.hasOptions %}Choose an edition{% else %}View product{% endif %} →</a></article>{% endfor %}</div>{% else %}<p>No activities to show yet.</p>{% endif %}</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Contents rich activity grid","tag":"section","settings":[{"type":"text","label":"Heading","default":"For curious afternoons.","id":"title"},{"type":"text","label":"Description","default":"","id":"subtitle"},{"type":"range","label":"Desktop columns","default":3,"min":2,"max":4,"step":1,"id":"columns"},{"type":"range","label":"Products to show","default":6,"min":1,"max":24,"step":1,"id":"productLimit"},{"type":"collection","label":"Collection","id":"collectionId"}],"blocks":[],"presets":[{"name":"Contents rich activity grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'rich-content': {
            path: 'sections/rich-content.liquid',
            source: '<div class="pf-theme"><section class="lb-rich-content" data-section-id="{{ section.id }}">\n' +
              '  <h1>{{ section.settings.title }}</h1>\n' +
              '  <div>{{ section.settings.body }}</div>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Rich Content","tag":"section","settings":[{"type":"text","label":"Title","id":"title"},{"type":"richtext","label":"Body","id":"body"}],"blocks":[],"presets":[{"name":"Rich Content","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'services-grid': {
            path: 'sections/services-grid.liquid',
            source: '<div class="pf-theme"><section class="lb-services-grid" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% for block in section.blocks %}<article {{ block.editor_attributes | raw }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p><a href="{{ block.settings.link | store_url }}">Learn more</a></article>{% endfor %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Services Grid","tag":"section","settings":[{"type":"text","label":"Title","default":"Services","id":"title"}],"blocks":[{"type":"service","name":"Service","settings":[{"type":"text","label":"Title","id":"title"},{"type":"textarea","label":"Description","id":"description"},{"type":"url","label":"Link","id":"link"}]}],"presets":[{"name":"Services Grid","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'skills-section': {
            path: 'sections/skills-section.liquid',
            source: '<div class="pf-theme"><section class="lb-skills-section" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% if section.blocks.size > 0 %}<h3>General</h3>{% endif %}\n' +
              '  {% for block in section.blocks %}<span {{ block.editor_attributes | raw }} data-level="{{ block.settings.level }}">{{ block.settings.name }} {{ block.settings.level }}%</span>{% endfor %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Skills Section","tag":"section","settings":[{"type":"text","label":"Title","default":"Skills","id":"title"}],"blocks":[{"type":"skill","name":"Skill","settings":[{"type":"text","label":"Skill","id":"name"},{"type":"range","label":"Level","min":0,"max":100,"step":5,"id":"level"}]}],"presets":[{"name":"Skills Section","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          testimonials: {
            path: 'sections/testimonials.liquid',
            source: '<div class="pf-theme"><section class="lb-testimonials" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  {% if section.blocks.size > 0 %}<div class="lb-testimonials__items">{% for block in section.blocks %}<blockquote {{ block.editor_attributes | raw }}><p>{{ block.settings.quote }}</p><cite>{{ block.settings.author }}</cite></blockquote>{% endfor %}</div>\n' +
              '  {% else %}<p class="lb-testimonials__empty">Add customer reviews to build trust.</p>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Testimonials","tag":"section","settings":[{"type":"text","label":"Title","default":"What customers say","id":"title"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","label":"Quote","id":"quote"},{"type":"text","label":"Author","id":"author"}]}],"presets":[{"name":"Testimonials","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'trust-badges': {
            path: 'sections/trust-badges.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap pf-section" data-section-id="{{ section.id }}"><div class="pf-services">{% if section.settings.contentsText != blank %}<div><h3>Count the possibilities.</h3><p>{{ section.settings.contentsText }}</p></div>{% endif %}{% if section.settings.materialsText != blank %}<div><h3>Know the object.</h3><p>{{ section.settings.materialsText }}</p></div>{% endif %}{% if section.settings.helpText != blank %}<div><h3>Choose with context.</h3><p>{{ section.settings.helpText }}</p></div>{% endif %}</div></section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Choosing information","tag":"section","settings":[{"type":"text","label":"Contents information","default":"","id":"contentsText"},{"type":"text","label":"Materials information","default":"","id":"materialsText"},{"type":"text","label":"Merchant help information","default":"","id":"helpText"}],"blocks":[],"presets":[{"name":"Choosing information","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'newsletter-signup': {
            path: 'sections/newsletter-signup.liquid',
            source: '<div class="pf-theme"><section class="lb-newsletter-signup" data-section-id="{{ section.id }}">\n' +
              '  <h2>{{ section.settings.title }}</h2>\n' +
              '  <p>{{ section.settings.subtitle }}</p>\n' +
              '  <form action="/contact" method="post">\n' +
              '    <input type="email" name="email" aria-label="Email" required>\n' +
              '    <button type="submit">{{ section.settings.buttonLabel }}</button>\n' +
              '  </form>\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Newsletter Signup","tag":"section","settings":[{"type":"text","label":"Heading","default":"Get first access","id":"title"},{"type":"text","label":"Subheading","id":"subtitle"},{"type":"text","label":"Button label","default":"Sign up","id":"buttonLabel"}],"blocks":[],"presets":[{"name":"Newsletter Signup","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          spotlight: {
            path: 'sections/spotlight.liquid',
            source: '<div class="pf-theme"><section class="pf-wrap pf-bento" data-section-id="{{ section.id }}"><a class="pf-bento-main" href="{{ section.settings.link | store_url }}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" fetchpriority="high" decoding="async">{% else %}<div class="pf-no-image">Add your activity photograph</div>{% endif %}<div class="pf-bento-caption"><p class="pf-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div></a><div class="pf-bento-side"><a class="pf-bento-small" href="{{ section.settings.firstLink | store_url }}">{% if section.settings.firstImage != blank %}<img src="{{ section.settings.firstImage | image_url }}" alt="{{ section.settings.firstImageAlt }}" loading="lazy">{% endif %}<div><h3>{{ section.settings.firstTitle }}</h3><span>Explore activities →</span></div></a><a class="pf-bento-small" href="{{ section.settings.secondLink | store_url }}">{% if section.settings.secondImage != blank %}<img src="{{ section.settings.secondImage | image_url }}" alt="{{ section.settings.secondImageAlt }}" loading="lazy">{% endif %}<div><h3>{{ section.settings.secondTitle }}</h3><span>Explore activities →</span></div></a></div></section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Activity bento","tag":"section","settings":[{"type":"text","label":"Main heading","default":"A little pattern. A big possibility.","id":"heading"},{"type":"text","label":"Main eyebrow","default":"MAKE · ARRANGE · START AGAIN","id":"eyebrow"},{"type":"image","label":"Main activity image","id":"image"},{"type":"text","label":"Main image description","default":"","id":"imageAlt"},{"type":"url","label":"Main destination","default":"/products","id":"link"},{"type":"text","label":"First interest heading","default":"Art & making","id":"firstTitle"},{"type":"image","label":"First interest image","id":"firstImage"},{"type":"text","label":"First image description","default":"","id":"firstImageAlt"},{"type":"url","label":"First interest destination","default":"/products","id":"firstLink"},{"type":"text","label":"Second interest heading","default":"Build a little world","id":"secondTitle"},{"type":"image","label":"Second interest image","id":"secondImage"},{"type":"text","label":"Second image description","default":"","id":"secondImageAlt"},{"type":"url","label":"Second interest destination","default":"/products","id":"secondLink"}],"blocks":[],"presets":[{"name":"Activity bento","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          },
          'video-hero': {
            path: 'sections/video-hero.liquid',
            source: '<div class="pf-theme"><section class="lb-video-hero" data-section-id="{{ section.id }}">\n' +
              '  <div class="lb-video-hero__copy">\n' +
              '    <h2 class="lb-video-hero__heading">{{ section.settings.heading }}</h2>\n' +
              '    {% if section.settings.subheading %}<p class="lb-video-hero__subheading">{{ section.settings.subheading }}</p>{% endif %}\n' +
              '  </div>\n' +
              '  {% if section.settings.videoUrl != blank %}<div class="lb-video-hero__embed"><iframe src="{{ section.settings.videoUrl | video_url }}" title="{{ section.settings.heading }}" loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation" allowfullscreen></iframe></div>{% endif %}\n' +
              '</section>\n' +
              '</div>\n' +
              '{% schema %}\n' +
              '{"name":"Video Hero","tag":"section","settings":[{"type":"text","label":"Heading","default":"See the fit in motion","id":"heading"},{"type":"textarea","label":"Subheading","default":"A quick look at how each drop moves, from the box to your feet.","id":"subheading"},{"type":"url","label":"Video embed URL","info":"A YouTube or Vimeo embed URL (for example https://www.youtube.com/embed/VIDEO_ID). Leave blank to hide the video.","id":"videoUrl"}],"blocks":[],"presets":[{"name":"Video Hero","settings":{},"blocks":[]}],"enabled_on":{"templates":["*"]},"disabled_on":{"templates":[]}}\n' +
              '{% endschema %}',
            schema: [Object]
          }
