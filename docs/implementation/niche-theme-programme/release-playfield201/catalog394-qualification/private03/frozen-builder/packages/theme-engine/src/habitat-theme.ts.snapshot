import { LiquidThemePackageBundleSchema, ThemeLiquidSectionSchema, type LiquidThemePackageBundle, type ThemeLiquidSectionFile, type ThemeBundleTemplateSection } from './theme-bundle';
import { fromThemeDocumentV2, toThemeDocumentV2 } from './theme-document';
import { HABITAT_CARD, HABITAT_DISCOVERY_CONTROLS, HABITAT_FILTERS, HABITAT_PAGINATION } from './habitat-discovery';
import { HABITAT_CSS } from './habitat-styles';

export const HABITAT_VERSION = '2.0.0';
type Field = ThemeLiquidSectionFile['schema']['settings'][number];
const text = (id: string, label: string, value = ''): Field => ({ id, type: 'text', label, default: value });
const url = (id: string, label: string, value = ''): Field => ({ id, type: 'url', label, default: value });
const image = (id: string, label: string): Field => ({ id, type: 'image', label });
const toggle = (id: string, label: string, value = true): Field => ({ id, type: 'toggle', label, default: value });
function section(type: string, name: string, settings: Field[], body: string): ThemeLiquidSectionFile {
  const schema = ThemeLiquidSectionSchema.parse({ name, settings, blocks: [], presets: [{ name }] });
  return { path: `sections/${type}.liquid`, source: `${body}\n{% schema %}\n${JSON.stringify(schema)}\n{% endschema %}`, schema };
}
function instance(type: string, settings: ThemeBundleTemplateSection['settings'] = {}): ThemeBundleTemplateSection {
  return { type, settings, blocks: {}, block_order: [], disabled: false };
}

const ROOM_LINKS = `{% assign has_room_selection = false %}{% if section.settings.collection1 != blank or section.settings.collection2 != blank or section.settings.collection3 != blank or section.settings.collection4 != blank %}{% assign has_room_selection = true %}{% endif %}{% if has_room_selection %}{% for slot in (1..4) %}{% assign room_key = 'collection' | append: slot %}{% assign room_id = section.settings[room_key] %}{% if room_id != blank %}{% for room in collections limit: 100 %}{% if room.id == room_id or room.handle == room_id %}<a href="{{ routes.collections_url }}/{{ room.handle }}">{{ room.title }} <span aria-hidden="true">→</span></a>{% endif %}{% endfor %}{% endif %}{% endfor %}{% elsif collections.size > 0 %}{% for room in collections limit: 4 %}<a href="{{ routes.collections_url }}/{{ room.handle }}">{{ room.title }} <span aria-hidden="true">→</span></a>{% endfor %}{% else %}<p class="hab-support">Collections supplied by this store will appear here.</p>{% endif %}`;

const QUICK_FACTS = `<div class="hab-quick-facts" aria-label="Common product dimensions"><p class="hab-support"><strong>Common product dimensions</strong> · check the selected finish below.</p>{% if product.furniture_display.assembled != blank %}<p><strong>{{ product.furniture_display.assembled }}</strong><br><span class="hab-support">Assembled dimensions</span></p>{% elsif product.furniture.assembled != blank %}<p><strong>{% if product.furniture.assembled.diameter %}{{ product.furniture.assembled.diameter }} Ø{% else %}{{ product.furniture.assembled.width | default: '—' }} W × {{ product.furniture.assembled.depth | default: '—' }} D{% endif %}{% if product.furniture.assembled.height %} × {{ product.furniture.assembled.height }} H{% endif %} {{ product.furniture.assembled.unit }}</strong><br><span class="hab-support">Assembled dimensions</span></p>{% else %}<p>Assembled dimensions not supplied.</p>{% endif %}{% if product.furniture_display.seat_height != blank %}<p>Seat height: <span>{{ product.furniture_display.seat_height }}</span></p>{% elsif product.furniture.seat_height != blank %}<p>Seat height: {{ product.furniture.seat_height.value }} {{ product.furniture.seat_height.unit }}</p>{% endif %}<a class="hab-link" href="#habitat-dimensions-{{ section.id }}">Dimensions, material &amp; access ↓</a></div>`;

const DIMENSION_TABLE = `<table><caption>Product facts (common) · selected finish facts are shown above</caption><tbody>{% if product.furniture_display.assembled != blank %}<tr><th scope="row">Assembled dimensions</th><td>{{ product.furniture_display.assembled }}</td></tr>{% elsif product.furniture.assembled != blank %}{% assign dimension_keys = 'width,depth,height,diameter' | split: ',' %}{% for key in dimension_keys %}{% assign supplied = product.furniture.assembled[key] %}{% if supplied != nil %}<tr><th scope="row">Assembled {{ key }}</th><td>{{ supplied }} {{ product.furniture.assembled.unit }}</td></tr>{% endif %}{% endfor %}{% else %}<tr><th scope="row">Assembled size</th><td>Not supplied</td></tr>{% endif %}{% if product.furniture_display.seat_height != blank %}<tr><th scope="row">Seat height</th><td>{{ product.furniture_display.seat_height }}</td></tr>{% elsif product.furniture.seat_height != blank %}<tr><th scope="row">Seat height</th><td>{{ product.furniture.seat_height.value }} {{ product.furniture.seat_height.unit }}</td></tr>{% endif %}{% if product.furniture_display.package != blank %}<tr><th scope="row">Package W × D × H</th><td>{{ product.furniture_display.package }}</td></tr>{% elsif product.furniture.package != blank %}<tr><th scope="row">Package W × D × H</th><td>{{ product.furniture.package.width | default: '—' }} × {{ product.furniture.package.depth | default: '—' }} × {{ product.furniture.package.height | default: '—' }} {{ product.furniture.package.unit }}</td></tr>{% endif %}{% if product.furniture_display.weight != blank %}<tr><th scope="row">Product weight</th><td>{{ product.furniture_display.weight }}</td></tr>{% elsif product.furniture.weight != blank %}<tr><th scope="row">Product weight</th><td>{{ product.furniture.weight.value }} {{ product.furniture.weight.unit }}</td></tr>{% endif %}</tbody></table>`;

const FURNITURE_FIELDS = [
  ['assembled', 'Assembled', 'Assembled dimensions not supplied.'],
  ['package', 'Package', 'Package dimensions not supplied.'],
  ['weight', 'Weight', 'Weight not supplied.'],
  ['seat_height', 'Seat height', 'Seat height not supplied.'],
  ['materials', 'Materials', 'Material information not supplied.'],
  ['assembly', 'Assembly', 'Assembly information not supplied.'],
  ['care', 'Care', 'Care information not supplied.'],
] as const;
const NAMED_FURNITURE_FIELDS = FURNITURE_FIELDS.map(([key, label, missing]) => `<div><dt>${label}</dt><dd>{{ display.${key} | default: '${missing}' }}</dd></div>`).join('');
const CURRENT_FURNITURE_FACTS = `<section class="hab-current-facts" data-lb-variant-facts data-lb-facts-namespace="furniture" data-product-id="{{ product.id }}" data-lb-variant-facts-state="common" aria-labelledby="habitat-current-facts-{{ section.id }}"><p class="hab-current-facts__status" id="habitat-current-facts-{{ section.id }}" data-lb-variant-facts-status role="status" aria-live="polite">Common product facts{% if product.options.size > 0 %} · select all finish options{% endif %}</p><dl>${FURNITURE_FIELDS.map(([key, label, missing]) => `<div><dt>${label}</dt><dd data-lb-furniture-field="${key}" data-lb-facts-missing="${missing}">{{ product.furniture_display.${key} | default: '${missing}' }}</dd></div>`).join('')}</dl><p class="hab-support">Only supplied measurements are listed. An absent width, depth, height or diameter is not supplied. Assembled and package measurements describe different things.</p><a class="hab-link" href="#habitat-dimensions-{{ section.id }}">Common reference, named finishes &amp; access guidance ↓</a></section>`;

const FURNITURE_FACTS = `<section class="hab-facts" id="habitat-dimensions-{{ section.id }}" aria-label="Furniture measurements and materials"><span class="hab-eyebrow">Make space for it</span><h2>{{ section.settings.factsHeading }}</h2><p>Measure the room it will live in, then the access path it will take to get there.</p><p class="hab-support">Product facts below are common reference information. A selected finish may override them; use its current facts above.</p><div class="hab-facts-layout"><div>{% if section.settings.showDimensionDiagram and product.furniture.assembled != blank %}<div class="hab-dimension-box" aria-label="Common product footprint schematic"><p>{% if product.furniture.assembled.diameter %}Diameter: {{ product.furniture.assembled.diameter }} {{ product.furniture.assembled.unit }}{% elsif product.furniture.assembled.width %}Width: {{ product.furniture.assembled.width }} {{ product.furniture.assembled.unit }}{% endif %}</p><div class="hab-footprint{% if product.furniture.assembled.diameter %} hab-footprint-round{% endif %}"><span>Footprint</span></div>{% if product.furniture.assembled.depth %}<p>Depth: {{ product.furniture.assembled.depth }} {{ product.furniture.assembled.unit }}</p>{% endif %}</div><p class="hab-support">Common product footprint only. Schematic, not to scale. Check the current finish measurements; no access or fit is guaranteed.</p>{% endif %}${DIMENSION_TABLE}<p class="hab-note">Package size is not assembled size. Compare supplied package dimensions with doors, stairs, turns and lifts.</p></div><div><h3>Product material &amp; assembly (common)</h3>{% if product.furniture.materials.size > 0 %}<p>{% for material in product.furniture.materials %}{{ material }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>{% else %}<p>Material information not supplied.</p>{% endif %}{% if product.furniture.assembly.status == 'assembled' %}<p>Arrives assembled.</p>{% elsif product.furniture.assembly.status == 'required' %}<p>Assembly required.</p>{% else %}<p>Assembly information not supplied.</p>{% endif %}{% if product.furniture.assembly.instructions != blank %}<p>{{ product.furniture.assembly.instructions }}</p>{% endif %}{% if product.furniture.assembly.tools != blank %}<p>Tools: {{ product.furniture.assembly.tools }}</p>{% endif %}{% if product.furniture.care != blank %}<details open><summary>Product care (common)</summary><p>{{ product.furniture.care }}</p></details>{% endif %}<details open><summary>Delivery &amp; access</summary><p>Delivery options and charges are confirmed by checkout for your address. A delivery date is not available unless a service result supplies one.</p>{% if shop.policies contains 'shipping' %}<a class="hab-link" href="{{ routes.root_url }}/shipping">Read the merchant’s shipping policy</a>{% endif %}</details></div></div>{% if product.variants.size > 0 %}<h3>Facts by named finish</h3><p class="hab-support">Compare supplied facts for each actual option. Each list includes resolved product facts unless that finish overrides them. Choose every option above to see the current finish.</p><div class="hab-finish-facts" data-lb-variant-facts-fallback data-product-id="{{ product.id }}">{% for variant in product.variants limit: 100 %}{% assign facts = variant.furniture %}{% assign display = variant.furniture_display %}<div data-lb-variant-facts-row data-variant-id="{{ variant.id }}"><h4>{{ facts.finish | default: variant.title | default: variant.name }}</h4><dl>${NAMED_FURNITURE_FIELDS}</dl></div>{% endfor %}</div>{% endif %}</section>`;

/** Pure, versioned canonical Liquid artifact. Demo products/media are applied only by the preview fixture. */
export function createHabitatTheme(base: LiquidThemePackageBundle): LiquidThemePackageBundle {
  const bundle = structuredClone(base);
  bundle.package = { ...bundle.package, slug: 'letbuyy-craft', name: 'Habitat', version: HABITAT_VERSION, version_number: 2, description: 'Room-led furniture browsing with supplied dimensions, named finishes, material and assembly details.' };
  Object.assign(bundle.config.settings_data.current, { primaryColor: '#4E573E', secondaryColor: '#625C50', accentColor: '#7B7261', backgroundColor: '#F7F3EB', textColor: '#302C25', surfaceColor: '#E9E2D5', headingFontFamily: 'Libre Baskerville', bodyFontFamily: 'Source Sans Pro', borderRadius: 6 });
  delete bundle.config.settings_data.current.fontFamily;

  bundle.sections['hero-banner'] = section('hero-banner', 'Room index and panorama', [text('eyebrow', 'Eyebrow', 'The considered home'), text('heading', 'Heading', 'A little room. A lot of living.'), text('subheading', 'Description', 'Find furniture for your space, with the dimensions and details to make it yours.'), text('roomIndexLabel', 'Room index label', 'Start with a room'), ...[1, 2, 3, 4].map(slot => ({ id: `collection${slot}`, type: 'collection' as const, label: `Room collection ${slot}` })), image('image', 'Room panorama'), text('imageAlt', 'Room photograph description'), text('caption', 'Panorama caption'), text('ctaText', 'Primary link', 'Explore furniture'), url('ctaLink', 'Primary destination', '/products'), text('guideText', 'Guide link'), url('guideLink', 'Guide destination'), { id: 'imageFocus', type: 'select', label: 'Panorama focal position', default: 'center', options: ['center', 'top', 'bottom'] }], `<section class="hab-theme{% if section.settings.image == blank %} hab-hero-empty{% endif %}" data-section-id="{{ section.id }}"><div class="hab-wrap"><div class="hab-hero-heading"><div><span class="hab-eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1></div><p>{{ section.settings.subheading }}</p></div><div class="hab-room-story"><nav class="hab-room-index" aria-label="Room collections"><span class="hab-eyebrow">{{ section.settings.roomIndexLabel }}</span>${ROOM_LINKS}</nav>{% if section.settings.image != blank %}<div class="hab-room-media hab-focus-{{ section.settings.imageFocus }}"><img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" fetchpriority="high" decoding="async"><div class="hab-room-caption">{% if section.settings.caption != blank %}<span>{{ section.settings.caption }}</span>{% endif %}{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="hab-link" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }} →</a>{% endif %}</div></div>{% endif %}</div><div class="hab-guide-strip"><p>Start with the space you have.<br><span class="hab-support">Room dimensions, doorways and access matter.</span></p>{% if section.settings.guideText != blank and section.settings.guideLink != blank %}<a class="hab-link" href="{{ section.settings.guideLink | store_url }}">{{ section.settings.guideText }}</a>{% endif %}{% if section.settings.image == blank and section.settings.ctaLink != blank %}<a class="hab-link" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }}</a>{% endif %}</div></div></section>`);

  const productFields: Field[] = [text('title', 'Heading', 'Objects with a purpose'), text('subtitle', 'Description'), { id: 'collectionId', type: 'collection', label: 'Collection' }, { id: 'productLimit', type: 'range', label: 'Products to show', min: 1, max: 24, step: 1, default: 4 }];
  bundle.sections['product-grid'] = section('product-grid', 'Furniture object grid', productFields, `<section class="hab-theme" data-section-id="{{ section.id }}"><div class="hab-wrap hab-section">{% if section.settings.title != blank or section.settings.subtitle != blank %}<div class="hab-heading"><div>{% if section.settings.title != blank %}<h2>{{ section.settings.title }}</h2>{% endif %}{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div></div>{% endif %}{% assign furniture_products = section.products | default: collection.products %}{% if furniture_products.size > 0 %}<div class="hab-grid">{% for item in furniture_products limit: section.settings.productLimit %}${HABITAT_CARD}{% endfor %}</div>${HABITAT_PAGINATION}{% else %}<p>No pieces found. Try a broader collection or clear the filters.</p><a class="hab-link" href="{{ routes.all_products_collection_url }}">Explore all furniture</a>{% endif %}</div></section>`);
  bundle.sections['collection-filter'] = section('collection-filter', 'Room and furniture discovery', [text('eyebrow', 'Eyebrow', 'A space to slow down'), text('title', 'Fallback heading', 'Furniture'), toggle('showDimensionFilters', 'Show supported dimension and material filters')], HABITAT_FILTERS);
  bundle.sections['featured-products'] = section('featured-products', 'Independent related furniture', [text('title', 'Heading', 'In the same room'), text('subtitle', 'Description', 'Each piece is sold separately.'), toggle('requireSelection', 'Only show selected related products'), ...[1, 2, 3].map(slot => ({ id: `product${slot}`, type: 'product' as const, label: `Independent product ${slot}` })), { id: 'productLimit', type: 'range', label: 'Products to show', min: 1, max: 8, step: 1, default: 2 }], `<section class="hab-theme" data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<div class="hab-wrap hab-section"><div class="hab-heading"><div><span class="hab-eyebrow">In the same room</span><h2>{{ section.settings.title }}</h2><p>{{ section.settings.subtitle }}</p></div></div><div class="hab-grid">{% for item in section.products limit: section.settings.productLimit %}${HABITAT_CARD}{% endfor %}</div></div>{% endif %}</section>`);
  bundle.sections['about-section'] = section('about-section', 'Materials and care editorial', [text('eyebrow', 'Eyebrow', 'Know the material'), text('title', 'Heading', 'The details make the difference.'), { id: 'content', type: 'textarea', label: 'Merchant-supplied material story' }, image('image', 'Material photograph'), text('imageAlt', 'Photograph description'), text('linkLabel', 'Link label'), url('linkUrl', 'Link destination')], `<section class="hab-theme" data-section-id="{{ section.id }}">{% if section.settings.content != blank or section.settings.image != blank %}<div class="hab-wrap hab-section hab-material{% if section.settings.image == blank %} hab-material-empty{% endif %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy" decoding="async">{% endif %}<div><span class="hab-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.title }}</h2><p>{{ section.settings.content }}</p>{% if section.settings.linkLabel != blank and section.settings.linkUrl != blank %}<a class="hab-link" href="{{ section.settings.linkUrl | store_url }}">{{ section.settings.linkLabel }}</a>{% endif %}</div></div>{% endif %}</section>`);
  bundle.sections['habitat-measurement-guide'] = section('habitat-measurement-guide', 'Measurement guide', [text('eyebrow', 'Eyebrow', 'Before you bring it home'), text('title', 'Heading', 'Measure twice. Make room once.'), text('description', 'Description', 'Check the furniture footprint and the route it will take to reach your room.'), text('step1Title', 'First step', 'Map your room'), text('step1Text', 'First guidance', 'Mark the supplied width and depth. Keep your own circulation space.'), text('step2Title', 'Second step', 'Follow the access path'), text('step2Text', 'Second guidance', 'Measure doors, stair turns and lifts against package dimensions.'), text('step3Title', 'Third step', 'Check delivery conditions'), text('step3Text', 'Third guidance', 'Read the merchant’s actual service terms before checkout.')], `<section class="hab-theme" data-section-id="{{ section.id }}"><div class="hab-wrap hab-section"><div class="hab-education"><div><span class="hab-eyebrow">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.title }}</h2><p>{{ section.settings.description }}</p></div><ol class="hab-steps">{% for step in (1..3) %}{% assign title_key = 'step' | append: step | append: 'Title' %}{% assign text_key = 'step' | append: step | append: 'Text' %}{% if section.settings[title_key] != blank %}<li><span aria-hidden="true">0{{ step }}</span><div><h3>{{ section.settings[title_key] }}</h3><p>{{ section.settings[text_key] }}</p></div></li>{% endif %}{% endfor %}</ol></div></div></section>`);
  bundle.sections['trust-badges'] = section('trust-badges', 'Supplied service information', [text('dimensionsText', 'Measurement information'), text('assemblyText', 'Assembly information'), text('deliveryText', 'Actual delivery information')], `<section class="hab-theme" data-section-id="{{ section.id }}"><div class="hab-wrap hab-services">{% if section.settings.dimensionsText != blank %}<div><h3>Dimensions, in the open</h3><p>{{ section.settings.dimensionsText }}</p></div>{% endif %}{% if section.settings.assemblyText != blank %}<div><h3>Assembly, explained</h3><p>{{ section.settings.assemblyText }}</p></div>{% endif %}{% if section.settings.deliveryText != blank %}<div><h3>Delivery, with context</h3><p>{{ section.settings.deliveryText }}</p></div>{% endif %}</div></section>`);

  const product = bundle.sections['product-detail'];
  product.schema.settings.push(toggle('showBuyNow', 'Show buy now', false), toggle('showFurnitureFacts', 'Show furniture facts'), toggle('showDimensionDiagram', 'Show supplied footprint schematic'), toggle('showRoomContext', 'Use the selected product image position as room context', false), text('factsHeading', 'Facts heading', 'Know every dimension.'), { id: 'contextMediaIndex', type: 'range', label: 'Room context image position (if supplied)', min: 1, max: 20, step: 1, default: 2 });
  product.source = product.source.replace('  <div class="lb-product-detail__layout">', `  {% assign context_index = section.settings.contextMediaIndex | minus: 1 %}{% assign context_image = product.images[context_index] %}{% if section.settings.showRoomContext and context_image != blank %}<figure class="hab-pdp-room"><img src="{{ context_image | image_url }}" alt="{{ product.title }} · supplied room context" decoding="async"><figcaption>Room context. Other objects are sold separately unless listed in this product’s contents.</figcaption></figure>{% endif %}\n  <div class="lb-product-detail__layout">`);
  product.source = product.source.replace('  {% if product.options.size > 0 %}<lb-variant-picker', `  {% if section.settings.showFurnitureFacts %}${QUICK_FACTS}{% endif %}\n  {% if product.options.size > 0 %}<lb-variant-picker`);
  product.source = product.source.replace('  <div class="lb-product-detail__purchase">', `  {% if section.settings.showFurnitureFacts %}${CURRENT_FURNITURE_FACTS}{% endif %}\n  <div class="lb-product-detail__purchase">`);
  product.source = product.source.replace(/(<button[^>]*data-lb-buy-now[\s\S]*?<\/button>)/, '{% if section.settings.showBuyNow %}$1{% endif %}');
  product.source = product.source.replace('  {% if section.settings.showReviews and product.reviews.size > 0 %}', `  {% if section.settings.showFurnitureFacts %}${FURNITURE_FACTS}{% endif %}\n  {% if section.settings.showReviews and product.reviews.size > 0 %}`);

  bundle.templates.index = { name: 'Habitat rooms and furniture', layout: 'theme', sections: { 'habitat-room-story': instance('hero-banner'), 'habitat-living-objects': instance('product-grid', { title: 'A place to pause.', productLimit: 4 }), 'habitat-material-story': instance('about-section'), 'habitat-measurement-guide': instance('habitat-measurement-guide'), 'habitat-service-information': instance('trust-badges') }, order: ['habitat-room-story', 'habitat-living-objects', 'habitat-material-story', 'habitat-measurement-guide', 'habitat-service-information'] };
  bundle.templates.collection = { name: 'Habitat furniture collection', layout: 'theme', sections: { 'habitat-discovery': instance('collection-filter'), 'habitat-collection-objects': instance('product-grid', { title: '', productLimit: 24 }) }, order: ['habitat-discovery', 'habitat-collection-objects'] };
  bundle.templates.product = { name: 'Habitat spatial product', layout: 'theme', sections: { 'habitat-product-selection': instance('product-detail', { showGallery: true, showDescription: true, showReviews: true, showBuyNow: false, showFurnitureFacts: true, showDimensionDiagram: true, showRoomContext: false, factsHeading: 'Know every dimension.', contextMediaIndex: 2 }), 'habitat-related-objects': instance('featured-products', { title: 'A place for the small things.', requireSelection: true, productLimit: 2 }) }, order: ['habitat-product-selection', 'habitat-related-objects'] };
  // Search keeps canonical query/pagination behavior while gaining honest dimension-bearing cards.
  if (bundle.sections['collection-product-list']) bundle.sections['collection-product-list'] = section('collection-product-list', 'Furniture search results', [text('title', 'Fallback heading', 'Furniture'), toggle('showDimensionFilters', 'Show supported dimension and material filters')], `<section class="hab-theme" data-section-id="{{ section.id }}"><div class="hab-wrap hab-section"><h1>{{ collection.title | default: section.settings.title }}</h1>${HABITAT_DISCOVERY_CONTROLS}{% if collection.products.size > 0 %}<div class="hab-grid">{% for item in collection.products %}${HABITAT_CARD}{% endfor %}</div>${HABITAT_PAGINATION}{% else %}<p>No pieces found.</p><a class="hab-link" href="{{ routes.all_products_collection_url }}">Explore all furniture</a>{% endif %}</div></section>`);
  for (const chrome of Object.values(bundle.templates.header.sections)) if (chrome.type === 'announcement-bar') chrome.settings = { text: 'Furniture for the way you live. Start with your room.', linkLabel: '', linkHref: '' };
  // Retained/addable Core inline blocks keep their own semantic root; preview metadata
  // comes from the renderer and is absent from the public drop.
  for (const file of Object.values(bundle.sections)) {
    file.source = file.source.replace(/(\{%\s*for\s+block\s+in\s+section\.blocks\s*%\}\s*<[a-z][a-z0-9-]*)(?=[\s>])(?!\s*\{\{\s*block\.editor_attributes\b)/gi, '$1 {{ block.editor_attributes | raw }}');
    if (!file.source.includes('class="hab-theme')) file.source = `<div class="hab-theme">${file.source.replace('{% schema %}', '</div>\n{% schema %}')}`;
    file.source = file.source.replace(/\{% schema %\}[\s\S]*?\{% endschema %\}/, `{% schema %}\n${JSON.stringify(file.schema)}\n{% endschema %}`);
  }
  for (const file of Object.values(bundle.blocks)) {
    // Core's old badge emitted its editor identity publicly. Use only the
    // renderer-generated conditional fragment on the same existing root.
    file.source = file.source.replace(/\sdata-block-id="\{\{\s*block\.id\s*\}\}"/g, '');
    if (!file.source.includes('block.editor_attributes')) file.source = file.source.replace(/^(\s*<[a-z][a-z0-9-]*)(?=[\s>])/i, '$1 {{ block.editor_attributes | raw }}');
  }
  bundle.layout.theme.source = bundle.layout.theme.source.replace('{{ content_for_header | raw }}', `{{ content_for_header | raw }}\n<style data-habitat="2">${HABITAT_CSS}</style>`);
  return LiquidThemePackageBundleSchema.parse(fromThemeDocumentV2(toThemeDocumentV2(bundle)));
}
