/** Circuit's scoped Liquid presentation; semantic values remain merchant theme data. */
export const CIRCUIT_CSS = `
.ct-theme{color:var(--foreground,#142236);background:var(--background,#f5f7fa);font:1rem/1.5 var(--font-main,Inter,Arial,sans-serif);--ct-muted:var(--text-secondary,#4c5b70);--ct-line:var(--border-color,#67768b);--ct-surface:var(--surface,#fff)}
.ct-theme *{box-sizing:border-box}.ct-theme img{max-width:100%;height:auto}.ct-theme :where(h1,h2,h3){font-family:var(--font-heading,Inter,Arial,sans-serif);line-height:1.18;letter-spacing:-.035em;overflow-wrap:anywhere}.ct-theme h1{font-size:clamp(2rem,3.3vw,3rem)}.ct-theme h2{font-size:clamp(1.5rem,2.4vw,2.1rem)}.ct-theme p{color:var(--ct-muted)}.ct-theme a{color:var(--primary,#17476e)}.ct-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--primary,#17476e);outline-offset:4px}.ct-wrap{width:min(1328px,calc(100% - 80px));margin-inline:auto}.ct-section{padding-block:40px}.ct-eyebrow{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em}.ct-button{display:inline-flex;justify-content:center;align-items:center;gap:10px;min-height:48px;padding:12px 20px;border:1px solid var(--primary,#17476e);border-radius:var(--radius,4px);background:var(--primary,#17476e);color:var(--primary-foreground,#fff)!important;font-weight:600;text-decoration:none}.ct-link{display:inline-flex;align-items:center;min-height:44px;text-underline-offset:4px}.ct-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:24px}.ct-heading h2{margin:0}.ct-theme button:disabled{cursor:not-allowed;opacity:.65}.ct-search{display:flex;gap:10px;max-width:760px;margin-block:24px}.ct-search input{flex:1;min-width:0;min-height:48px;padding:12px;border:1px solid var(--ct-line);background:var(--ct-surface);color:var(--foreground)}
.ct-theme .lb-header{background:var(--foreground,#142236);color:var(--background,#f5f7fa);padding-block:14px}.ct-theme .lb-header__inner{max-width:1328px;width:calc(100% - 80px);margin:auto;gap:24px}.ct-theme .lb-header a,.ct-theme .lb-header button,.ct-theme .lb-header summary{color:inherit}.ct-theme .lb-header button{background:transparent}.ct-theme .lb-header__brand{font-weight:800;font-size:1.75rem;letter-spacing:-.06em}.ct-header-search{display:flex;flex:1;min-width:0;max-width:620px;gap:8px}.ct-header-search input{flex:1;min-width:0;min-height:44px;padding:10px 12px;color:var(--foreground);background:var(--background);border:1px solid var(--ct-line);border-radius:var(--radius,4px)}.ct-header-search button{min-height:44px;padding:8px 14px;border:1px solid currentColor;border-radius:var(--radius,4px)}.ct-theme .lb-header__nav-links{gap:22px}.ct-theme .lb-announcement-bar{background:var(--surface,#e7edf5);color:var(--foreground);text-align:center;font-size:.75rem}.ct-theme .lb-header__search-overlay{color:var(--foreground)}.ct-theme .lb-footer{background:var(--foreground,#142236);--footer-bg:var(--foreground,#142236);--footer-text:var(--background,#f5f7fa);--footer-text-muted:var(--background,#f5f7fa);color:var(--background,#f5f7fa);padding-inline:max(24px,calc((100vw - 1328px)/2))}.ct-theme .lb-footer :where(a,p,h2,h3){color:inherit}
.ct-tasks{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ct-task{padding:24px;border:1px solid var(--ct-line);background:var(--ct-surface);text-decoration:none;min-width:0}.ct-task h3{font-size:1.1rem;margin:0 0 10px}.ct-task p{font-size:.875rem;margin:0}.ct-feature{display:grid;grid-template-columns:1fr 1fr;background:var(--surface,#e7edf5);border:1px solid var(--ct-line)}.ct-feature-copy{padding:40px;align-self:center;min-width:0}.ct-feature-copy h2{font-size:clamp(2rem,3.3vw,3rem);margin-block:14px 20px}.ct-feature-media{min-width:0;display:grid;place-items:center}.ct-feature-media img{width:100%;height:390px;object-fit:contain}.ct-feature-empty{grid-template-columns:1fr}.ct-feature-empty .ct-feature-copy{max-width:800px}.ct-empty{padding:28px;border:1px solid var(--ct-line);background:var(--ct-surface)}
.ct-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ct-grid[data-columns="2"]{grid-template-columns:repeat(2,minmax(0,1fr))}.ct-grid[data-columns="3"]{grid-template-columns:repeat(3,minmax(0,1fr))}.ct-card{border:1px solid var(--ct-line);background:var(--ct-surface);min-width:0}.ct-card-media{aspect-ratio:1;display:grid;place-items:center;background:var(--surface,#e7edf5)}.ct-card-media img{width:100%;height:100%;object-fit:contain}.ct-card-placeholder{padding:24px;text-align:center;font-size:.875rem}.ct-card-body{padding:18px;min-width:0}.ct-card h3{font-size:1.0625rem;line-height:1.4;margin:8px 0 14px}.ct-card h3 a{color:inherit;text-decoration:none}.ct-card-model{font-size:.75rem;overflow-wrap:anywhere}.ct-card-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;border-block:1px solid var(--ct-line);padding-block:12px;font-size:.875rem}.ct-card-facts>div{min-width:0;overflow-wrap:anywhere}.ct-card-facts dt{font-size:.75rem;color:var(--ct-muted);margin-bottom:5px}.ct-card-facts dd{margin:0}.ct-card-price{overflow-wrap:anywhere;font-variant-numeric:tabular-nums;font-size:1.125rem;font-weight:700}.ct-card-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px}.ct-card-status{font-size:.75rem}.ct-catalog-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:28px}.ct-catalog-layout.ct-no-facets{grid-template-columns:1fr}.ct-facets{padding:22px;border:1px solid var(--ct-line);background:var(--ct-surface);align-self:start}.ct-facets h2{font-size:1.125rem}.ct-facets fieldset{border:0;border-top:1px solid var(--ct-line);margin:22px 0;padding:18px 0 0}.ct-facets legend{font-size:.875rem;font-weight:600}.ct-facets label{display:flex;align-items:start;gap:8px;font-size:.875rem;margin:14px 0}.ct-facets input{width:18px;height:18px;flex-shrink:0;accent-color:var(--primary)}.ct-facets label span{margin-left:auto}.ct-pagination{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:24px}.ct-sort{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:flex-end;margin-bottom:20px}.ct-sort select{min-height:44px;max-width:100%;padding:8px;border:1px solid var(--ct-line);background:var(--ct-surface);color:var(--foreground)}.ct-mobile-facets{display:none}
.ct-education{display:grid;grid-template-columns:1fr 1.3fr;gap:32px;padding:36px;background:var(--surface,#e7edf5);border:1px solid var(--ct-line)}.ct-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.ct-step{border:1px solid var(--ct-line);padding:20px;min-width:0}.ct-step h3{font-size:1rem}.ct-step p{font-size:.875rem}.ct-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.ct-services article{border-top:2px solid var(--ct-line);padding-top:20px}.ct-services h3{font-size:1.1rem}.ct-services p{font-size:.875rem}
.ct-theme .lb-product-detail{width:min(1328px,calc(100% - 80px));margin:auto;padding-block:28px 48px}.ct-theme .lb-product-detail__layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:48px}.ct-theme .lb-product-detail__info{min-width:0}.ct-theme .lb-product-detail__gallery-image{width:100%;aspect-ratio:1;object-fit:contain;background:var(--surface,#e7edf5)}.ct-theme .lb-product-detail__gallery-thumb img{object-fit:contain}.ct-theme .lb-product-detail__info>h1{font-size:clamp(1.8rem,2.6vw,2.3rem)}.ct-theme .lb-product-detail__price-current{font-size:1.6rem;font-weight:700;font-variant-numeric:tabular-nums}.ct-theme .lb-product-detail__variant-values button{min-height:44px;border:1px solid var(--ct-line);border-radius:var(--radius,4px)}.ct-theme .lb-product-detail__variant-values button[aria-pressed=true]{background:var(--primary);color:var(--primary-foreground,#fff)}.ct-theme .lb-product-detail__variant-values button:disabled{text-decoration:line-through}.ct-theme .lb-product-detail__cta{min-height:48px;border-radius:var(--radius,4px)}.ct-theme .lb-product-detail__cta--primary{background:var(--primary);color:var(--primary-foreground,#fff)}.ct-compatibility{padding:18px;border:1px solid var(--ct-line);border-left:3px solid var(--primary);background:var(--surface);margin-block:20px}.ct-compatibility h2{font-size:1rem;margin:0 0 8px}.ct-compatibility p{margin:0;font-size:.875rem}.ct-specs{margin-top:36px;padding-top:28px;border-top:1px solid var(--ct-line)}.ct-specs table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:.875rem;margin-bottom:24px}.ct-specs caption{text-align:left;font-weight:700;padding:16px;border:1px solid var(--ct-line);border-bottom:0;background:var(--surface)}.ct-specs th,.ct-specs td{border:1px solid var(--ct-line);padding:14px 18px;text-align:left;vertical-align:top;overflow-wrap:anywhere}.ct-specs th{width:36%;font-weight:500;background:var(--surface)}.ct-specs td{font-weight:600}.ct-specs h3{font-size:1.125rem}.ct-specs ul{padding-left:22px}.ct-specs li{margin-bottom:12px}.ct-fact-columns{display:grid;grid-template-columns:1fr 1fr;gap:28px}.ct-fact-note{font-size:.875rem}.ct-theme :where(.lb-cart,.lb-customer-account,.lb-customer-orders,.lb-customer-order-detail,.lb-customer-addresses){max-width:1328px;margin-inline:auto}.ct-theme :where(.lb-cart__checkout,.lb-cart-drawer__checkout){background:var(--primary);color:var(--primary-foreground,#fff)}
@media(max-width:1100px){.ct-wrap,.ct-theme .lb-product-detail{width:calc(100% - 48px)}.ct-theme .lb-header__inner{width:calc(100% - 48px);gap:16px}.ct-feature-copy{padding:28px}.ct-theme .lb-product-detail__layout{gap:28px}.ct-education{grid-template-columns:1fr}.ct-header-search{max-width:420px}.ct-catalog-layout{grid-template-columns:190px minmax(0,1fr);gap:20px}}
@media(max-width:900px){.ct-theme .lb-header__nav{color:var(--foreground);background:var(--background)}.ct-grid,.ct-grid[data-columns="3"],.ct-grid[data-columns="4"]{grid-template-columns:repeat(2,minmax(0,1fr))}.ct-catalog-layout{grid-template-columns:1fr}.ct-desktop-facets{display:none}.ct-mobile-facets{display:block;margin-bottom:20px}.ct-mobile-facets summary{min-height:48px;padding:12px;border:1px solid var(--ct-line);cursor:pointer}.ct-tasks{grid-template-columns:repeat(2,minmax(0,1fr))}.ct-theme .lb-header__inner{flex-wrap:wrap}.ct-header-search{order:3;flex-basis:100%;max-width:none}.ct-services{gap:20px}}
@media(max-width:640px){.ct-wrap,.ct-theme .lb-product-detail{width:calc(100% - 32px)}.ct-section{padding-block:28px}.ct-theme .lb-header__inner{width:calc(100% - 32px)}.ct-theme .lb-header button{background:transparent}.ct-theme .lb-header__brand{font-size:1.5rem}.ct-header-search button{padding-inline:12px}.ct-heading{display:block}.ct-task{padding:18px 14px}.ct-task h3{font-size:1rem;overflow-wrap:anywhere}.ct-task p{font-size:.75rem}.ct-feature{grid-template-columns:1fr}.ct-feature-copy{padding:26px 22px}.ct-feature-media img{height:300px}.ct-grid,.ct-grid[data-columns]{gap:12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,9rem),1fr))}.ct-card-body{padding:14px 12px}.ct-card h3{font-size:1rem}.ct-card-facts{font-size:.8125rem;gap:8px}.ct-collection-grid{grid-template-columns:1fr!important}.ct-collection-grid .ct-card{display:grid;grid-template-columns:112px minmax(0,1fr)}.ct-collection-grid .ct-card-media img{height:150px}.ct-card-bottom{flex-wrap:wrap}.ct-card-model{font-size:.6875rem}.ct-education{padding:24px 20px;gap:24px}.ct-steps,.ct-services{grid-template-columns:1fr}.ct-step{padding:18px}.ct-theme .lb-product-detail__layout{grid-template-columns:1fr;gap:28px}.ct-theme .lb-product-detail__info>h1{font-size:1.9rem}.ct-specs th,.ct-specs td{padding:12px;font-size:.8125rem}.ct-specs th{width:42%}.ct-fact-columns{grid-template-columns:1fr;gap:20px}.ct-search{flex-wrap:wrap}.ct-search input{flex-basis:70%}.ct-sort{justify-content:flex-start}.ct-theme .lb-footer{padding-inline:20px}}
@media(max-width:47.999em){.ct-theme .lb-mobile-nav:not([data-open="true"]) .lb-header__nav{visibility:hidden;box-shadow:none}.ct-theme .lb-mobile-nav[data-open="true"] .lb-header__nav{visibility:visible}}
@media(max-width:359px){.ct-collection-grid .ct-card{grid-template-columns:92px minmax(0,1fr)}.ct-card-facts{grid-template-columns:1fr}.ct-header-search input{font-size:.875rem}.ct-specs th,.ct-specs td{padding:10px 8px}}
@media(prefers-reduced-motion:reduce){.ct-theme *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
`;
