/** Query fields and independent clear URLs come from the validated server projection. */
const keep = (edited: string[], giftControls = false, sortControl = false) => `{% for field in collection.discovery_query_fields %}{% unless field.key == 'page'${edited.map(key => ` or field.key == '${key}'`).join('')} %}${giftControls ? `{% if field.key == 'occasion' and kr_occasion_editable %}{% continue %}{% endif %}{% if field.key == 'recipient' and kr_recipient_editable %}{% continue %}{% endif %}` : ''}${sortControl ? `{% if field.key == 'sort' and collection.sort_options.size > 0 %}{% continue %}{% endif %}` : ''}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endfor %}`;

// A selected zero-result value stays hidden and removable by its canonical chip.
// It never becomes an invented selectable option.
const giftChoices = `{% assign kr_occasion_editable = false %}{% assign kr_recipient_editable = false %}{% if shop.gift_discovery_enabled == true %}{% if shop.gift_occasions.size > 0 %}{% if request.query.occasion == blank %}{% assign kr_occasion_editable = true %}{% else %}{% for choice in shop.gift_occasions %}{% if choice.value == request.query.occasion %}{% assign kr_occasion_editable = true %}{% break %}{% endif %}{% endfor %}{% endif %}{% endif %}{% if shop.gift_recipients.size > 0 %}{% if request.query.recipient == blank %}{% assign kr_recipient_editable = true %}{% else %}{% for choice in shop.gift_recipients %}{% if choice.value == request.query.recipient %}{% assign kr_recipient_editable = true %}{% break %}{% endif %}{% endfor %}{% endif %}{% endif %}{% endif %}`;
const occasion = `{% if kr_occasion_editable %}<label>The occasion<select name="occasion"><option value="">Any occasion</option>{% for choice in shop.gift_occasions %}<option value="{{ choice.value }}"{% if request.query.occasion == choice.value %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}</select></label>{% endif %}`;
const recipient = `{% if kr_recipient_editable %}<label>Who’s it for?<select name="recipient"><option value="">Anyone</option>{% for choice in shop.gift_recipients %}<option value="{{ choice.value }}"{% if request.query.recipient == choice.value %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}</select></label>{% endif %}`;
const priceFields = `<div class="kr-budget"><label>Minimum budget<input type="number" name="min_price" min="0" step="0.01" value="{{ request.query.min_price }}" placeholder="INR ₹"></label><label>Maximum budget<input type="number" name="max_price" min="0" step="0.01" value="{{ request.query.max_price }}" placeholder="INR ₹"></label></div>`;
const sort = `{% if collection.sort_options.size > 0 %}<label>Sort<select name="sort">{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></label>{% endif %}`;
const search = `<label>Search this store<input name="search" type="search" maxlength="200" value="{{ request.query.search }}" placeholder="{{ section.settings.placeholder | default: 'A product or a thoughtful detail' }}"></label>`;

export const KINDRED_SEARCH = `<section class="kr-theme" data-section-id="{{ section.id }}"><div class="kr-wrap kr-section"><form class="kr-search-form lb-search-box__form" method="get" action="{{ request.path | store_url }}">${search}${keep(['search'])}<button class="kr-button" type="submit">Search products →</button></form></div></section>`;
export const KINDRED_FINDER = `${giftChoices}{% if shop.gift_discovery_enabled == true %}<form class="kr-finder" method="get" action="{{ routes.all_products_collection_url }}">${occasion}${recipient}${priceFields}${keep(['min_price', 'max_price'], true)}<button type="submit" class="kr-button">Find their gift →</button></form>{% else %}<form class="kr-finder" method="get" action="{{ routes.search_url }}">${search}${keep(['search'])}<button type="submit" class="kr-button">Search products →</button></form>{% endif %}<a class="kr-link" href="{{ routes.all_products_collection_url }}">Browse every gift →</a>`;
export const KINDRED_FILTERS = `<section class="kr-theme" data-section-id="{{ section.id }}"><div class="kr-wrap kr-section"><div class="kr-heading"><div><p class="kr-eyebrow">A LITTLE DIRECTION</p><h1>{{ collection.title | default: section.settings.title }}</h1>{% if collection.total != nil %}<p>{{ collection.total }} products</p>{% endif %}</div></div>${giftChoices}{% if collection.capabilities.discovery == true or shop.gift_discovery_enabled == true %}<form class="kr-filter-form" method="get" action="{{ request.path | store_url }}">${occasion}${recipient}${priceFields}${sort}${keep(['min_price', 'max_price'], true, true)}<button class="kr-button" type="submit">Find gifts →</button></form>{% else %}<p>Browse this store’s products or use search. Gift filters have not been configured.</p><a class="kr-link" href="{{ routes.search_url }}">Search products →</a>{% endif %}{% if collection.active_filters.size > 0 %}<div class="kr-applied-filters">{% for filter in collection.active_filters %}<a class="kr-chip" href="{{ filter.clear_url | store_url }}" data-kindred-clear="{{ filter.key }}" data-kindred-value="{{ filter.value }}">Remove {{ filter.label }} ×</a>{% endfor %}{% if collection.clear_filters_url != blank %}<a class="kr-link" href="{{ collection.clear_filters_url | store_url }}" data-kindred-clear-all>Clear all filters</a>{% endif %}</div>{% endif %}</div></section>`;
export const KINDRED_PAGINATION = `<nav class="kr-pagination" aria-label="Product pages">{% if collection.pagination.previous_url != blank %}<a class="kr-link" href="{{ collection.pagination.previous_url }}">← Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url != blank %}<a class="kr-link" href="{{ collection.pagination.next_url }}">Next →</a>{% endif %}</nav>`;
