/** Kindred presentation consumes the existing storefront settings roles. No platform credential overrides. */
export const KINDRED_CSS = `
.kr-theme{--kr-action:var(--primary,#662e42);--kr-canvas:var(--background,#fffaf4);--kr-text:var(--foreground,#342c2c);--kr-surface:var(--surface,#f2e7df);--kr-muted:color-mix(in srgb,var(--kr-text) 75%,var(--kr-canvas));--kr-border:color-mix(in srgb,var(--kr-text) 32%,var(--kr-canvas));color:var(--kr-text);background:var(--kr-canvas);font-family:var(--font-main,Lato,Arial,sans-serif);font-size:1rem;line-height:1.55;overflow-wrap:anywhere}
.kr-theme *{box-sizing:border-box}.kr-theme :where(h1,h2,h3,p,figure){margin:0}.kr-theme :where(h1,h2,h3){font-family:var(--font-heading,'Playfair Display',Georgia,serif);font-weight:400;letter-spacing:-.025em;line-height:1.15}.kr-theme h1{font-size:clamp(2.1rem,4vw,3.5rem)}.kr-theme h2{font-size:clamp(1.7rem,3vw,2.4rem)}.kr-theme h3{font-size:1.5rem}.kr-theme p{color:var(--kr-muted);margin-block:.75rem}.kr-theme a{color:inherit;text-decoration:none}.kr-theme a:hover{text-decoration:underline;text-underline-offset:.2em}.kr-theme img{display:block;max-width:100%;height:auto}.kr-theme :where(button,input,select,textarea){font:inherit}.kr-theme :where(a,button,input,select,summary):focus-visible{outline:var(--lb-focus-ring-width,2px) solid var(--lb-color-focus-ring,#005fcc);outline-offset:var(--lb-focus-offset,3px)}.kr-theme :where(button){cursor:pointer}.kr-theme :where(button:disabled){cursor:default;opacity:.65}.kr-wrap{width:min(75rem,calc(100% - 6rem));margin-inline:auto}.kr-section{padding-block:3.5rem}.kr-eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.12em;color:var(--kr-action)!important;text-transform:uppercase}.kr-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.8rem}.kr-heading p{max-width:28rem}.kr-button,.kr-theme .lb-product-detail__cta--primary{display:inline-flex;align-items:center;justify-content:center;gap:1rem;min-height:3.125rem;padding:.9rem 1.4rem;border:1px solid var(--kr-action);border-radius:var(--radius,.375rem);background:var(--kr-action);color:var(--lb-color-primary-cta-text,#fff);font-weight:700;line-height:1.3;text-align:center}.kr-link{display:inline-block;color:var(--kr-action)!important;border-bottom:1px solid var(--kr-border);padding-block:.25rem;font-weight:700}.kr-intro{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);grid-template-areas:'copy image' 'finder image';gap:1.8rem 3.5rem;padding-top:3rem}.kr-intro-empty{grid-template-areas:'copy finder';padding-bottom:1rem}.kr-intro-copy{grid-area:copy}.kr-intro-copy h1{margin-top:.8rem}.kr-intro-image{grid-area:image;min-width:0;align-self:stretch}.kr-intro-image img{width:100%;height:100%;max-height:42rem;object-fit:contain;background:var(--kr-surface);border-radius:.6rem}.kr-finder-panel{grid-area:finder;background:var(--kr-surface);border:1px solid var(--kr-border);border-radius:var(--radius,.5rem);padding:1.6rem;align-self:start}.kr-finder-panel h2{font-size:1.6rem;margin-bottom:1rem}.kr-finder{display:grid;gap:1rem}.kr-theme label{display:grid;gap:.45rem;font-size:.875rem;font-weight:700;min-width:0}.kr-theme :where(input,select,textarea){width:100%;min-height:2.9rem;padding:.7rem .8rem;border:1px solid var(--kr-border);border-radius:var(--radius,.375rem);background:var(--kr-canvas);color:var(--kr-text);min-width:0}.kr-budget{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.kr-finder-panel>.kr-link{margin-top:1rem}.kr-occasions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-block:1px solid var(--kr-border)}.kr-occasion{padding:1.6rem 1.3rem;min-width:0;border-inline-start:1px solid var(--kr-border)}.kr-occasion:first-child{border-inline-start:0}.kr-occasion h3{font-size:1.5rem}.kr-occasion p{font-size:.875rem}.kr-grid{display:grid;grid-template-columns:repeat(var(--kr-columns,2),minmax(0,1fr));gap:2rem}.kr-columns-3{--kr-columns:3}.kr-card{min-width:0}.kr-card-media{aspect-ratio:4/3;position:relative;background:var(--kr-surface);border-radius:.6rem}.kr-card-media img{width:100%;height:100%;object-fit:contain;border-radius:inherit}.kr-placeholder{display:grid;place-items:center;min-height:10rem;padding:1.5rem;color:var(--kr-muted);text-align:center}.kr-card-meta{display:flex;justify-content:space-between;gap:1rem;margin-block:1rem .5rem;font-size:.875rem}.kr-card h3{font-size:1.65rem}.kr-card p{font-size:.9rem}.kr-card .kr-link{font-size:.85rem}.kr-unavailable{position:absolute;inset:auto .7rem .7rem;background:var(--kr-canvas);padding:.4rem .7rem;border:1px solid var(--kr-border);font-size:.8rem}.kr-pack-story{background:var(--kr-surface)}.kr-split{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:4rem}.kr-split>img{width:100%;aspect-ratio:4/3;object-fit:contain;border-radius:.6rem}.kr-split h2{margin-block:1rem}.kr-help-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.kr-help-grid>article{padding-top:1.2rem;border-top:1px solid var(--kr-border)}.kr-help-grid p{font-size:.95rem}.kr-filter-form{display:grid;grid-template-columns:1fr 1fr 1.4fr 1fr auto;gap:1rem;align-items:end}.kr-applied-filters{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1rem;align-items:center}.kr-applied-filters form{margin:0}.kr-chip{padding:.65rem 1rem;min-height:2.75rem;border:1px solid var(--kr-border);border-radius:5rem;background:var(--kr-surface);color:var(--kr-text);font-size:.85rem}.kr-pagination{display:flex;justify-content:center;gap:1.5rem;align-items:center;flex-wrap:wrap;margin-block:2rem}.kr-empty{padding:2rem;border:1px solid var(--kr-border);border-radius:var(--radius,.5rem)}.kr-theme .lb-product-detail{width:min(75rem,calc(100% - 6rem));margin:auto;padding-block:2rem 3.5rem}.kr-theme .lb-product-detail__layout{display:grid;grid-template-columns:1.08fr 1fr;gap:3.5rem}.kr-theme .lb-product-detail__gallery-main{background:var(--kr-surface);border-radius:.6rem}.kr-theme .lb-product-detail__gallery-image{width:100%;aspect-ratio:1/1;object-fit:contain}.kr-theme .lb-product-detail__gallery-thumbs{display:flex;gap:.8rem;margin-top:1rem}.kr-theme .lb-product-detail__gallery-thumb{width:6rem;height:5rem;border:1px solid var(--kr-border);background:var(--kr-canvas);padding:.3rem;border-radius:.4rem}.kr-theme .lb-product-detail__gallery-thumb img{width:100%;height:100%;object-fit:contain}.kr-theme .lb-product-detail__info{min-width:0}.kr-theme .lb-product-detail__info h1{font-size:clamp(2rem,3vw,2.7rem)}.kr-theme .lb-product-detail__price{font-size:1.5rem;font-weight:700;margin-block:1.2rem}.kr-theme .lb-product-detail__breadcrumb{display:flex;flex-wrap:wrap;gap:.8rem;margin-bottom:2rem;font-size:.85rem}.kr-theme .lb-product-detail__variants{display:block;margin-block:1.5rem}.kr-theme .lb-product-detail__variant-values{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:.6rem}.kr-theme [data-lb-variant-option]{min-height:2.75rem;padding:.6rem .9rem;border:1px solid var(--kr-border);border-radius:.4rem;background:var(--kr-canvas);color:var(--kr-text)}.kr-theme [data-lb-variant-option][aria-pressed='true']{border:2px solid var(--kr-action);background:var(--kr-surface)}.kr-theme lb-add-to-cart{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}.kr-theme .lb-product-detail__quantity{width:5rem}.kr-theme .lb-product-detail__accordion{padding-block:1rem;border-top:1px solid var(--kr-border);margin-top:1rem}.kr-theme .lb-product-detail__accordion summary{font-family:var(--font-heading,Georgia,serif);font-size:1.4rem;cursor:pointer}.kr-facts{border-top:1px solid var(--kr-border);padding-block:1.2rem}.kr-facts h2{font-size:1.5rem}.kr-facts ol{list-style:decimal;padding-left:1.4rem}.kr-facts li{padding:.8rem 0;border-bottom:1px solid var(--kr-border)}.kr-facts li strong{font-weight:700}.kr-facts li p{margin-block:.35rem;font-size:.875rem}.kr-media-pair{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-block:2rem}.kr-media-pair img{width:100%;aspect-ratio:4/3;object-fit:contain;background:var(--kr-surface);border-radius:.5rem}.kr-media-pair figcaption{font-size:.875rem;padding-top:.65rem}.kr-theme :where(.lb-cart-summary,.lb-customer-account,.lb-customer-addresses,.lb-customer-orders,.lb-customer-order-detail,.lb-customer-settings,.lb-page-content,.lb-policy-content){max-width:min(75rem,calc(100% - 4rem));margin-inline:auto;padding-block:2rem}.kr-theme .lb-header,.kr-theme .lb-footer{background:var(--kr-canvas);color:var(--kr-text);border-color:var(--kr-border)}.kr-theme .lb-header__brand{font-family:var(--font-heading,Georgia,serif);font-size:2rem;font-weight:400}.kr-theme .lb-announcement-bar{background:var(--kr-action);color:var(--lb-color-primary-cta-text,#fff)}
@media(max-width:70rem){.kr-wrap{width:calc(100% - 4rem)}.kr-intro{gap:1.5rem}.kr-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.kr-filter-form{grid-template-columns:1fr 1fr}.kr-filter-form>.kr-budget{grid-column:1/-1}.kr-help-grid{gap:1.3rem}.kr-theme .lb-product-detail__layout{gap:2rem}.kr-occasions{grid-template-columns:1fr 1fr}.kr-occasion:nth-child(3){border-inline-start:0;border-top:1px solid var(--kr-border)}.kr-occasion:nth-child(4){border-top:1px solid var(--kr-border)}}
@media(max-width:40rem){.kr-wrap{width:calc(100% - 2.5rem)}.kr-section{padding-block:2.2rem}.kr-intro{display:flex;flex-direction:column;padding-top:2rem;gap:1.5rem}.kr-intro-image{order:1}.kr-intro-copy{order:0}.kr-finder-panel{order:2;width:100%;padding:1.4rem}.kr-intro-image img{aspect-ratio:4/3;height:auto;max-height:none}.kr-grid{grid-template-columns:1fr;gap:2rem}.kr-heading{display:block}.kr-occasions{grid-template-columns:1fr 1fr}.kr-occasion{padding:1.3rem .8rem}.kr-occasion h3{font-size:1.3rem}.kr-split,.kr-help-grid{grid-template-columns:1fr;gap:1.8rem}.kr-budget{grid-template-columns:1fr 1fr}.kr-filter-form{grid-template-columns:1fr}.kr-filter-form>.kr-budget{grid-column:auto}.kr-theme .lb-product-detail{width:calc(100% - 2.5rem);padding-block:1.5rem 2.5rem}.kr-theme .lb-product-detail__layout{grid-template-columns:1fr;gap:2rem}.kr-theme .lb-product-detail__gallery-image{aspect-ratio:4/3}.kr-media-pair{grid-template-columns:1fr}.kr-theme :where(.lb-cart-summary,.lb-customer-account,.lb-customer-addresses,.lb-customer-orders,.lb-customer-order-detail,.lb-customer-settings,.lb-page-content,.lb-policy-content){max-width:calc(100% - 2.5rem)}.kr-theme .lb-product-detail__cta--primary{flex:1}.kr-theme .lb-product-detail__quantity{width:4.5rem}}
/* Match inherited chrome to the light canvas and retain real standalone targets. */
.kr-theme .kr-link{display:inline-flex;align-items:center;min-height:2.75rem}
.kr-theme .lb-header__nav-links>a,.kr-theme .lb-product-detail__accordion summary{min-height:2.75rem}
.kr-theme .lb-product-detail__accordion summary{display:flex;align-items:center}
.kr-theme .lb-header__toggle{flex-shrink:0;min-width:2.75rem;min-height:2.75rem}
.kr-theme .lb-header__brand{min-width:0;overflow-wrap:anywhere;white-space:normal}
.kr-theme .lb-product-detail__gallery-main{aspect-ratio:4/3}
.kr-theme .lb-product-detail__gallery-image{height:100%;aspect-ratio:auto;object-fit:contain}
.kr-theme .lb-product-detail__gallery-image[hidden]{display:none}
.kr-theme .lb-footer{--footer-bg:var(--kr-canvas);--footer-text:var(--kr-text);--footer-text-muted:var(--kr-muted)}
@media(max-width:47.999em){.kr-theme .lb-header__inner{gap:.5rem}.kr-theme .lb-header__brand{flex:1;font-size:clamp(1.35rem,5vw,1.75rem)}.kr-theme .lb-mobile-nav:not([data-open='true']) .lb-header__nav{visibility:hidden}.kr-theme .lb-mobile-nav[data-open='true'] .lb-header__nav{visibility:visible}}
@media(max-width:23rem){.kr-theme .lb-header__inner{padding-inline:.75rem;gap:.25rem}.kr-theme .lb-header__brand{font-size:1.125rem}}
@media(prefers-reduced-motion:reduce){.kr-theme *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
`;
