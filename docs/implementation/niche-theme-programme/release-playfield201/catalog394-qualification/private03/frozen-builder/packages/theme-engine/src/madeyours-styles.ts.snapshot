/** Indigo form workspace; semantic colors and fonts follow the merchant's supported settings. */
export const MADEYOURS_CSS = `
.my-theme{--my-ink:var(--foreground,#23243e);--my-muted:var(--secondary,#595d7d);--my-action:var(--primary,#484b8b);--my-canvas:var(--background,#f5f6fc);--my-surface:var(--surface,#fff);--my-border:var(--secondary,#747999);--my-focus:var(--accent,#005fcc);background:var(--my-canvas);color:var(--my-ink);font:1rem/1.55 var(--font-body,Inter,Arial,sans-serif);overflow-wrap:anywhere}
.my-theme *{box-sizing:border-box;min-width:0}.my-theme [hidden]{display:none!important}.my-theme :where(h1,h2,h3){font-family:var(--font-display,Inter,Arial,sans-serif);line-height:1.2;letter-spacing:-.025em;font-weight:600}.my-theme h1{font-size:clamp(2rem,3.6vw,3.4rem)}.my-theme h2{font-size:clamp(1.6rem,2.4vw,2.2rem)}.my-theme h3{font-size:1.2rem}.my-theme p{color:var(--my-muted)}.my-theme a{color:inherit;text-underline-offset:.2em}.my-theme img{max-width:100%;height:auto;display:block}.my-theme :where(button,input,select,textarea){font:inherit}.my-theme :where(a,button,input,select,summary):focus-visible{outline:3px solid var(--my-focus);outline-offset:3px}.my-theme :where(button,a,summary){touch-action:manipulation}.my-theme button{cursor:pointer}.my-theme button:disabled{cursor:default;opacity:.65}.my-wrap{width:min(76rem,calc(100% - 6rem));margin-inline:auto}.my-section{padding-block:3.5rem}.my-eyebrow{font-size:.75rem;letter-spacing:.12em;font-weight:700;color:var(--my-action)!important}.my-button,.my-theme .lb-product-detail__cta--primary{display:inline-flex;justify-content:center;align-items:center;min-height:3rem;padding:.8rem 1.3rem;background:var(--my-action);color:var(--lb-color-primary-cta-text,#fff);border:1px solid var(--my-action);border-radius:var(--my-radius,.5rem);text-decoration:none;font-weight:600;line-height:1.35}.my-link{display:inline-flex;align-items:center;min-height:2.75rem;font-weight:600;color:var(--my-action)!important}.my-theme label{display:grid;gap:.45rem;font-size:.9rem;font-weight:600}.my-theme :where(input,select,textarea){min-height:2.9rem;max-width:100%;padding:.7rem .8rem;border:1px solid var(--my-border);border-radius:var(--my-radius,.4rem);background:var(--my-surface);color:var(--my-ink)}
.my-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:3rem;align-items:center;padding-block:3rem}.my-intro-copy{max-width:34rem}.my-intro-copy h1{margin:.8rem 0 1.2rem}.my-intro-copy p{max-width:31rem}.my-intro-media[data-focus="top"] img{object-position:center top}.my-intro-media[data-focus="bottom"] img{object-position:center bottom}.my-intro-media img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--my-radius,1rem)}.my-process{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;border-block:1px solid var(--my-border);padding-block:1.5rem}.my-process article{display:grid;grid-template-columns:2.25rem 1fr;gap:.8rem}.my-step{display:grid;place-items:center;width:2.25rem;height:2.25rem;border:1px solid var(--my-action);border-radius:50%;color:var(--my-action);font-weight:600}.my-process h3{font-size:1rem;margin:0 0 .4rem}.my-process p{font-size:.875rem;margin:0}.my-heading{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;margin-bottom:1.6rem}.my-heading h2{margin:0}.my-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.my-grid[data-columns="3"]{grid-template-columns:repeat(3,minmax(0,1fr))}.my-card{background:var(--my-surface);border:1px solid var(--my-border);border-radius:var(--my-radius,.8rem);overflow:hidden}.my-card-image{display:block;position:relative;background:var(--my-canvas);aspect-ratio:4/3}.my-card-image img{width:100%;height:100%;object-fit:contain}.my-card-body{padding:1.4rem}.my-card h3{margin:0}.my-card h3 a{text-decoration:none}.my-price{font-weight:600;color:var(--my-ink)!important;font-variant-numeric:tabular-nums}.my-capabilities{list-style:none;padding:0;font-size:.875rem;color:var(--my-muted)}.my-capabilities li{padding-block:.25rem}.my-unavailable{position:absolute;bottom:.75rem;left:.75rem;background:var(--my-surface);padding:.4rem .8rem;border:1px solid var(--my-border);border-radius:var(--my-radius,.4rem);font-size:.8rem}.my-empty-image{display:grid;place-items:center;height:100%;padding:2rem;text-align:center;color:var(--my-muted)}.my-collections{display:flex;flex-wrap:wrap;gap:.75rem}.my-collections a{border:1px solid var(--my-border);padding:.7rem 1.2rem;border-radius:3rem;background:var(--my-surface);min-height:2.75rem}.my-story{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}.my-story>img{width:100%;aspect-ratio:4/3;object-fit:contain;border-radius:var(--my-radius,.8rem)}.my-story-no-image{grid-template-columns:1fr;max-width:50rem}.my-filters{display:flex;flex-wrap:wrap;gap:1rem;align-items:end;margin-top:1.5rem}.my-filters label{flex:1;min-width:9rem}.my-filters input{width:100%}.my-pagination{display:flex;flex-wrap:wrap;gap:1.5rem;align-items:center;justify-content:center;margin-top:2rem}.my-empty{padding:2rem;border:1px solid var(--my-border);border-radius:var(--my-radius,.8rem);background:var(--my-surface)}
.my-theme .lb-product-detail{width:min(76rem,calc(100% - 6rem));margin:auto;padding-block:2rem 3.5rem}.my-theme .lb-product-detail__layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:3rem;align-items:start}.my-theme .lb-product-detail__gallery{position:static}.my-theme .lb-product-detail__gallery-main{background:var(--my-surface);border:1px solid var(--my-border);border-radius:var(--my-radius,.8rem)}.my-theme .lb-product-detail__gallery-image{width:100%;height:100%;object-fit:contain;aspect-ratio:1}.my-theme .lb-product-detail__gallery-thumbs{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1rem}.my-theme .lb-product-detail__gallery-thumb{width:4.5rem;height:4.5rem;padding:.3rem;border:1px solid var(--my-border);background:var(--my-surface)}.my-theme .lb-product-detail__gallery-thumb img{width:100%;height:100%;object-fit:contain}.my-theme .lb-product-detail__info h1{font-size:clamp(1.8rem,2.7vw,2.6rem);margin-block:0 1rem}.my-theme .lb-product-detail__price{font-size:1.3rem;font-weight:600}.my-theme .lb-product-detail__breadcrumb{display:flex;flex-wrap:wrap;gap:.7rem;font-size:.85rem;margin-bottom:1.5rem}.my-theme .lb-product-detail__variants{display:block;margin-block:1rem}.my-theme .lb-product-detail__variant-values{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.5rem}.my-theme [data-lb-variant-option]{min-height:2.75rem;padding:.6rem .9rem;background:var(--my-surface);color:var(--my-ink);border:1px solid var(--my-border);border-radius:var(--my-radius,.4rem)}.my-theme [data-lb-variant-option][aria-pressed="true"]{outline:1px solid var(--my-action);border-color:var(--my-action);background:var(--my-canvas)}.my-theme lb-add-to-cart{display:flex;flex-wrap:wrap;gap:1rem;align-items:center}.my-theme .lb-product-detail__quantity{width:5rem}.my-theme .lb-product-detail__accordion{padding-block:1rem;border-top:1px solid var(--my-border);margin-top:1rem}.my-theme .lb-product-detail__accordion summary{min-height:2.75rem;display:flex;align-items:center;cursor:pointer;font-weight:600}
.my-config{flex-basis:100%;background:var(--my-surface);border:1px solid var(--my-border);border-radius:var(--my-radius,.8rem);padding:1.4rem}.my-config h2{font-size:1.2rem;margin:0 0 1rem}.my-config fieldset{margin:1rem 0;padding:0;border:0;display:grid;gap:1rem}.my-config legend{font-weight:600;margin-bottom:.5rem}.my-stages{list-style:none;padding:0;display:flex;gap:1rem;flex-wrap:wrap;font-size:.8rem;color:var(--my-muted)}.my-stages li[aria-current="step"]{color:var(--my-action);font-weight:700}.my-config select,.my-config input{width:100%}.my-theme .my-note{font-size:.8rem}.my-error{color:var(--lb-color-error,#b42318)!important;border-inline-start:3px solid currentColor;padding-left:.7rem}.my-preview{padding:1rem;border:1px dashed var(--my-border);border-radius:var(--my-radius,.4rem)}.my-preview output{display:block;font-size:1.6rem;color:var(--my-ink);white-space:pre-wrap;overflow-wrap:anywhere}.my-summary{display:grid;grid-template-columns:minmax(6rem,1fr) minmax(0,2fr);gap:.7rem;margin:1rem 0}.my-summary dt{color:var(--my-muted)}.my-summary dd{margin:0;white-space:pre-wrap;font-weight:600}.my-theme :where(.lb-cart-summary,.lb-customer-account,.lb-customer-addresses,.lb-customer-orders,.lb-customer-order-detail,.lb-customer-settings,.lb-page-content,.lb-policy-content){max-width:min(76rem,calc(100% - 4rem));margin-inline:auto;padding-block:2rem}.my-theme .lb-header,.my-theme .lb-footer{background:var(--my-surface);color:var(--my-ink);border-color:var(--my-border)}.my-theme .lb-header__brand{font-family:var(--font-display,Inter,Arial,sans-serif);font-size:1.4rem;font-weight:700;letter-spacing:-.04em}.my-theme .lb-announcement-bar{background:var(--my-action);color:var(--lb-color-primary-cta-text,#fff)}.my-theme .lb-cart__checkout,.my-theme .lb-cart-drawer__checkout{background:var(--my-action);color:var(--lb-color-primary-cta-text,#fff)}
@media(max-width:70rem){.my-wrap,.my-theme .lb-product-detail{width:calc(100% - 4rem)}.my-intro,.my-story,.my-theme .lb-product-detail__layout{gap:2rem}.my-grid[data-columns="3"]{grid-template-columns:repeat(2,minmax(0,1fr))}.my-process{gap:1rem}}
@media(max-width:48rem){.my-wrap,.my-theme .lb-product-detail{width:calc(100% - 2.5rem)}.my-section{padding-block:2.5rem}.my-intro,.my-story,.my-theme .lb-product-detail__layout{grid-template-columns:1fr;gap:1.5rem}.my-intro{padding-block:2rem}.my-intro-copy{max-width:none}.my-process{grid-template-columns:1fr;gap:1.3rem}.my-grid,.my-grid[data-columns="3"]{grid-template-columns:1fr}.my-heading{display:block}.my-card-body{padding:1.2rem}.my-config{padding:1.1rem}.my-theme .lb-product-detail__cta--primary{flex:1}.my-theme :where(.lb-cart-summary,.lb-customer-account,.lb-customer-addresses,.lb-customer-orders,.lb-customer-order-detail,.lb-customer-settings,.lb-page-content,.lb-policy-content){max-width:calc(100% - 2.5rem)}.my-filters label{flex-basis:100%}}
@media(max-width:22rem){.my-wrap,.my-theme .lb-product-detail{width:calc(100% - 2rem)}.my-summary{grid-template-columns:1fr;gap:.3rem}.my-summary dd{margin-bottom:.7rem}}
.my-theme a.my-button{color:var(--lb-color-primary-cta-text,#fff)}.my-theme button.my-link{background:transparent;border:0;padding-inline:0;min-width:44px}.my-theme .lb-footer{--footer-bg:var(--my-surface);--footer-text:var(--my-ink);--footer-text-muted:var(--my-muted)}.my-theme .lb-header__inner{flex-wrap:wrap;column-gap:1rem;row-gap:.5rem}.my-theme .lb-header__brand{display:inline-flex;align-items:center;min-height:44px;max-width:100%;overflow-wrap:anywhere}.my-theme .lb-header__actions{flex-wrap:wrap;margin-inline-start:auto;max-width:100%}.my-theme :where(.lb-header__toggle,.lb-header__search-toggle,.lb-header__account,.lb-header__cart,.lb-header__nav-close){min-width:44px;min-height:44px;flex-shrink:0}.my-theme .lb-header__nav-links{flex-wrap:wrap}.my-theme .lb-header__nav-links>a{display:flex;align-items:center;min-height:44px}.my-theme .my-card h3 a{display:inline-flex;align-items:center;min-height:44px}
@media(max-width:47.999em){.my-theme .lb-mobile-nav:not([data-open="true"]) .lb-header__nav{visibility:hidden;pointer-events:none}.my-theme .lb-mobile-nav[data-open="true"] .lb-header__nav{visibility:visible;pointer-events:auto}.my-theme .lb-header__inner{column-gap:.75rem}.my-theme .lb-header__brand{max-width:calc(100% - 56px)}}
.my-theme .lb-product-detail__breadcrumb{opacity:1;color:var(--my-muted)}
.my-theme .lb-footer :where(h4,.lb-footer__bottom,.lb-footer__brand p,.lb-footer__col a),.my-theme .lb-product-detail__accordion-body{opacity:1}
@media(prefers-reduced-motion:reduce){.my-theme *{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
`;
