/** Storefront-only presentation. Every selector stays under the Dewdrop section scope. */
export const DEWDROP_CSS = `
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:500;font-display:swap;src:url('/theme-assets/dewdrop/v2/cormorant-garamond-500.ttf') format('truetype')}
@font-face{font-family:Lato;font-style:normal;font-weight:400;font-display:swap;src:url('/theme-assets/dewdrop/v2/lato-400.ttf') format('truetype')}
@font-face{font-family:Lato;font-style:normal;font-weight:700;font-display:swap;src:url('/theme-assets/dewdrop/v2/lato-700.ttf') format('truetype')}
.dd-theme{--dd-muted:var(--secondary,#596754);--dd-line:var(--border-color,#74816c);--dd-soft:var(--surface,#ede9e1);--dd-focus:var(--accent,#005fcc);background:var(--background,#faf8f4);color:var(--foreground,#293229);font:1rem/1.55 var(--font-body,Lato,Arial,sans-serif)}
.dd-theme *{box-sizing:border-box}.dd-theme [hidden]{display:none!important}.dd-theme img{display:block;max-width:100%}.dd-theme a{color:inherit}.dd-theme :where(h1,h2,h3){font-family:var(--font-display,Georgia,serif);font-weight:500;line-height:1.1;letter-spacing:-.02em;overflow-wrap:anywhere}.dd-theme h1{font-size:clamp(2.4rem,4.8vw,4.5rem)}.dd-theme h2{font-size:clamp(1.8rem,3vw,2.5rem)}.dd-theme h3{font-size:1.8rem}.dd-theme p{color:var(--dd-muted);overflow-wrap:anywhere}.dd-theme :where(a,button,input,select,summary):focus-visible{outline:2px solid var(--dd-focus);outline-offset:4px}.dd-wrap{width:min(1280px,calc(100% - 112px));margin-inline:auto}.dd-section{padding-block:50px}.dd-eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.75rem;font-weight:700}.dd-button{display:inline-flex;justify-content:center;align-items:center;min-height:50px;padding:13px 24px;border:1px solid var(--primary);border-radius:6px;background:var(--primary);color:var(--on-primary,#fff)!important;font:inherit;font-weight:700;text-decoration:none}.dd-link{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:5px}.dd-heading{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:28px}.dd-heading h2{margin:8px 0}.dd-empty{padding:35px 0}.dd-missing{font-size:.85rem}.dd-placeholder{display:grid;place-items:center;min-height:150px;height:100%;padding:20px;text-align:center;background:var(--dd-soft);color:var(--dd-muted);font-size:.85rem}
.dd-hero{display:grid;grid-template-columns:42% 58%;min-height:570px}.dd-hero-copy{padding:65px 42px 65px max(56px,calc((100vw - 1280px)/2));display:flex;flex-direction:column;align-items:start;justify-content:center}.dd-hero-copy h1{margin:20px 0}.dd-hero-copy p{max-width:380px;margin:0 0 27px}.dd-hero-media{min-width:0}.dd-hero-media img{width:100%;height:100%;min-height:570px;object-fit:cover;object-position:65% center}.dd-focus-left img{object-position:left center}.dd-focus-right img{object-position:right center}.dd-hero-empty{grid-template-columns:1fr}.dd-hero-empty .dd-hero-copy{max-width:900px;margin:auto;min-height:350px;padding:50px 28px}
.dd-routine{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-block:1px solid var(--dd-line)}.dd-routine-item{display:flex;gap:20px;align-items:start;padding:25px 20px;border-inline-end:1px solid var(--dd-line)}.dd-routine-item:last-child{border:0}.dd-routine-item h3{margin:0}.dd-routine-item p{margin:10px 0}.dd-step{font-family:var(--font-display,Georgia,serif);font-size:2rem;color:var(--primary);flex-shrink:0}.dd-shelf{display:grid;grid-template-columns:200px minmax(0,1fr);gap:40px;padding-block:30px;border-bottom:1px solid var(--dd-line)}.dd-shelf-label{display:flex;align-items:start;gap:17px;flex-wrap:wrap}.dd-shelf-label h2{margin:0}.dd-shelf-label p{font-size:.85rem}.dd-shelf-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}.dd-card{display:grid;grid-template-columns:145px minmax(0,1fr);gap:20px;min-width:0}.dd-card-media{display:block;aspect-ratio:4/5;background:var(--dd-soft);overflow:hidden;border-radius:10px}.dd-card-media img{width:100%;height:100%;object-fit:contain}.dd-card-copy{min-width:0;overflow-wrap:anywhere;padding-top:8px}.dd-card-copy .dd-eyebrow{font-size:.65rem;margin:0 0 9px}.dd-card-heading{display:flex;align-items:start;justify-content:space-between;gap:10px}.dd-card-heading h3 a{display:inline-flex;align-items:center;min-height:44px}.dd-card-heading h3{font-size:1.7rem;margin:0}.dd-card-heading>span{white-space:nowrap;font-variant-numeric:tabular-nums}.dd-card-copy p{font-size:.85rem;margin:9px 0}.dd-card-copy .dd-link{font-size:.85rem}.dd-featured{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.dd-featured .dd-card{display:block}.dd-featured .dd-card-media{aspect-ratio:4/5}.dd-featured .dd-card-copy{padding-top:18px}
.dd-education{display:grid;grid-template-columns:1fr 1fr;background:var(--dd-soft)}.dd-education>img{width:100%;height:480px;object-fit:cover}.dd-education-copy{padding:60px;align-self:center}.dd-education-copy h2{margin:15px 0}.dd-education-empty{grid-template-columns:1fr}.dd-services{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;padding-block:32px}.dd-services article{border-inline-end:1px solid var(--dd-line);padding-inline-end:25px}.dd-services article:last-child{border:0}.dd-services h3{font-size:1.5rem}.dd-services p{font-size:.85rem}.dd-filters{display:flex;align-items:end;gap:16px;flex-wrap:wrap;margin-block:28px;border-block:1px solid var(--dd-line);padding-block:20px}.dd-filters label{display:grid;gap:8px;font-size:.85rem;max-width:100%}.dd-filters :where(input,select){border:1px solid var(--dd-line);border-radius:5px;padding:11px;background:var(--background);color:var(--foreground);font:inherit;min-height:46px;max-width:100%}.dd-filters input{width:170px}.dd-pagination{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-block:24px}
.dd-theme .lb-header{background:var(--background);border-bottom:1px solid var(--dd-line)}.dd-theme .lb-header__inner{width:min(1280px,calc(100% - 112px));margin:auto;padding-block:20px}.dd-theme .lb-header__brand{text-decoration:none;font-family:var(--font-display,Georgia,serif);font-size:2.5rem;font-weight:500;letter-spacing:-.04em}.dd-theme .lb-header__search-toggle{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;background:transparent;padding:0;cursor:pointer}.dd-theme .lb-header__account{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px}.dd-theme .lb-header__nav-links{gap:28px}.dd-theme .lb-header__nav-links>a{display:inline-flex;align-items:center;min-height:44px}.dd-theme .lb-product-detail__accordion>summary{min-height:44px;display:flex;align-items:center;cursor:pointer}.dd-theme .lb-announcement-bar{background:var(--primary);color:var(--on-primary,#fff);text-align:center;padding:9px 18px;font-size:.8rem}.dd-theme .lb-announcement-bar__inner{justify-content:center}.dd-theme .lb-footer a{display:inline-flex;align-items:center;min-height:44px}.dd-theme .lb-product-detail__breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.dd-theme .lb-product-detail__breadcrumb a{display:inline-flex;align-items:center;min-height:44px;min-width:44px}.dd-theme .lb-footer{background:var(--dd-soft);border-top:1px solid var(--dd-line);padding:45px max(28px,calc((100vw - 1280px)/2))}.dd-theme .lb-product-detail{width:min(1280px,calc(100% - 112px));margin:auto;padding-block:35px 60px}.dd-theme .lb-product-detail__layout{display:grid;grid-template-columns:1.1fr 1fr;gap:70px}.dd-theme .lb-product-detail__info{min-width:0}.dd-theme .lb-product-detail__gallery-main{aspect-ratio:4/5;background:var(--dd-soft);border-radius:12px}.dd-theme .lb-product-detail__layout>.dd-placeholder{height:auto;min-height:250px;aspect-ratio:4/5;align-self:start}.dd-theme .lb-product-detail__gallery-image{width:100%;aspect-ratio:4/5;object-fit:contain;border-radius:12px;background:var(--dd-soft)}.dd-theme .lb-product-detail__variant-group{display:block;width:100%;min-width:0;border:0;padding:0;margin:22px 0}.dd-theme .lb-product-detail__variant-values{width:100%}.dd-theme .lb-product-detail__variant-group legend{font:inherit;font-weight:700;margin-bottom:10px}.dd-theme .lb-product-detail__variant-values{display:flex;gap:10px;flex-wrap:wrap}.dd-theme .lb-product-detail__variant-values button{display:flex;flex-direction:column;gap:7px;align-items:start;min-height:80px;min-width:120px;padding:13px;border:1px solid var(--dd-line);border-radius:7px;background:var(--background);color:var(--foreground);font:inherit}.dd-theme .lb-product-detail__variant-values button[aria-pressed="true"]{outline:2px solid var(--primary);outline-offset:-3px}.dd-theme .lb-product-detail__variant-values button[aria-pressed="true"]:after{content:'✓ Selected';font-size:.75rem}.dd-theme .lb-product-detail__variant-values button:focus-visible{outline:2px solid var(--dd-focus);outline-offset:4px}.dd-swatch{width:28px;height:28px;border:1px solid var(--dd-line);border-radius:50%}.dd-theme .lb-product-detail__variant-status{min-height:1.2em;margin:0;font-size:.85rem}.dd-shade-code{font-size:.75rem}.dd-facts{margin-block:25px;padding-block:18px;border-block:1px solid var(--dd-line)}.dd-facts h2{font-size:1.7rem}.dd-facts h3{font-size:1.35rem}.dd-facts p{font-size:.95rem;white-space:pre-line}.dd-facts details{border-top:1px solid var(--dd-line);padding-block:14px}.dd-facts summary{cursor:pointer;min-height:44px}.dd-theme .lb-product-detail__purchase{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px}.dd-theme .lb-product-detail__cta--primary{background:var(--primary);color:var(--on-primary,#fff);min-height:50px;border-radius:6px;border:1px solid var(--primary)}.dd-theme .lb-product-detail__quantity{width:85px;min-height:48px;border:1px solid var(--dd-line);border-radius:5px;padding:10px;font:inherit}.dd-theme .lb-product-detail__cta:disabled{opacity:.6;cursor:not-allowed}.dd-theme :where(.lb-cart,.lb-customer-account,.lb-customer-orders,.lb-customer-addresses,.lb-customer-order-detail){width:min(1280px,calc(100% - 60px));margin-inline:auto}.dd-theme :where(.lb-cart__checkout,.lb-cart-drawer__checkout){background:var(--primary);color:var(--on-primary,#fff)}
@media(max-width:1100px){.dd-wrap{width:calc(100% - 64px)}.dd-hero-copy{padding:45px 32px}.dd-hero{grid-template-columns:45% 55%}.dd-shelf{grid-template-columns:170px minmax(0,1fr);gap:28px}.dd-shelf-products{grid-template-columns:1fr}.dd-card{grid-template-columns:140px minmax(0,1fr)}.dd-theme .lb-product-detail__layout{gap:35px}.dd-education-copy{padding:35px}}
@media(max-width:900px){.dd-routine{grid-template-columns:1fr}.dd-routine-item{border-inline-end:0;border-bottom:1px solid var(--dd-line);padding:22px 0}.dd-hero-media img{min-height:515px}.dd-featured{gap:20px}.dd-featured .dd-card-heading{display:block}.dd-theme .lb-header__inner{width:calc(100% - 64px)}.dd-theme .lb-product-detail{width:calc(100% - 64px)}.dd-theme .lb-product-detail__variant-values{flex-direction:column}.dd-theme .lb-product-detail__variant-values button{min-height:65px;width:100%}}
@media(max-width:640px){.dd-wrap{width:calc(100% - 40px)}.dd-section{padding-block:32px}.dd-heading{display:block}.dd-hero{grid-template-columns:1fr}.dd-hero-copy{padding:38px 24px}.dd-hero-copy h1{font-size:3.2rem}.dd-hero-media img{min-height:0;height:345px}.dd-shelf{grid-template-columns:1fr;gap:20px;padding-block:27px}.dd-shelf-label{align-items:center}.dd-card{grid-template-columns:115px minmax(0,1fr);gap:18px}.dd-card-heading{display:block}.dd-card-heading h3 a{display:inline-flex;align-items:center;min-height:44px}.dd-card-heading h3{font-size:1.6rem}.dd-card-heading>span{display:block;margin-top:8px}.dd-card-copy p{font-size:.8rem}.dd-featured{grid-template-columns:1fr}.dd-featured .dd-card{display:grid}.dd-education{grid-template-columns:1fr}.dd-education>img{height:330px}.dd-education-copy{padding:30px 24px}.dd-services{grid-template-columns:1fr}.dd-services article{border-inline-end:0;border-bottom:1px solid var(--dd-line);padding-bottom:20px}.dd-filters{gap:13px}.dd-filters label{width:100%}.dd-filters :where(input,select){width:100%}.dd-theme .lb-product-detail{width:calc(100% - 40px)}.dd-theme .lb-product-detail__layout{grid-template-columns:1fr;gap:30px}.dd-theme .lb-header__inner{width:calc(100% - 32px)}.dd-theme .lb-header__inner{flex-wrap:wrap;gap:8px}.dd-theme .lb-header__brand{text-decoration:none;font-size:2rem;flex:1 0 6ch;min-width:0;max-width:calc(100% - 52px);overflow-wrap:anywhere}.dd-theme .lb-header__actions{margin-inline-start:auto;flex-wrap:wrap;max-width:100%;gap:8px}.dd-theme .lb-header__cart{font-size:.85rem}.dd-pagination{flex-wrap:wrap}.dd-theme :where(.lb-cart,.lb-customer-account,.lb-customer-orders,.lb-customer-addresses,.lb-customer-order-detail){width:calc(100% - 32px)}}
@media(max-width:47.99em){.dd-theme .lb-mobile-nav:not([data-open="true"]) .lb-header__nav{visibility:hidden}.dd-theme .lb-mobile-nav[data-open="true"] .lb-header__nav{visibility:visible}}
@media(prefers-reduced-motion:reduce){.dd-theme *{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
`;
