/** GET controls consume the finite projection of the same validated server page.
 * Query state, local product facts and theme defaults never enable a chooser. */
export const PLAYFIELD_DISCOVERY_FLAGS = `{% assign pf_age_available = false %}{% assign pf_interest_available = false %}{% if collection.capabilities.discovery == true and collection.capabilities.toys_filters == true %}{% if collection.capabilities.toys_age_band == true and collection.toy_facets.age_bands.size > 0 %}{% assign pf_age_available = true %}{% endif %}{% if collection.capabilities.toys_interest == true and collection.toy_facets.interests.size > 0 %}{% assign pf_interest_available = true %}{% endif %}{% endif %}`;
/** A validated active value may have no facet match after another filter changes.
 * Retain that selection only inside an already-supported chooser; it cannot enable one. */
const selectedQueryChoice = (key: string, suppliedPath: string) => `{% assign pf_selected_choices = ${suppliedPath} | where: 'selected', true %}{% if pf_selected_choices.size == 0 %}{% for field in collection.discovery_query_fields %}{% if field.key == '${key}' %}<option value="{{ field.value }}" selected>{{ field.value }} (selected)</option>{% endif %}{% endfor %}{% endif %}`;
export const PLAYFIELD_AGE_OPTIONS = `<option value="">Any age</option>{% for choice in collection.toy_facets.age_bands %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}${selectedQueryChoice('age_band', 'collection.toy_facets.age_bands')}`;
export const PLAYFIELD_INTEREST_OPTIONS = `<option value="">Any interest</option>{% for choice in collection.toy_facets.interests %}<option value="{{ choice.value }}"{% if choice.selected == true %} selected{% endif %}>{{ choice.label }}</option>{% endfor %}${selectedQueryChoice('interest', 'collection.toy_facets.interests')}`;
export const PLAYFIELD_CHOOSERS = `{% if pf_age_available %}<label>Choose an age<select name="age_band">${PLAYFIELD_AGE_OPTIONS}</select></label>{% endif %}{% if pf_interest_available %}<label>Follow an interest<select name="interest">${PLAYFIELD_INTEREST_OPTIONS}</select></label>{% endif %}`;
const hiddenQueryField = `<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">`;
/** This is a list of controls edited by this form, never a query-key whitelist. */
const preserveUntouchedQuery = (edited: string[], conditional: Array<[string, string]> = []) => `{% for field in collection.discovery_query_fields %}{% unless ${['page', ...edited].map(key => `field.key == '${key}'`).join(' or ')} %}${conditional.map(([key, flag]) => `{% unless field.key == '${key}' and ${flag} %}`).join('')}${hiddenQueryField}${conditional.map(() => '{% endunless %}').join('')}{% endunless %}{% endfor %}`;
export const PLAYFIELD_SEARCH_QUERY_FIELDS = preserveUntouchedQuery(['search']);
const finderQueryFields = preserveUntouchedQuery([], [['age_band', 'pf_age_available'], ['interest', 'pf_interest_available']]);
const filterQueryFields = preserveUntouchedQuery(['search', 'sort'], [['age_band', 'pf_age_available'], ['interest', 'pf_interest_available']]);
export const PLAYFIELD_FINDER = `${PLAYFIELD_DISCOVERY_FLAGS}{% if pf_age_available or pf_interest_available %}<form class="pf-finder" method="get" action="{{ routes.all_products_collection_url }}">${PLAYFIELD_CHOOSERS}${finderQueryFields}<button class="pf-button" type="submit">{{ section.settings.buttonLabel }} →</button>{% if pf_age_available %}<p class="pf-note">Shopping for a young person? Age ranges come from the merchant.</p>{% endif %}</form>{% else %}<form class="pf-finder" method="get" action="{{ routes.search_url }}"><label>Search activities<input type="search" name="search" maxlength="200" value="{{ request.query.search }}"></label>${PLAYFIELD_SEARCH_QUERY_FIELDS}<button class="pf-button" type="submit">Search products →</button><a class="pf-link" href="{{ routes.all_products_collection_url }}">Browse all activities →</a></form>{% endif %}`;
export const PLAYFIELD_AGE_ENTRIES = `${PLAYFIELD_DISCOVERY_FLAGS}<section class="pf-wrap pf-section" data-section-id="{{ section.id }}">{% if pf_age_available %}<h2>{{ section.settings.title }}</h2><div class="pf-ages">{% for choice in collection.toy_facets.age_bands %}<a class="pf-link" href="{{ routes.all_products_collection_url }}?age_band={{ choice.value | url_encode }}">{{ choice.label }} →</a>{% endfor %}</div><p class="pf-note">These are merchant recommendations. Read each product’s information before choosing.</p>{% else %}<h2>Explore their next activity.</h2><a class="pf-link" href="{{ routes.all_products_collection_url }}">Browse all activities →</a>{% endif %}</section>`;
export const PLAYFIELD_FILTERS = `${PLAYFIELD_DISCOVERY_FLAGS}<section class="pf-wrap pf-section" data-section-id="{{ section.id }}"><p class="pf-eyebrow">FOLLOW THEIR CURIOSITY</p><h1>{{ collection.title | default: 'Find their next activity.' }}</h1>{% if collection.total != nil %}<p>{{ collection.total }} products</p>{% endif %}<form class="pf-filters" method="get" action="{{ request.path }}"><label>Search activities<input type="search" name="search" maxlength="200" value="{{ request.query.search }}"></label>${PLAYFIELD_CHOOSERS}<label>Sort<select name="sort"><option value="display_order"{% if request.query.sort == 'display_order' %} selected{% endif %}>Featured</option><option value="price-asc"{% if request.query.sort == 'price-asc' %} selected{% endif %}>Price: low to high</option><option value="price-desc"{% if request.query.sort == 'price-desc' %} selected{% endif %}>Price: high to low</option><option value="newest"{% if request.query.sort == 'newest' %} selected{% endif %}>Newest</option><option value="name"{% if request.query.sort == 'name' %} selected{% endif %}>Name</option></select></label>${filterQueryFields}<button class="pf-button" type="submit">Apply filters</button></form><div class="pf-active-filters">{% for filter in collection.active_filters %}<a class="pf-link" href="{{ filter.clear_url }}">Remove {{ filter.label }} ×</a>{% endfor %}<a class="pf-link" href="{{ collection.clear_filters_url | default: request.path }}">Clear all filters</a></div>{% if pf_age_available %}<p class="pf-note">Age ranges are merchant recommendations. Read each product’s information before choosing.</p>{% elsif pf_interest_available == false %}<p>Browse all activities or search this store’s products.</p>{% endif %}</section>`;
export const PLAYFIELD_PAGINATION = `<nav class="pf-pagination" aria-label="Product pages">{% if collection.pagination.previous_url %}<a class="pf-link" href="{{ collection.pagination.previous_url }}">Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url %}<a class="pf-link" href="{{ collection.pagination.next_url }}">Next</a>{% endif %}</nav>`;
