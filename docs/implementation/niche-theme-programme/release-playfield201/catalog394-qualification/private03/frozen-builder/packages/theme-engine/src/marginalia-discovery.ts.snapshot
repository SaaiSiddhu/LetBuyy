/** Print products use uncropped covers and bibliography; stationery retains its own units. */
export const MARGINALIA_CARD = `<article class="mg-book-row" data-product-kind="{{ item.books.kind }}"><a class="mg-cover" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async" width="208" height="312">{% else %}<span class="mg-missing">Image not supplied</span>{% endif %}</a><div class="mg-bibliography"><h3><a href="{{ item.url }}">{{ item.title }}</a></h3>{% if item.books.kind == 'book' %}{% if item.books_display.authors != blank %}<p class="mg-author">{{ item.books_display.authors }}</p>{% elsif item.books.authors.size > 0 %}<p class="mg-author">{{ item.books.authors | join: ', ' }}</p>{% endif %}{% if item.books_display.multiple_editions or item.variants.size > 1 %}<p>Multiple editions — check language and format</p>{% else %}<p>{% if item.books_display.language != blank or item.books.language != blank %}{{ item.books_display.language | default: item.books.language }}{% endif %}{% if item.books_display.format != blank or item.books.format != blank %} · {{ item.books_display.format | default: item.books.format | replace: '-', ' ' }}{% endif %}{% if item.books_display.edition != blank or item.books.edition != blank %} · {{ item.books_display.edition | default: item.books.edition }}{% endif %}</p>{% endif %}{% elsif item.books.kind == 'stationery' %}<p>{% if item.books.paper_gsm %}{{ item.books.paper_gsm }} gsm{% endif %}{% if item.books_display.dimensions != blank %} · {{ item.books_display.dimensions }}{% elsif item.books.dimensions_mm %} · {{ item.books.dimensions_mm.width }} × {{ item.books.dimensions_mm.height }} mm{% endif %}</p><p>{% if item.books.page_count %}{{ item.books.page_count }} pages{% endif %}{% if item.books.sheet_count %} / {{ item.books.sheet_count }} sheets{% endif %}{% if item.books.ruling %} · {{ item.books.ruling }}{% endif %}</p>{% endif %}{% if item.available == false %}<p class="mg-availability">Currently unavailable</p>{% endif %}</div><div class="mg-row-end"><strong class="mg-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</strong><a class="mg-link" href="{{ item.url }}">{% if item.books.kind == 'book' and item.books_display.multiple_editions %}View editions{% elsif item.has_options or item.options.size > 0 %}View options{% else %}View details{% endif %} <span aria-hidden="true">→</span></a></div></article>`;

export const MARGINALIA_PAGINATION = `<nav class="mg-pagination" aria-label="Product pages">{% if collection.pagination.previous_url != blank %}<a class="mg-link" href="{{ collection.pagination.previous_url }}">← Previous</a>{% endif %}{% if collection.pagination.page %}<span>Page {{ collection.pagination.page }}</span>{% endif %}{% if collection.pagination.next_url != blank %}<a class="mg-link" href="{{ collection.pagination.next_url }}">Next →</a>{% endif %}</nav>`;

/** Preserve the canonical query sidecar; a selected zero-result row is not a supplied ruling choice. */
export const MARGINALIA_FILTERS = `<section class="mg-theme" data-section-id="{{ section.id }}"><div class="mg-wrap mg-discovery">
{% assign mg_ruling_available = false %}{% assign mg_current_ruling_supplied = false %}
{% if collection.capabilities.books_filters %}{% for facet in collection.discovery_facets %}{% if facet.key == 'books_ruling' and facet.count > 0 %}{% assign mg_ruling_available = true %}{% if facet.value == request.query.books_ruling %}{% assign mg_current_ruling_supplied = true %}{% endif %}{% endif %}{% endfor %}{% endif %}
<form class="mg-filters" method="get" action="{{ request.path | store_url }}">
{% for field in collection.discovery_query_fields %}{% assign mg_controlled = false %}{% if field.key == 'search' or field.key == 'sort' or field.key == 'page' %}{% assign mg_controlled = true %}{% elsif collection.capabilities.books_filters %}{% if field.key == 'books_author' or field.key == 'books_subject' or field.key == 'books_language' or field.key == 'books_format' or field.key == 'books_kind' %}{% assign mg_controlled = true %}{% endif %}{% endif %}{% if field.key == 'books_ruling' and mg_ruling_available %}{% assign mg_controlled = true %}{% endif %}{% unless mg_controlled %}<input type="hidden" name="{{ field.key }}" value="{{ field.value }}">{% endunless %}{% endfor %}
<input type="hidden" name="page" value="1"><label>Search<input name="search" type="search" maxlength="200" value="{{ request.query.search }}" placeholder="Title, author or keyword"></label>
{% if collection.capabilities.books_filters %}<details class="mg-filter-details" open><summary>Book and paper filters</summary>
<div class="mg-filter-fields" role="group" aria-label="Book editions"><label>Author<input name="books_author" maxlength="200" value="{{ request.query.books_author }}"></label><label>Subject<input name="books_subject" maxlength="100" value="{{ request.query.books_subject }}"></label><label>Language<input name="books_language" maxlength="80" value="{{ request.query.books_language }}"></label><label>Format<select name="books_format"><option value="">Any format</option>{% assign formats = 'paperback,hardback,board-book,spiral-bound,other' | split: ',' %}{% for format in formats %}<option value="{{ format }}"{% if request.query.books_format == format %} selected{% endif %}>{{ format | replace: '-', ' ' }}</option>{% endfor %}</select></label></div>
<label>Product type<select name="books_kind"><option value="">Books and stationery</option><option value="book"{% if request.query.books_kind == 'book' %} selected{% endif %}>Books</option><option value="stationery"{% if request.query.books_kind == 'stationery' %} selected{% endif %}>Stationery</option></select></label>
{% if mg_ruling_available %}<div class="mg-filter-fields" role="group" aria-label="Stationery"><label>Ruling<select name="books_ruling"><option value="">Any ruling</option>{% if request.query.books_ruling != blank and mg_current_ruling_supplied != true %}<option value="{{ request.query.books_ruling }}" selected>Current ruling: {{ request.query.books_ruling }} (no supplied match)</option>{% endif %}{% for facet in collection.discovery_facets %}{% if facet.key == 'books_ruling' and facet.count > 0 %}<option value="{{ facet.value }}"{% if facet.selected %} selected{% endif %}>{{ facet.label }} ({{ facet.count }})</option>{% endif %}{% endfor %}</select></label></div>{% endif %}
</details>{% endif %}
<label>Sort<select name="sort"><option value="display_order"{% if request.query.sort == 'display_order' %} selected{% endif %}>Featured</option><option value="name"{% if request.query.sort == 'name' %} selected{% endif %}>Title</option><option value="price-asc"{% if request.query.sort == 'price-asc' %} selected{% endif %}>Price: low to high</option><option value="price-desc"{% if request.query.sort == 'price-desc' %} selected{% endif %}>Price: high to low</option><option value="newest"{% if request.query.sort == 'newest' %} selected{% endif %}>Newest</option></select></label><button class="mg-button" type="submit">Apply</button></form>
{% if collection.active_filters.size > 0 %}<nav class="mg-heading" aria-label="Applied filters">{% for filter in collection.active_filters %}<a class="mg-link" href="{{ filter.clear_url }}" aria-label="Remove {{ filter.label }}">{{ filter.label }} <span aria-hidden="true">×</span></a>{% endfor %}</nav>{% endif %}
</div></section>`;
