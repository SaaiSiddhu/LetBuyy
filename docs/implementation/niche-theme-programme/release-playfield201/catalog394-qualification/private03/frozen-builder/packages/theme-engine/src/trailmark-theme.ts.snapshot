import { LiquidThemePackageBundleSchema, ThemeLiquidSectionSchema, type LiquidThemePackageBundle, type ThemeLiquidSectionFile } from './theme-bundle';
import { TRAILMARK_FILTERS, TRAILMARK_PAGINATION } from './trailmark-discovery';
import { TRAILMARK_CSS } from './trailmark-styles';

export const TRAILMARK_VERSION = '2.0.0';
export const TRAILMARK_PRESET_ID = 'ride';
export const TRAILMARK_SLUG = 'letbuyy-ride';
export const TRAILMARK_CATALOG_ID = '7b669c70-0000-4000-8000-000000000006';
type Field = ThemeLiquidSectionFile['schema']['settings'][number];
const text = (id: string, label: string, value = ''): Field => ({ id, type: 'text', label, default: value });
const link = (id: string, label: string, value = ''): Field => ({ id, type: 'url', label, default: value });
const image = (id: string, label: string): Field => ({ id, type: 'image', label });
function section(type: string, name: string, settings: Field[], body: string): ThemeLiquidSectionFile {
  const schema = ThemeLiquidSectionSchema.parse({ name, settings, blocks: [], presets: [{ name }] });
  return { path: `sections/${type}.liquid`, source: `${body}\n{% schema %}\n${JSON.stringify(schema)}\n{% endschema %}`, schema };
}
const CARD = `<article class="tm-card"><a class="tm-card-image" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy" decoding="async">{% else %}<span class="tm-placeholder">Product image not supplied</span>{% endif %}</a><div><p class="tm-eyebrow">{% if item.sports.activity != blank %}{{ item.sports.activity }}{% elsif item.category != blank %}{{ item.category }}{% endif %}</p><h3><a href="{{ item.url }}">{{ item.title }}</a></h3><p class="tm-card-facts">{% if item.sports %}{% if item.sports_display.length != blank %}<span>{{ item.sports_display.length }} length</span>{% endif %}{% if item.sports_display.weight != blank %}<span>{{ item.sports_display.weight }}</span>{% endif %}{% if item.sports_display.dimensions != blank %}<span>{{ item.sports_display.dimensions }}</span>{% endif %}{% elsif item.apparel %}{% for option in item.option_summaries %}<span>{{ option.name }}: {{ option.summary }}</span>{% endfor %}{% endif %}</p><span class="tm-card-price">{{ item.price | times: 100 | money_with_currency: item.currency }}</span>{% if item.available == false %}<span class="tm-unavailable">Unavailable</span>{% endif %}<a class="tm-link" href="{{ item.url }}">{% if item.apparel %}View clothing{% else %}View equipment{% endif %} →</a></div></article>`;
const SUMMARY = `{% if section.settings.showEquipmentFacts %}{% if product.sports %}<div class="tm-fact-tiles" aria-label="Product-level equipment measurements"><div><span>Product length</span><strong>{% if product.sports_display.length != blank %}{{ product.sports_display.length }}{% else %}Not supplied{% endif %}</strong></div><div><span>Product weight</span><strong>{% if product.sports_display.weight != blank %}{{ product.sports_display.weight }}{% else %}Not supplied{% endif %}</strong></div><div><span>Activity</span><strong>{{ product.sports.activity }}</strong></div></div><a class="tm-link" href="#equipment-facts">Equipment measurements &amp; conditions ↗</a>{% elsif product.apparel %}<a class="tm-link" href="#equipment-facts">Garment measurements &amp; care ↗</a>{% endif %}{% endif %}`;
const FACTS = `{% if section.settings.showEquipmentFacts %}<section class="tm-facts" id="equipment-facts" aria-label="Product measurements and conditions">{% if product.sports %}<h2>Measure first. Choose second.</h2><table><caption>Merchant-supplied product facts; variant measurements follow below</caption><tbody><tr><th scope="row">Activity</th><td>{{ product.sports.activity }}</td></tr><tr><th scope="row">Equipment type</th><td>{{ product.sports.equipmentType | replace: '-', ' ' }}</td></tr><tr><th scope="row">Overall length</th><td>{% if product.sports_display.length != blank %}{{ product.sports_display.length }}{% else %}Not supplied{% endif %}</td></tr><tr><th scope="row">Weight</th><td>{% if product.sports_display.weight != blank %}{{ product.sports_display.weight }}{% else %}Not supplied{% endif %}</td></tr>{% if product.sports_display.grip != blank %}<tr><th scope="row">Grip circumference</th><td>{{ product.sports_display.grip }}</td></tr>{% endif %}{% if product.sports_display.dimensions != blank %}<tr><th scope="row">Dimensions</th><td>{{ product.sports_display.dimensions }}</td></tr>{% endif %}<tr><th scope="row">Material</th><td>{{ product.sports.material | default: 'Not supplied' }}</td></tr></tbody></table>{% for variant in product.variants %}{% if variant.sports_display.length != blank or variant.sports_display.weight != blank or variant.sports_display.grip != blank or variant.sports_display.dimensions != blank %}<div class="tm-variant-facts"><h3>Measurements for {{ variant.title | default: variant.name }}</h3>{% if variant.sports_display.length != blank %}<p>Length: {{ variant.sports_display.length }}</p>{% endif %}{% if variant.sports_display.weight != blank %}<p>Weight: {{ variant.sports_display.weight }}</p>{% endif %}{% if variant.sports_display.grip != blank %}<p>Grip circumference: {{ variant.sports_display.grip }}</p>{% endif %}{% if variant.sports_display.dimensions != blank %}<p>Dimensions: {{ variant.sports_display.dimensions }}</p>{% endif %}</div>{% endif %}{% endfor %}{% if product.sports.contents.size > 0 %}<details open><summary>Included contents</summary><ul>{% for item in product.sports.contents %}<li>{{ item }}</li>{% endfor %}</ul></details>{% else %}<p>Included contents have not been supplied.</p>{% endif %}{% if product.sports.conditions != blank %}<details open><summary>Use conditions</summary><p>{{ product.sports.conditions }}</p></details>{% endif %}{% if product.sports.care != blank %}<details><summary>Care</summary><p>{{ product.sports.care }}</p></details>{% endif %}{% if product.sports.compatibility.status == 'merchant-supplied' %}<div class="tm-unknown"><strong>Merchant-supplied compatibility reference</strong><p>{{ product.sports.compatibility.reference }}</p>{% if product.sports.compatibility.note != blank %}<p>{{ product.sports.compatibility.note }}</p>{% endif %}</div>{% else %}<p class="tm-unknown"><strong>Compatibility: unconfirmed.</strong>{% if product.sports.compatibility.note != blank %} {{ product.sports.compatibility.note }}{% endif %}</p>{% endif %}{% elsif product.apparel %}<h2>Clothing fit &amp; care</h2>{% if product.apparel.fit != blank %}<p>{{ product.apparel.fit }}</p>{% endif %}{% if product.apparel.measurements.size > 0 %}<table><caption>Garment measurements · {{ product.apparel.unit }}</caption><thead><tr><th scope="col">Garment size</th><th scope="col">Chest</th><th scope="col">Length</th></tr></thead><tbody>{% for row in product.apparel.measurements %}<tr><th scope="row">{{ row.size }}</th><td>{{ row.chest | default: 'Not supplied' }}</td><td>{{ row.length | default: 'Not supplied' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p>Garment measurements have not been supplied.</p>{% endif %}{% if product.apparel.fabric != blank %}<p>{{ product.apparel.fabric }}</p>{% endif %}{% if product.apparel.care != blank %}<p>{{ product.apparel.care }}</p>{% endif %}{% else %}<h2>Know your product</h2><p>Product measurements and use conditions have not been supplied. Equipment measurements and garment sizes are different.</p>{% endif %}</section>{% endif %}`;

/** Pure versioned Core-to-Trailmark package factory; never mutates an installed or published bundle. */
export function createTrailmarkTheme(base: LiquidThemePackageBundle): LiquidThemePackageBundle {
  if (base.package.slug === TRAILMARK_SLUG && base.package.version === TRAILMARK_VERSION && base.layout.theme.source.includes('data-trailmark="2"')) return LiquidThemePackageBundleSchema.parse(structuredClone(base));
  const bundle = structuredClone(base);
  bundle.package = { ...bundle.package, slug: TRAILMARK_SLUG, name: 'Trailmark', version: TRAILMARK_VERSION, version_number: 2, description: 'Activity-first recreational equipment, measured specifications and honest compatibility.' };
  Object.assign(bundle.config.settings_data.current, { primaryColor: '#314E3B', secondaryColor: '#FFFFFF', accentColor: '#005FCC', backgroundColor: '#F5F6F1', textColor: '#222B22', surfaceColor: '#E5E9DD', headingFontFamily: 'Inter', bodyFontFamily: 'Inter', borderRadius: 4 });
  delete bundle.config.settings_data.current.fontFamily;
  bundle.sections['hero-banner'] = section('hero-banner', 'Activity masthead', [text('eyebrow', 'Eyebrow', 'RECREATION / EVERYDAY MOVEMENT'), text('heading', 'Heading', 'Make room for a game.'), text('subheading', 'Description', 'Start with the activity. Find the gear. Check the measurements.'), text('ctaText', 'Button label', 'Find your equipment'), link('ctaLink', 'Button destination', '/products'), image('image', 'Activity context image'), text('imageAlt', 'Image description'), { id: 'imageFocus', type: 'select', label: 'Image focus', options: ['center', 'top', 'bottom'], default: 'center' }], `<section class="tm-hero" data-section-id="{{ section.id }}"><div class="tm-wrap tm-hero-grid{% if section.settings.image == blank %} tm-hero-empty{% endif %}"><div class="tm-hero-copy"><span class="tm-eyebrow">{{ section.settings.eyebrow }}</span><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p>{% if section.settings.ctaText != blank and section.settings.ctaLink != blank %}<a class="tm-button" href="{{ section.settings.ctaLink | store_url }}">{{ section.settings.ctaText }} →</a>{% endif %}</div>{% if section.settings.image != blank %}<img class="tm-focus-{{ section.settings.imageFocus }}" src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" decoding="async" fetchpriority="high">{% endif %}</div></section>`);
  bundle.sections['category-grid'] = section('category-grid', 'Activity pathways', [text('title', 'Heading', 'Find your kind of play'), ...[1,2,3].map(slot => ({ id: `collection${slot}`, type: 'collection' as const, label: `Activity collection ${slot}` }))], `<section data-section-id="{{ section.id }}"><div class="tm-wrap tm-section"><h2>{{ section.settings.title }}</h2>{% if collections.size > 0 %}<div class="tm-paths">{% for item in collections limit: 100 %}{% if section.settings.collection1 != blank or section.settings.collection2 != blank or section.settings.collection3 != blank %}{% unless item.id == section.settings.collection1 or item.id == section.settings.collection2 or item.id == section.settings.collection3 %}{% continue %}{% endunless %}{% elsif forloop.index > 6 %}{% break %}{% endif %}<a class="tm-path" href="{{ routes.collections_url }}/{{ item.handle }}"><h3>{{ item.title }} ↗</h3>{% if item.description != blank %}<p>{{ item.description }}</p>{% endif %}{% if item.product_count != nil %}<p>{{ item.product_count }} {% if item.product_count == 1 %}product{% else %}products{% endif %}</p>{% endif %}</a>{% endfor %}</div>{% else %}<p class="tm-empty">Activity collections added to this shop will appear here.</p>{% endif %}</div></section>`);
  const gridFields: Field[] = [text('title', 'Heading', 'Equipment, explained'), text('subtitle', 'Description'), { id: 'collectionId', type: 'collection', label: 'Equipment collection' }, { id: 'productLimit', type: 'range', label: 'Products to show', min: 1, max: 24, step: 1, default: 6 }, { id: 'columns', type: 'range', label: 'Desktop columns', min: 2, max: 4, step: 1, default: 3 }];
  bundle.sections['product-grid'] = section('product-grid', 'Factual equipment cards', gridFields, `<section data-section-id="{{ section.id }}"><div class="tm-wrap tm-section"><div class="tm-heading"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}</div></div>{% assign equipment_products = section.products | default: collection.products %}{% if equipment_products.size > 0 %}<div class="tm-grid" data-columns="{{ section.settings.columns }}">{% for item in equipment_products limit: section.settings.productLimit %}${CARD}{% endfor %}</div>{% else %}<p class="tm-empty">No equipment is available in this selection.</p>{% endif %}</div></section>`);
  bundle.sections['collection-filter'] = section('collection-filter', 'Equipment discovery controls', [], `<div class="tm-wrap tm-section">${TRAILMARK_FILTERS}</div>`);
  bundle.sections['collection-product-list'] = section('collection-product-list', 'Activity equipment discovery', [text('title', 'Heading', 'Equipment')], `<section data-section-id="{{ section.id }}"><div class="tm-wrap tm-section"><div class="tm-heading"><div><span class="tm-eyebrow">ACTIVITY / EQUIPMENT</span><h1>{{ collection.title | default: section.settings.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}{% if collection.total != nil %}<p>{{ collection.total }} products</p>{% endif %}</div></div><div class="tm-discovery">${TRAILMARK_FILTERS}<div>{% if collection.active_filters.size > 0 %}<nav class="tm-active-filters" aria-label="Applied filters">{% for filter in collection.active_filters %}<a class="tm-link" href="{{ filter.clear_url }}">{{ filter.label }} ×</a>{% endfor %}</nav>{% endif %}{% if collection.products.size > 0 %}<div class="tm-grid">{% for item in collection.products %}${CARD}{% endfor %}</div>{% else %}<p class="tm-empty">No matching equipment. Your search is retained; clear a filter or browse a broader category.</p>{% endif %}${TRAILMARK_PAGINATION}</div></div></div></section>`);
  bundle.sections['about-section'] = section('about-section', 'Equipment selection guide', [text('title', 'Heading', 'Different kit. Different measurements.'), text('content', 'Merchant guide text'), image('image', 'Guide image'), text('imageAlt', 'Image description'), text('linkLabel', 'Guide link label'), link('linkUrl', 'Guide destination')], `<section data-section-id="{{ section.id }}"><div class="tm-wrap tm-section tm-guide{% if section.settings.image == blank %} tm-guide-empty{% endif %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy">{% endif %}<div><span class="tm-eyebrow">KNOW YOUR GEAR</span><h2>{{ section.settings.title }}</h2>{% if section.settings.content != blank %}<p>{{ section.settings.content }}</p>{% endif %}{% if section.settings.linkLabel != blank and section.settings.linkUrl != blank %}<a class="tm-link" href="{{ section.settings.linkUrl | store_url }}">{{ section.settings.linkLabel }} →</a>{% endif %}</div></div></section>`);
  bundle.sections['trust-badges'] = section('trust-badges', 'Merchant service information', [text('measurementsText', 'Measurements information'), text('contentsText', 'Included contents information'), text('supportText', 'Support information')], `<section data-section-id="{{ section.id }}"><div class="tm-wrap tm-services">{% if section.settings.measurementsText != blank %}<div><h3>Measurements before labels</h3><p>{{ section.settings.measurementsText }}</p></div>{% endif %}{% if section.settings.contentsText != blank %}<div><h3>Know what is included</h3><p>{{ section.settings.contentsText }}</p></div>{% endif %}{% if section.settings.supportText != blank %}<div><h3>Support, in plain words</h3><p>{{ section.settings.supportText }}</p></div>{% endif %}</div></section>`);
  bundle.sections['featured-products'] = section('featured-products', 'Independent court accessories', [text('title', 'Heading', 'Keep your court kit simple.'), text('subtitle', 'Description'), image('image', 'Context image'), text('imageAlt', 'Image description'), { id: 'requireSelection', type: 'toggle', label: 'Show only selected products', default: true }, ...[1,2,3].map(slot => ({ id: `product${slot}`, type: 'product' as const, label: `Independent product ${slot}` })), { id: 'productLimit', type: 'range', label: 'Products to show', min: 1, max: 8, step: 1, default: 3 }], `<section data-section-id="{{ section.id }}">{% if section.products.size > 0 %}<div class="tm-wrap tm-section tm-related{% if section.settings.image == blank %} tm-related-empty{% endif %}">{% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.imageAlt }}" loading="lazy">{% endif %}<div><h2>{{ section.settings.title }}</h2>{% if section.settings.subtitle != blank %}<p>{{ section.settings.subtitle }}</p>{% endif %}<p>Each item is sold independently. Check its own measurements and availability.</p>{% for item in section.products limit: section.settings.productLimit %}<a class="tm-related-item" href="{{ item.url }}">{% if item.featured_image != blank %}<img src="{{ item.featured_image | image_url }}" alt="{{ item.title }}" loading="lazy">{% endif %}<div><h3>{{ item.title }}</h3><p>{{ item.price | times: 100 | money_with_currency: item.currency }}</p><span class="tm-link">View product →</span></div></a>{% endfor %}</div></div>{% endif %}</section>`);
  const product = bundle.sections['product-detail'];
  if (!product?.source.includes('  {% if product.options.size > 0 %}<lb-variant-picker') || !product.source.includes('  {% if section.settings.showReviews and product.reviews.size > 0 %}')) throw new Error('Trailmark requires the canonical product/variant section contract.');
  product.schema.settings.push({ id: 'showEquipmentFacts', type: 'toggle', label: 'Show product measurements and conditions', default: true }, { id: 'showBuyNow', type: 'toggle', label: 'Show buy now', default: false });
  product.source = product.source.replace('  {% if product.options.size > 0 %}<lb-variant-picker', `${SUMMARY}\n  {% if product.options.size > 0 %}<lb-variant-picker`).replace('  {% if section.settings.showReviews and product.reviews.size > 0 %}', `${FACTS}\n  {% if section.settings.showReviews and product.reviews.size > 0 %}`).replace(/(<button[^>]*data-lb-buy-now[\s\S]*?<\/button>)/, '{% if section.settings.showBuyNow %}$1{% endif %}');
  const instance = (type: string, settings: Record<string, string | number | boolean> = {}) => ({ type, settings, blocks: {}, block_order: [], disabled: false });
  bundle.templates.index = { name: 'Trailmark activity home', layout: 'theme', order: ['ride-hero-index','ride-activities-index','ride-equipment-index','ride-guide-index','ride-services-index'], sections: { 'ride-hero-index': instance('hero-banner', { eyebrow: 'RECREATION / EVERYDAY MOVEMENT', heading: 'Make room for a game.', subheading: 'Start with the activity. Find the gear. Check the measurements.', ctaText: 'Find your equipment', ctaLink: '/products', imageFocus: 'center' }), 'ride-activities-index': instance('category-grid', { title: 'Find your kind of play' }), 'ride-equipment-index': instance('product-grid', { title: 'A simple start. Proper details.', columns: 3, productLimit: 6 }), 'ride-guide-index': instance('about-section', { title: 'Different kit. Different measurements.' }), 'ride-services-index': instance('trust-badges') } };
  bundle.templates.collection = { name: 'Trailmark equipment collection', layout: 'theme', order: ['ride-collection'], sections: { 'ride-collection': instance('collection-product-list', { title: 'Equipment' }) } };
  bundle.templates.search = { name: 'Trailmark equipment search', layout: 'theme', order: ['ride-search'], sections: { 'ride-search': instance('collection-product-list', { title: 'Search products' }) } };
  // Fresh Core list defaults contain copy that the replacement activity grid never renders.
  // Remove only that known inherited default, before installation; captured v2 bundles return above.
  const inheritedCollectionGrid = bundle.templates['list-collections']?.sections['list-collections-grid'];
  if (inheritedCollectionGrid?.type === 'category-grid') delete inheritedCollectionGrid.settings.subtitle;
  for (const item of Object.values(bundle.templates.header.sections)) {
    if (item.type === 'announcement-bar') item.settings = { text: 'A little more play. A little less guesswork.', linkLabel: '', linkHref: '' };
    if (item.type === 'header') Object.assign(item.settings, { behavior: 'static', layout: 'inline' });
  }
  for (const item of Object.values(bundle.templates.product.sections)) {
    if (item.type === 'product-detail') Object.assign(item.settings, { showEquipmentFacts: true, showBuyNow: false });
    if (item.type === 'featured-products') Object.assign(item.settings, { title: 'Keep your court kit simple.', requireSelection: true, productLimit: 3 });
  }
  for (const [key, file] of Object.entries(bundle.sections)) {
    // Inline Core blocks keep their real root; preview-only attributes are empty in buyer mode.
    file.source = file.source.replace(/(\{% for block in section\.blocks %\}\s*<(?:a|span|article|details|blockquote)\b)/g, '$1 {{ block.editor_attributes | raw }}');
    file.source = file.source.replace(/\{% schema %\}[\s\S]*?\{% endschema %\}/, `{% schema %}\n${JSON.stringify(file.schema)}\n{% endschema %}`);
    if (key !== 'customer-login' && key !== 'customer-register') file.source = `<div class="tm-theme">${file.source.replace('{% schema %}', '</div>\n{% schema %}')}`;
  }
  const headerSlot = '{{ content_for_header | raw }}';
  if (!bundle.layout.theme.source.includes(headerSlot)) throw new Error('Trailmark requires the canonical layout header slot.');
  bundle.layout.theme.source = bundle.layout.theme.source.replace(headerSlot, `${headerSlot}\n<style data-trailmark="2">${TRAILMARK_CSS}</style>`);
  return LiquidThemePackageBundleSchema.parse(bundle);
}
