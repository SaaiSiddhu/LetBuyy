+});
+
+function world(mode='normal'){
+ const calls=[],children=[],streams=[],openFds=new Set(),closes=[];
+ const primary=new Error('SYNTHETIC_PRIMARY_'+mode),secondary=new Error('SYNTHETIC_CLEANUP_'+mode);
+ let nextFd=100;
+ const specs=['identity','merchant','commerce'].map((name,n)=>({kind:name+'-next-production',port:64593+n,env:{SYNTHETIC:'only'}}));
+ const tools={
+  readPreservedPrivateFile(path){calls.push(['read',path]);if(mode==='manifest-read'&&path.includes('/builds/'))throw primary;return Buffer.from(path.includes('/builds/')?'synthetic-stage-manifest':JSON.stringify({syntheticPermit:true}));},
+  writePreservedProgress(run,phase,value){calls.push(['progress',phase,value]);},
+  preservedCutoverPermitPath(){return'/synthetic/cutover.json';},
+  parsePreservedJson(bytes){return JSON.parse(bytes);},
+  validatePreservedCutoverPermit(){calls.push(['permit']);if(mode==='bad-permit')throw primary;},
+ };
+ const input={tools,saved:{capsuleSha256:'a'.repeat(64),capsule:{application:{fixtureId:'49ada80bc494'},sourceBundle:{manifestPath:'/synthetic/source.json',manifestSha256:'b'.repeat(64)},expiresAt:'2026-10-25T10:22:55.858Z'}}};
+ const context=vm.createContext({assert,Buffer,Date,setTimeout,createHash,streamFinished:finished,
+  startOwnedClientRuntime(owned,kind,args){
+   if(mode==='start-throws')throw primary;
+   const child=new EventEmitter();child.kind=kind;child.stopped=0;child.done=false;
+   child.stdout=new PassThrough();child.stderr=new PassThrough();
+   for(const side of ['stdout','stderr']){
+    const original=child[side].pipe.bind(child[side]);
+    child[side].pipe=(target,options)=>{calls.push(['pipe',side,kind]);if(mode===side+'-pipe')throw primary;return original(target,options);};
+   }
+   children.push(child);calls.push(['start',kind,args]);
+   queueMicrotask(()=>{if(child.done||mode==='async-log')return;child.done=true;child.stdout.end();child.stderr.end();if(mode==='child-error')child.emit('error',primary);else child.emit('close',mode==='nonzero'?9:0);});
+   return child;
+  },
+  openSync(){calls.push(['open']);if(mode==='open'||mode==='stop-primary')throw primary;const fd=nextFd++;openFds.add(fd);return fd;},
+  closeSync(fd){calls.push(['close-fd',fd]);closes.push(fd);assert(openFds.has(fd));if(mode==='fd-close')throw secondary;openFds.delete(fd);},
+  createWriteStream(path,{fd,autoClose}){
+   calls.push(['create-stream',fd]);assert.equal(autoClose,true);if(mode==='create-stream'||mode==='fd-close')throw primary;
+   const stream=new Writable({write(chunk,encoding,callback){callback();},autoDestroy:true,emitClose:true});
+   stream.ownedFd=fd;stream.endCalls=0;stream.on('close',()=>{calls.push(['stream-close',fd]);assert(openFds.has(fd));openFds.delete(fd);});
+   const end=stream.end.bind(stream);stream.end=(...args)=>{stream.endCalls++;if(mode==='end-cleanup')throw secondary;return end(...args);};
