+ assert(w.calls.findIndex(c=>c[0]==='revalidate')>w.calls.findIndex(c=>c[0]==='permit'));
+ for(const call of w.calls.filter(c=>c[0]==='start'))assert.equal(call[2].env.LETBUYY_OWNED_NEXT_STAGE_ONLY,'1');
+});
