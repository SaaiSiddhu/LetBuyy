+   if(!child.done){child.done=true;child.stdout.end();child.stderr.end();child.emit('close',-15);}
+  },
+  existsSync(){calls.push(['permit-exists']);return true;},
+  preservedServingInput(){calls.push(['revalidate']);return{};},
+ });
+ vm.runInContext(compiled.outputText,context,{filename:sourceRoot+'/'+fixture+':actual-stage'});
+ async function run(){let failure;try{await context.actualStage({runId:'abcdef123456'},specs,input,{path:'/synthetic/binding.json',sha256:'c'.repeat(64)});}catch(error){failure=error;}await new Promise(resolve=>setImmediate(resolve));return failure;}
+ return{mode,calls,children,streams,openFds,closes,primary,secondary,specs,run};
+}
+function primaryRetained(error,expected){assert(error===expected||error?.cause===expected&&error?.errors?.[0]===expected);}
+function stopped(w,count){assert.equal(w.children.length,count);for(const child of w.children)assert.equal(child.stopped,1);}
+function noPublication(w){assert.equal(w.calls.filter(c=>c[0]==='progress').length,0);assert(!w.calls.some(c=>c[0]==='permit'));}
+
+test('stage normal path stops three sequential clients, closes streams and validates manifests before serving permit',async()=>{
+ const w=world();assert.equal(await w.run(),undefined);stopped(w,3);assert.equal(w.openFds.size,0);
