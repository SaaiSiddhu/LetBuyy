// Source/admission checks only: never import the owned native module or obtain its database handle.
import test from 'node:test';
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {createHash} from 'node:crypto';
import {readFileSync,readdirSync} from 'node:fs';
import {fileURLToPath} from 'node:url';
const require=createRequire(import.meta.url),ts=require('typescript');
const root=new URL('../../../../',import.meta.url),folder='docs/implementation/niche-theme-programme/publisher-acl393/';
const suitePath='services/api-gateway/src/__tests__/owned-db/theme-publisher-acl.postgres.test.ts';
const read=p=>readFileSync(new URL(p,root),'utf8'),sha=s=>createHash('sha256').update(s).digest('hex');
const source=read(suitePath),manifest=JSON.parse(read(folder+'manifest.json')),up=read(manifest.candidates[0].path),down=read(manifest.candidates[1].path);
const ast=ts.createSourceFile(suitePath,source,ts.ScriptTarget.Latest,true);
function nodes(test){const found=[];function walk(n){if(test(n))found.push(n);ts.forEachChild(n,walk);}walk(ast);return found;}

test('dedicated native source has one parent/seven ordered phases and fails closed before its owned boundary',()=>{
 assert.equal(ast.parseDiagnostics.length,0);const calls=nodes(ts.isCallExpression);assert.equal(calls.filter(n=>ts.isIdentifier(n.expression)&&n.expression.text==='test').length,1);
 const stages=calls.filter(n=>ts.isIdentifier(n.expression)&&n.expression.text==='stage');assert.equal(stages.length,7);stages.forEach((s,i)=>assert(s.arguments[0].text.startsWith(`${i+1} `)));
 assert(!calls.some(n=>ts.isPropertyAccessExpression(n.expression)&&['skip','todo','only'].includes(n.expression.name.text)));
 assert(source.indexOf('const inputs=admittedInputs();')<source.indexOf('const owned=requireOwnedDatabase();'));
 for(const n of nodes(ts.isImportDeclaration))assert(!/apps\/|legacy\/|\.next|\/dist\//.test(n.moduleSpecifier.text));
 assert(!/\.dev\.vars|session_replication_role\s*=|DISABLE\s+(?:TRIGGER|ROW)|UPDATE\s+pg_catalog|DELETE\s+FROM\s+pg_catalog|spawn\(|execSync\(/i.test(source));
});

test('pair changes one fixed ACL only; DOWN is exact owned historical inverse and no writer is replaced',()=>{
 const fixed='public.publish_theme_release(uuid,text,jsonb,uuid,integer,uuid,text,boolean,text,uuid)';
 assert.equal((up.match(/REVOKE EXECUTE ON FUNCTION/g)||[]).length,1);assert(up.includes(`REVOKE EXECUTE ON FUNCTION ${fixed} FROM app_tenant RESTRICT;`));
 assert.equal((down.match(/GRANT EXECUTE ON FUNCTION/g)||[]).length,1);assert(down.includes(`GRANT EXECUTE ON FUNCTION ${fixed} TO app_tenant;`));
 assert(!/GRANT EXECUTE ON FUNCTION/.test(up));assert(!/REVOKE EXECUTE ON FUNCTION/.test(down));
 for(const sql of [up,down]){assert.equal((sql.match(/^BEGIN;$/gm)||[]).length,1);assert.equal((sql.match(/^COMMIT;$/gm)||[]).length,1);assert(!/CREATE\s+(?:OR\s+REPLACE\s+)?(?:FUNCTION|ROLE|TABLE|POLICY)|ALTER\s+(?:ROLE|POLICY|DEFAULT\s+PRIVILEGES)|ON\s+ALL\s+FUNCTIONS|UPDATE\s+pg_catalog|CASCADE/i.test(sql));}
 const normalize=sql=>sql.replace(/^--.*\n/gm,'').replace(/wanted constant boolean := (?:true|false)/,'wanted constant boolean := VALUE').replace(/(?:REVOKE EXECUTE ON FUNCTION[^;]+|GRANT EXECUTE ON FUNCTION[^;]+);/,'ACL_COMMAND;');assert.equal(normalize(up),normalize(down));
});

test('both directions pin definition/context/ordinary dependency and exact ACL shared-dependency conservation',()=>{
 for(const sql of [up,down])for(const witness of ["session_user<>current_user","session_replication_role')<>'origin'",'pg_catalog.pg_auth_members,pg_catalog.pg_authid',"LETBUYY_NATIVE_CATALOG_LOCKS_REQUIRED",'56a6b7b15e8a7ec159341fe0331ac593','proargdefaults','proargtypes','proallargtypes','proargmodes','proconfig','proowner','prosecdef','proisstrict','prosupport','protrftypes','old_comment IS NOT NULL','old_dependencies IS DISTINCT FROM expected_dependencies','unknown grantor, ACL or effective privileges','refuses inherited tenant EXECUTE','old_tenant_dependencies<>CASE WHEN tenant_direct THEN 1 ELSE 0 END',"(to_jsonb(old_row)-'proacl') IS DISTINCT FROM (to_jsonb(new_row)-'proacl')",'new_tenant_dependencies<>CASE WHEN wanted THEN 1 ELSE 0 END','old_acl_without_tenant IS DISTINCT FROM new_acl_without_tenant','old_dependencies IS DISTINCT FROM new_dependencies'])assert(sql.includes(witness),witness);
});

test('native obligations include real route publish/rollback, positive-first42501, raw profiles, atomic refusals and final re-UP',()=>{
 for(const witness of ['entry-full-profile-before-assertions','before-phase','pre-up-full-profile','post-up-full-profile','up-replay-full-profile','ACL393 own-row positive control failed','VERBOSITY verbose','/42501/','/permission denied for function publish_theme_release/','/editor/draft','/publish','/rollback','expected_current_release_id','privatePreserved:true','casAndRetry:true','ACL393_MUTANT_PROFILE','profileBeforeAssertions:captured','assert.deepEqual(snapshot(),before)','after-down-full-profile-unsafe-negative-control','down-replay-full-profile','final-reup-full-profile','No app_tenant publisher or updater invocation','rootInputBindingsExact:true'])assert(source.includes(witness),witness);
 assert(source.includes('new Gateway(gatewayEnv(owned,await newIdentityKeys()))'));assert(!source.includes('new Hono'));
});

// Evaluate only the pure pre-owned admission prefix using in-memory fake grant bytes.
const prefix=source.slice(source.indexOf('const root='),source.indexOf('const inputs=admittedInputs();'));
assert(!/requireOwnedDatabase|new Gateway|owned\./.test(prefix));
const js=ts.transpileModule(prefix.replace("new URL('../../../../../',import.meta.url)",`new URL(${JSON.stringify(root.href)})`)+'\nreturn admittedInputs();',{compilerOptions:{module:ts.ModuleKind.None,target:ts.ScriptTarget.ES2022}}).outputText;
const evaluate=new Function('assert','readFileSync','readdirSync','createHash','z',js),{z}=createRequire(new URL('services/api-gateway/package.json',root))('zod');
const closure=read(folder+'source-input-closure.json');
const simulated={status:'ROOT_PUBLISHER_ACL393_NATIVE_SOURCE_ADMITTED_ONE_FRESH_DEFAULT_LATEST392',suitePath,suiteSha256:sha(source),allocationPath:manifest.allocation.path,allocationSha256:manifest.allocation.sha256,manifestPath:folder+'manifest.json',manifestSha256:sha(read(folder+'manifest.json')),inputClosurePath:folder+'source-input-closure.json',inputClosureSha256:sha(closure),sourceMigrationMaximum:392,sourceMigrationCount:321,migrationCeiling:null,candidateMigration:393,candidateOutsideMigrationScan:true,nativeLease:'GRANTED_ONE_FRESH_DEFAULT_LATEST392_JOBS1_NO_REAP_PREPARED2_600S'};
const actualPath=fileURLToPath(new URL(folder+'admission.json',root));
function check({grant=simulated,mutateRead,mutateDirectory}={}){const safeRead=(p,encoding)=>{const name=fileURLToPath(p);if(name===actualPath){if(grant===null)throw Object.assign(new Error('Missing actual native admission'),{code:'ENOENT'});return JSON.stringify(grant);}const value=readFileSync(p,encoding);return mutateRead?mutateRead(name,value):value;};const safeDirectory=p=>{const value=readdirSync(p);return mutateDirectory?mutateDirectory(fileURLToPath(p),value):value;};return evaluate(assert,safeRead,safeDirectory,createHash,z);}

test('pure admission prefix accepts only current exact source via an in-memory simulated grant',()=>{const r=check();assert.equal(r.sourceCount,JSON.parse(closure).files.length);assert.equal(r.up,up);assert.equal(r.down,down);assert.equal(r.grant.suiteSha256,sha(source));});
test('missing/pending/wrong source/manifest/allocation/closure admissions fail before any owned code',()=>{assert.throws(()=>check({grant:null}),/Missing actual native admission/);assert.throws(()=>check({grant:{...simulated,status:'PENDING'}}),{name:'ZodError'});for(const key of ['suiteSha256','manifestSha256','allocationSha256','inputClosureSha256'])assert.throws(()=>check({grant:{...simulated,[key]:'0'.repeat(64)}}),{code:'ERR_ASSERTION'});});
test('candidate/dependency tampering and newly emitted393/394 fail the pure boundary',()=>{for(const path of ['393_publisher_tenant_execute.up.candidate.sql','393_publisher_tenant_execute.down.candidate.sql','services/api-gateway/src/lib/tenant-transaction.ts'])assert.throws(()=>check({mutateRead:(name,value)=>name.endsWith('/'+path)?value+'\n-- tampered':value}),{code:'ERR_ASSERTION'});for(const kind of ['migrations','rollback'])for(const number of [393,394])assert.throws(()=>check({mutateDirectory:(name,names)=>name.endsWith('/'+kind+'/')?[...names,`${number}_unexpected.sql`]:names}),{code:'ERR_ASSERTION'});});
test('Root allocation and observed baseline data remain exact; old catalog history is unchanged',()=>{assert.equal(sha(read(manifest.diagnostic.path)),manifest.diagnostic.sha256);const diagnostic=JSON.parse(read(manifest.diagnostic.path));assert.equal(diagnostic.fixture.runId,'936e5f577646');assert.equal(diagnostic.publisher.bodyMd5,manifest.bodyMd5);assert.equal(diagnostic.publisher.appTenantInheritsServiceRole,false);assert.equal(diagnostic.publisher.effectiveExecute.app_tenant,true);for(const f of manifest.historicalCatalogFive)assert.equal(sha(read(f.path)),f.sha256);assert.equal(sha(read(manifest.frozenPriorNative.path)),manifest.frozenPriorNative.sha256);});

// Extract and compile the actual parser declaration only; the owned native module is never imported.
const parserNodes=nodes(n=>ts.isFunctionDeclaration(n)&&n.name?.text==='parseOwnRowCount');assert.equal(parserNodes.length,1);
const parserJs=ts.transpileModule(parserNodes[0].getText(ast),{compilerOptions:{module:ts.ModuleKind.None,target:ts.ScriptTarget.ES2022}}).outputText;
const parseCount=new Function('assert',parserJs+'\nreturn parseOwnRowCount;')(assert);
const tagged=count=>'BEGIN\nSET\nsynthetic-site-id\n'+JSON.stringify({marker:'ACL393_OWN_ROW_COUNT',count})+'\nROLLBACK\n';
test('actual own-row parser reads typed positive1 between transaction command tags',()=>{assert.equal(parseCount(tagged(1)),1);assert.equal(parseCount('BEGIN\r\nSET\r\n  {"marker":"ACL393_OWN_ROW_COUNT","count":1}  \r\nROLLBACK\r\n'),1);assert(source.includes("SELECT jsonb_build_object('marker','ACL393_OWN_ROW_COUNT','count',(SELECT count(*) FROM sites WHERE id="));assert(!source.includes(".split('\\n').at(-1),'1'"));});
test('actual own-row parser rejects zero and untyped/noninteger counts',()=>{for(const count of [0,'1',null,1.5,2])assert.throws(()=>parseCount(tagged(count)));});
test('actual own-row parser rejects missing malformed and duplicate markers',()=>{for(const output of ['BEGIN\nSET\n1\nROLLBACK\n','{"count":1}\n','{"marker":"ACL393_OWN_ROW_COUNT","count":1\nROLLBACK\n',tagged(1)+tagged(1)])assert.throws(()=>parseCount(output));});
test('closed native01 admission cannot qualify the repaired source',()=>{const closed=JSON.parse(read(folder+'native-runs/01/admission.json.before.snapshot'));assert.equal(closed.suiteSha256,'24d1b0cc9e8b0ce76aa6a14adc9466420f52b1069a9ae0b3b885dbab1312a58a');assert.notEqual(closed.suiteSha256,sha(source));assert.throws(()=>check({grant:closed}),{code:'ERR_ASSERTION'});});
