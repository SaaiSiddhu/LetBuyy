+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { readFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import path from 'node:path'
+import type ReactTypes from 'react'
+import type CenterPanelComponent from './CenterPanel'
+import type { EditorPreviewContext } from '@letbuyy/theme-engine/editor-bridge-protocol'
+
+// A private two-file preparation has no dependency tree. Pass the read-only
+// repository as argv[2]; after integration the normal relative root is used.
+const testDirectory = path.dirname(path.resolve(process.argv[1]))
+const sourceRoot = process.argv[2] || path.resolve(testDirectory, '../../../../../..')
+const requireApp = createRequire(path.join(sourceRoot, 'apps/merchant/web/package.json'))
+const requireUI = createRequire(path.join(sourceRoot, 'packages/typescript/ui/package.json'))
+const React = requireApp('react') as typeof import('react')
+const { act } = React
+const { createRoot } = requireApp('react-dom/client') as typeof import('react-dom/client')
+const ts = requireApp('typescript') as typeof import('typescript')
+const protocol = requireApp('@letbuyy/theme-engine/editor-bridge-protocol') as typeof import('@letbuyy/theme-engine/editor-bridge-protocol')
+type Dom = { window: Window & typeof globalThis & { close(): void } }
+const domLibrary = requireUI('jsdom') as {
+    JSDOM: new (html: string, options: { url: string }) => Dom
+}
+
+// Compile the complete allocated component, then mount its real React tree.
+// All component/UI/protocol dependencies are the existing read-only modules.
+// Only URL configuration is synthetic; no actual environment or token is read.
+function loadComponent() {
+    const filename = process.argv[3] || path.join(testDirectory, 'CenterPanel.tsx')
+    const code = ts.transpileModule(readFileSync(filename, 'utf8'), {
+        compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS, jsx: ts.JsxEmit.ReactJSX, esModuleInterop: true },
+        fileName: filename,
+    }).outputText
+    const compiled: { exports: { default?: typeof CenterPanelComponent } } = { exports: {} }
+    const dependencies = (name: string): unknown => {
+        if (name === '@/lib/public-urls') return {
+            getEditorPreviewBaseUrl: () => 'https://storefront.example.invalid',
+            getStorefrontRootDomain: () => 'example.invalid',
+        }
+        if (name.startsWith('./')) return requireApp(path.join(sourceRoot, 'apps/merchant/web/src/components/theme-editor', name))
+        return requireApp(name)
+    }
+    new Function('require', 'module', 'exports', code)(dependencies, compiled, compiled.exports)
+    assert.ok(compiled.exports.default)
+    return compiled.exports.default
+}
+const CenterPanel = loadComponent()
+type Props = ReactTypes.ComponentProps<typeof CenterPanelComponent>
+type SentMessage = { data: Record<string, unknown>; origin: string }
+const origin = 'https://storefront.example.invalid'
+const context: EditorPreviewContext = { sessionId: '33333333-3333-4333-8333-333333333333', revision: 4, templateKey: 'index' }
+const identities = protocol.createEditorPreviewIdentityIndex([{ id: 'hero', type: 'Hero', blocks: [{ id: 'parent', children: [{ id: 'child' }] }] }])
+
+async function mount() {
+    // jsdom's default disables every subresource, including iframe navigation.
+    // Load/READY boundaries below are deliberate controlled DOM events.
+    const dom = new domLibrary.JSDOM('<!doctype html><div id="root"></div>', { url: 'https://admin.example.invalid/editor' })
+    const values: Record<string, unknown> = {
+        window: dom.window, document: dom.window.document, navigator: dom.window.navigator,
+        HTMLElement: dom.window.HTMLElement, Element: dom.window.Element,
+        IS_REACT_ACT_ENVIRONMENT: true,
+        fetch: () => Promise.reject(new Error('Network is forbidden in this mounted test')),
+        ResizeObserver: class {
+            constructor(private callback: () => void) {}
+            observe() { this.callback() }
+            disconnect() {}
+        },
+    }
+    const previous = new Map(Object.keys(values).map(key => [key, Object.getOwnPropertyDescriptor(globalThis, key)]))
+    for (const [key, value] of Object.entries(values)) Object.defineProperty(globalThis, key, { value, configurable: true, writable: true })
+    Object.defineProperty(dom.window.HTMLElement.prototype, 'clientWidth', { configurable: true, get: () => 960 })
+    Object.defineProperty(dom.window.HTMLElement.prototype, 'clientHeight', { configurable: true, get: () => 800 })
+    const timers = new Map<number, () => void>(), cleared: number[] = []
+    let timerId = 100000, createdTimers = 0, retries = 0
+    const originalSet = dom.window.setTimeout.bind(dom.window), originalClear = dom.window.clearTimeout.bind(dom.window)
+    dom.window.setTimeout = ((callback: TimerHandler, delay?: number, ...args: unknown[]) => {
+        if (delay === 20000) {
+            assert.equal(typeof callback, 'function')
+            const id = ++timerId
+            timers.set(id, callback as () => void); createdTimers++
+            return id
+        }
+        return originalSet(callback, delay, ...args)
+    }) as typeof dom.window.setTimeout
+    dom.window.clearTimeout = ((id?: number) => {
+        if (id !== undefined && timers.delete(id)) cleared.push(id)
+        else originalClear(id)
+    }) as typeof dom.window.clearTimeout
+    const calls = { blocks: [] as string[][], sections: [] as string[], add: [] as string[][] }
+    let props: Props = {
+        storeName: 'synthetic-editor', viewport: 'desktop', previewToken: 'synthetic-preview-token',
+        previewError: null, isPreviewRefreshing: false, selectedSectionId: 'hero', selectedBlockId: 'child',
+        previewContext: context, identities, onRetryPreview: () => { retries++ },
+        onSelectSection: id => calls.sections.push(id), onSelectBlock: (...ids) => calls.blocks.push(ids),
+        onAddSectionIntent: (...args) => calls.add.push(args),
+    }
+    const container = dom.window.document.getElementById('root')!
+    const root = createRoot(container)
+    const render = async (changes: Partial<Props> = {}) => {
+        props = { ...props, ...changes }
+        await act(async () => root.render(React.createElement(CenterPanel, props)))
+    }
+    const frame = () => {
+        const element = container.querySelector('iframe')
+        assert.ok(element); assert.ok(element.contentWindow)
+        return element
+    }
+    const sent = new Map<HTMLIFrameElement, SentMessage[]>()
+    const messages = () => {
+        const element = frame()
+        if (!sent.has(element)) {
+            const log: SentMessage[] = []
+            sent.set(element, log)
+            Object.defineProperty(element.contentWindow, 'postMessage', { configurable: true,
+                value: (data: Record<string, unknown>, target: string) => log.push({ data, origin: target }) })
+        }
+        return sent.get(element)!
+    }
+    const send = async (data: Record<string, unknown>, changes: { origin?: string; source?: Window | null } = {}) => {
+        messages()
+        await act(async () => dom.window.dispatchEvent(new dom.window.MessageEvent('message', {
+            origin, source: frame().contentWindow, data: { context: props.previewContext, ...data }, ...changes,
+        })))
+    }
+    const load = async () => {
+        messages()
+        await act(async () => frame().dispatchEvent(new dom.window.Event('load')))
+    }
+    const ready = () => send({ type: protocol.EDITOR_READY_MESSAGE })
+    const click = async (label: string) => {
+        const button = [...container.querySelectorAll('button')].find(element => element.getAttribute('aria-label') === label || element.textContent?.trim() === label)
+        assert.ok(button, label)
+        await act(async () => button.click())
+    }
+    const timeout = async () => {
+        const callback = [...timers.values()].at(-1)
+        assert.ok(callback)
+        await act(async () => callback())
+    }
+    let closed = false
+    const close = async () => {
+        if (closed) return
+        closed = true
+        await act(async () => root.unmount())
+        dom.window.close()
+        for (const [key, descriptor] of previous) {
+            if (descriptor) Object.defineProperty(globalThis, key, descriptor)
+            else Reflect.deleteProperty(globalThis, key)
+        }
+    }
+    try { await render() } catch (error) { await close(); throw error }
+    return { dom, container, render, frame, messages, send, load, ready, click, timeout, close, calls, timers, cleared,
+        get createdTimers() { return createdTimers }, get retries() { return retries } }
+}
+
+test('mounted device changes keep one iframe/src and send exact viewport messages with inspection off', async () => {
+    const h = await mount()
+    try {
+        const first = h.frame(), src = first.src
+        const messages = h.messages()
+        await h.ready()
+        await h.click('Inspect preview')
+        assert.equal(h.container.querySelector('[aria-label="Inspect preview"]')?.getAttribute('aria-pressed'), 'false')
+        messages.length = 0
+        for (const viewport of ['tablet', 'mobile', 'desktop'] as const) {
+            await h.render({ viewport })
+            assert.equal(h.frame() === first, true, 'Device-only change must retain the actual iframe node')
+            assert.equal(h.frame().src, src)
+            const posted = messages.filter(message => message.data.type === protocol.EDITOR_VIEWPORT_MESSAGE).at(-1)
+            assert.ok(posted)
+            assert.equal(posted.data.viewport, viewport)
+            assert.deepEqual(posted.data.context, context)
+            assert.equal(posted.origin, origin)
+            assert.equal(messages.some(message => message.data.type === protocol.EDITOR_SELECTION_MESSAGE), false)
+        }
+        assert.equal(h.createdTimers, 1, 'Device changes do not restart navigation readiness')
+        await h.timeout()
+        assert.equal(h.container.querySelector('[role="alert"]'), null, 'Verified readiness survives device changes')
+    } finally { await h.close() }
+})
+
+test('mounted unloaded frame gets no message; load and verified READY reapply the latest device', async () => {
+    const h = await mount()
+    try {
+        const first = h.frame(), messages = h.messages()
+        await h.render({ viewport: 'mobile' })
+        assert.equal(h.frame() === first, true, 'Unloaded device change must retain the actual iframe node')
+        assert.equal(messages.length, 0)
+        await h.load()
+        assert.equal(messages.filter(message => message.data.type === protocol.EDITOR_VIEWPORT_MESSAGE).at(-1)?.data.viewport, 'mobile')
+        messages.length = 0
+        await h.ready()
+        assert.equal(messages.filter(message => message.data.type === protocol.EDITOR_VIEWPORT_MESSAGE).at(-1)?.data.viewport, 'mobile')
+    } finally { await h.close() }
+})
+
+test('mounted token, template, resource and page navigation still remount and require fresh READY', async () => {
+    const h = await mount()
+    try {
+        await h.ready()
+        const changes: Partial<Props>[] = [
+            { previewToken: 'synthetic-replacement-token' },
+            { previewContext: { ...context, templateKey: 'product' } },
+            { previewContext: { ...context, templateKey: 'product', resourceId: 'owned-product' } },
+            { previewContext: { ...context, templateKey: 'blog', page: 1 } },
+            { previewContext: { ...context, templateKey: 'blog', page: 2 } },
+        ]
+        for (const change of changes) {
+            const previous = h.frame()
+            await h.render(change)
+            assert.equal(h.frame() === previous, false, 'Document navigation must replace the actual iframe node')
+            assert.equal(h.messages().length, 0)
+            await h.send({ type: protocol.EDITOR_READY_MESSAGE }, { source: previous.contentWindow })
+            await h.timeout()
+            assert.match(h.container.textContent || '', /could not finish loading/)
+            await h.ready()
+            assert.equal(h.container.querySelector('[role="alert"]'), null)
+        }
+        assert.equal(h.createdTimers, 6)
+        assert.equal(h.cleared.length, 5)
+    } finally { await h.close() }
+})
+
+test('mounted selection accepts its positive control and rejects foreign/stale/forged messages', async () => {
+    const h = await mount()
+    try {
+        const selection = { type: protocol.EDITOR_SECTION_SELECT_MESSAGE, sectionId: 'hero', blockId: 'child', blockPath: ['parent', 'child'] }
+        await h.send(selection)
+        assert.deepEqual(h.calls.blocks, [['hero', 'child']])
+        await h.send(selection, { origin: 'https://foreign.example.invalid' })
+        await h.send(selection, { source: h.dom.window })
+        for (const change of [{ revision: 3 }, { templateKey: 'product' }, { sessionId: '44444444-4444-4444-8444-444444444444' }, { resourceId: 'another-product' }, { page: 2 }]) {
+            await h.send({ ...selection, context: { ...context, ...change } })
+        }
+        await h.send({ ...selection, context: null })
+        await h.send({ ...selection, blockPath: ['child'] })
+        await h.send({ ...selection, sectionId: 'constructor' })
+        await h.send({ ...selection, blockId: 'unknown' })
+        assert.deepEqual(h.calls.blocks, [['hero', 'child']])
+        assert.deepEqual(h.calls.sections, [])
+    } finally { await h.close() }
+})
+
+test('mounted readiness rejects foreign/stale signals and incoming invalid viewport messages, then retries normally', async () => {
+    const h = await mount()
+    try {
+        await h.send({ type: protocol.EDITOR_READY_MESSAGE }, { origin: 'https://foreign.example.invalid' })
+        await h.send({ type: protocol.EDITOR_READY_MESSAGE }, { source: h.dom.window })
+        await h.send({ type: protocol.EDITOR_READY_MESSAGE, context: { ...context, revision: 3 } })
+        await h.send({ type: protocol.EDITOR_VIEWPORT_MESSAGE, viewport: 'invalid' })
+        assert.equal(h.messages().length, 0)
+        await h.timeout()
+        assert.match(h.container.textContent || '', /could not finish loading/)
+        await h.click('Retry preview')
+        assert.equal(h.retries, 1)
+        const previous = h.frame()
+        await h.render({ previewToken: 'synthetic-retry-token', previewContext: { ...context, sessionId: '44444444-4444-4444-8444-444444444444' } })
+        assert.equal(h.frame() === previous, false, 'Retry token must replace the actual iframe node')
+        assert.equal(h.container.querySelector('[role="alert"]'), null)
+        await h.ready()
+        await h.timeout()
+        assert.equal(h.container.querySelector('[role="alert"]'), null)
+    } finally { await h.close() }
+})
+
+test('mounted navigation timeout is cancelled on unmount', async () => {
+    const h = await mount()
+    assert.equal(h.timers.size, 1)
+    await h.close()
+    assert.equal(h.timers.size, 0)
+    assert.equal(h.cleared.length, 1)
+})
