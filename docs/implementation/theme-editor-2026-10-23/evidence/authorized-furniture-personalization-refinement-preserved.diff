+test('Habitat and MadeYours owner refinements stay on their same existing recipe keys', () => {
+  const prepared = themeEditorFixtureProductCommands(editorData);
+  assert.equal(prepared.length, 14);
+  const furniture = prepared.find(row => row.key === 'furniture')!.command;
+  assert.deepEqual(furniture.product_options.map(row => row.name), ['Width','Finish']);
+  assert.deepEqual(furniture.variants.map(row => [row.options.Width, row.options.Finish, row.stock]),
+    [['48 in','Natural',4],['130 cm','Black',3],['Common size','Natural',0],['48 in width only','Natural',2]]);
+  assert.deepEqual(furniture.variants[3].metadata?.furniture?.assembled, {unit:'in',width:48});
+  const personalized = prepared.find(row => row.key === 'personalization')!.command;
+  const facts = personalized.metadata.personalization as {methods:Array<{id:string;styles:unknown[];placements:unknown[]}>};
+  assert.deepEqual(facts.methods.map(row => row.id), ['engrave','print']);
+  assert.ok(facts.methods.every(row => row.styles.length === 2 && row.placements.length === 2));
+  assert.deepEqual(personalized.variants.map(row => [row.options.Cover,row.stock]), [['Moss',4],['Oat',4],['Slate unavailable',0]]);
+});
