          "text": "): { html: string; headStyleText: string } {"
        },
        {
          "line": 19,
          "text": "    // Full-Liquid page: header + body + footer are ALL rendered by the Liquid engine (each fragment is"
        },
        {
          "line": 20,
          "text": "    // sanitized per-section in theme-renderer.ts), so nothing in the storefront chrome is React."
        },
        {
          "line": 21,
          "text": "    // layout.tsx drops its React header/footer when rendererEngine === 'liquid'. We concatenate the"
        },
        {
          "line": 22,
          "text": "    // sanitized fragments (not the full <!doctype> layout document, which can't nest inside a <div>)."
        },
        {
          "line": 23,
          "text": "    //"
        },
        {
          "line": 24,
          "text": "    // The theme's own :root token block + base stylesheet (headStyleText) is NOT part of that"
        },
        {
          "line": 25,
          "text": "    // concatenation: it belongs in <head>, and a nested layout/page component cannot render"
        },
        {
          "line": 26,
          "text": "    // <html>/<head> directly. headStyleText is already sanitized (theme-renderer.ts's"
        },
        {
          "line": 27,
          "text": "    // sanitizeLiquidHeadStyleText, the same allowHeadMetadata DOMPurify pass layoutHtml's own"
        },
        {
          "line": 28,
          "text": "    // wholeDocument sanitization uses) plain CSS TEXT \u2014 the caller renders it as a real <style>"
        },
        {
          "line": 29,
          "text": "    // element anywhere in the tree; Next.js/React hoist <style> elements into <head> regardless of"
        },
        {
          "line": 30,
          "text": "    // nesting depth, so this reaches the document head without emitting a nested document."
        },
        {
          "line": 31,
          "text": "    const { header, contentForLayout, footer, headStyleText } = liquid;"
        },
        {
          "line": 32,
          "text": "    return { html: `${header || ''}${controls.beforeContentHtml || ''}${contentForLayout}${controls.afterContentHtml || ''}${footer || ''}`, headStyleText: headStyleText || '' };"
        }
