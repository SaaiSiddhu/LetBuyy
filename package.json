{
  "name": "letbuyy-store",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev/setup-local-env.mjs && turbo run dev --concurrency=25 --filter=./apps/* --filter=@letbuyy/ui",
    "dev:all": "node scripts/dev/setup-local-env.mjs && turbo run dev --concurrency=25",
    "dev:apps": "node scripts/dev/setup-local-env.mjs && turbo run dev --concurrency=25 --filter=./apps/*",
    "dev:services": "node scripts/dev/setup-local-env.mjs && turbo run dev --concurrency=25 --filter=./services/*",
    "dev:storybook": "turbo run dev --filter=@letbuyy/ui",
    "dev:setup": "node scripts/dev/setup-local-env.mjs --force",
    "build": "turbo build --filter=!@letbuyy/app-marketplace --filter=!@letbuyy/theme-marketplace --filter=!@letbuyy/developer-portal --filter=!@letbuyy/platform-operations-portal",
    "lint": "turbo lint --filter=!@letbuyy/app-marketplace --filter=!@letbuyy/theme-marketplace --filter=!@letbuyy/developer-portal --filter=!@letbuyy/platform-operations-portal",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:governance": "node scripts/validate-governance.mjs --lane=gate",
    "validate:governance:gate": "node scripts/validate-governance.mjs --lane=gate",
    "validate:governance:report": "node scripts/validate-governance.mjs --lane=report",
    "validate:anti-fabrication": "node scripts/validators/foundation-antifabrication-gate.mjs",
    "validate:tenant-isolation": "node scripts/validators/tenant-isolation-validator.mjs",
    "validate:production-safety": "node scripts/validators/production-safety-validator.mjs",
    "validate:session-security": "node scripts/validators/session-security-validator.mjs",
    "validate:design-system": "node scripts/validators/validate-design-system.mjs",
    "validate:theme-governance": "node scripts/validators/theme-governance-validator.mjs",
    "validate:beta-readiness": "node scripts/validators/beta-readiness-validator.mjs",
    "validate:design-system:update": "node scripts/validators/validate-design-system.mjs --update",
    "validate:mobile-tokens": "node scripts/generators/generate-mobile-tokens.mjs --check",
    "validate:design-tokens": "node scripts/generators/generate-design-tokens.mjs --check",
    "lint:css": "stylelint \"apps/**/src/**/*.css\" \"packages/**/src/**/*.css\"",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "validate:workspace": "node scripts/validators/workspace-lifecycle-validator.mjs",
    "validate:lifecycle": "node scripts/validators/operational-lifecycle-validator.mjs",
    "validate:production": "node infrastructure/scripts/operations/phase4-ultimate-validate.mjs --environment=production",
    "validate:cloudflare": "node scripts/validators/cloudflare-topology-validator.mjs && node scripts/validators/wrangler-env-validator.mjs && node scripts/validators/cloudflare-binding-validator.mjs && node scripts/validators/durable-object-validator.mjs && node scripts/validators/d1-governance-validator.mjs && node scripts/validators/queue-topology-validator.mjs && node scripts/validators/provider-evidence-validator.mjs --environment=production",
    "cloudflare:bootstrap:staging": "node infrastructure/scripts/cloudflare/bootstrap-staging.mjs",
    "cloudflare:bootstrap:production": "node infrastructure/scripts/cloudflare/bootstrap-production.mjs",
    "cloudflare:provider:capabilities": "node infrastructure/scripts/cloudflare/provider-capability-validator.mjs",
    "validate:dependencies": "node scripts/validators/dependency-manifest-validator.mjs && node scripts/validators/undeclared-import-validator.mjs && node scripts/validators/package-export-validator.mjs && node scripts/validators/dependency-graph-validator.mjs && node scripts/validators/circular-import-validator.mjs",
    "validate:dependency-graph": "node scripts/validators/dependency-graph-validator.mjs && node scripts/validators/circular-import-validator.mjs",
    "validate:runtime": "node scripts/validators/runtime-topology-validator.mjs && node scripts/validators/runtime-manifest-validator.mjs && node scripts/validators/runtime-validator.mjs",
    "validate:migrations": "node scripts/validators/migration-safety-validator.mjs",
    "validate:deployment": "node scripts/validators/deployment-safety-validator.mjs && node scripts/validators/deploy-matrix-topology-validator.mjs",
    "validate:rollback": "node scripts/validators/migration-safety-validator.mjs",
    "validate:queues": "node scripts/validators/queue-topology-validator.mjs",
    "validate:topology": "node scripts/validators/runtime-topology-validator.mjs && node scripts/validators/topology-json-antifabrication-validator.mjs && node scripts/validators/deploy-matrix-topology-validator.mjs",
    "validate:reconciliation": "node scripts/validators/single-writer-ownership-validator.mjs && node scripts/validators/source-ledger-residue-validator.mjs",
    "validate:tests": "node scripts/validators/test-coverage-governance-validator.mjs",
    "validate:typescript": "node scripts/validators/typescript-governance-validator.mjs",
    "validate:security": "node scripts/validators/provider-isolation-validator.mjs && node scripts/validators/environment-validator.mjs && node scripts/validators/supply-chain-validator.mjs",
    "validate:observability": "node scripts/validators/production-readiness-validator.mjs",
    "validate:end-state": "node scripts/validators/whole-repo-end-state-validator.mjs",
    "validate:ci": "node scripts/validators/ci-simulation-validator.mjs",
    "certify:production": "node infrastructure/scripts/operations/phase4-live-certify.mjs --environment=production --mode=auto",
    "certify:production:plan-report": "node infrastructure/scripts/operations/generate-certification-report.mjs --environment=production --mode=plan",
    "graph:ui": "node tools/graph-server/server.mjs",
    "graph:update": "node tools/graph-server/refresh-graph.mjs",
    "graph:validate": "node tools/graph-server/validate-graph.mjs",
    "graph:stats": "node tools/graph-server/graph-stats.mjs",
    "test": "node --test --test-concurrency=1 tests/*/*.test.mjs && pnpm run test:contracts",
    "test:foundation:wave0": "node --test tests/governance/foundation-wave0.test.mjs && node scripts/governance/foundation-ephemeral-postgres.mjs start && node --test tests/executable/money-ledger-postgres.test.mjs",
    "test:foundation:wave1": "tsx --test packages/payments/test/payments.test.ts packages/billing-core/test/billing-core.test.ts services/api-gateway/src/__tests__/money.test.ts && node scripts/governance/foundation-ephemeral-postgres.mjs start && node --test tests/executable/foundation-wave1-money-postgres.test.mjs",
    "test:foundation:wave2": "tsx --test tests/governance/foundation-wave2-tenant.test.ts && node scripts/governance/foundation-ephemeral-postgres.mjs start && node --test tests/executable/tenant-redteam-postgres.test.mjs && pnpm run validate:tenant-isolation",
    "test:foundation:wave3": "tsx --test tests/governance/foundation-wave3-production-safety.test.ts && pnpm run validate:production-safety",
    "test:foundation:wave4": "node --test tests/auth/session-verifier.test.mjs && tsx --test tests/governance/foundation-wave4-session-security.test.ts && node scripts/governance/foundation-ephemeral-postgres.mjs start && node --test tests/executable/foundation-wave4-session-postgres.test.mjs && pnpm run validate:session-security",
    "test:foundation:wave5": "node --test tests/governance/foundation-wave5-design-governance.test.mjs && pnpm run validate:design-system && pnpm run validate:mobile-tokens",
    "test:foundation:wave6": "pnpm --filter @letbuyy/theme-engine run test && pnpm run validate:theme-governance",
    "test:foundation:wave7": "pnpm --filter @letbuyy/mobile-bff run test && tsx --test services/api-gateway/src/__tests__/checkout.test.ts services/api-gateway/src/__tests__/orders-v1.test.ts services/api-gateway/src/__tests__/whatsapp.test.ts && cd apps/mobile/merchant-app && flutter test test/mobile_services_test.dart --plain-name \"verifies Turnstile with the mobile BFF before password login\" && cd ../../.. && pnpm run validate:beta-readiness",
    "test:governance": "pnpm run test:behavioral && pnpm run test:contracts",
    "test:behavioral": "node --test --test-concurrency=1 tests/*/*.test.mjs",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:unit:gateway": "pnpm --filter @letbuyy/api-gateway run test:unit",
    "test:workspaces": "turbo test",
    "typecheck": "turbo typecheck --filter=!@letbuyy/app-marketplace --filter=!@letbuyy/theme-marketplace --filter=!@letbuyy/developer-portal --filter=!@letbuyy/platform-operations-portal",
    "foundation:pg:start": "node scripts/governance/foundation-ephemeral-postgres.mjs start",
    "foundation:pg:stop": "node scripts/governance/foundation-ephemeral-postgres.mjs stop",
    "foundation:restore-drill:plan": "node scripts/governance/foundation-restore-drill.mjs --plan",
    "money:invariants": "node scripts/money-certification/check-invariants.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260525.1",
    "@playwright/test": "1.60.0",
    "eslint": "9.39.2",
    "stylelint": "17.13.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.20.6",
    "turbo": "2.8.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "defu@<=6.1.4": "6.1.5",
      "fast-uri@<=3.1.1": "3.1.2",
      "flatted@<=3.4.1": "3.4.2",
      "hono@<4.12.4": "4.12.4",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.1": "10.2.5",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "socket.io-parser@>=4.0.0 <4.2.6": "4.2.6",
      "undici@<6.24.0": "6.24.0"
    }
  },
  "packageManager": "pnpm@10.6.2"
}
