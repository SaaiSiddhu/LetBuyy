{
  "name": "@letbuyy/api-gateway",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 9010 --inspector-port 9110",
    "build": "tsc --noEmit",
    "deploy": "node ../../infrastructure/scripts/deploy/deploy-worker-runtime.mjs --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "test:unit": "cd ../.. && tsx --test services/api-gateway/src/__tests__/*.test.ts",
    "test": "pnpm run test:unit && tsx --test ../../tests/contracts/*.test.ts"
  },
  "dependencies": {
    "@letbuyy/api-types": "workspace:*",
    "@letbuyy/audit-core": "workspace:*",
    "@letbuyy/auth-core": "workspace:*",
    "@letbuyy/billing-core": "workspace:*",
    "@letbuyy/checkout-core": "workspace:*",
    "@letbuyy/cms-core": "workspace:*",
    "@letbuyy/commerce-core": "workspace:*",
    "@letbuyy/event-core": "workspace:*",
    "@letbuyy/infrastructure": "workspace:*",
    "@letbuyy/identity-core": "workspace:*",
    "@letbuyy/notification-core": "workspace:*",
    "@letbuyy/organization-core": "workspace:*",
    "@letbuyy/payments": "workspace:*",
    "@letbuyy/permission-core": "workspace:*",
    "@letbuyy/runtime-composition": "workspace:*",
    "@letbuyy/shared-types": "workspace:*",
    "@letbuyy/session-core": "workspace:*",
    "@letbuyy/tenant-core": "workspace:*",
    "@letbuyy/theme-engine": "workspace:*",
    "@letbuyy/token-core": "workspace:*",
    "bcryptjs": "^3.0.3",
    "hash-wasm": "^4.12.0",
    "hono": "^4.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260524.1",
    "tsx": "4.20.6",
    "typescript": "^5.7.0",
    "wrangler": "^4.94.0"
  }
}
