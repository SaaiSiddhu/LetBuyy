{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "hono/cors": [
        "../../node_modules/.pnpm/node_modules/hono/dist/types/middleware/cors/index.d.ts"
      ],
      "hono/factory": [
        "../../node_modules/.pnpm/node_modules/hono/dist/types/helper/factory/index.d.ts"
      ],
      "@letbuyy/api-types": [
        "../../packages/typescript/api-types/src/index.ts"
      ],
      "@letbuyy/audit-core": [
        "../../packages/audit-core/src/index.ts"
      ],
      "@letbuyy/auth-core": [
        "../../packages/auth-core/src/index.ts"
      ],
      "@letbuyy/checkout-core": [
        "../../packages/checkout-core/src/index.ts"
      ],
      "@letbuyy/cms-core": [
        "../../packages/cms-core/src/index.ts"
      ],
      "@letbuyy/commerce-core": [
        "../../packages/commerce-core/src/index.ts"
      ],
      "@letbuyy/event-core": [
        "../../packages/event-core/src/index.ts"
      ],
      "@letbuyy/infrastructure/*": [
        "../../packages/infrastructure/*/index.ts"
      ],
      "@letbuyy/identity-core": [
        "../../packages/identity-core/src/index.ts"
      ],
      "@letbuyy/notification-core": [
        "../../packages/notification-core/src/index.ts"
      ],
      "@letbuyy/organization-core": [
        "../../packages/organization-core/src/index.ts"
      ],
      "@letbuyy/permission-core": [
        "../../packages/permission-core/src/index.ts"
      ],
      "@letbuyy/runtime-composition": [
        "../../packages/runtime-composition/src/index.ts"
      ],
      "@letbuyy/search-core": [
        "../../packages/search-core/src/index.ts"
      ],
      "@letbuyy/billing-core": [
        "../../packages/billing-core/src/index.ts"
      ],
      "@letbuyy/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@letbuyy/session-core": [
        "../../packages/session-core/src/index.ts"
      ],
      "@letbuyy/tenant-core": [
        "../../packages/tenant-core/src/index.ts"
      ],
      "@letbuyy/theme-engine": [
        "../../packages/theme-engine/src/index.ts"
      ],
      "@letbuyy/token-core": [
        "../../packages/token-core/src/index.ts"
      ],
      "*": [
        "../../node_modules/.pnpm/node_modules/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": "../../tsconfig.base.json"
}
