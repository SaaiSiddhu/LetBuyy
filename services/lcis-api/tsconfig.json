{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@letbuyy/lcis-core": ["../../packages/lcis-core/src/index.ts"],
      "@letbuyy/lcis-live": ["../../packages/lcis-live/src/index.ts"],
      "@letbuyy/lcis-adapters": ["../../packages/lcis-adapters/src/index.ts"],
      "@letbuyy/lcis-execution": ["../../packages/lcis-execution/src/index.ts"],
      "@letbuyy/lcis-governance": ["../../packages/lcis-governance/src/index.ts"],
      "@letbuyy/lcis-operations": ["../../packages/lcis-operations/src/index.ts"],
      "@letbuyy/lcis-engineering": ["../../packages/lcis-engineering/src/index.ts"],
      "@letbuyy/lcis-orchestration": ["../../packages/lcis-orchestration/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
