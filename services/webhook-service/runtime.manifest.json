{
  "$schema": "config/runtime/runtime-manifest.schema.json",
  "runtimeName": "Webhook Service",
  "runtimeRoot": "services/webhook-service",
  "actorType": ["service", "external-provider"],
  "runtimeCategory": "cloudflare-worker",
  "runtimeClassification": "backend-webhook-plane",
  "ownership": {
    "sourceAuthority": "services/webhook-service",
    "businessAuthority": "Inbound provider webhook verification, idempotency, and side-effect reconciliation.",
    "governanceDocs": ["docs/governance/runtime-boundaries.md", "docs/governance/observability-governance.md"]
  },
  "allowedDependencies": {
    "workspacePackages": [],
    "runtimeImports": []
  },
  "forbiddenDependencies": ["apps/*", "services/*", "legacy/*", "infrastructure/*", "generated-artifacts"],
  "deploymentAuthority": {
    "platform": "Cloudflare Workers",
    "config": ["services/webhook-service/wrangler.toml"]
  },
  "environmentAuthority": {
    "schema": "config/env/schemas/worker.schema.json",
    "template": "config/env/templates/worker.env.example",
    "secretStore": "Cloudflare Worker secrets"
  },
  "observabilityAuthority": {
    "correlationId": "X-Request-ID",
    "logging": "structured redacted webhook logs",
    "audit": "provider events must record idempotency keys and verification status"
  }
}
