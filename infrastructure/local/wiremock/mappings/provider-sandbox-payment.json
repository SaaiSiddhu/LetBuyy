{
  "request": {
    "method": "POST",
    "urlPathPattern": "/payments/(stripe|razorpay|paypal)/intents"
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "provider": "{{request.pathSegments.[1]}}",
      "mode": "sandbox",
      "status": "requires_confirmation",
      "intent_id": "sandbox_{{randomValue length=12 type='ALPHANUMERIC'}}",
      "production_side_effect": false
    },
    "headers": {
      "Content-Type": "application/json",
      "Idempotency-Replayed": "false"
    }
  }
}
