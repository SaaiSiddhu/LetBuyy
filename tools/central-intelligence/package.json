{
  "name": "@letbuyy/central-intelligence",
  "version": "2.0.0",
  "description": "LCIS V2 — Autonomous Commerce Intelligence Platform for LetBuyy",
  "type": "module",
  "private": true,
  "main": "intelligence-api/server.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node intelligence-api/server.mjs",
    "start:dev": "node --watch intelligence-api/server.mjs",
    "memory:init": "node -e \"import('./memory-engine/MemoryIndexer.mjs').then(m => m.indexAll())\"",
    "memory:health": "node -e \"import('./memory-engine/MemoryHealthMonitor.mjs').then(m => m.checkHealth()).then(r => console.log(JSON.stringify(r, null, 2)))\"",
    "knowledge:crawl": "node knowledge-engine/KnowledgeAcquisitionService.mjs",
    "graph:build": "node graph-engine/GraphBuilder.mjs",
    "graph:query": "node graph-engine/GraphQueryEngine.mjs",
    "browser:validate": "node browser-intelligence/BrowserIntelligenceEngine.mjs",
    "context:build": "node context-intelligence/ContextCompressionPipeline.mjs",
    "context:map": "node -e \"import('./context-intelligence/ContextCompressionPipeline.mjs').then(m => m.buildContextMap())\"",
    "reasoning:run": "node reasoning/ReasoningEngine.mjs",
    "self:model": "node self-model/SelfModelBuilder.mjs",
    "health": "curl -sf http://localhost:3334/intelligence/health | jq",
    "setup": "bash setup.sh",
    "setup:python": "pip3 install -r graph-engine/graphrag/requirements.txt && pip3 install -r knowledge-engine/crawlers/requirements.txt"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.49.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "playwright": "^1.45.0"
  },
  "optionalDependencies": {
    "@microlabs/otel-cf-workers": "^1.0.0"
  }
}
