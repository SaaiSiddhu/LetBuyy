{
  "contractVersion": 1,
  "name": "letbuyy-catastrophic-failure-matrix",
  "evidenceDirectory": "chaos/reports",
  "certification": false,
  "certificationReason": "Chaos execution records requested or measured failure evidence only. Certification requires observed recovery evidence and operations control-plane records.",
  "executeRequires": [
    "LETBUYY_CHAOS_EXECUTION_APPROVED=true",
    "LETBUYY_OPERATIONS_TOKEN",
    "LETBUYY_API_BASE_URL",
    "LETBUYY_SURVIVABILITY_EXECUTION_APPROVED=true for production"
  ],
  "forbidden": [
    "requested chaos marked as passed",
    "recovery claimed without observed recovery evidence",
    "failover claimed without RTO/RPO measurement",
    "production chaos without incident commander approval"
  ],
  "experiments": [
    {
      "id": "queue-outage",
      "type": "queue-outage",
      "blastRadius": "single-runtime",
      "mustObserve": ["queue lag", "dlq growth", "redrive disabled until approval", "recovery event"]
    },
    {
      "id": "db-outage",
      "type": "workflow-recovery",
      "blastRadius": "single-runtime",
      "mustObserve": ["write rejection", "read degradation", "recovery checkpoint", "no replay divergence"]
    },
    {
      "id": "replay-corruption",
      "type": "replay-corruption",
      "blastRadius": "single-runtime",
      "mustObserve": ["corruption rejected", "checksum mismatch alert", "projection rebuild blocked", "deterministic replay after recovery"]
    },
    {
      "id": "provider-outage",
      "type": "provider-outage",
      "blastRadius": "single-provider",
      "mustObserve": ["circuit breaker open", "degraded checkout", "provider recovery event", "no duplicate payment mutation"]
    },
    {
      "id": "worker-crash",
      "type": "workflow-recovery",
      "blastRadius": "single-runtime",
      "mustObserve": ["worker restart", "queue retry", "idempotent handler", "no lost event"]
    },
    {
      "id": "deployment-interruption",
      "type": "workflow-recovery",
      "blastRadius": "single-runtime",
      "mustObserve": ["deployment gate failure", "rollback requested", "traffic restored", "evidence recorded"]
    },
    {
      "id": "cache-outage",
      "type": "cache-failure",
      "blastRadius": "single-runtime",
      "mustObserve": ["cache bypass", "origin protection", "latency alert", "cache recovery"]
    },
    {
      "id": "regional-outage",
      "type": "regional-outage",
      "blastRadius": "single-region",
      "mustObserve": ["regional routing override", "rto measurement", "rpo measurement", "cross-region replay integrity"]
    },
    {
      "id": "network-partition",
      "type": "telemetry-outage",
      "blastRadius": "single-runtime",
      "mustObserve": ["telemetry gap", "retry buffer", "recovery flush", "incident timeline"]
    }
  ]
}
