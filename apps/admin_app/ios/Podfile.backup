# ios/Podfile

# ========================================
# LETBUYY iOS PODFILE
# Platform & Dependencies Configuration
# ========================================

platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Define sources for pods
source 'https://github.com/CocoaPods/Specs.git'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # ========================================
  # FLUTTER DEPENDENCIES
  # ========================================
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # ========================================
  # FIREBASE PODS
  # ========================================
  pod 'Firebase/Core'
  pod 'Firebase/Auth'
  pod 'Firebase/Firestore'
  pod 'Firebase/Storage'
  pod 'Firebase/Messaging'
  pod 'Firebase/Functions'
  pod 'Firebase/Analytics'
  pod 'Firebase/Crashlytics'
  pod 'Firebase/RemoteConfig'

  # ========================================
  # GOOGLE SERVICES
  # ========================================
  pod 'GoogleMaps'
  pod 'GoogleSignIn'
  pod 'GoogleUtilities'
  
  # ✅ ML Kit for Text Recognition & Face Detection
  pod 'GoogleMLKit/TextRecognition'
  pod 'GoogleMLKit/FaceDetection'

  # ========================================
  # PAYMENT & THIRD-PARTY
  # ========================================

  # ========================================
  # NETWORKING & PARSING
  # ========================================
  pod 'Alamofire'

  # ========================================
  # RUNNER TEST TARGET
  # ========================================
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# ========================================
# POST-INSTALL CONFIGURATION
# ========================================
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # ========================================
    # BUILD SETTINGS OPTIMIZATION
    # ========================================
    target.build_configurations.each do |config|
      # ✅ Camera & ML Kit Permissions
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
      ]
      
      # Disable Bitcode (required for some pods)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Optimization level for performance
      if config.name == 'Release'
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '-Ofast'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Owholemodule'
      end
      
      # Minimum iOS version
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
      
      # Build active architecture only (speeds up build time)
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES' if config.name == 'Debug'
      
      # Code signing identity
      config.build_settings['CODE_SIGN_STYLE'] = 'Automatic'
      
      # Suppress warnings
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      
      # Enable module stability
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      
      # ✅ Exclude arm64 for simulator (fixes M1/M2 Mac issues)
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # ========================================
  # POD SIGNING & SECURITY
  # ========================================
  post_install_pods_patch = File.join(File.dirname(__FILE__), 'post_install_patch.rb')
  if File.exist?(post_install_pods_patch)
    load(post_install_pods_patch)
  end
end
