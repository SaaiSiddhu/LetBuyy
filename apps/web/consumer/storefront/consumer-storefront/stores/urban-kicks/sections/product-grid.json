{
    "name": "Product Grid",
    "type": "productGrid",
    "description": "Responsive product grid with hover animations and quick-add-to-cart",
    "defaults": {
        "title": "Trending Drops",
        "subtitle": "Hottest picks this season",
        "columns": 4,
        "columnsTablet": 3,
        "columnsMobile": 2,
        "rows": 2,
        "showTitle": true,
        "showPrice": true,
        "showRating": true,
        "showAddToCart": true,
        "cardStyle": "minimal",
        "sortBy": "newest"
    },
    "presets": [
        {
            "name": "4-Column Grid",
            "settings": {
                "title": "Trending Drops",
                "subtitle": "Hottest picks this season",
                "columns": 4,
                "showPrice": true,
                "showRating": true,
                "showAddToCart": true,
                "cardStyle": "minimal"
            }
        },
        {
            "name": "3-Column Featured",
            "settings": {
                "title": "Featured Collection",
                "subtitle": "Hand-picked for you",
                "columns": 3,
                "showPrice": true,
                "showRating": false,
                "showAddToCart": true,
                "cardStyle": "detailed"
            }
        },
        {
            "name": "2-Column Showcase",
            "settings": {
                "title": "New Arrivals",
                "subtitle": "Just dropped",
                "columns": 2,
                "showPrice": true,
                "showRating": true,
                "showAddToCart": false,
                "cardStyle": "standard"
            }
        }
    ],
    "settings_schema": {
        "title": {
            "type": "text",
            "label": "Section Title",
            "maxLength": 80
        },
        "subtitle": {
            "type": "text",
            "label": "Subtitle",
            "maxLength": 120
        },
        "columns": {
            "type": "range",
            "label": "Columns",
            "min": 2,
            "max": 5,
            "step": 1
        },
        "rows": {
            "type": "range",
            "label": "Rows",
            "min": 1,
            "max": 4,
            "step": 1
        },
        "showPrice": {
            "type": "toggle",
            "label": "Show Price"
        },
        "showRating": {
            "type": "toggle",
            "label": "Show Rating"
        },
        "showAddToCart": {
            "type": "toggle",
            "label": "Show Add to Cart"
        },
        "cardStyle": {
            "type": "select",
            "label": "Card Style",
            "options": [
                "standard",
                "minimal",
                "detailed"
            ]
        },
        "sortBy": {
            "type": "select",
            "label": "Sort By",
            "options": [
                "newest",
                "price_low",
                "price_high",
                "popular"
            ]
        }
    }
}