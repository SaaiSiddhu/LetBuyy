{
    "name": "Testimonials",
    "type": "testimonials",
    "description": "Customer testimonial carousel with star ratings",
    "defaults": {
        "title": "What Our Customers Say",
        "subtitle": "Real reviews from real sneakerheads",
        "layout": "carousel",
        "autoplay": true,
        "showRating": true,
        "showImage": false
    },
    "presets": [
        {
            "name": "Carousel",
            "settings": {
                "title": "What Our Customers Say",
                "layout": "carousel",
                "autoplay": true,
                "showRating": true
            }
        },
        {
            "name": "Grid",
            "settings": {
                "title": "Customer Reviews",
                "layout": "grid",
                "autoplay": false,
                "showRating": true
            }
        }
    ],
    "sample_blocks": [
        {
            "type": "testimonialCard",
            "settings": {
                "name": "Priya S.",
                "text": "Amazing quality! Best sneakers I've ever owned. The packaging was premium too.",
                "rating": 5
            }
        },
        {
            "type": "testimonialCard",
            "settings": {
                "name": "Rahul K.",
                "text": "Fast delivery and excellent packaging. Will definitely order again.",
                "rating": 5
            }
        },
        {
            "type": "testimonialCard",
            "settings": {
                "name": "Ananya M.",
                "text": "Love the designs! The streetwear collection is fire. Already ordered twice.",
                "rating": 4
            }
        },
        {
            "type": "testimonialCard",
            "settings": {
                "name": "Vikram D.",
                "text": "Finally a store that gets streetwear culture. Great curation and fast shipping.",
                "rating": 5
            }
        }
    ],
    "settings_schema": {
        "title": {
            "type": "text",
            "label": "Section Title",
            "maxLength": 80
        },
        "subtitle": {
            "type": "text",
            "label": "Subtitle",
            "maxLength": 120
        },
        "layout": {
            "type": "select",
            "label": "Layout",
            "options": [
                "carousel",
                "grid",
                "masonry"
            ]
        },
        "autoplay": {
            "type": "toggle",
            "label": "Autoplay Carousel"
        },
        "showRating": {
            "type": "toggle",
            "label": "Show Star Ratings"
        },
        "showImage": {
            "type": "toggle",
            "label": "Show Customer Photos"
        }
    }
}