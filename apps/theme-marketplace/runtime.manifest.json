{
  "$schema": "config/runtime/runtime-manifest.schema.json",
  "runtimeName": "Theme Marketplace",
  "runtimeRoot": "apps/theme-marketplace",
  "actorType": ["merchant", "theme-developer"],
  "runtimeCategory": "next-app",
  "runtimeClassification": "marketplace-control-plane",
  "ownership": {
    "sourceAuthority": "apps/theme-marketplace",
    "businessAuthority": "Theme catalog, theme details, checkout, acquisition, and marketplace discovery flows.",
    "governanceDocs": ["docs/governance/runtime-boundaries.md", "docs/governance/theme-runtime-governance.md"]
  },
  "allowedDependencies": {
    "workspacePackages": ["@letbuyy/api-types", "@letbuyy/utils"],
    "runtimeImports": []
  },
  "forbiddenDependencies": ["apps/*", "services/*", "legacy/*", "infrastructure/*", "generated-artifacts"],
  "deploymentAuthority": {
    "platform": "Vercel",
    "config": ["apps/theme-marketplace/next.config.ts"]
  },
  "environmentAuthority": {
    "schema": "config/env/schemas/next-app.schema.json",
    "template": "config/env/templates/next-app.env.example",
    "secretStore": "Vercel theme-marketplace project environment"
  },
  "observabilityAuthority": {
    "correlationId": "X-Request-ID",
    "logging": "structured redacted theme marketplace logs",
    "audit": "theme acquisition and payment actions must be audit-correlated"
  }
}
