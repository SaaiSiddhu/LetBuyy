{
  "$schema": "config/runtime/distributed-execution-contract.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "durableExecutionContract": "config/runtime/durable-execution-contract.json",
  "executionEngine": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "planner": "planDistributedExecution",
    "resumeEngine": "resumeDistributedExecution",
    "journalFunction": "createExecutionJournalEntry",
    "replaySafetyAssertion": "assertExecutionReplaySafe",
    "states": ["PLANNED", "EXECUTING", "PARTIAL_FAILURE", "COMPENSATING", "RECOVERED", "VERIFIED"],
    "checkpointPolicy": "every-state-transition-has-checksum-and-causality-chain",
    "operationSequencing": "sequence-then-operation-id",
    "lineageTracking": "executionLineageChecksum",
    "recoveryPolicy": "resume-from-last-verified-checkpoint-before-compensation"
  },
  "idempotencyEngine": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "registryFactory": "createIdempotentExecutionRegistry",
    "registrationFunction": "registerIdempotentOperation",
    "retryLineageFunction": "buildRetryLineage",
    "assertionFunction": "assertNoDuplicateExecution",
    "requiredFields": ["operationId", "operationIdempotencyKey", "executionHash", "retryFingerprint", "compensationHash", "executionChecksum"],
    "retryPolicy": "same-idempotency-key-must-replay-same-execution-checksum",
    "exactlyOnceSimulation": "registry-deduplicates-retry-before-apply"
  },
  "compensationGovernance": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "stepFactory": "createCompensationStep",
    "dagCompiler": "compileCompensationDag",
    "assertionFunction": "assertCompensationDagSafe",
    "rollbackLineageManifest": "config/runtime/deployment-lineage-manifest.json",
    "irreversibleOperationPolicy": "operator-approval-required-and-checksummed",
    "partialRollbackPolicy": "compensate-reversible-steps-before-forward-fix",
    "orderingPolicy": "dependency-aware-dag-before-execution"
  },
  "cloudflareExecutionGovernance": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "bindingOwnershipManifest": "config/runtime/cloudflare-binding-ownership.json",
    "compiler": "compileCloudflareExecutionLineage",
    "assertionFunction": "assertCloudflareExecutionLineage",
    "nonInheritableBindings": ["vars", "kv_namespaces", "r2_buckets", "queues", "durable_objects", "services", "secrets"],
    "resourceLineage": ["worker-execution", "queue-producer-consumer-causality", "durable-object-ownership", "service-binding-ancestry", "kv-r2-binding-ancestry"],
    "remoteBindingPolicy": "plan-only-until-execute-mode-credentials-exist"
  },
  "validators": [
    "execution-runtime-validator",
    "orchestration-idempotency-validator",
    "compensation-governance-validator",
    "cloudflare-execution-governance-validator"
  ],
  "failurePolicy": "fail-closed"
}
