{
  "$schema": "config/runtime/recovery-slo-contract.schema.json",
  "contractVersion": 1,
  "mode": "staging-executable-evidence-not-production-certification",
  "budgets": {
    "replayRestorationMs": 1500,
    "queueRebuildMs": 1500,
    "rollbackRecoveryMs": 1500,
    "walRestorationMs": 1500,
    "orchestrationRecoveryMs": 1500,
    "leaseFailoverMs": 1500,
    "durableObjectRecoveryMs": 1500
  },
  "boundedConvergence": {
    "maxIterations": 8,
    "requiresFixedPoint": true,
    "requiresAcyclicRecoveryDag": true,
    "requiresTelemetryLineage": true
  },
  "recoveryBudgetGovernance": {
    "budgetSource": "config/runtime/recovery-slo-contract.json",
    "timingEvidenceSource": "artifacts/operational-certification/report.json",
    "budgetComparison": "observed-staging-duration-must-not-exceed-budget",
    "productionCertificationPolicy": "staging timing evidence is not production SLO certification"
  },
  "executionCertificationBudgets": {
    "replayThroughputEventsPerSecondMinimum": 1,
    "queueRebuildMessagesPerSecondMinimum": 1,
    "restartRestorationRequired": true,
    "persistentBackendRequired": true,
    "telemetryPipelineRequired": true
  },
  "failurePolicy": "fail-closed"
}
