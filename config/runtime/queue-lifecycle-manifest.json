{
  "$schema": "config/runtime/queue-lifecycle-manifest.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "producerRuntime": "services/api-gateway",
  "consumerRuntime": "services/queue-workers",
  "producerConfig": "services/api-gateway/wrangler.toml",
  "consumerConfig": "services/queue-workers/wrangler.toml",
  "environments": {
    "staging": {
      "suffix": "-staging",
      "deploymentEnv": "staging",
      "mustNotReferenceProductionQueues": true
    },
    "production": {
      "suffix": "",
      "deploymentEnv": "production",
      "mustNotReferenceLowerEnvironmentQueues": true
    }
  },
  "queues": [
    {
      "logicalName": "runtime",
      "producerBinding": "RUNTIME_QUEUE",
      "producerRoot": "services/api-gateway",
      "consumerRoot": "services/queue-workers",
      "names": {
        "staging": "letbuyy-staging-queue",
        "production": "letbuyy-production-queue"
      },
      "deadLetterNames": {
        "staging": "letbuyy-staging-dead-letter-queue",
        "production": "letbuyy-production-dead-letter-queue"
      },
      "orderingKey": "environment+runtimeName+traceId",
      "retry": {
        "maxRetries": {
          "staging": 8,
          "production": 10
        },
        "retryDelaySeconds": 30,
        "backoff": "provider-fixed-delay"
      },
      "poisonMessagePolicy": "dead-letter-after-retry-exhaustion",
      "replayIntegrity": "provider-runtime-events-require-trace-and-idempotency-key"
    },
    {
      "logicalName": "events",
      "producerBinding": "EVENT_QUEUE",
      "producerRoot": "services/api-gateway",
      "consumerRoot": "services/queue-workers",
      "names": {
        "staging": "letbuyy-events-staging",
        "production": "letbuyy-events-production"
      },
      "deadLetterNames": {
        "staging": "letbuyy-dead-letters-staging",
        "production": "letbuyy-dead-letters-production"
      },
      "orderingKey": "siteId+aggregateId+streamPosition",
      "retry": {
        "maxRetries": {
          "staging": 3,
          "production": 3
        },
        "retryDelaySeconds": 30,
        "backoff": "provider-fixed-delay"
      },
      "poisonMessagePolicy": "dead-letter-after-retry-exhaustion",
      "replayIntegrity": "idempotency-key-and-event-position-required"
    },
    {
      "logicalName": "analytics",
      "producerBinding": "ANALYTICS_QUEUE",
      "producerRoot": "services/api-gateway",
      "consumerRoot": "services/queue-workers",
      "names": {
        "staging": "letbuyy-analytics-queue-staging",
        "production": "letbuyy-analytics-queue-production"
      },
      "deadLetterNames": {
        "staging": "letbuyy-dead-letters-staging",
        "production": "letbuyy-dead-letters-production"
      },
      "orderingKey": "siteId+eventType",
      "retry": {
        "maxRetries": {
          "staging": 8,
          "production": 8
        },
        "retryDelaySeconds": 30,
        "backoff": "provider-fixed-delay"
      },
      "poisonMessagePolicy": "dead-letter-after-retry-exhaustion",
      "replayIntegrity": "analytics-events-must-not-mutate-source-events"
    },
    {
      "logicalName": "search-indexing",
      "producerBinding": "SEARCH_QUEUE",
      "producerRoot": "services/api-gateway",
      "consumerRoot": "services/queue-workers",
      "names": {
        "staging": "letbuyy-search-queue-staging",
        "production": "letbuyy-search-queue-production"
      },
      "deadLetterNames": {
        "staging": "letbuyy-dead-letters-staging",
        "production": "letbuyy-dead-letters-production"
      },
      "orderingKey": "siteId+objectType+objectId",
      "retry": {
        "maxRetries": {
          "staging": 8,
          "production": 8
        },
        "retryDelaySeconds": 45,
        "backoff": "provider-fixed-delay"
      },
      "poisonMessagePolicy": "dead-letter-after-retry-exhaustion",
      "replayIntegrity": "projection-rebuild-required-after-redrive"
    },
    {
      "logicalName": "notifications",
      "producerBinding": "NOTIFICATION_QUEUE",
      "producerRoot": "services/api-gateway",
      "consumerRoot": "services/queue-workers",
      "names": {
        "staging": "letbuyy-notifications-queue-staging",
        "production": "letbuyy-notifications-queue-production"
      },
      "deadLetterNames": {
        "staging": "letbuyy-dead-letters-staging",
        "production": "letbuyy-dead-letters-production"
      },
      "orderingKey": "siteId+recipientId+template",
      "retry": {
        "maxRetries": {
          "staging": 6,
          "production": 6
        },
        "retryDelaySeconds": 60,
        "backoff": "provider-fixed-delay"
      },
      "poisonMessagePolicy": "dead-letter-after-retry-exhaustion",
      "replayIntegrity": "notification-side-effects-require-idempotency-key"
    }
  ],
  "deadLetterQueue": {
    "logicalName": "dead-letters",
    "names": {
      "staging": "letbuyy-dead-letters-staging",
      "production": "letbuyy-dead-letters-production"
    },
    "redrivePolicy": "operator-approved-dry-run-before-mutating-redrive",
    "maxRetries": {
      "staging": 3,
      "production": 3
    },
    "retryDelaySeconds": 300
  },
  "deterministicRecovery": {
    "clockSource": "caller-supplied-runtime-time",
    "retryAvailableAt": "queueRetryAvailableAt(attempt, policy, nowMs)",
    "failIfClockImplicit": true
  },
  "gates": [
    "queue-lifecycle-validator",
    "cloudflare-binding-validator",
    "runtime-topology-validator"
  ],
  "failurePolicy": "fail-closed"
}
