{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Distributed Execution Contract",
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "mode",
    "executionEngine",
    "idempotencyEngine",
    "compensationGovernance",
    "cloudflareExecutionGovernance",
    "validators",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "const": "config/runtime/distributed-execution-contract.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "executionEngine": { "type": "object" },
    "idempotencyEngine": { "type": "object" },
    "compensationGovernance": { "type": "object" },
    "cloudflareExecutionGovernance": { "type": "object" },
    "validators": { "type": "array", "minItems": 4 },
    "failurePolicy": { "const": "fail-closed" }
  }
}
