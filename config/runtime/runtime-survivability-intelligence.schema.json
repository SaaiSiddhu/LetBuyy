{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Runtime Survivability Intelligence",
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "mode",
    "reconciliationIntelligence",
    "rollbackIntelligence",
    "runtimeTransitions",
    "queueConvergence",
    "projectionRebuildIntelligence",
    "manifestProvenance",
    "replaySimulation",
    "deploymentIntelligence",
    "cloudflareResourceLineage",
    "validators",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "const": "config/runtime/runtime-survivability-intelligence.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "reconciliationIntelligence": { "type": "object" },
    "rollbackIntelligence": { "type": "object" },
    "runtimeTransitions": { "type": "object" },
    "queueConvergence": { "type": "object" },
    "projectionRebuildIntelligence": { "type": "object" },
    "manifestProvenance": { "type": "object" },
    "replaySimulation": { "type": "object" },
    "deploymentIntelligence": { "type": "object" },
    "cloudflareResourceLineage": { "type": "object" },
    "validators": { "type": "array", "minItems": 9 },
    "failurePolicy": { "const": "fail-closed" }
  }
}
