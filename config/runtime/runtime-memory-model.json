{
  "$schema": "config/runtime/runtime-memory-model.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "engine": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "compiler": "compileRuntimeMemoryModel",
    "assertionFunction": "assertRuntimeMemoryModel",
    "lineage": "memoryChecksum",
    "overlapPolicy": "resource-owned-by-exactly-one-authority"
  },
  "ownership": [
    { "memoryClass": "durable-state", "owner": "event-store", "resources": ["source-events", "global-position", "stream-position"], "lifecycle": "append-only" },
    { "memoryClass": "ephemeral-state", "owner": "worker-runtime", "resources": ["request-context", "temporary-cache"], "lifecycle": "ephemeral" },
    { "memoryClass": "replay-owned-state", "owner": "replay-runtime", "resources": ["replay-checkpoint", "replay-branch"], "lifecycle": "checkpointed" },
    { "memoryClass": "projection-owned-state", "owner": "projection-runtime", "resources": ["read-model", "projection-checkpoint"], "lifecycle": "rebuildable" },
    { "memoryClass": "queue-owned-state", "owner": "queue-runtime", "resources": ["delivery-state", "retry-state", "dead-letter-state"], "lifecycle": "checkpointed" },
    { "memoryClass": "orchestration-owned-state", "owner": "distributed-execution", "resources": ["execution-journal", "operation-idempotency-registry"], "lifecycle": "checkpointed" },
    { "memoryClass": "reconciliation-owned-state", "owner": "runtime-reconciliation", "resources": ["desired-state", "observed-state", "convergence-plan"], "lifecycle": "derived" }
  ],
  "validators": ["runtime-memory-validator"],
  "failurePolicy": "fail-closed"
}
