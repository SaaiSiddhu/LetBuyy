{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Survivability Execution Contract",
  "type": "object",
  "required": [
    "contractVersion",
    "modePolicy",
    "evidencePolicy",
    "requiredStages",
    "operationalProof"
  ],
  "properties": {
    "contractVersion": { "type": "integer", "minimum": 1 },
    "modePolicy": { "type": "object" },
    "evidencePolicy": { "type": "object" },
    "requiredStages": { "type": "array", "items": { "type": "object" }, "minItems": 1 },
    "operationalProof": { "type": "object" }
  }
}
