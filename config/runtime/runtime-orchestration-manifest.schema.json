{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Runtime Orchestration Manifest",
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "mode",
    "runtimeReconciliation",
    "deploymentOrchestration",
    "rollbackOrchestration",
    "projectionReconciliation",
    "queueRecovery",
    "replayRecovery",
    "stateMachines",
    "cloudflareOrchestration",
    "validators",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "const": "config/runtime/runtime-orchestration-manifest.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "runtimeReconciliation": { "type": "object" },
    "deploymentOrchestration": { "type": "object" },
    "rollbackOrchestration": { "type": "object" },
    "projectionReconciliation": { "type": "object" },
    "queueRecovery": { "type": "object" },
    "replayRecovery": { "type": "object" },
    "stateMachines": { "type": "array", "minItems": 6 },
    "cloudflareOrchestration": { "type": "object" },
    "validators": { "type": "array", "minItems": 8 },
    "failurePolicy": { "const": "fail-closed" }
  }
}
