{
  "$schema": "config/runtime/deployment-lineage-manifest.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "promotionOrder": [
    "staging",
    "production"
  ],
  "deploymentWrappers": [
    {
      "name": "worker-deploy",
      "script": "infrastructure/scripts/deploy/deploy-worker-runtime.mjs",
      "requiresExplicitEnv": true,
      "allowedEnvironments": [
        "staging",
        "production"
      ],
      "rawWranglerDeployForbidden": true
    },
    {
      "name": "production-orchestrator",
      "script": "infrastructure/scripts/deploy/production-deploy.mjs",
      "requiresGovernanceValidation": true,
      "requiresRealBindingsForExecute": true,
      "supportsPlanMode": true
    },
    {
      "name": "worker-rollback",
      "script": "infrastructure/scripts/deploy/production-rollback.mjs",
      "requiresExplicitEnv": true,
      "requiresVersionId": true,
      "requiresReason": true,
      "rawWranglerRollbackForbiddenOutsideWrapper": true
    }
  ],
  "rollbackManifests": [
    {
      "runtimeRoot": "services/api-gateway",
      "workerNames": {
        "staging": "letbuyy-api-staging",
        "production": "letbuyy-api"
      },
      "config": "services/api-gateway/wrangler.toml",
      "rollbackCommand": "node infrastructure/scripts/deploy/production-rollback.mjs --environment=production --worker=letbuyy-api --version-id=$APPROVED_PREVIOUS_VERSION_ID --reason=$ROLLBACK_REASON",
      "queueValidation": "validate:queues",
      "migrationCompatibility": "forward-compatible-or-forward-fix-only",
      "rollbackCorruptionPolicy": "block-if-queue-or-migration-state-incompatible"
    },
    {
      "runtimeRoot": "services/webhook-service",
      "workerNames": {
        "staging": "letbuyy-webhook-staging",
        "production": "letbuyy-webhook"
      },
      "config": "services/webhook-service/wrangler.toml",
      "rollbackCommand": "node infrastructure/scripts/deploy/production-rollback.mjs --environment=production --worker=letbuyy-webhook --version-id=$APPROVED_PREVIOUS_VERSION_ID --reason=$ROLLBACK_REASON",
      "queueValidation": "validate:queues",
      "migrationCompatibility": "forward-compatible-or-forward-fix-only",
      "rollbackCorruptionPolicy": "block-if-webhook-queue-state-incompatible"
    },
    {
      "runtimeRoot": "services/queue-workers",
      "workerNames": {
        "staging": "letbuyy-queue-workers-staging",
        "production": "letbuyy-queue-workers"
      },
      "config": "services/queue-workers/wrangler.toml",
      "rollbackCommand": "node infrastructure/scripts/deploy/production-rollback.mjs --environment=production --worker=letbuyy-queue-workers --version-id=$APPROVED_PREVIOUS_VERSION_ID --reason=$ROLLBACK_REASON",
      "queueValidation": "validate:queues",
      "migrationCompatibility": "forward-compatible-or-forward-fix-only",
      "rollbackCorruptionPolicy": "block-if-queue-redrive-state-incompatible"
    }
  ],
  "lineageGates": [
    "rollback-integrity-validator",
    "deployment-lineage-validator",
    "topology-drift-validator",
    "deployment-safety-validator"
  ],
  "integrityRules": {
    "rollbackRequiresPriorDeploymentVersion": true,
    "rollbackMustNotDropMigrationState": true,
    "rollbackMustPreserveQueueNames": true,
    "rollbackMustNotMutateOutbox": true
  },
  "failurePolicy": "fail-closed"
}
