{
  "$schema": "config/runtime/cloudflare-binding-ownership.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "cloudflareDocs": [
    "https://developers.cloudflare.com/workers/wrangler/environments/",
    "https://developers.cloudflare.com/workers/wrangler/configuration/"
  ],
  "nonInheritableKeys": [
    "vars",
    "kv_namespaces",
    "r2_buckets",
    "queues",
    "durable_objects",
    "services",
    "secrets"
  ],
  "workers": [
    {
      "runtimeRoot": "services/api-gateway",
      "config": "services/api-gateway/wrangler.toml",
      "environments": {
        "staging": {
          "workerName": "letbuyy-api-staging",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION",
            "EVENT_QUEUE_NAME",
            "ANALYTICS_QUEUE_NAME",
            "SEARCH_QUEUE_NAME",
            "NOTIFICATION_QUEUE_NAME",
            "RUNTIME_QUEUE_NAME"
          ],
          "queueProducers": [
            "EVENT_QUEUE",
            "ANALYTICS_QUEUE",
            "SEARCH_QUEUE",
            "NOTIFICATION_QUEUE",
            "RUNTIME_QUEUE"
          ],
          "queueConsumers": [],
          "kvNamespaces": [
            "CACHE"
          ],
          "r2Buckets": [
            "R2_BUCKET"
          ],
          "d1Databases": [
            "RUNTIME_DB"
          ],
          "durableObjects": [
            "RUNTIME_COORDINATOR"
          ],
          "serviceBindings": [
            "WEBHOOK_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        },
        "production": {
          "workerName": "letbuyy-api",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION",
            "EVENT_QUEUE_NAME",
            "ANALYTICS_QUEUE_NAME",
            "SEARCH_QUEUE_NAME",
            "NOTIFICATION_QUEUE_NAME",
            "RUNTIME_QUEUE_NAME"
          ],
          "queueProducers": [
            "EVENT_QUEUE",
            "ANALYTICS_QUEUE",
            "SEARCH_QUEUE",
            "NOTIFICATION_QUEUE",
            "RUNTIME_QUEUE"
          ],
          "queueConsumers": [],
          "kvNamespaces": [
            "CACHE"
          ],
          "r2Buckets": [
            "R2_BUCKET"
          ],
          "d1Databases": [
            "RUNTIME_DB"
          ],
          "durableObjects": [
            "RUNTIME_COORDINATOR"
          ],
          "serviceBindings": [
            "WEBHOOK_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        }
      }
    },
    {
      "runtimeRoot": "services/webhook-service",
      "config": "services/webhook-service/wrangler.toml",
      "environments": {
        "staging": {
          "workerName": "letbuyy-webhook-staging",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION"
          ],
          "queueProducers": [],
          "queueConsumers": [],
          "kvNamespaces": [],
          "r2Buckets": [],
          "d1Databases": [],
          "durableObjects": [],
          "serviceBindings": [
            "API_GATEWAY_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        },
        "production": {
          "workerName": "letbuyy-webhook",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION"
          ],
          "queueProducers": [],
          "queueConsumers": [],
          "kvNamespaces": [],
          "r2Buckets": [],
          "d1Databases": [],
          "durableObjects": [],
          "serviceBindings": [
            "API_GATEWAY_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        }
      }
    },
    {
      "runtimeRoot": "services/queue-workers",
      "config": "services/queue-workers/wrangler.toml",
      "environments": {
        "staging": {
          "workerName": "letbuyy-queue-workers-staging",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION"
          ],
          "queueProducers": [],
          "queueConsumers": [
            "letbuyy-events-staging",
            "letbuyy-analytics-queue-staging",
            "letbuyy-search-queue-staging",
            "letbuyy-notifications-queue-staging",
            "letbuyy-dead-letters-staging",
            "letbuyy-staging-queue",
            "letbuyy-staging-dead-letter-queue"
          ],
          "kvNamespaces": [],
          "r2Buckets": [],
          "d1Databases": [],
          "durableObjects": [],
          "serviceBindings": [
            "API_GATEWAY_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        },
        "production": {
          "workerName": "letbuyy-queue-workers",
          "vars": [
            "ENVIRONMENT",
            "APP_ENV",
            "NODE_ENV",
            "DEPLOYMENT_ENV",
            "TELEMETRY_ENV",
            "RUNTIME_NAME",
            "PRIMARY_REGION",
            "FAILOVER_REGION"
          ],
          "queueProducers": [],
          "queueConsumers": [
            "letbuyy-events-production",
            "letbuyy-analytics-queue-production",
            "letbuyy-search-queue-production",
            "letbuyy-notifications-queue-production",
            "letbuyy-dead-letters-production",
            "letbuyy-production-queue",
            "letbuyy-production-dead-letter-queue"
          ],
          "kvNamespaces": [],
          "r2Buckets": [],
          "d1Databases": [],
          "durableObjects": [],
          "serviceBindings": [
            "API_GATEWAY_SERVICE"
          ],
          "telemetry": [
            "observability",
            "observability.logs"
          ],
          "analyticsEngineDatasets": [
            "RUNTIME_TELEMETRY"
          ]
        }
      }
    }
  ],
  "failurePolicy": "fail-closed"
}
