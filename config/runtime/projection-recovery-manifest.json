{
  "$schema": "config/runtime/projection-recovery-manifest.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "rebuildRuntime": {
    "package": "@letbuyy/projection-runtime",
    "source": "packages/projection-runtime/src/projection-rebuild-runtime.ts",
    "checkpointSource": "packages/projection-runtime/src/projection-checkpoint-runtime.ts",
    "hashAlgorithm": "fnv1a32-stable-json",
    "serialization": "stable-json-sorted-keys"
  },
  "projections": [
    {
      "projectionName": "commerce-order-read-model",
