            "sourceStreamPosition": 3,
            "projectedAt": "2026-05-25T00:00:00.000Z"
          },
          "readModel": {
            "orderId": "ord_fixture_1",
            "siteId": "site_fixture_1",
            "status": "fulfillment_queued",
            "totalMinor": 199900,
            "currency": "INR"
          },
          "integrityHash": "77e95d5b"
        }
      ]
    }
  ],
  "recoveryGates": [
    "projection-recovery-validator",
    "projection-integrity-validator",
    "replay-evolution-validator"
  ],
  "failurePolicy": "fail-closed"
}
