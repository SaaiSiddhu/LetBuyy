{
  "$schema": "config/runtime/runtime-causality-graph.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "engine": {
    "engineSource": "packages/distributed-runtime/src/runtime-causality-graph-runtime.ts",
    "compiler": "compileRuntimeCausalityGraph",
    "validator": "assertRuntimeCausalityGraph",
    "checksum": "causalityChecksum",
    "loopPolicy": "causality-loops-hard-fail"
  },
  "lineageSources": [
    "config/runtime/deployment-lineage-manifest.json",
    "config/runtime/replay-evolution-manifest.json",
    "config/runtime/queue-lifecycle-manifest.json",
    "config/runtime/projection-recovery-manifest.json",
    "config/runtime/runtime-orchestration-manifest.json",
    "config/runtime/runtime-survivability-intelligence.json",
    "config/runtime/distributed-execution-contract.json"
  ],
  "graph": {
    "nodes": [
      { "id": "deployment-lineage", "kind": "deployment", "owner": "deployment-runtime" },
      { "id": "replay-lineage", "kind": "replay", "owner": "replay-runtime" },
      { "id": "queue-lineage", "kind": "queue", "owner": "queue-runtime" },
      { "id": "projection-lineage", "kind": "projection", "owner": "projection-runtime" },
      { "id": "rollback-lineage", "kind": "rollback", "owner": "rollback-runtime" },
      { "id": "reconciliation-lineage", "kind": "reconciliation", "owner": "runtime-reconciliation" },
      { "id": "execution-lineage", "kind": "execution", "owner": "distributed-execution" },
      { "id": "temporal-lineage", "kind": "temporal", "owner": "runtime-clock-governance" }
    ],
    "edges": [
      { "from": "deployment-lineage", "to": "execution-lineage", "reason": "causes" },
      { "from": "execution-lineage", "to": "queue-lineage", "reason": "enqueues" },
      { "from": "queue-lineage", "to": "replay-lineage", "reason": "replays" },
      { "from": "replay-lineage", "to": "projection-lineage", "reason": "projects" },
      { "from": "rollback-lineage", "to": "reconciliation-lineage", "reason": "compensates" },
      { "from": "temporal-lineage", "to": "replay-lineage", "reason": "depends-on" }
    ],
    "temporalOrderingPolicy": "producer-supplied-time-and-global-position-only",
    "ancestryReconciliation": "all-lineage-sources-must-have-manifest-lineage-entry"
  },
  "validators": ["runtime-causality-validator"],
  "failurePolicy": "fail-closed"
}
