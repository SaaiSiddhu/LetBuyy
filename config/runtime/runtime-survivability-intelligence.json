{
  "$schema": "config/runtime/runtime-survivability-intelligence.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "reconciliationIntelligence": {
    "engineSource": "packages/distributed-runtime/src/reconciliation-convergence-runtime.ts",
    "baseReconciliationEngine": "packages/distributed-runtime/src/runtime-reconciliation-runtime.ts",
    "graphCompiler": "compileRuntimeResourceGraph",
    "convergencePlanner": "planRuntimeConvergence",
    "deterministicOrdering": ["environment", "resourceKind", "resourceName"],
    "actions": ["create-missing", "update-drift", "quarantine-orphan"],
    "orphanRecoveryPolicy": "quarantine-orphan-before-activation",
    "checksumGovernance": "convergenceChecksum-per-step-and-planChecksum"
  },
  "rollbackIntelligence": {
    "engineSource": "packages/distributed-runtime/src/rollback-intelligence-runtime.ts",
    "baseRollbackEngine": "packages/distributed-runtime/src/rollback-orchestration-runtime.ts",
    "dagCompiler": "compileRollbackDag",
    "simulationEngine": "simulateRollback",
    "convergenceValidator": "assertRollbackDagSafe",
    "dependencyEdges": [
      { "fromRuntimeRoot": "services/webhook-service", "toRuntimeRoot": "services/api-gateway", "reason": "event-producer" },
      { "fromRuntimeRoot": "services/api-gateway", "toRuntimeRoot": "services/queue-workers", "reason": "queue-consumer" }
    ],
    "requiredCompatibility": ["replay", "projection", "queue", "migration", "deployment-lineage"],
    "blastRadiusDimensions": ["replay", "projection", "queue", "migration", "deployment-lineage", "worker-traffic"]
  },
  "runtimeTransitions": {
    "engineSource": "packages/distributed-runtime/src/runtime-transition-lineage-runtime.ts",
    "stateMachineSource": "packages/distributed-runtime/src/runtime-state-machine-runtime.ts",
    "journalFunction": "appendRuntimeTransitionJournal",
    "recoveryFunction": "recoverRuntimeTransition",
    "auditChain": "previousChecksum-to-checkpointChecksum",
    "causalityRequired": true,
    "checkpointGovernance": "every-transition-has-gates-causation-and-checksum"
  },
  "queueConvergence": {
    "engineSource": "packages/distributed-runtime/src/queue-convergence-runtime.ts",
    "queueLifecycleManifest": "config/runtime/queue-lifecycle-manifest.json",
    "convergenceFunction": "planQueueConvergence",
    "assertionFunction": "assertQueueConvergence",
    "stateEquality": ["event-store", "projection", "queue-processing"],
    "idempotencyRequired": true,
    "hashes": ["eventStoreHash", "queueHash", "projectionHash"],
    "eventualConvergencePolicy": "redrive-or-rebuild-until-hashes-align"
  },
  "projectionRebuildIntelligence": {
    "engineSource": "packages/projection-runtime/src/projection-rebuild-planner-runtime.ts",
    "projectionRecoveryManifest": "config/runtime/projection-recovery-manifest.json",
    "planner": "planSelectiveProjectionRebuild",
    "boundedAssertion": "assertProjectionRebuildPlanBounded",
    "dependencyGraph": [],
    "candidates": [
      {
        "projectionName": "commerce-order-read-model",
        "projectionVersion": 1,
        "lastHealthyGlobalPosition": 0,
        "targetGlobalPosition": 3,
        "priority": 1,
        "estimatedRecords": 1
      }
    ],
    "maxBatchSize": 500,
    "rebuildPolicy": "selective-window-before-full-rebuild"
  },
  "manifestProvenance": {
    "engineSource": "packages/distributed-runtime/src/manifest-provenance-runtime.ts",
    "lineageManifest": "config/runtime/manifest-lineage.json",
    "checksumAlgorithm": "sha256",
    "snapshotFunction": "compileManifestProvenance",
    "assertionFunction": "assertManifestProvenance",
    "signaturePolicy": "detached-signature-required-before-execute-mode",
    "ancestryEntries": [
      {
        "path": "config/runtime/deployment-topology.json",
        "parentChecksum": null,
        "owner": "runtime-topology"
      },
      {
        "path": "config/runtime/runtime-orchestration-manifest.json",
        "parentChecksum": "3750b2472f4a2b5a95698ae9f6dd447b865032b145f46ebb0dff2c3263d5cc31",
        "owner": "runtime-orchestration"
      },
      {
        "path": "config/runtime/runtime-survivability-intelligence.json",
        "parentChecksum": "374e485f4e9df3e5fde1fde6fae63b6fdf5453c9aed16836bcf2a07a7ad1dace",
        "owner": "runtime-survivability"
      },
      {
        "path": "config/runtime/durable-execution-contract.json",
        "parentChecksum": "964941585bab9b6f10b403722174d4831249ab264b8ed561c1e2098447cb9e7b",
        "owner": "durable-distributed-execution"
      }
    ]
  },
  "replaySimulation": {
    "engineSource": "packages/distributed-runtime/src/replay-simulation-runtime.ts",
    "replayEvolutionManifest": "config/runtime/replay-evolution-manifest.json",
    "timelineFunction": "simulateReplayTimelines",
    "assertionFunction": "assertReplayTimelineStable",
    "branchingPolicy": "branch-checksum-must-remain-stable",
    "branches": [
      {
        "branchName": "schema-evolution-v1",
        "baseCheckpoint": "checkout-order-replay-fixture-v1",
        "scenario": "schema-evolution",
        "expectedProjectionChecksum": "77e95d5b"
      },
      {
        "branchName": "deployment-rollback-v1",
        "baseCheckpoint": "checkout-order-replay-fixture-v1",
        "scenario": "deployment-rollback",
        "expectedProjectionChecksum": "77e95d5b"
      },
      {
        "branchName": "checkpoint-recovery-v1",
        "baseCheckpoint": "checkout-order-replay-fixture-v1",
        "scenario": "checkpoint-recovery",
        "expectedProjectionChecksum": "77e95d5b"
      },
      {
        "branchName": "alternate-replay-timeline-v1",
        "baseCheckpoint": "checkout-order-replay-fixture-v1",
        "scenario": "replay-branch",
        "expectedProjectionChecksum": "77e95d5b"
      }
    ]
  },
  "deploymentIntelligence": {
    "engineSource": "packages/distributed-runtime/src/deployment-intelligence-runtime.ts",
    "topologyManifest": "config/runtime/deployment-topology.json",
    "dagCompiler": "compileDeploymentDag",
    "deterministicAssertion": "assertDeploymentDagDeterministic",
    "targetRuntimeRoots": ["database/supabase", "services/queue-workers", "services/api-gateway", "services/webhook-service"],
    "convergencePolicy": "dependency-dag-before-runtime-activation",
    "blastRadiusPolicy": "runtime-dependencies-compiled-before-activation"
  },
  "cloudflareResourceLineage": {
    "engineSource": "packages/distributed-runtime/src/cloudflare-resource-lineage-runtime.ts",
    "bindingOwnershipManifest": "config/runtime/cloudflare-binding-ownership.json",
    "compiler": "compileCloudflareResourceLineage",
    "assertionFunction": "assertCloudflareResourceLineage",
    "nonInheritableBindings": ["vars", "kv_namespaces", "r2_buckets", "queues", "durable_objects", "services", "secrets"],
    "resourceKinds": ["worker", "var", "queue-producer", "queue-consumer", "kv", "r2", "durable-object", "service-binding", "telemetry"],
    "remoteBindingReconciliation": "plan-only-until-execute-mode-credentials-exist",
    "forbiddenDrift": ["env-crossover", "ambiguous-owner", "unresolved-binding", "worker-name-collision"]
  },
  "validators": [
    "reconciliation-convergence-validator",
    "rollback-intelligence-validator",
    "runtime-transition-validator",
    "queue-convergence-validator",
    "projection-rebuild-validator",
    "manifest-provenance-validator",
    "replay-simulation-validator",
    "deployment-intelligence-validator",
    "cloudflare-resource-lineage-validator"
  ],
  "failurePolicy": "fail-closed"
}
