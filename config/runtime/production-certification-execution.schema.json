{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letbuyy.internal/schemas/production-certification-execution.schema.json",
  "title": "LetBuyy Provider-Backed Production Certification Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "mode",
    "certificationMode",
    "runner",
    "executeRequires",
    "providerEvidence",
    "benchmarkDatasets",
    "cloudflareExecution",
    "artifactPolicy",
    "validators",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "provider-backed-execute-required" },
    "certificationMode": { "enum": ["credential-gated-provider-required", "live-certified"] },
    "runner": { "$ref": "#/$defs/namedObject" },
    "executeRequires": { "$ref": "#/$defs/namedObject" },
    "providerEvidence": { "$ref": "#/$defs/namedObject" },
    "benchmarkDatasets": { "$ref": "#/$defs/namedObject" },
    "cloudflareExecution": { "$ref": "#/$defs/namedObject" },
    "artifactPolicy": { "$ref": "#/$defs/namedObject" },
    "validators": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "failurePolicy": { "const": "fail-closed" }
  },
  "$defs": {
    "namedObject": {
      "type": "object",
      "additionalProperties": true,
      "minProperties": 1
    }
  }
}
