{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letbuyy.internal/schemas/deployment-topology.schema.json",
  "title": "LetBuyy Runtime Deployment Topology",
  "type": "object",
  "additionalProperties": false,
  "required": ["topologyVersion", "generatedFrom", "nodes", "dependencies", "telemetry"],
  "properties": {
    "topologyVersion": { "type": "integer", "minimum": 1 },
    "generatedFrom": { "const": "runtime-manifests" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtimeName", "runtimeRoot", "deploymentKind", "platform", "regions", "startupOrder", "scaling", "health"],
        "properties": {
          "runtimeName": { "type": "string", "minLength": 1 },
          "runtimeRoot": { "type": "string", "minLength": 1 },
          "deploymentKind": {
            "enum": ["next-app", "cloudflare-worker", "queue-worker", "scheduler", "reserved-service", "database"]
          },
          "platform": {
            "enum": ["vercel", "cloudflare-workers", "supabase", "reserved", "mobile"]
          },
          "regions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "startupOrder": { "type": "integer", "minimum": 0 },
          "scaling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minInstances", "maxInstances", "concurrency", "scaleMetric"],
            "properties": {
              "minInstances": { "type": "integer", "minimum": 0 },
              "maxInstances": { "type": "integer", "minimum": 0 },
              "concurrency": { "type": "integer", "minimum": 1 },
              "scaleMetric": {
                "enum": ["request-rate", "queue-depth", "replay-lag", "workflow-lag", "manual"]
              }
            }
          },
          "health": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checkName", "timeoutMs", "degradedAfterFailures", "unavailableAfterFailures"],
            "properties": {
              "path": { "type": "string" },
              "checkName": { "type": "string", "minLength": 1 },
              "timeoutMs": { "type": "integer", "minimum": 1 },
              "degradedAfterFailures": { "type": "integer", "minimum": 1 },
              "unavailableAfterFailures": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromRuntime", "toRuntime", "dependencyType", "requiredForStartup", "healthCheckName"],
        "properties": {
          "fromRuntime": { "type": "string", "minLength": 1 },
          "toRuntime": { "type": "string", "minLength": 1 },
          "dependencyType": {
            "enum": ["api", "queue", "event-stream", "database", "cache", "telemetry", "provider"]
          },
          "requiredForStartup": { "type": "boolean" },
          "healthCheckName": { "type": "string", "minLength": 1 }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracePropagationHeader", "correlationHeader", "metricsRuntime"],
      "properties": {
        "tracePropagationHeader": { "const": "traceparent" },
        "correlationHeader": { "const": "X-Request-ID" },
        "metricsRuntime": { "type": "string", "minLength": 1 }
      }
    }
  }
}
