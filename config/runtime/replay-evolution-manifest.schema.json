{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Replay Evolution Manifest",
  "type": "object",
  "required": ["$schema", "manifestVersion", "mode", "serializer", "eventFamilies", "compatibilityMatrix", "deterministicSnapshots"],
  "properties": {
    "$schema": { "const": "config/runtime/replay-evolution-manifest.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "serializer": {
      "type": "object",
      "required": ["name", "checksum", "eventTimeSource", "forbiddenEntropy"],
      "properties": {
        "name": { "const": "stable-json-sorted-keys" },
        "checksum": { "const": "fnv1a32-stable-json" },
        "eventTimeSource": { "const": "producer-supplied-occurredAt-only" },
        "forbiddenEntropy": { "type": "array", "items": { "type": "string" } }
      }
    },
    "eventFamilies": { "type": "array", "minItems": 1 },
    "compatibilityMatrix": { "type": "array", "minItems": 1 },
    "deterministicSnapshots": { "type": "array", "minItems": 1 }
  }
}
