{
  "$schema": "config/runtime/runtime-saturation-contract.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "engine": {
    "engineSource": "packages/distributed-runtime/src/saturation-governance-runtime.ts",
    "decisionFunction": "decideSaturation",
    "assertionFunction": "assertSaturationGovernance",
    "throttlePolicy": "token-bucket-with-stable-ordering",
    "stormPrevention": "recovery-systems-never-exceed-runtime-budget"
  },
  "budgets": [
    { "kind": "orchestration", "maxConcurrency": 8, "rateLimitPerMinute": 30, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "rollback", "maxConcurrency": 2, "rateLimitPerMinute": 6, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "replay", "maxConcurrency": 4, "rateLimitPerMinute": 12, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "queue-rebuild", "maxConcurrency": 3, "rateLimitPerMinute": 10, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "reconciliation", "maxConcurrency": 4, "rateLimitPerMinute": 20, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "dag-execution", "maxConcurrency": 6, "rateLimitPerMinute": 24, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "projection-rebuild", "maxConcurrency": 3, "rateLimitPerMinute": 10, "deterministicThrottle": "token-bucket-with-stable-ordering" },
    { "kind": "queue-recovery", "maxConcurrency": 2, "rateLimitPerMinute": 8, "deterministicThrottle": "token-bucket-with-stable-ordering" }
  ],
  "validators": ["saturation-governance-validator"],
  "failurePolicy": "fail-closed"
}
