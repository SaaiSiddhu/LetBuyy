{
  "$schema": "config/runtime/replay-safety-contract.schema.json",
  "contractVersion": 1,
  "determinism": {
    "eventTimeSource": "producer-supplied-occurredAt-only",
    "serialization": "stable-json-sorted-keys",
    "checksum": "fnv1a32-stable-json",
    "forbiddenReplayEntropy": [
      "Date.now",
      "new Date().toISOString",
      "Math.random",
      "crypto.randomUUID"
    ]
  },
  "eventOrdering": {
    "requiredPositions": ["stream_position", "global_position"],
    "gapPolicy": "fail-closed",
    "idempotencyPolicy": "stream-scoped-idempotency-key"
  },
  "eventEvolution": {
    "schemaVersionPolicy": "positive-integer",
    "compatibilityPolicy": "additive-compatible-or-explicit-migration",
    "breakingChangePolicy": "blocked-before-replay"
  },
  "projectionIntegrity": {
    "sourceEventIdRequired": true,
    "sourceGlobalPositionRequired": true,
    "readModelSerialization": "stable-json-sorted-keys"
  },
  "migrationSafety": {
    "destructiveOperations": "forbidden",
    "renamePolicy": "expand-contract-with-compatibility-only",
    "rehearsalPolicy": "required-before-production"
  },
  "authorization": {
    "nonDryRunReplay": "approved-and-timeboxed",
    "expiryPolicy": "fail-closed"
  }
}
