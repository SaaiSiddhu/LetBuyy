{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letbuyy.internal/schemas/runtime-manifest.schema.json",
  "title": "LetBuyy Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeName",
    "runtimeRoot",
    "actorType",
    "runtimeCategory",
    "runtimeClassification",
    "ownership",
    "allowedDependencies",
    "forbiddenDependencies",
    "orchestrationAuthority",
    "eventAuthority",
    "workflowAuthority",
    "queryAuthority",
    "compositionAuthority",
    "executionOwnership",
    "distributedExecutionOwnership",
    "queueOwnership",
    "providerOwnership",
    "executionBoundaries",
    "asyncExecutionOwnership",
    "observabilityOwnership",
    "telemetryOwnership",
    "workflowRecoveryOwnership",
    "recoveryOwnership",
    "replayOwnership",
    "checkpointOwnership",
    "projectionOwnership",
    "cqrsOwnership",
    "cacheOwnership",
    "coordinationOwnership",
    "resilienceOwnership",
    "regionalOwnership",
    "tenantScalingOwnership",
    "auditOwnership",
    "operationalOwnership",
    "telemetryExecutionOwnership",
    "replayExecutionOwnership",
    "queueExecutionOwnership",
    "resilienceExecutionOwnership",
    "regionalExecutionOwnership",
    "auditExecutionOwnership",
    "cacheExecutionOwnership",
    "coordinationExecutionOwnership",
    "diagnosticsOwnership",
    "operationalControlPlaneOwnership",
    "deploymentOwnership",
    "observabilityInfrastructureOwnership",
    "queueProviderOwnership",
    "eventStoreOwnership",
    "failoverOwnership",
    "incidentOwnership",
    "deploymentTopologyOwnership",
    "securityOwnership",
    "chaosOwnership",
    "loadTestingOwnership",
    "controlPlaneOwnership",
    "regionalRoutingOwnership",
    "executionAuthority",
    "deploymentAuthority",
    "environmentAuthority",
    "observabilityAuthority"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "runtimeName": { "type": "string", "minLength": 1 },
    "runtimeRoot": { "type": "string", "minLength": 1 },
    "actorType": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "runtimeCategory": { "type": "string", "minLength": 1 },
    "runtimeClassification": { "type": "string", "minLength": 1 },
    "ownership": {
      "type": "object",
      "required": ["sourceAuthority", "governanceDocs"],
      "additionalProperties": false,
      "properties": {
        "sourceAuthority": { "type": "string", "minLength": 1 },
        "businessAuthority": { "type": "string" },
        "governanceDocs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "allowedDependencies": {
      "type": "object",
      "required": ["workspacePackages", "runtimeImports"],
      "additionalProperties": false,
      "properties": {
        "workspacePackages": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "runtimeImports": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "forbiddenDependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "orchestrationAuthority": { "type": "string", "minLength": 1 },
    "eventAuthority": { "type": "string", "minLength": 1 },
    "workflowAuthority": { "type": "string", "minLength": 1 },
    "queryAuthority": { "type": "string", "minLength": 1 },
    "compositionAuthority": { "type": "string", "minLength": 1 },
    "executionOwnership": { "type": "string", "minLength": 1 },
    "distributedExecutionOwnership": { "type": "string", "minLength": 1 },
    "queueOwnership": { "type": "string", "minLength": 1 },
    "providerOwnership": { "type": "string", "minLength": 1 },
    "executionBoundaries": { "type": "string", "minLength": 1 },
    "asyncExecutionOwnership": { "type": "string", "minLength": 1 },
    "observabilityOwnership": { "type": "string", "minLength": 1 },
    "telemetryOwnership": { "type": "string", "minLength": 1 },
    "workflowRecoveryOwnership": { "type": "string", "minLength": 1 },
    "recoveryOwnership": { "type": "string", "minLength": 1 },
    "replayOwnership": { "type": "string", "minLength": 1 },
    "checkpointOwnership": { "type": "string", "minLength": 1 },
    "projectionOwnership": { "type": "string", "minLength": 1 },
    "cqrsOwnership": { "type": "string", "minLength": 1 },
    "cacheOwnership": { "type": "string", "minLength": 1 },
    "coordinationOwnership": { "type": "string", "minLength": 1 },
    "resilienceOwnership": { "type": "string", "minLength": 1 },
    "regionalOwnership": { "type": "string", "minLength": 1 },
    "tenantScalingOwnership": { "type": "string", "minLength": 1 },
    "auditOwnership": { "type": "string", "minLength": 1 },
    "operationalOwnership": { "type": "string", "minLength": 1 },
    "telemetryExecutionOwnership": { "type": "string", "minLength": 1 },
    "replayExecutionOwnership": { "type": "string", "minLength": 1 },
    "queueExecutionOwnership": { "type": "string", "minLength": 1 },
    "resilienceExecutionOwnership": { "type": "string", "minLength": 1 },
    "regionalExecutionOwnership": { "type": "string", "minLength": 1 },
    "auditExecutionOwnership": { "type": "string", "minLength": 1 },
    "cacheExecutionOwnership": { "type": "string", "minLength": 1 },
    "coordinationExecutionOwnership": { "type": "string", "minLength": 1 },
    "diagnosticsOwnership": { "type": "string", "minLength": 1 },
    "operationalControlPlaneOwnership": { "type": "string", "minLength": 1 },
    "deploymentOwnership": { "type": "string", "minLength": 1 },
    "observabilityInfrastructureOwnership": { "type": "string", "minLength": 1 },
    "queueProviderOwnership": { "type": "string", "minLength": 1 },
    "eventStoreOwnership": { "type": "string", "minLength": 1 },
    "failoverOwnership": { "type": "string", "minLength": 1 },
    "incidentOwnership": { "type": "string", "minLength": 1 },
    "deploymentTopologyOwnership": { "type": "string", "minLength": 1 },
    "securityOwnership": { "type": "string", "minLength": 1 },
    "chaosOwnership": { "type": "string", "minLength": 1 },
    "loadTestingOwnership": { "type": "string", "minLength": 1 },
    "controlPlaneOwnership": { "type": "string", "minLength": 1 },
    "regionalRoutingOwnership": { "type": "string", "minLength": 1 },
    "executionAuthority": {
      "type": "object",
      "required": [
        "executionRole",
        "orchestrationRole",
        "infrastructureOwnership",
        "eventOwnership",
        "queryOwnership",
        "compositionOwnership"
      ],
      "additionalProperties": false,
      "properties": {
        "executionRole": { "type": "string", "minLength": 1 },
        "orchestrationRole": { "type": "string", "minLength": 1 },
        "infrastructureOwnership": { "type": "string", "minLength": 1 },
        "eventOwnership": { "type": "string", "minLength": 1 },
        "queryOwnership": { "type": "string", "minLength": 1 },
        "compositionOwnership": { "type": "string", "minLength": 1 }
      }
    },
    "deploymentAuthority": {
      "type": "object",
      "required": ["platform", "config"],
      "additionalProperties": true,
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "config": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "environmentAuthority": {
      "type": "object",
      "required": ["schema", "template", "secretStore"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "secretStore": { "type": "string", "minLength": 1 }
      }
    },
    "observabilityAuthority": {
      "type": "object",
      "required": ["correlationId", "logging", "audit"],
      "additionalProperties": false,
      "properties": {
        "correlationId": { "type": "string", "minLength": 1 },
        "logging": { "type": "string", "minLength": 1 },
        "audit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
