{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://letbuyy.internal/schemas/environment-lifecycle.schema.json",
  "title": "LetBuyy Enterprise Environment Lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lifecycleVersion",
    "promotionOrder",
    "isolationRules",
    "environments"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "lifecycleVersion": { "type": "integer", "minimum": 1 },
    "promotionOrder": {
      "type": "array",
      "items": { "enum": ["local", "development", "staging", "production"] },
      "minItems": 4,
      "uniqueItems": true
    },
    "isolationRules": {
      "type": "object",
      "required": ["mustSeparate", "forbidden"],
      "properties": {
        "mustSeparate": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/environment" }
    }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stability",
        "credentialsMode",
        "dataIsolation",
        "regions",
        "topology",
        "providers",
        "featureFlags",
        "observability",
        "deployment",
        "evidence"
      ],
      "properties": {
        "name": { "enum": ["local", "development", "staging", "production"] },
        "stability": { "type": "string", "minLength": 1 },
        "credentialsMode": { "type": "string", "minLength": 1 },
        "dataIsolation": { "type": "string", "minLength": 1 },
        "regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "topology": { "type": "object" },
        "providers": { "type": "object" },
        "featureFlags": { "type": "object" },
        "observability": { "type": "object" },
        "deployment": { "type": "object" },
        "evidence": { "type": "object" }
      }
    }
  }
}
