{
  "$schema": "config/runtime/observability-platform.schema.json",
  "contractVersion": 1,
  "signals": [
    "traces",
    "metrics",
    "logs",
    "spans",
    "operational-events"
  ],
  "lineage": [
    "request-lineage",
    "queue-lineage",
    "deployment-lineage",
    "tenant-lineage",
    "migration-lineage"
  ],
  "dashboards": [
    {
      "name": "runtime",
      "path": "infrastructure/observability/grafana-runtime-dashboard.json",
      "mustUseLiveTelemetry": true
    },
    {
      "name": "queue",
      "path": "infrastructure/observability/grafana-queue-dashboard.json",
      "mustUseLiveTelemetry": true
    },
    {
      "name": "incident",
      "path": "infrastructure/observability/grafana-incident-dashboard.json",
      "mustUseLiveTelemetry": true
    },
    {
      "name": "deployment",
      "path": "infrastructure/observability/grafana-deployment-dashboard.json",
      "mustUseLiveTelemetry": true
    }
  ],
  "alerts": [
    {
      "name": "LetBuyyApiGatewayHighErrorRate",
      "class": "burn-rate"
    },
    {
      "name": "LetBuyyQueueDeadLetterGrowth",
      "class": "queue-lag"
    },
    {
      "name": "LetBuyyDeploymentGateFailed",
      "class": "deployment-degradation"
    }
  ],
  "forbiddenDashboardSources": [
    "mockData",
    "fixtureData",
    "static sample data",
    "placeholder"
  ]
}
