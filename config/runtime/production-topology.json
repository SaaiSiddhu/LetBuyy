{
  "$schema": "config/runtime/production-topology.schema.json",
  "topologyVersion": 2,
  "environment": "production",
  "canonicalDomain": "letbuyy.com",
  "mode": "governance-contract-not-live-evidence",
  "queueProvider": {
    "provider": "cloudflare-queues",
    "terraform": "infrastructure/cloudflare/queues.tf",
    "producerConfig": "services/api-gateway/wrangler.toml",
    "consumerConfig": "services/queue-workers/wrangler.toml",
    "queues": [
      "letbuyy-events-production",
      "letbuyy-analytics-queue-production",
      "letbuyy-search-queue-production",
      "letbuyy-notifications-queue-production",
      "letbuyy-dead-letters-production",
      "letbuyy-production-queue",
      "letbuyy-production-dead-letter-queue"
    ]
  },
  "eventStoreProvider": {
    "provider": "supabase-postgres-append-only",
    "migrations": [
      "database/supabase/migrations/000_baseline.sql"
    ],
    "retentionPolicy": "single-region append-only outbox and ledger evidence"
  },
  "regions": {
    "primary": "ap-south-1",
    "edge": [
      "global-edge"
    ],
    "replayIntegrity": {
      "failClosedOnDivergence": true
    }
  },
  "runtimes": [
    {
      "runtimeName": "Supabase Database",
      "runtimeRoot": "database/supabase",
      "environment": "production",
      "status": "active",
      "deploymentManifests": [
        "database/supabase/migrations/000_baseline.sql"
      ]
    },
    {
      "runtimeName": "API Gateway",
      "runtimeRoot": "services/api-gateway",
      "environment": "production",
      "status": "active",
      "deploymentKind": "cloudflare-worker",
      "deploymentManifests": [
        "services/api-gateway/wrangler.toml"
      ]
    },
    {
      "runtimeName": "Queue Workers",
      "runtimeRoot": "services/queue-workers",
      "environment": "production",
      "status": "active",
      "deploymentKind": "queue-worker",
      "deploymentManifests": [
        "services/queue-workers/wrangler.toml"
      ]
    },
    {
      "runtimeName": "Mobile BFF",
      "runtimeRoot": "services/mobile-bff",
      "environment": "production",
      "status": "active",
      "deploymentKind": "cloudflare-worker",
      "deploymentManifests": [
        "services/mobile-bff/wrangler.toml"
      ]
    },
    {
      "runtimeName": "Webhook Service",
      "runtimeRoot": "services/webhook-service",
      "environment": "production",
      "status": "active",
      "deploymentKind": "cloudflare-worker",
      "deploymentManifests": [
        "services/webhook-service/wrangler.toml"
      ]
    },
    {
      "runtimeName": "Identity Platform",
      "runtimeRoot": "apps/identity-platform",
      "environment": "production",
      "status": "active",
      "deploymentKind": "vercel-next",
      "deploymentManifests": [
        "apps/identity-platform/vercel.json"
      ]
    },
    {
      "runtimeName": "Storefront Runtime",
      "runtimeRoot": "apps/storefront-runtime",
      "environment": "production",
      "status": "active",
      "deploymentKind": "vercel-next",
      "deploymentManifests": [
        "apps/storefront-runtime/vercel.json"
      ]
    },
    {
      "runtimeName": "Merchant Control Plane",
      "runtimeRoot": "apps/merchant-control-plane",
      "environment": "production",
      "status": "active",
      "deploymentKind": "vercel-next",
      "deploymentManifests": [
        "apps/merchant-control-plane/vercel.json"
      ]
    },
    {
      "runtimeName": "Marketing Site",
      "runtimeRoot": "apps/marketing-site",
      "environment": "production",
      "status": "active",
      "deploymentKind": "vercel-next",
      "deploymentManifests": [
        "apps/marketing-site/vercel.json"
      ]
    },
    {
      "runtimeName": "Platform Console",
      "runtimeRoot": "apps/platform-console",
      "environment": "production",
      "status": "active",
      "deploymentKind": "vercel-next",
      "deploymentManifests": [
        "apps/platform-console/vercel.json"
      ]
    },
    {
      "runtimeName": "Mobile Merchant App",
      "runtimeRoot": "apps/mobile/merchant-app",
      "environment": "production",
      "status": "active",
      "deploymentKind": "mobile-app",
      "deploymentManifests": [
        "apps/mobile/merchant-app/pubspec.yaml"
      ]
    },
    {
      "runtimeName": "checkout-runtime",
      "runtimeRoot": "services/checkout-runtime",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "search-service",
      "runtimeRoot": "services/search-service",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "media-service",
      "runtimeRoot": "services/media-service",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "notification-service",
      "runtimeRoot": "services/notification-service",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "event-bus",
      "runtimeRoot": "services/event-bus",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "analytics-pipeline",
      "runtimeRoot": "services/analytics-pipeline",
      "environment": "reserved",
      "status": "reserved",
      "deploymentKind": "manifest-only",
      "deploymentManifests": []
    },
    {
      "runtimeName": "app-marketplace",
      "runtimeRoot": "apps/app-marketplace",
      "environment": "frozen",
      "status": "frozen",
      "deploymentKind": "not-deployed",
      "deploymentManifests": []
    },
    {
      "runtimeName": "developer-portal",
      "runtimeRoot": "apps/developer-portal",
      "environment": "frozen",
      "status": "frozen",
      "deploymentKind": "not-deployed",
      "deploymentManifests": []
    },
    {
      "runtimeName": "theme-marketplace",
      "runtimeRoot": "apps/theme-marketplace",
      "environment": "frozen",
      "status": "frozen",
      "deploymentKind": "not-deployed",
      "deploymentManifests": []
    },
    {
      "runtimeName": "platform-operations-portal",
      "runtimeRoot": "apps/platform-operations-portal",
      "environment": "frozen",
      "status": "frozen",
      "deploymentKind": "not-deployed",
      "deploymentManifests": []
    }
  ]
}
