{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Durable Distributed Execution Contract",
  "type": "object",
  "required": [
    "$schema",
    "manifestVersion",
    "mode",
    "durableExecution",
    "leaseGovernance",
    "fencingGovernance",
    "sagaRecovery",
    "distributedClock",
    "executionIsolation",
    "operationalStorage",
    "recoverySimulation",
    "executionReconciliation",
    "cloudflareDurableRuntime",
    "walLifecycle",
    "leaseHeartbeat",
    "splitBrainPrevention",
    "resumableExecution",
    "distributedConflictArbitration",
    "crdtConvergence",
    "adaptiveRecoveryThrottling",
    "durableObjectRecovery",
    "convergenceProof",
    "recoveryDrillGovernance",
    "validators",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "const": "config/runtime/durable-execution-contract.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "durableExecution": { "type": "object" },
    "leaseGovernance": { "type": "object" },
    "fencingGovernance": { "type": "object" },
    "sagaRecovery": { "type": "object" },
    "distributedClock": { "type": "object" },
    "executionIsolation": { "type": "object" },
    "operationalStorage": { "type": "object" },
    "recoverySimulation": { "type": "object" },
    "executionReconciliation": { "type": "object" },
    "cloudflareDurableRuntime": { "type": "object" },
    "walLifecycle": { "type": "object" },
    "leaseHeartbeat": { "type": "object" },
    "splitBrainPrevention": { "type": "object" },
    "resumableExecution": { "type": "object" },
    "distributedConflictArbitration": { "type": "object" },
    "crdtConvergence": { "type": "object" },
    "adaptiveRecoveryThrottling": { "type": "object" },
    "durableObjectRecovery": { "type": "object" },
    "convergenceProof": { "type": "object" },
    "recoveryDrillGovernance": { "type": "object" },
    "validators": { "type": "array", "minItems": 20 },
    "failurePolicy": { "const": "fail-closed" }
  }
}
