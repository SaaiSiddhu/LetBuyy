{
  "$schema": "config/runtime/durable-execution-contract.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "durableExecution": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "baseExecutionContract": "config/runtime/distributed-execution-contract.json",
    "walFactory": "createExecutionWal",
    "walAppender": "appendExecutionWalEntry",
    "walFromPlan": "buildExecutionWalFromPlan",
    "restoreFunction": "restoreExecutionFromWal",
    "crashRecoveryFunction": "recoverExecutionAfterInterruption",
    "integrityAssertion": "assertExecutionWalIntegrity",
    "walPolicy": "append-only-execution-journal",
    "requiredStepFields": [
      "executionId",
      "orchestrationId",
      "executionSequence",
      "executionCheckpoint",
      "executionJournalEntry",
      "executionCausalityReference",
      "executionChecksum"
    ],
    "survives": [
      "process-restart",
      "runtime-interruption",
      "partial-execution-failure",
      "replay-reconstruction"
    ],
    "checkpointLineagePolicy": "previousWalChecksum-links-every-entry"
  },
  "leaseGovernance": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "arbitrationFunction": "arbitrateOrchestrationLease",
    "checkpointFunction": "reconcileLeaseCheckpoint",
    "revocationFunction": "revokeOrchestrationLease",
    "singleExecutorAssertion": "assertSingleAuthoritativeExecutor",
    "leasePolicy": "one-authoritative-executor-per-orchestration",
    "takeoverPolicy": "expired-lease-only-with-monotonic-fencing-token",
    "renewalPolicy": "same-owner-or-expired-takeover-only",
    "splitBrainPolicy": "hard-fail-on-active-owner-overlap"
  },
  "fencingGovernance": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "tokenFunction": "createFencingToken",
    "validationFunction": "validateFencingToken",
    "tokenPolicy": "monotonic-increment-only",
    "epochLineage": "workerEpoch-plus-leaseVersion-plus-fencingToken",
    "staleTokenPolicy": "reject-before-operation-apply"
  },
  "sagaRecovery": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "baseCompensationEngine": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "walAppender": "appendSagaWalEntry",
    "recoveryFunction": "recoverPersistentSaga",
    "assertionFunction": "assertSagaRecoverySafe",
    "compensationWalPolicy": "append-only-compensation-wal",
    "irreversibleOperationRegistry": "irreversibleOperationIds-in-checkpoint",
    "resumptionPolicy": "remaining-steps-derived-from-compensation-wal"
  },
  "distributedClock": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "lamportTick": "tickLamportClock",
    "lamportMerge": "mergeLamportClock",
    "vectorMerge": "mergeVectorClock",
    "timestampArbitration": "arbitrateCausalityTimestamp",
    "assertionFunction": "assertTemporalOrderingStable",
    "clockPolicy": "producer-time-plus-lamport-and-vector-clock",
    "forbiddenTemporalSources": [
      "Date.now",
      "new Date()",
      "Math.random"
    ],
    "replayTemporalPolicy": "logical-clock-ordering-precedes-wall-clock-observation"
  },
  "executionIsolation": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "graphCompiler": "compileExecutionAuthorityGraph",
    "assertionFunction": "assertExecutionIsolation",
    "capabilityModel": "deny-by-default-capability-token",
    "authorityPolicy": "one-runtime-owner-per-operation",
    "sandboxPolicy": "manifest-granted-or-deny-by-default",
    "trustDomains": [
      "worker-runtime",
      "queue-runtime",
      "replay-runtime",
      "projection-runtime",
      "deployment-runtime"
    ]
  },
  "operationalStorage": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "topologyCompiler": "compileOperationalStorageTopology",
    "assertionFunction": "assertOperationalStorageGovernance",
    "stateClasses": [
      "execution-wal",
      "saga-wal",
      "replay-checkpoint",
      "lineage-archive",
      "lease-checkpoint"
    ],
    "retentionPolicy": "retention-days-required-for-every-state-class",
    "archivalPolicy": "wal-hot-then-cold-with-provenance-required",
    "persistenceProvenance": "archivalLineageChecksum"
  },
  "recoverySimulation": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "simulationFunction": "simulateRecoveryPlayback",
    "assertionFunction": "assertRecoverySimulationStable",
    "simulationKinds": [
      "orchestration-recovery",
      "replay-restoration",
      "compensation-recovery",
      "checkpoint-restoration",
      "lease-failover",
      "wal-replay",
      "execution-continuation"
    ],
    "playbackPolicy": "expected-checksum-must-match-deterministic-playback",
    "equilibriumPolicy": "all-recovery-paths-converge-before-execute-mode"
  },
  "executionReconciliation": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "reconciliationFunction": "reconcileExecutionState",
    "assertionFunction": "assertExecutionReconciliationStable",
    "inputs": [
      "runtime-state",
      "execution-wal",
      "lease",
      "saga"
    ],
    "fixedPointPolicy": "wal-runtime-lease-saga-fixed-point-required",
    "oscillationPolicy": "duplicate-reconciliation-actions-hard-fail"
  },
  "cloudflareDurableRuntime": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "bindingOwnershipManifest": "config/runtime/cloudflare-binding-ownership.json",
    "compiler": "compileCloudflareDurableExecutionLineage",
    "assertionFunction": "assertCloudflareDurableExecutionLineage",
    "requiredExplicitBindings": [
      "vars",
      "kv_namespaces",
      "r2_buckets",
      "queues",
      "durable_objects",
      "services",
      "telemetry"
    ],
    "durableObjectPolicy": "namespace-and-migration-owned-per-environment",
    "executionLeaseOwnership": "durable-object-namespace-per-worker-environment",
    "remoteReconciliationPolicy": "plan-only-until-execute-mode-credentials-exist"
  },
  "walLifecycle": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "segmentFunction": "segmentExecutionWal",
    "planFunction": "compileWalLifecyclePlan",
    "restorationFunction": "restoreWalEntriesFromCursor",
    "assertionFunction": "assertWalLifecycleDeterministic",
    "rotationPolicy": "deterministic-sequence-window-rotation",
    "compactionPolicy": "replay-safe-snapshot-before-compaction",
    "corruptionPolicy": "checksum-lineage-hard-fail",
    "cursorPolicy": "replay-cursor-restored-from-segment-boundary",
    "archivalPolicy": "wal-ancestry-required-before-cold-archive"
  },
  "leaseHeartbeat": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "heartbeatFunction": "recordLeaseHeartbeat",
    "reconciliationFunction": "reconcileLeaseHeartbeats",
    "assertionFunction": "assertLeaseHeartbeatSafe",
    "heartbeatPolicy": "monotonic-heartbeat-sequence-per-lease-owner",
    "staleExecutorPolicy": "evict-expired-heartbeat-before-takeover",
    "starvationPolicy": "oldest-expired-lease-takeover-before-new-work",
    "driftPolicy": "heartbeat-checksum-and-epoch-validation-required"
  },
  "splitBrainPrevention": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "simulationFunction": "simulateSplitBrain",
    "assertionFunction": "assertLeaseHeartbeatSafe",
    "authorityPolicy": "single-authoritative-owner-after-fencing-replay",
    "conflictPolicy": "higher-epoch-then-higher-fencing-token-wins",
    "recoveryPolicy": "reject-stale-executor-and-replay-authoritative-heartbeat",
    "failurePolicy": "hard-fail-if-concurrent-authority-survives"
  },
  "resumableExecution": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "cursorFunction": "compileResumableDagCursor",
    "restoreFunction": "restoreExecutionContinuation",
    "assertionFunction": "assertResumableDagExecution",
    "cursorPolicy": "persisted-orchestration-cursor-per-checkpoint",
    "continuationPolicy": "dependencies-completed-before-next-node",
    "branchPolicy": "execution-branch-continuation-checksum-required",
    "survives": [
      "restart",
      "interruption",
      "partial-compensation",
      "replay-continuation"
    ]
  },
  "distributedConflictArbitration": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "arbitrationFunction": "arbitrateDistributedConflicts",
    "assertionFunction": "assertDistributedConflictArbitration",
    "authorityPolicy": "lowest-authority-rank-then-highest-version-wins",
    "staleAuthorityPolicy": "selected-owner-removes-stale-authorities",
    "replayPolicy": "conflict-lineage-checksum-required",
    "mergePolicy": "deterministic-arbitration-dag-before-reconciliation"
  },
  "crdtConvergence": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "mergeFunction": "mergeCrdtLattice",
    "assertionFunction": "assertCrdtConvergence",
    "mergePolicy": "monotonic-lattice-join",
    "orderingPolicy": "replay-safe-lexicographic-merge-order",
    "oscillationPolicy": "monotonic-state-only",
    "proofPolicy": "lattice-checksum-required"
  },
  "adaptiveRecoveryThrottling": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "allocatorFunction": "allocateAdaptiveRecoveryBudgets",
    "assertionFunction": "assertAdaptiveRecoveryThrottling",
    "governorPolicy": "deterministic-token-bucket-recovery-governor",
    "stormPrevention": [
      "replay",
      "compensation",
      "queue-rebuild"
    ],
    "budgetPolicy": "weighted-by-backlog-error-rate-and-priority",
    "starvationPolicy": "at-least-one-token-per-active-kind"
  },
  "durableObjectRecovery": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "planFunction": "compileDurableObjectRecoveryPlan",
    "assertionFunction": "assertDurableObjectRecovery",
    "bindingOwnershipManifest": "config/runtime/cloudflare-binding-ownership.json",
    "requiredEnvironments": [
      "staging",
      "production"
    ],
    "migrationPolicy": "durable-object-migration-lineage-per-environment",
    "resurrectionPolicy": "snapshot-and-replay-cursor-required",
    "bindingPolicy": "non-inheritable-binding-explicit-per-environment"
  },
  "convergenceProof": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "proofFunction": "compileConvergenceProof",
    "assertionFunction": "assertConvergenceProof",
    "boundedPolicy": "observed-iterations-must-not-exceed-max-iterations",
    "livenessPolicy": "positive-bound-required-for-orchestration-liveness",
    "deadlockPolicy": "acyclic-dag-and-terminal-fixed-point-required",
    "equilibriumPolicy": "fixed-point-and-theorem-checksum-required"
  },
  "recoveryDrillGovernance": {
    "engineSource": "services/api-gateway/src/execution/event-execution.adapter.ts",
    "runtimeFunction": "replayRecoveryDrill",
    "assertionFunction": "assertRecoveryDrillLineage",
    "drillKinds": [
      "replay-restoration",
      "wal-corruption",
      "checkpoint-corruption",
      "lease-failover",
      "compensation-interruption",
      "queue-reconstruction",
      "orchestration-replay"
    ],
    "lineagePolicy": "deterministic-drill-lineage-checksum-required",
    "evidencePolicy": "governance-drills-are-not-live-operational-evidence"
  },
  "validators": [
    "durable-execution-validator",
    "lease-governance-validator",
    "fencing-token-validator",
    "saga-recovery-validator",
    "distributed-clock-validator",
    "execution-isolation-validator",
    "operational-storage-validator",
    "recovery-simulation-validator",
    "execution-reconciliation-validator",
    "durable-cloudflare-runtime-validator",
    "wal-lifecycle-validator",
    "lease-heartbeat-validator",
    "split-brain-validator",
    "resumable-execution-validator",
    "distributed-conflict-validator",
    "crdt-convergence-validator",
    "adaptive-throttling-validator",
    "durable-object-recovery-validator",
    "convergence-proof-validator",
    "recovery-drill-validator"
  ],
  "failurePolicy": "fail-closed"
}
