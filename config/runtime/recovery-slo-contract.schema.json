{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Recovery SLO Contract",
  "type": "object",
  "required": [
    "$schema",
    "contractVersion",
    "mode",
    "budgets",
    "boundedConvergence",
    "failurePolicy"
  ],
  "properties": {
    "$schema": { "const": "config/runtime/recovery-slo-contract.schema.json" },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "local-executable-evidence-not-production-certification" },
    "budgets": { "type": "object" },
    "boundedConvergence": { "type": "object" },
    "failurePolicy": { "const": "fail-closed" }
  }
}
