{
  "$schema": "config/runtime/runtime-orchestration-manifest.schema.json",
  "manifestVersion": 1,
  "mode": "governance-contract-not-live-evidence",
  "runtimeReconciliation": {
    "engineSource": "packages/distributed-runtime/src/runtime-reconciliation-runtime.ts",
    "topologyManifest": "config/runtime/deployment-topology.json",
    "desiredResourceSources": [
      {
        "kind": "worker",
        "manifest": "config/runtime/cloudflare-binding-ownership.json",
        "owner": "workers[].runtimeRoot",
        "environments": ["dev", "staging", "production"]
      },
      {
        "kind": "queue",
        "manifest": "config/runtime/queue-lifecycle-manifest.json",
        "owner": "queues[].consumerRoot",
        "environments": ["dev", "staging", "production"]
      },
      {
        "kind": "projection",
        "manifest": "config/runtime/projection-recovery-manifest.json",
        "owner": "projections[].ownerRuntime",
        "environments": ["dev", "staging", "production"]
      },
      {
        "kind": "replay-stream",
        "manifest": "config/runtime/replay-evolution-manifest.json",
        "owner": "eventFamilies[].ownerPackage",
        "environments": ["dev", "staging", "production"]
      }
    ],
    "requiredActions": ["noop", "create-missing", "update-drift", "quarantine-orphan"],
    "orphanPolicy": "quarantine-orphan",
    "driftPolicy": "fail-closed-before-activation",
    "cleanAssertion": "assertRuntimeReconciliationClean"
  },
  "deploymentOrchestration": {
    "engineSource": "packages/distributed-runtime/src/deployment-orchestration-runtime.ts",
    "promotionOrder": ["local", "dev", "staging", "production"],
    "topologyManifest": "config/runtime/deployment-topology.json",
    "activationSource": "buildRuntimeStartupPlan",
    "stageGatePolicy": "each-stage-must-have-fail-closed-gates",
    "stages": [
      {
        "environment": "local",
        "stageName": "local-governance",
        "order": 1,
        "runtimeRoots": ["database/supabase", "services/api-gateway", "services/webhook-service", "services/queue-workers"],
        "requiredGates": ["validate:runtime", "validate:replay", "validate:queues", "validate:deployment"]
      },
      {
        "environment": "dev",
        "stageName": "dev-runtime-activation",
        "order": 2,
        "runtimeRoots": ["database/supabase", "services/queue-workers", "services/api-gateway", "services/webhook-service"],
        "requiredGates": ["validate:reconciliation", "validate:runtime", "validate:cloudflare", "validate:deployment"]
      },
      {
        "environment": "staging",
        "stageName": "staging-runtime-activation",
        "order": 3,
        "runtimeRoots": ["database/supabase", "services/queue-workers", "services/api-gateway", "services/webhook-service"],
        "requiredGates": ["validate:reconciliation", "validate:runtime", "validate:replay", "validate:queues", "validate:deployment"]
      },
      {
        "environment": "production",
        "stageName": "production-runtime-activation",
        "order": 4,
        "runtimeRoots": ["database/supabase", "services/queue-workers", "services/api-gateway", "services/webhook-service"],
        "requiredGates": ["validate:governance", "validate:reconciliation", "validate:runtime", "validate:replay", "validate:rollback", "validate:queues", "validate:deployment", "validate:cloudflare"]
      }
    ]
  },
  "rollbackOrchestration": {
    "engineSource": "packages/distributed-runtime/src/rollback-orchestration-runtime.ts",
    "lineageManifest": "config/runtime/deployment-lineage-manifest.json",
    "requiresPreviousVersionId": true,
    "requiresReason": true,
    "sequencing": "reverse-runtime-activation-for-worker-roots",
    "steps": [
      {
        "environment": "production",
        "runtimeRoot": "services/webhook-service",
        "workerName": "letbuyy-webhooks",
        "order": 1,
        "requiredGates": ["validate:rollback", "validate:replay", "validate:queues", "validate:migrations"],
        "preserves": ["replay", "projection", "queue", "migration", "deployment-lineage"]
      },
      {
        "environment": "production",
        "runtimeRoot": "services/api-gateway",
        "workerName": "letbuyy-api",
        "order": 2,
        "requiredGates": ["validate:rollback", "validate:replay", "validate:queues", "validate:migrations"],
        "preserves": ["replay", "projection", "queue", "migration", "deployment-lineage"]
      },
      {
        "environment": "production",
        "runtimeRoot": "services/queue-workers",
        "workerName": "letbuyy-queue-workers",
        "order": 3,
        "requiredGates": ["validate:rollback", "validate:replay", "validate:queues", "validate:migrations"],
        "preserves": ["replay", "projection", "queue", "migration", "deployment-lineage"]
      }
    ]
  },
  "projectionReconciliation": {
    "engineSource": "packages/projection-runtime/src/projection-reconciliation-runtime.ts",
    "recoveryManifest": "config/runtime/projection-recovery-manifest.json",
    "ownerRuntime": "services/queue-workers",
    "requiredActions": ["none", "rebuild", "restore-snapshot", "block-owner-drift"],
    "hashValidation": "projectionIntegrityHash",
    "checkpointValidation": "sourceGlobalPosition-required"
  },
  "queueRecovery": {
    "engineSource": "packages/distributed-runtime/src/queue-recovery-orchestration-runtime.ts",
    "lifecycleManifest": "config/runtime/queue-lifecycle-manifest.json",
    "requiredActions": ["none", "reconcile-retries", "quarantine-poison", "operator-redrive-review"],
    "deadLetterPolicy": "operator-approved-dry-run-before-mutating-redrive",
    "retryPolicy": "deterministic-retry-sequencing-from-manifest",
    "policies": [
      { "queueName": "letbuyy-events", "maxRetrying": 250, "maxDeadLetteredBeforeQuarantine": 25, "maxPoisonMessages": 0 },
      { "queueName": "letbuyy-analytics", "maxRetrying": 500, "maxDeadLetteredBeforeQuarantine": 50, "maxPoisonMessages": 0 },
      { "queueName": "letbuyy-search-indexing", "maxRetrying": 300, "maxDeadLetteredBeforeQuarantine": 30, "maxPoisonMessages": 0 },
      { "queueName": "letbuyy-notifications", "maxRetrying": 300, "maxDeadLetteredBeforeQuarantine": 30, "maxPoisonMessages": 0 },
      { "queueName": "letbuyy-production-queue", "maxRetrying": 200, "maxDeadLetteredBeforeQuarantine": 20, "maxPoisonMessages": 0 }
    ]
  },
  "replayRecovery": {
    "engineSource": "packages/distributed-runtime/src/replay-recovery-runtime.ts",
    "evolutionManifest": "config/runtime/replay-evolution-manifest.json",
    "orderingPolicy": "global-position-and-stream-position-strictly-increasing",
    "checksumPolicy": "event-checksum-must-match-replay-evolution-fixture",
    "recoveryPlans": [
      {
        "recoveryId": "checkout-order-replay-reconstruction-v1",
        "streamName": "site_fixture_1:order:ord_fixture_1",
        "expectedProjectionChecksum": "77e95d5b",
        "events": [
          { "eventId": "evt_fixture_0001", "eventType": "order.created", "schemaVersion": 1, "globalPosition": 1, "streamPosition": 1, "checksum": "da9a2c09" },
          { "eventId": "evt_fixture_0002", "eventType": "payment.authorized", "schemaVersion": 1, "globalPosition": 2, "streamPosition": 2, "checksum": "781109fa" },
          { "eventId": "evt_fixture_0003", "eventType": "fulfillment.queued", "schemaVersion": 1, "globalPosition": 3, "streamPosition": 3, "checksum": "557a2bb1" }
        ]
      }
    ]
  },
  "stateMachines": [
    {
      "kind": "runtime",
      "initialState": "declared",
      "terminalStates": ["active", "quarantined"],
      "transitions": [
        { "from": "declared", "to": "reconciled", "command": "reconcile", "requires": ["runtime-reconciliation-validator"] },
        { "from": "reconciled", "to": "validated", "command": "validate", "requires": ["runtime-state-machine-validator", "manifest-lineage-validator"] },
        { "from": "validated", "to": "active", "command": "activate", "requires": ["deployment-orchestration-validator"] },
        { "from": "declared", "to": "quarantined", "command": "quarantine", "requires": ["runtime-reconciliation-validator"] }
      ]
    },
    {
      "kind": "deployment",
      "initialState": "planned",
      "terminalStates": ["activated", "blocked"],
      "transitions": [
        { "from": "planned", "to": "reconciled", "command": "reconcile", "requires": ["runtime-reconciliation-validator"] },
        { "from": "reconciled", "to": "sequenced", "command": "sequence", "requires": ["deployment-orchestration-validator"] },
        { "from": "sequenced", "to": "activated", "command": "activate", "requires": ["validate:runtime", "validate:deployment"] },
        { "from": "planned", "to": "blocked", "command": "block", "requires": ["manifest-lineage-validator"] }
      ]
    },
    {
      "kind": "rollback",
      "initialState": "requested",
      "terminalStates": ["rolled-back", "blocked"],
      "transitions": [
        { "from": "requested", "to": "lineage-verified", "command": "verify-lineage", "requires": ["rollback-orchestration-validator", "deployment-lineage-validator"] },
        { "from": "lineage-verified", "to": "compatibility-verified", "command": "verify-compatibility", "requires": ["validate:replay", "validate:queues", "validate:migrations"] },
        { "from": "compatibility-verified", "to": "rolled-back", "command": "execute-wrapper", "requires": ["validate:rollback"] },
        { "from": "requested", "to": "blocked", "command": "block", "requires": ["rollback-orchestration-validator"] }
      ]
    },
    {
      "kind": "replay",
      "initialState": "source-events-declared",
      "terminalStates": ["reconstructed", "blocked"],
      "transitions": [
        { "from": "source-events-declared", "to": "ordered", "command": "verify-order", "requires": ["replay-recovery-validator"] },
        { "from": "ordered", "to": "checksummed", "command": "verify-checksums", "requires": ["replay-evolution-validator"] },
        { "from": "checksummed", "to": "reconstructed", "command": "reconstruct", "requires": ["validate:replay"] },
        { "from": "source-events-declared", "to": "blocked", "command": "block", "requires": ["replay-recovery-validator"] }
      ]
    },
    {
      "kind": "projection",
      "initialState": "snapshot-declared",
      "terminalStates": ["reconciled", "blocked"],
      "transitions": [
        { "from": "snapshot-declared", "to": "hash-verified", "command": "verify-hash", "requires": ["projection-recovery-validator"] },
        { "from": "hash-verified", "to": "owner-verified", "command": "verify-owner", "requires": ["projection-reconciliation-validator"] },
        { "from": "owner-verified", "to": "reconciled", "command": "reconcile", "requires": ["projection-reconciliation-validator"] },
        { "from": "snapshot-declared", "to": "blocked", "command": "block", "requires": ["projection-reconciliation-validator"] }
      ]
    },
    {
      "kind": "queue",
      "initialState": "manifest-declared",
      "terminalStates": ["recoverable", "blocked"],
      "transitions": [
        { "from": "manifest-declared", "to": "bindings-verified", "command": "verify-bindings", "requires": ["cloudflare-binding-validator", "queue-lifecycle-validator"] },
        { "from": "bindings-verified", "to": "retry-policy-verified", "command": "verify-retry", "requires": ["queue-recovery-validator"] },
        { "from": "retry-policy-verified", "to": "recoverable", "command": "mark-recoverable", "requires": ["validate:queues"] },
        { "from": "manifest-declared", "to": "blocked", "command": "block", "requires": ["queue-recovery-validator"] }
      ]
    }
  ],
  "manifestEvolution": {
    "lineageManifest": "config/runtime/manifest-lineage.json",
    "checksumAlgorithm": "sha256",
    "compatibilityPolicy": "manifest-changes-require-validator-and-test-updates",
    "migrationPolicy": "additive-or-explicit-manifest-migration"
  },
  "cloudflareOrchestration": {
    "bindingOwnershipManifest": "config/runtime/cloudflare-binding-ownership.json",
    "requiredWrappers": [
      "infrastructure/scripts/deploy/deploy-worker-runtime.mjs",
      "infrastructure/scripts/deploy/production-deploy.mjs",
      "infrastructure/scripts/deploy/production-rollback.mjs"
    ],
    "requiresExplicitEnv": true,
    "requiresBindingValidation": true,
    "requiresWorkerOwnershipValidation": true,
    "requiresQueueOwnershipValidation": true,
    "requiresKvR2OwnershipValidation": true,
    "remoteResourceReconciliation": "plan-only-until-execute-mode-credentials-exist",
    "rawDeployBypassPolicy": "forbidden"
  },
  "validators": [
    "runtime-reconciliation-validator",
    "deployment-orchestration-validator",
    "rollback-orchestration-validator",
    "replay-recovery-validator",
    "projection-reconciliation-validator",
    "queue-recovery-validator",
    "runtime-state-machine-validator",
    "manifest-lineage-validator"
  ],
  "failurePolicy": "fail-closed"
}
