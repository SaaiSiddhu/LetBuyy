{
  "$schema": "config/runtime/environment-lifecycle.schema.json",
  "lifecycleVersion": 1,
  "promotionOrder": [
    "staging",
    "production"
  ],
  "isolationRules": {
    "mustSeparate": [
      "secrets",
      "databases",
      "queues",
      "event stores",
      "replay checkpoints",
      "telemetry backends",
      "feature flag stores",
      "provider accounts",
      "deployment credentials",
      "certification evidence"
    ],
    "forbidden": [
      "sharing production secrets with lower environments",
      "sending lower-environment traffic to production providers",
      "promoting code without staging rehearsal evidence",
      "marking live certification without fresh provider execution evidence"
    ]
  },
  "environments": [
    {
      "name": "staging",
      "stability": "production-mirror-rehearsal",
      "credentialsMode": "isolated staging secret store",
      "dataIsolation": "staging-only traffic, data, queues, telemetry, providers, and feature flags",
      "regions": [
        "ap-south-1",
        "ap-southeast-1",
        "us-east-1",
        "eu-west-1"
      ],
      "topology": {
        "mirrorProductionTopology": true,
        "database": "staging primary plus rehearsal replicas",
        "queues": [
          "letbuyy-events-staging",
          "letbuyy-analytics-queue-staging",
          "letbuyy-search-queue-staging",
          "letbuyy-notifications-queue-staging",
          "letbuyy-dead-letters-staging",
          "letbuyy-staging-queue",
          "letbuyy-staging-dead-letter-queue"
        ],
        "kvNamespace": "letbuyy-cache-staging",
        "r2Bucket": "letbuyy-media-staging",
        "d1Database": "letbuyy-staging-d1",
        "telemetryDataset": "letbuyy-staging-telemetry",
        "eventStore": "staging append-only event store",
        "replayRuntime": "staging replay workers",
        "observability": "staging Prometheus/Grafana/Tempo/Loki",
        "controlPlane": "/v1/operations scoped to staging"
      },
      "providers": {
        "payments": [
          "Stripe test mode",
          "Razorpay test mode",
          "PayPal sandbox"
        ],
        "email": "staging sender domain",
        "sms": "sandbox gateway",
        "sideEffectPolicy": "no production mutation"
      },
      "featureFlags": {
        "store": "staging feature flag namespace",
        "defaultRollout": "canary, tenant, region, and percentage rehearsals",
        "auditing": true
      },
      "observability": {
        "required": [
          "traces",
          "metrics",
          "structured logs",
          "SLO burn rates",
          "queue lag",
          "replay integrity",
          "deployment scoring"
        ],
        "alerts": "paging rehearsal alerts"
      },
      "deployment": {
        "strategy": "production-equivalent canary and blue/green rehearsal",
        "gates": [
          "governance",
          "typecheck",
          "tests",
          "migration-rehearsal",
          "load-test",
          "chaos-drill",
          "failover-drill",
          "rollback-validation",
          "observability-validation"
        ],
        "rollback": "blue/green switchback and replay-safe queue cursor restore"
      },
      "evidence": {
        "mode": "staging-certification-evidence",
        "certifiableAsLive": false,
        "requiredRecords": [
          "production_readiness_gate_runs",
          "deployment_health_gate_results",
          "failover_drill_runs",
          "chaos_experiment_runs",
          "load_test_runs",
          "event_store_integrity_checks",
          "operational_dashboard_snapshots",
          "sre_error_budget_snapshots"
        ]
      }
    },
    {
      "name": "production",
      "stability": "customer-facing-live",
      "credentialsMode": "production secret stores only",
      "dataIsolation": "production data, queues, event store, telemetry, providers, and feature flags only",
      "regions": [
        "ap-south-1",
        "ap-southeast-1",
        "us-east-1",
        "eu-west-1"
      ],
      "topology": {
        "source": "config/runtime/production-topology.json",
        "database": "production Supabase/Postgres",
        "queues": [
          "letbuyy-events-production",
          "letbuyy-analytics-queue-production",
          "letbuyy-search-queue-production",
          "letbuyy-notifications-queue-production",
          "letbuyy-dead-letters-production",
          "letbuyy-production-queue",
          "letbuyy-production-dead-letter-queue"
        ],
        "kvNamespace": "letbuyy-cache-production",
        "r2Bucket": "letbuyy-media-production",
        "d1Database": "letbuyy-production-d1",
        "telemetryDataset": "letbuyy-production-telemetry",
        "eventStore": "production append-only event store",
        "replayRuntime": "production replay workers",
        "observability": "production telemetry stack",
        "controlPlane": "/v1/operations scoped to production"
      },
      "providers": {
        "payments": [
          "Stripe live",
          "Razorpay live",
          "PayPal live"
        ],
        "email": "production sender domain",
        "sms": "production gateway",
        "sideEffectPolicy": "governed-live-only-after-execute-mode"
      },
      "featureFlags": {
        "store": "production feature flag namespace",
        "defaultRollout": "off until approved; canary begins at 1 percent",
        "auditing": true,
        "instantDisablement": true
      },
      "observability": {
        "required": [
          "traces",
          "metrics",
          "structured logs",
          "SLO burn rates",
          "queue lag",
          "replay integrity",
          "deployment scoring",
          "incident timelines"
        ],
        "alerts": "paging production alerts"
      },
      "deployment": {
        "strategy": "credential-gated canary, blue/green, shadow traffic, and rollback automation",
        "gates": [
          "governance",
          "typecheck",
          "tests",
          "security",
          "migration",
          "load",
          "chaos",
          "failover",
          "observability",
          "SLO",
          "live-certification"
        ],
        "rollback": "automated production rollback plus evidence recording"
      },
      "evidence": {
        "mode": "fresh-live-execution-evidence",
        "certifiableAsLive": true,
        "requiredRecords": [
          "production_readiness_gate_runs",
          "deployment_health_gate_results",
          "failover_drill_runs",
          "chaos_experiment_runs",
          "load_test_runs",
          "security_enforcement_events",
          "event_store_integrity_checks",
          "operational_dashboard_snapshots",
          "sre_error_budget_snapshots",
          "operational_certification_reports"
        ]
      }
    }
  ]
}
