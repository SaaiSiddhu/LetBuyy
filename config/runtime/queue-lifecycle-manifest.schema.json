{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Queue Lifecycle Manifest",
  "type": "object",
  "required": ["$schema", "manifestVersion", "mode", "producerConfig", "consumerConfig", "environments", "queues", "gates"],
  "properties": {
    "$schema": { "const": "config/runtime/queue-lifecycle-manifest.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "producerConfig": { "const": "services/api-gateway/wrangler.toml" },
    "consumerConfig": { "const": "services/queue-workers/wrangler.toml" },
    "environments": { "type": "object" },
    "queues": { "type": "array", "minItems": 1 },
    "gates": { "type": "array", "minItems": 1 }
  }
}
