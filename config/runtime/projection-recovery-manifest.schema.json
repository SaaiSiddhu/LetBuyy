{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Projection Recovery Manifest",
  "type": "object",
  "required": ["$schema", "manifestVersion", "mode", "projections", "recoveryGates"],
  "properties": {
    "$schema": { "const": "config/runtime/projection-recovery-manifest.schema.json" },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "mode": { "const": "governance-contract-not-live-evidence" },
    "projections": { "type": "array", "minItems": 1 },
    "recoveryGates": { "type": "array", "minItems": 1 }
  }
}
