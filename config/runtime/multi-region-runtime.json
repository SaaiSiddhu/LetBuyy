{
  "$schema": "config/runtime/multi-region-runtime.schema.json",
  "contractVersion": 1,
  "regions": [
    {
      "id": "india",
      "primaryRegion": "ap-south-1",
      "cloudflarePlacement": "global-edge",
      "tenantAffinity": "india-first",
      "queueNamespace": "letbuyy-india",
      "telemetryLabel": "region=\"india\""
    },
    {
      "id": "apac",
      "primaryRegion": "ap-southeast-1",
      "cloudflarePlacement": "global-edge",
      "tenantAffinity": "apac",
      "queueNamespace": "letbuyy-apac",
      "telemetryLabel": "region=\"apac\""
    },
    {
      "id": "eu",
      "primaryRegion": "eu-west-1",
      "cloudflarePlacement": "global-edge",
      "tenantAffinity": "eu",
      "queueNamespace": "letbuyy-eu",
      "telemetryLabel": "region=\"eu\""
    },
    {
      "id": "us",
      "primaryRegion": "us-east-1",
      "cloudflarePlacement": "global-edge",
      "tenantAffinity": "us",
      "queueNamespace": "letbuyy-us",
      "telemetryLabel": "region=\"us\""
    }
  ],
  "failoverPairs": [
    {
      "source": "india",
      "target": "apac",
      "rtoSeconds": 300,
      "rpoSeconds": 60,
      "replayRequired": true
    },
    {
      "source": "eu",
      "target": "us",
      "rtoSeconds": 600,
      "rpoSeconds": 120,
      "replayRequired": true
    },
    {
      "source": "us",
      "target": "eu",
      "rtoSeconds": 600,
      "rpoSeconds": 120,
      "replayRequired": true
    }
  ],
  "replayIntegrity": {
    "checksumRequired": true,
    "projectionComparisonRequired": true,
    "eventOrderMustBePreserved": true,
    "regionalReplayEvidence": "event_store_integrity_checks",
    "failClosedOnDivergence": true
  }
}
