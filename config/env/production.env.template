# LetBuyy Production Environment Variables
# Legacy compatibility template only. Prefer production.env.example plus
# secret-manager-backed Vercel, Cloudflare, Supabase, and provider stores.
# NEVER commit actual values.

# ========== SUPABASE (Letbuyy-Store-Production) ==========
NEXT_PUBLIC_SUPABASE_URL=https://[PRODUCTION_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[PROD_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[PROD_SERVICE_ROLE_KEY]
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ========== UPSTASH REDIS (Leetbuyy-Store-Production) ==========
UPSTASH_REDIS_REST_URL=https://[PROD_REDIS_HOST].upstash.io
UPSTASH_REDIS_REST_TOKEN=[PROD_REDIS_TOKEN]

# ========== CLOUDFLARE ==========
CLOUDFLARE_API_TOKEN=[CF_API_TOKEN]
CLOUDFLARE_ACCOUNT_ID=[CF_ACCOUNT_ID]

# ========== VERCEL / CI ==========
VERCEL_TOKEN=[VERCEL_TOKEN]
VERCEL_ORG_ID=[VERCEL_ORG_ID]
VERCEL_PROJECT_ID_MARKETING=[VERCEL_PROJECT_ID_MARKETING]
VERCEL_PROJECT_ID_IDENTITY=[VERCEL_PROJECT_ID_IDENTITY]
VERCEL_PROJECT_ID_MERCHANT=[VERCEL_PROJECT_ID_MERCHANT]
VERCEL_PROJECT_ID_STOREFRONT=[VERCEL_PROJECT_ID_STOREFRONT]
VERCEL_PROJECT_ID_APP_MARKETPLACE=[VERCEL_PROJECT_ID_APP_MARKETPLACE]
VERCEL_PROJECT_ID_THEME_MARKETPLACE=[VERCEL_PROJECT_ID_THEME_MARKETPLACE]
VERCEL_PROJECT_ID_PLATFORM_CONSOLE=[VERCEL_PROJECT_ID_PLATFORM_CONSOLE]
VERCEL_PROJECT_ID_PLATFORM_OPERATIONS_PORTAL=[VERCEL_PROJECT_ID_PLATFORM_OPERATIONS_PORTAL]
SUPABASE_ACCESS_TOKEN=[SUPABASE_ACCESS_TOKEN]
PRODUCTION_SUPABASE_PROJECT_REF=[PRODUCTION_PROJECT_REF]
PRODUCTION_SUPABASE_URL=https://[PRODUCTION_PROJECT_REF].supabase.co
PRODUCTION_SUPABASE_ANON_KEY=[PROD_ANON_KEY]
PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=[PROD_SERVICE_ROLE_KEY]
PRODUCTION_DB_CONNECTION_STRING=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ========== RAZORPAY LIVE MODE ==========
RAZORPAY_KEY_ID=rzp_live_[KEY]
RAZORPAY_KEY_SECRET=[LIVE_SECRET]
RAZORPAY_WEBHOOK_SECRET=[LIVE_WEBHOOK_SECRET]
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_[KEY]

# ========== RAZORPAY ROUTE / PAYOUT RAILS ==========
RAZORPAY_ROUTE_ACCOUNT_ID=[LIVE_ROUTE_ACCOUNT_ID]
RAZORPAY_ROUTE_KEY_SECRET=[LIVE_ROUTE_SECRET]
RAZORPAY_ROUTE_WEBHOOK_SECRET=[LIVE_ROUTE_WEBHOOK_SECRET]
RAZORPAY_ROUTE_MODE=live

# ========== STRIPE LIVE MODE ==========
STRIPE_SECRET_KEY=sk_live_[KEY]
STRIPE_WEBHOOK_SECRET=whsec_[LIVE_WEBHOOK_SECRET]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_[KEY]

# ========== PAYPAL LIVE ==========
PAYPAL_CLIENT_ID=[LIVE_CLIENT_ID]
PAYPAL_CLIENT_SECRET=[LIVE_SECRET]
PAYPAL_WEBHOOK_ID=[LIVE_WEBHOOK_ID]

# ========== CASHFREE LIVE ==========
CASHFREE_APP_ID=[LIVE_APP_ID]
CASHFREE_SECRET_KEY=[LIVE_SECRET]
CASHFREE_ENVIRONMENT=production
CASHFREE_API_VERSION=2025-01-01

# ========== RESEND (EMAIL) ==========
RESEND_API_KEY=re_[PROD_KEY]
EMAIL_FROM=noreply@letbuyy.store
RESEND_FROM_EMAIL=noreply@letbuyy.store

# ========== SOCIAL OAUTH ==========
GOOGLE_OAUTH_CLIENT_ID=[GOOGLE_PROD_CLIENT_ID]
GOOGLE_OAUTH_CLIENT_SECRET=[GOOGLE_PROD_CLIENT_SECRET]
APPLE_OAUTH_CLIENT_ID=[APPLE_PROD_CLIENT_ID]
APPLE_OAUTH_CLIENT_SECRET=[APPLE_PROD_CLIENT_SECRET]
OAUTH_REDIRECT_URL=https://accounts.letbuyy.store/auth/callback

# ========== CLOUDFLARE TURNSTILE ==========
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[PROD_SITE_KEY]
TURNSTILE_SECRET_KEY=[PROD_SECRET_KEY]

# ========== SESSION / AUTH SECRETS ==========
SESSION_SECRET=[64_char_random_hex_DIFFERENT_FROM_STAGING]
AUTH_SECRET=[64_char_random_hex_DIFFERENT_FROM_STAGING]
CUSTOMER_SESSION_SECRET=[64_char_random_hex_DIFFERENT_FROM_STAGING]
COOKIE_DOMAIN=.letbuyy.store
ADMIN_ORIGIN=https://admin.letbuyy.store

# ========== INTERNAL SERVICE AUTH ==========
INTERNAL_API_SECRET=[32_char_random_hex_DIFFERENT_FROM_STAGING]
WORKER_INTERNAL_SECRET=[32_char_random_hex_DIFFERENT_FROM_STAGING]

# ========== APP URLS (PRODUCTION) ==========
NEXT_PUBLIC_APP_URL=https://letbuyy.store
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.letbuyy.store
NEXT_PUBLIC_ADMIN_URL=https://admin.letbuyy.store
NEXT_PUBLIC_API_URL=https://api.letbuyy.store
NEXT_PUBLIC_API_BASE_URL=https://api.letbuyy.store/v1
WORKER_API_BASE_URL=https://api.letbuyy.store
ASSET_PUBLIC_BASE_URL=https://cdn.letbuyy.store

# ========== PLATFORM CONSOLE ==========
PLATFORM_CONSOLE_ALLOWED_EMAILS=[PRODUCTION_OPERATOR_EMAILS]
PLATFORM_CONSOLE_API_TOKEN=[32_char_random_hex_DIFFERENT_FROM_STAGING]

# ========== ENVIRONMENT LABEL ==========
NODE_ENV=production
NEXT_PUBLIC_ENV=production
