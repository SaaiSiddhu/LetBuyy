{
  "$schema": "./schemas/staging-production-secret-matrix.schema.json",
  "version": 1,
  "policy": {
    "deploymentTargets": [
      "staging",
      "production"
    ],
    "localPolicy": "removed",
    "localMustNotUse": [
      "repository env files",
      "local emulators",
      "development secret files"
    ],
    "secretHandling": "secret-manager-only",
    "notes": [
      "Local execution is not a supported environment.",
      "Staging and production values must be unique per environment.",
      "NEXT_PUBLIC_* values are public configuration only and must not contain server secrets."
    ]
  },
  "stores": {
    "vercel": "Next app project environment variables",
    "cloudflare": "Worker secrets and resource bindings",
    "supabase": "Supabase project dashboard or API",
    "provider": "Provider dashboards for payment, email, bot protection, and cache services",
    "github": "CI/CD automation secrets only"
  },
  "nextApps": {
    "owners": [
      "apps/marketing/web",
      "apps/platform/identity",
      "apps/merchant/web",
      "apps/commerce/web",
      "apps/internal/console"
    ],
    "public": [
      "NEXT_PUBLIC_API_URL",
      "NEXT_PUBLIC_API_BASE_URL",
      "NEXT_PUBLIC_ACCOUNTS_URL",
      "NEXT_PUBLIC_ADMIN_URL",
      "NEXT_PUBLIC_STOREFRONT_URL",
      "NEXT_PUBLIC_STORE_ROOT_DOMAIN",
      "NEXT_PUBLIC_STORE_ROOT_DOMAIN_ALIASES",
      "NEXT_PUBLIC_APP_URL",
      "NEXT_PUBLIC_APP_MARKETPLACE_URL",
      "NEXT_PUBLIC_DEVELOPER_PORTAL_URL",
      "NEXT_PUBLIC_SUPPORT_EMAIL",
      "NEXT_PUBLIC_ENV",
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
      "NEXT_PUBLIC_RAZORPAY_KEY_ID"
    ],
    "server": [
      "LETBUYY_API_URL",
      "LETBUYY_API_BASE_URL",
      "API_URL",
      "API_BASE_URL",
      "AUTH_SECRET",
      "CUSTOMER_SESSION_SECRET",
      "ACCOUNTS_COOKIE_SECRET",
      "LETBUYY_IDENTITY_ISSUER",
      "LETBUYY_IDENTITY_PRIVATE_JWK",
      "INTERNAL_API_SECRET",
      "QUEUE_TENANT_ENVELOPE_SECRET",
      "PREVIEW_SIGNING_KEY",
      "STORE_ACCESS_SIGNING_KEY",
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL",
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "APPLE_OAUTH_CLIENT_ID",
      "APPLE_OAUTH_CLIENT_SECRET",
      "OAUTH_REDIRECT_URL",
      "TURNSTILE_SECRET_KEY",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN",
      "COOKIE_DOMAIN",
      "ADMIN_ORIGIN"
    ],
    "platformConsoleOnly": [
      "LETBUYY_IDENTITY_URL",
      "PLATFORM_CONSOLE_API_BASE_URL"
    ],
    "operatorAuthentication": {
      "identityOnly": [
        "LETBUYY_IDENTITY_PRIVATE_JWK",
        "PLATFORM_CONSOLE_TOTP_SECRETS"
      ],
      "identityAndConsole": [
        "PLATFORM_CONSOLE_ALLOWED_EMAILS",
        "PLATFORM_CONSOLE_API_TOKEN"
      ],
      "publicVerificationOnConsoleAndGateway": [
        "LETBUYY_IDENTITY_ISSUER",
        "LETBUYY_IDENTITY_PUBLIC_JWKS"
      ],
      "transport": "PLATFORM_CONSOLE_API_TOKEN authenticates finite body-bound Console\u2192Identity requests and existing Console\u2192Gateway service transport; it is never a human identity or signing key. Identity\u2192Gateway uses fresh accounts transport proofs and durable replay claims.",
      "retiredFromCanonicalOperatorPath": [
        "PLATFORM_CONSOLE_SESSION_SECRET",
        "PLATFORM_CONSOLE_TOTP_SECRET"
      ],
      "rollout": "Local owned proof only. Hosted provisioning/cutover and approved inbox/provider delivery remain separately gated. Prior cookies must fail closed; operators sign in again after an approved cutover."
    }
  },
  "workers": {
    "owners": [
      "services/api-gateway",
      "services/webhook-service",
      "services/queue-workers"
    ],
    "perCallerInternalSecrets": {
      "note": "Each runtime signs outbound internal requests with its own secret (callerId \u2192 secret). The receiving runtime holds INTERNAL_API_KEYRING (JSON blob) mapping all caller IDs to their secrets. INTERNAL_AUTH_LEGACY_ACCEPT defaults ON \u2014 set to 'false' after all callers rotated per HR-SECRET-ROTATION.",
      "callerIds": {
        "services/api-gateway": "api-gateway",
        "services/webhook-service": "webhook-service",
        "services/queue-workers": "queue-workers",
        "services/mobile-bff": "mobile-bff",
        "apps/merchant/web": "merchant-web",
        "apps/commerce/web": "customer-web",
        "apps/platform/identity": "identity-platform",
        "apps/internal/console": "admin-web",
        "apps/marketing/web": "marketing-site"
      },
      "githubSecretSuffixes": {
        "api-gateway": "API_GATEWAY_INTERNAL_SECRET",
        "webhook-service": "WEBHOOK_SERVICE_INTERNAL_SECRET",
        "queue-workers": "QUEUE_WORKERS_INTERNAL_SECRET",
        "mobile-bff": "MOBILE_BFF_INTERNAL_SECRET",
        "merchant-web": "MERCHANT_CONTROL_PLANE_INTERNAL_SECRET",
        "customer-web": "STOREFRONT_RUNTIME_INTERNAL_SECRET",
        "identity-platform": "IDENTITY_PLATFORM_INTERNAL_SECRET",
        "admin-web": "PLATFORM_CONSOLE_INTERNAL_SECRET",
        "marketing-site": "MARKETING_SITE_INTERNAL_SECRET"
      },
      "keyringSuffix": "INTERNAL_API_KEYRING"
    },
    "requiredSecrets": [
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "AUTH_SECRET",
      "CSRF_SECRET",
      "STEP_UP_SIGNING_SECRET",
      "INTERNAL_API_SECRET",
      "LETBUYY_INTERNAL_API_SECRET",
      "INTERNAL_API_KEYRING",
      "QUEUE_TENANT_ENVELOPE_SECRET",
      "STAFF_INVITATION_SIGNING_SECRET",
      "PREVIEW_SIGNING_KEY",
      "STORE_ACCESS_SIGNING_KEY",
      "LETBUYY_IDENTITY_PUBLIC_JWKS",
      "PLATFORM_CONSOLE_API_TOKEN",
      "RAZORPAY_KEY_ID",
      "RAZORPAY_KEY_SECRET",
      "RAZORPAY_WEBHOOK_SECRET",
      "RAZORPAY_ROUTE_ACCOUNT_ID",
      "RAZORPAY_ROUTE_KEY_SECRET",
      "RAZORPAY_ROUTE_WEBHOOK_SECRET",
      "RAZORPAY_ROUTE_MODE",
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN",
      "PAYMENT_CONFIG_ENCRYPTION_KEY"
    ],
    "optionalProviderSecrets": [
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "PAYPAL_CLIENT_ID",
      "PAYPAL_CLIENT_SECRET",
      "PAYPAL_WEBHOOK_ID",
      "PAYPAL_MODE",
      "CASHFREE_APP_ID",
      "CASHFREE_SECRET_KEY",
      "CASHFREE_ENVIRONMENT",
      "CASHFREE_API_VERSION"
    ],
    "bindings": [
      "EVENT_QUEUE",
      "ANALYTICS_QUEUE",
      "SEARCH_QUEUE",
      "NOTIFICATION_QUEUE",
      "RUNTIME_QUEUE",
      "WEBHOOK_SERVICE",
      "API_GATEWAY_SERVICE",
      "R2_BUCKET",
      "CACHE",
      "RUNTIME_DB",
      "RUNTIME_COORDINATOR",
      "RUNTIME_TELEMETRY"
    ]
  },
  "supabase": {
    "staging": {
      "projectRefSecret": "STAGING_SUPABASE_PROJECT_REF",
      "urlSecret": "STAGING_SUPABASE_URL",
      "anonKeySecret": "STAGING_SUPABASE_ANON_KEY",
      "serviceRoleSecret": "STAGING_SUPABASE_SERVICE_ROLE_KEY",
      "dbConnectionSecret": "STAGING_DB_CONNECTION_STRING"
    },
    "production": {
      "projectRefSecret": "PRODUCTION_SUPABASE_PROJECT_REF",
      "urlSecret": "PRODUCTION_SUPABASE_URL",
      "anonKeySecret": "PRODUCTION_SUPABASE_ANON_KEY",
      "serviceRoleSecret": "PRODUCTION_SUPABASE_SERVICE_ROLE_KEY",
      "dbConnectionSecret": "PRODUCTION_DB_CONNECTION_STRING"
    }
  },
  "ciSecrets": {
    "shared": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "VERCEL_TOKEN",
      "VERCEL_ORG_ID",
      "VERCEL_API_TOKEN",
      "VERCEL_STOREFRONT_PROJECT_ID",
      "VERCEL_TEAM_ID",
      "SUPABASE_ACCESS_TOKEN"
    ],
    "vercelProjectIdSuffixes": [
      "MARKETING",
      "IDENTITY",
      "MERCHANT",
      "STOREFRONT",
      "PLATFORM_CONSOLE"
    ],
    "generatedSecretSuffixes": [
      "AUTH_SECRET",
      "CUSTOMER_SESSION_SECRET",
      "ACCOUNTS_COOKIE_SECRET",
      "STEP_UP_SIGNING_SECRET",
      "IDENTITY_PRIVATE_JWK",
      "IDENTITY_PUBLIC_JWKS",
      "INTERNAL_API_KEYRING",
      "QUEUE_TENANT_ENVELOPE_SECRET",
      "PREVIEW_SIGNING_KEY",
      "STORE_ACCESS_SIGNING_KEY",
      "CSRF_SECRET",
      "PLATFORM_CONSOLE_SESSION_SECRET",
      "PLATFORM_CONSOLE_TOTP_SECRET",
      "PLATFORM_CONSOLE_API_TOKEN",
      "PAYMENT_CONFIG_ENCRYPTION_KEY"
    ],
    "perCallerInternalSecretSuffixes": [
      "API_GATEWAY_INTERNAL_SECRET",
      "WEBHOOK_SERVICE_INTERNAL_SECRET",
      "QUEUE_WORKERS_INTERNAL_SECRET",
      "MOBILE_BFF_INTERNAL_SECRET",
      "MERCHANT_CONTROL_PLANE_INTERNAL_SECRET",
      "STOREFRONT_RUNTIME_INTERNAL_SECRET",
      "IDENTITY_PLATFORM_INTERNAL_SECRET",
      "PLATFORM_CONSOLE_INTERNAL_SECRET",
      "MARKETING_SITE_INTERNAL_SECRET"
    ],
    "oauthProviderSuffixes": [
      "GOOGLE_OAUTH_CLIENT_ID",
      "GOOGLE_OAUTH_CLIENT_SECRET",
      "APPLE_OAUTH_CLIENT_ID",
      "APPLE_OAUTH_CLIENT_SECRET",
      "OAUTH_REDIRECT_URL"
    ],
    "operatorConfigSuffixes": [
      "PLATFORM_CONSOLE_ALLOWED_EMAILS",
      "PLATFORM_CONSOLE_DEV_MFA_CODE"
    ],
    "publicConfigSuffixes": [
      "TURNSTILE_SITE_KEY",
      "RAZORPAY_KEY_ID"
    ],
    "providerSecretSuffixes": [
      "RAZORPAY_KEY_SECRET",
      "RAZORPAY_WEBHOOK_SECRET",
      "RAZORPAY_ROUTE_ACCOUNT_ID",
      "RAZORPAY_ROUTE_KEY_SECRET",
      "RAZORPAY_ROUTE_WEBHOOK_SECRET",
      "RAZORPAY_ROUTE_MODE",
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL",
      "UPSTASH_REDIS_REST_URL",
      "UPSTASH_REDIS_REST_TOKEN",
      "TURNSTILE_SECRET_KEY",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "PAYPAL_CLIENT_ID",
      "PAYPAL_CLIENT_SECRET",
      "PAYPAL_WEBHOOK_ID",
      "PAYPAL_MODE",
      "CASHFREE_APP_ID",
      "CASHFREE_SECRET_KEY",
      "CASHFREE_ENVIRONMENT",
      "CASHFREE_API_VERSION",
      "ABUSE_REPUTATION_API_URL",
      "ABUSE_REPUTATION_API_KEY",
      "REGISTRAR_PROVIDER",
      "REGISTRAR_API_URL",
      "REGISTRAR_RESELLER_ID",
      "REGISTRAR_API_KEY",
      "REGISTRAR_USERNAME",
      "REGISTRAR_PASSWORD",
      "REGISTRAR_DEFAULT_CURRENCY",
      "REGISTRAR_MOCK_ENABLED"
    ]
  }
}
