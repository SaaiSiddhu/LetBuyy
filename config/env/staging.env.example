# ============================================================
# LETBUYY STAGING ENVIRONMENT VARIABLES
# Copy these into Vercel environment variables for staging.
# Never commit real values — only this template.
# ============================================================

# API
NEXT_PUBLIC_API_URL=https://api-staging.letbuyy.store/v1
NEXT_PUBLIC_API_BASE_URL=https://api-staging.letbuyy.store/v1
LETBUYY_API_URL=https://api-staging.letbuyy.store/v1
LETBUYY_API_BASE_URL=https://api-staging.letbuyy.store/v1
API_URL=https://api-staging.letbuyy.store/v1
API_BASE_URL=https://api-staging.letbuyy.store/v1

# App URLs
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts-staging.letbuyy.store
NEXT_PUBLIC_ADMIN_URL=https://admin-staging.letbuyy.store
NEXT_PUBLIC_STOREFRONT_URL=https://store-staging.letbuyy.store
NEXT_PUBLIC_STOREFRONT_LOCAL_URL=https://store-staging.letbuyy.store
NEXT_PUBLIC_APP_URL=https://store-staging.letbuyy.store
NEXT_PUBLIC_ENV=staging

# Supabase (from config/supabase/staging.json after Phase 5)
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=STAGING_ANON_KEY
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=STAGING_SERVICE_ROLE_KEY

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
CUSTOMER_SESSION_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
LETBUYY_INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
CSRF_SECRET=generate-with-openssl-rand-base64-32
COOKIE_DOMAIN=.letbuyy.store
ADMIN_ORIGIN=https://admin-staging.letbuyy.store

# Email (Resend)
RESEND_API_KEY=re_staging_xxxx
RESEND_FROM_EMAIL=noreply@letbuyy.store

# Payments (Razorpay test keys for staging)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=razorpay_staging_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_staging_webhook_secret
PAYMENT_CONFIG_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Optional payment providers (configure only when enabled)
STRIPE_SECRET_KEY=stripe_staging_secret
STRIPE_WEBHOOK_SECRET=stripe_staging_webhook_secret
PAYPAL_CLIENT_ID=paypal_staging_client_id
PAYPAL_CLIENT_SECRET=paypal_staging_client_secret
PAYPAL_WEBHOOK_ID=paypal_staging_webhook_id
PAYPAL_MODE=sandbox

# Turnstile (Cloudflare)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=staging_turnstile_site_key
TURNSTILE_SECRET_KEY=staging_turnstile_secret_key

# Platform Console
PLATFORM_CONSOLE_ALLOWED_EMAILS=your@email.com
PLATFORM_CONSOLE_SESSION_SECRET=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_TOTP_SECRET=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_API_TOKEN=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_API_BASE_URL=https://api-staging.letbuyy.store/v1

# Upstash Redis (if used)
UPSTASH_REDIS_REST_URL=https://staging-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=staging_redis_token
