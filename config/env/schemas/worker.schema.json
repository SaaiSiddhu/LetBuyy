{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Worker Environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "properties": {
    "LETBUYY_MANAGED_PAYMENTS_MODE": {
      "type": "string",
      "enum": ["", "sandbox"],
      "description": "API-only managed test collections. Explicit non-production opt-in; never enables live payments."
    },
    "SUPABASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "SUPABASE_ANON_KEY": {
      "type": "string"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "type": "string"
    },
    "AUTH_SECRET": {
      "type": "string"
    },
    "CSRF_SECRET": {
      "type": "string"
    },
    "INTERNAL_API_SECRET": {
      "type": "string"
    },
    "INTERNAL_API_KEYRING": {
      "type": "string",
      "description": "API-only JSON caller key map. The reserved queue-workers-domain-reconcile entry authorizes only its bound maintenance request, never general app authentication."
    },
    "DOMAIN_RECONCILE_REQUEST_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "Queue-only dedicated domain-maintenance signing key; independent per environment. Its matching receiver entry is held only in the API keyring."
    },
    "PREVIEW_SIGNING_KEY": {
      "type": "string"
    },
    "STORE_ACCESS_SIGNING_KEY": {
      "type": "string"
    },
    "LETBUYY_INTERNAL_API_SECRET": {
      "type": "string"
    },
    "NEXT_PUBLIC_STORE_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "STOREFRONT_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "PLATFORM_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "CUSTOM_DOMAIN_CNAME_TARGET": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "PLATFORM_CONSOLE_API_TOKEN": {
      "type": "string"
    },
    "ENVIRONMENT": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "APP_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "NODE_ENV": {
      "enum": [
        "production"
      ]
    },
    "DEPLOYMENT_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "TELEMETRY_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "RUNTIME_NAME": {
      "type": "string"
    },
    "LETBUYY_ENABLE_LEGACY_SITE_TYPES": {
      "enum": [
        "true",
        "false"
      ],
      "description": "Defaults to false. Enables new portfolio/resume site creation only for explicitly approved legacy cohorts."
    },
    "CORS_CREDENTIAL_ORIGINS": {
      "type": "string",
      "description": "Comma-separated exact HTTPS origins that may receive credentialed API CORS. Tenant storefront and custom-domain origins must be listed explicitly; wildcard subdomain reflection is forbidden."
    },
    "PRIMARY_REGION": {
      "type": "string"
    },
    "EDGE_SCOPE": {
      "type": "string"
    },
    "ASSET_PUBLIC_BASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "CHECKOUT_ORIGIN": {
      "type": "string",
      "format": "uri"
    },
    "CHECKOUT_SIGNING_SECRET": {
      "type": "string"
    },
    "EVENT_QUEUE_NAME": {
      "type": "string"
    },
    "ANALYTICS_QUEUE_NAME": {
      "type": "string"
    },
    "SEARCH_QUEUE_NAME": {
      "type": "string"
    },
    "NOTIFICATION_QUEUE_NAME": {
      "type": "string"
    },
    "RUNTIME_QUEUE_NAME": {
      "type": "string"
    },
    "RAZORPAY_KEY_ID": {
      "type": "string"
    },
    "RAZORPAY_KEY_SECRET": {
      "type": "string"
    },
    "RAZORPAY_WEBHOOK_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_ACCOUNT_ID": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_KEY_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_WEBHOOK_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "STRIPE_SECRET_KEY": {
      "type": "string"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "type": "string"
    },
    "PAYPAL_CLIENT_ID": {
      "type": "string"
    },
    "PAYPAL_CLIENT_SECRET": {
      "type": "string"
    },
    "PAYPAL_WEBHOOK_ID": {
      "type": "string"
    },
    "PAYPAL_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "CASHFREE_APP_ID": {
      "type": "string"
    },
    "CASHFREE_SECRET_KEY": {
      "type": "string"
    },
    "CASHFREE_ENVIRONMENT": {
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "CASHFREE_API_VERSION": {
      "type": "string"
    },
    "AI_PROVIDER_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "AI_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "openai_compatible",
        "manual"
      ]
    },
    "AI_PROVIDER_API_KEY": {
      "type": "string"
    },
    "AI_PROVIDER_BASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "AI_PROVIDER_MODEL": {
      "type": "string"
    },
    "AI_CREDIT_PURCHASE_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "AI_CREDIT_PURCHASE_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "razorpay",
        "manual"
      ]
    },
    "AI_CREDIT_PRICE_INR_PAISE": {
      "type": "string"
    },
    "AI_CREDIT_RAZORPAY_KEY_ID": {
      "type": "string"
    },
    "AI_CREDIT_RAZORPAY_KEY_SECRET": {
      "type": "string"
    },
    "WHATSAPP_PROVIDER_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "WHATSAPP_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "twilio",
        "manual"
      ]
    },
    "WHATSAPP_WEBHOOK_SECRET": {
      "type": "string"
    },
    "TWILIO_ACCOUNT_SID": {
      "type": "string"
    },
    "TWILIO_AUTH_TOKEN": {
      "type": "string"
    },
    "TWILIO_WHATSAPP_FROM": {
      "type": "string"
    },
    "STAFF_INVITATION_SIGNING_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "Purpose-specific invitation proof key shared only by Gateway and queue-workers in one environment. Never a browser/mobile or Identity signing key."
    },
    "RESEND_API_KEY": {
      "type": "string"
    },
    "RESEND_FROM_EMAIL": {
      "type": "string"
    },
    "UPSTASH_REDIS_REST_URL": {
      "type": "string",
      "format": "uri"
    },
    "UPSTASH_REDIS_REST_TOKEN": {
      "type": "string"
    },
    "PAYMENT_CONFIG_ENCRYPTION_KEY": {
      "type": "string"
    },
    "TURNSTILE_SECRET_KEY": {
      "type": "string"
    },
    "VERCEL_API_TOKEN": {
      "type": "string"
    },
    "VERCEL_STOREFRONT_PROJECT_ID": {
      "type": "string"
    },
    "VERCEL_TEAM_ID": {
      "type": "string"
    },
    "VERCEL_TEAM_SLUG": {
      "type": "string"
    },
    "ABUSE_REPUTATION_API_URL": {
      "type": "string",
      "format": "uri"
    },
    "ABUSE_REPUTATION_API_KEY": {
      "type": "string"
    },
    "CUSTOM_DOMAIN_RECONCILE_BATCH_LIMIT": {
      "type": "string"
    },
    "REGISTRAR_PROVIDER": {
      "enum": [
        "resellerclub",
        "opensrs",
        "sandbox"
      ]
    },
    "REGISTRAR_API_URL": {
      "type": "string",
      "format": "uri"
    },
    "REGISTRAR_RESELLER_ID": {
      "type": "string"
    },
    "REGISTRAR_API_KEY": {
      "type": "string"
    },
    "REGISTRAR_USERNAME": {
      "type": "string"
    },
    "REGISTRAR_PASSWORD": {
      "type": "string"
    },
    "REGISTRAR_DEFAULT_CURRENCY": {
      "type": "string"
    },
    "REGISTRAR_MOCK_ENABLED": {
      "enum": [
        "true",
        "false"
      ]
    },
    "R2_BUCKET": {
      "type": "string"
    },
    "KYC_UPLOAD_ENABLED": {
      "enum": [
        "true",
        "false"
      ]
    },
    "CUSTOMER_SESSION_SECRET": {
      "type": "string"
    },
    "STEP_UP_SIGNING_SECRET": {
      "type": "string"
    },
    "LETBUYY_IDENTITY_ISSUER": {
      "type": "string"
    },
    "LETBUYY_IDENTITY_PUBLIC_JWKS": {
      "type": "string"
    },
    "CUSTOMER_PASSWORD_RESET_URL": {
      "type": "string"
    },
    "STOREFRONT_BASE_URL": {
      "type": "string"
    },
    "NEXT_PUBLIC_STOREFRONT_URL": {
      "type": "string"
    },
    "NEXT_PUBLIC_ADMIN_URL": {
      "type": "string"
    },
    "LETBUYY_PLATFORM_DOMAIN": {
      "type": "string"
    },
    "NEXT_PUBLIC_PLATFORM_DOMAIN": {
      "type": "string"
    },
    "VERCEL_ORG_ID": {
      "type": "string"
    },
    "QUEUE_TENANT_ENVELOPE_SECRET": {
      "type": "string"
    },
    "LETBUYY_KMS_SANDBOX_SECRET": {
      "type": "string"
    },
    "LETBUYY_KMS_KEY_ID": {
      "type": "string"
    },
    "SES_ACCESS_KEY_ID": {
      "type": "string"
    },
    "SES_SECRET_ACCESS_KEY": {
      "type": "string"
    },
    "SENDGRID_API_KEY": {
      "type": "string"
    },
    "SHIPROCKET_TOKEN": {
      "type": "string"
    },
    "DELHIVERY_TOKEN": {
      "type": "string"
    },
    "PICKRR_TOKEN": {
      "type": "string"
    },
    "PRODUCT_VARIANTS_RELATIONAL_READS": {
      "type": "string"
    },
    "REQUEST_LOG_SAMPLE_RATE": {
      "type": "string"
    },
    "RATE_LIMIT_KV_FALLBACK": {
      "type": "string"
    },
    "LETBUYY_KMS_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "LETBUYY_ALLOW_SANDBOX_KMS": {
      "enum": [
        "true",
        "false"
      ]
    },
    "LETBUYY_WAREHOUSE_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "LETBUYY_AI_MODEL_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "LETBUYY_EMAIL_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "LOGISTICS_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "BUYER_AI_ENABLED": {
      "enum": [
        "false",
        "true"
      ],
      "default": "false"
    },
    "BUYER_AI_PROFILE": {
      "type": "string",
      "description": "Server-only JSON approved buyer shopping profile, provider endpoint/model, content scope, audited conservative token-bound coefficients and all caps; parsed fail-closed by the buyer infrastructure adapter.",
      "contentMediaType": "application/json",
      "contentSchema": {
        "$ref": "#/$defs/BuyerAiProfile"
      }
    },
    "BUYER_AI_API_KEY": {
      "type": "string"
    },
    "BUYER_AI_FINGERPRINT_KEY": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "BUYER_AI_ENABLED"
        ],
        "properties": {
          "BUYER_AI_ENABLED": {
            "const": "true"
          }
        }
      },
      "then": {
        "required": [
          "BUYER_AI_PROFILE",
          "BUYER_AI_API_KEY",
          "BUYER_AI_FINGERPRINT_KEY"
        ],
        "properties": {
          "BUYER_AI_PROFILE": {
            "minLength": 2
          },
          "BUYER_AI_API_KEY": {
            "minLength": 1
          },
          "BUYER_AI_FINGERPRINT_KEY": {
            "minLength": 32
          }
        }
      }
    }
  ],
  "$defs": {
    "BuyerAiProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": {
          "const": true
        },
        "purpose": {
          "const": "buyer_shopping_public"
        },
        "content_scope": {
          "const": "submitted_message_and_visible_chat"
        },
        "provider": {
          "const": "openai_compatible"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "requests_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "token_bound_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "input_token_bound_per_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "input_framing_token_bound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "approved",
        "purpose",
        "content_scope",
        "provider",
        "id",
        "endpoint",
        "model",
        "requests_per_day",
        "token_bound_per_day",
        "max_input_bytes",
        "max_output_tokens",
        "timeout_ms",
        "input_token_bound_per_byte",
        "input_framing_token_bound"
      ]
    }
  }
}
