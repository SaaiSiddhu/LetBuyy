{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Worker Environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY"
  ],
  "properties": {
    "SUPABASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "SUPABASE_ANON_KEY": {
      "type": "string"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "type": "string"
    },
    "AUTH_SECRET": {
      "type": "string"
    },
    "CSRF_SECRET": {
      "type": "string"
    },
    "INTERNAL_API_SECRET": {
      "type": "string"
    },
    "PREVIEW_SIGNING_KEY": {
      "type": "string"
    },
    "STORE_ACCESS_SIGNING_KEY": {
      "type": "string"
    },
    "LETBUYY_INTERNAL_API_SECRET": {
      "type": "string"
    },
    "NEXT_PUBLIC_STORE_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "STOREFRONT_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "PLATFORM_ROOT_DOMAIN": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "CUSTOM_DOMAIN_CNAME_TARGET": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "PLATFORM_CONSOLE_API_TOKEN": {
      "type": "string"
    },
    "ENVIRONMENT": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "APP_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "NODE_ENV": {
      "enum": [
        "production"
      ]
    },
    "DEPLOYMENT_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "TELEMETRY_ENV": {
      "enum": [
        "staging",
        "production"
      ]
    },
    "RUNTIME_NAME": {
      "type": "string"
    },
    "LETBUYY_ENABLE_LEGACY_SITE_TYPES": {
      "enum": [
        "true",
        "false"
      ],
      "description": "Defaults to false. Enables new portfolio/resume site creation only for explicitly approved legacy cohorts."
    },
    "CORS_CREDENTIAL_ORIGINS": {
      "type": "string",
      "description": "Comma-separated exact HTTPS origins that may receive credentialed API CORS. Tenant storefront and custom-domain origins must be listed explicitly; wildcard subdomain reflection is forbidden."
    },
    "PRIMARY_REGION": {
      "type": "string"
    },
    "EDGE_SCOPE": {
      "type": "string"
    },
    "ASSET_PUBLIC_BASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "CHECKOUT_ORIGIN": {
      "type": "string",
      "format": "uri"
    },
    "CHECKOUT_SIGNING_SECRET": {
      "type": "string"
    },
    "EVENT_QUEUE_NAME": {
      "type": "string"
    },
    "ANALYTICS_QUEUE_NAME": {
      "type": "string"
    },
    "SEARCH_QUEUE_NAME": {
      "type": "string"
    },
    "NOTIFICATION_QUEUE_NAME": {
      "type": "string"
    },
    "RUNTIME_QUEUE_NAME": {
      "type": "string"
    },
    "RAZORPAY_KEY_ID": {
      "type": "string"
    },
    "RAZORPAY_KEY_SECRET": {
      "type": "string"
    },
    "RAZORPAY_WEBHOOK_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_ACCOUNT_ID": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_KEY_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_WEBHOOK_SECRET": {
      "type": "string"
    },
    "RAZORPAY_ROUTE_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "STRIPE_SECRET_KEY": {
      "type": "string"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "type": "string"
    },
    "PAYPAL_CLIENT_ID": {
      "type": "string"
    },
    "PAYPAL_CLIENT_SECRET": {
      "type": "string"
    },
    "PAYPAL_WEBHOOK_ID": {
      "type": "string"
    },
    "PAYPAL_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "CASHFREE_APP_ID": {
      "type": "string"
    },
    "CASHFREE_SECRET_KEY": {
      "type": "string"
    },
    "CASHFREE_ENVIRONMENT": {
      "enum": [
        "sandbox",
        "production"
      ]
    },
    "CASHFREE_API_VERSION": {
      "type": "string"
    },
    "AI_PROVIDER_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "AI_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "openai_compatible",
        "manual"
      ]
    },
    "AI_PROVIDER_API_KEY": {
      "type": "string"
    },
    "AI_PROVIDER_BASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "AI_PROVIDER_MODEL": {
      "type": "string"
    },
    "AI_CREDIT_PURCHASE_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "AI_CREDIT_PURCHASE_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "razorpay",
        "manual"
      ]
    },
    "AI_CREDIT_PRICE_INR_PAISE": {
      "type": "string"
    },
    "AI_CREDIT_RAZORPAY_KEY_ID": {
      "type": "string"
    },
    "AI_CREDIT_RAZORPAY_KEY_SECRET": {
      "type": "string"
    },
    "WHATSAPP_PROVIDER_MODE": {
      "enum": [
        "sandbox",
        "live"
      ]
    },
    "WHATSAPP_PROVIDER": {
      "enum": [
        "letbuyy_sandbox",
        "twilio",
        "manual"
      ]
    },
    "WHATSAPP_WEBHOOK_SECRET": {
      "type": "string"
    },
    "TWILIO_ACCOUNT_SID": {
      "type": "string"
    },
    "TWILIO_AUTH_TOKEN": {
      "type": "string"
    },
    "TWILIO_WHATSAPP_FROM": {
      "type": "string"
    },
    "RESEND_API_KEY": {
      "type": "string"
    },
    "RESEND_FROM_EMAIL": {
      "type": "string"
    },
    "UPSTASH_REDIS_REST_URL": {
      "type": "string",
      "format": "uri"
    },
    "UPSTASH_REDIS_REST_TOKEN": {
      "type": "string"
    },
    "PAYMENT_CONFIG_ENCRYPTION_KEY": {
      "type": "string"
    },
    "TURNSTILE_SECRET_KEY": {
      "type": "string"
    },
    "VERCEL_API_TOKEN": {
      "type": "string"
    },
    "VERCEL_STOREFRONT_PROJECT_ID": {
      "type": "string"
    },
    "VERCEL_TEAM_ID": {
      "type": "string"
    },
    "VERCEL_TEAM_SLUG": {
      "type": "string"
    },
    "ABUSE_REPUTATION_API_URL": {
      "type": "string",
      "format": "uri"
    },
    "ABUSE_REPUTATION_API_KEY": {
      "type": "string"
    },
    "CUSTOM_DOMAIN_RECONCILE_BATCH_LIMIT": {
      "type": "string"
    },
    "REGISTRAR_PROVIDER": {
      "enum": [
        "resellerclub",
        "opensrs",
        "mock"
      ]
    },
    "REGISTRAR_API_URL": {
      "type": "string",
      "format": "uri"
    },
    "REGISTRAR_RESELLER_ID": {
      "type": "string"
    },
    "REGISTRAR_API_KEY": {
      "type": "string"
    },
    "REGISTRAR_USERNAME": {
      "type": "string"
    },
    "REGISTRAR_PASSWORD": {
      "type": "string"
    },
    "REGISTRAR_DEFAULT_CURRENCY": {
      "type": "string"
    },
    "REGISTRAR_MOCK_ENABLED": {
      "enum": [
        "true",
        "false"
      ]
    },
    "R2_BUCKET": {
      "type": "string"
    }
  }
}
