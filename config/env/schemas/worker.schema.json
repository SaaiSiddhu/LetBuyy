{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Worker Environment",
  "type": "object",
  "additionalProperties": true,
  "required": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"],
  "properties": {
    "SUPABASE_URL": { "type": "string", "format": "uri" },
    "SUPABASE_ANON_KEY": { "type": "string" },
    "SUPABASE_SERVICE_ROLE_KEY": { "type": "string" },
    "AUTH_SECRET": { "type": "string" },
    "CSRF_SECRET": { "type": "string" },
    "INTERNAL_API_SECRET": { "type": "string" },
    "LETBUYY_INTERNAL_API_SECRET": { "type": "string" },
    "PLATFORM_CONSOLE_API_TOKEN": { "type": "string" },
    "ENVIRONMENT": { "enum": ["local", "development", "staging", "production"] },
    "APP_ENV": { "enum": ["local", "development", "staging", "production"] },
    "NODE_ENV": { "enum": ["development", "production", "test"] },
    "DEPLOYMENT_ENV": { "enum": ["local", "dev", "staging", "production"] },
    "TELEMETRY_ENV": { "enum": ["local", "development", "staging", "production"] },
    "RUNTIME_NAME": { "type": "string" },
    "PRIMARY_REGION": { "type": "string" },
    "FAILOVER_REGION": { "type": "string" },
    "ASSET_PUBLIC_BASE_URL": { "type": "string", "format": "uri" },
    "EVENT_QUEUE_NAME": { "type": "string" },
    "ANALYTICS_QUEUE_NAME": { "type": "string" },
    "SEARCH_QUEUE_NAME": { "type": "string" },
    "NOTIFICATION_QUEUE_NAME": { "type": "string" },
    "RUNTIME_QUEUE_NAME": { "type": "string" },
    "RAZORPAY_KEY_ID": { "type": "string" },
    "RAZORPAY_KEY_SECRET": { "type": "string" },
    "RAZORPAY_WEBHOOK_SECRET": { "type": "string" },
    "STRIPE_SECRET_KEY": { "type": "string" },
    "STRIPE_WEBHOOK_SECRET": { "type": "string" },
    "PAYPAL_CLIENT_ID": { "type": "string" },
    "PAYPAL_CLIENT_SECRET": { "type": "string" },
    "PAYPAL_WEBHOOK_ID": { "type": "string" },
    "PAYPAL_MODE": { "enum": ["sandbox", "live"] },
    "RESEND_API_KEY": { "type": "string" },
    "RESEND_FROM_EMAIL": { "type": "string" },
    "UPSTASH_REDIS_REST_URL": { "type": "string", "format": "uri" },
    "UPSTASH_REDIS_REST_TOKEN": { "type": "string" },
    "PAYMENT_CONFIG_ENCRYPTION_KEY": { "type": "string" },
    "R2_BUCKET": { "type": "string" }
  }
}
