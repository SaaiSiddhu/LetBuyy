{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Staging And Production Secret Matrix",
  "type": "object",
  "required": ["version", "policy", "stores", "nextApps", "workers", "supabase", "ciSecrets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "policy": {
      "type": "object",
      "required": ["deploymentTargets", "localPolicy", "secretHandling"],
      "additionalProperties": true,
      "properties": {
        "deploymentTargets": {
          "type": "array",
          "items": { "enum": ["staging", "production"] },
          "minItems": 2,
          "uniqueItems": true
        },
        "localPolicy": { "enum": ["same-shape-only"] },
        "secretHandling": { "enum": ["secret-manager-only"] }
      }
    },
    "stores": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "nextApps": {
      "type": "object",
      "required": ["owners", "public", "server"],
      "additionalProperties": true,
      "properties": {
        "owners": { "$ref": "#/$defs/stringList" },
        "public": { "$ref": "#/$defs/stringList" },
        "server": { "$ref": "#/$defs/stringList" },
        "platformConsoleOnly": { "$ref": "#/$defs/stringList" }
      }
    },
    "workers": {
      "type": "object",
      "required": ["owners", "requiredSecrets", "bindings"],
      "additionalProperties": true,
      "properties": {
        "owners": { "$ref": "#/$defs/stringList" },
        "requiredSecrets": { "$ref": "#/$defs/stringList" },
        "optionalProviderSecrets": { "$ref": "#/$defs/stringList" },
        "bindings": { "$ref": "#/$defs/stringList" }
      }
    },
    "supabase": {
      "type": "object",
      "required": ["staging", "production"],
      "additionalProperties": false,
      "properties": {
        "staging": { "$ref": "#/$defs/supabaseEnvironment" },
        "production": { "$ref": "#/$defs/supabaseEnvironment" }
      }
    },
    "ciSecrets": {
      "type": "object",
      "required": ["shared", "vercelProjectIdSuffixes", "generatedSecretSuffixes"],
      "additionalProperties": true,
      "properties": {
        "shared": { "$ref": "#/$defs/stringList" },
        "vercelProjectIdSuffixes": { "$ref": "#/$defs/stringList" },
        "generatedSecretSuffixes": { "$ref": "#/$defs/stringList" }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supabaseEnvironment": {
      "type": "object",
      "required": ["projectRefSecret", "urlSecret", "anonKeySecret", "serviceRoleSecret", "dbConnectionSecret"],
      "additionalProperties": false,
      "properties": {
        "projectRefSecret": { "type": "string" },
        "urlSecret": { "type": "string" },
        "anonKeySecret": { "type": "string" },
        "serviceRoleSecret": { "type": "string" },
        "dbConnectionSecret": { "type": "string" }
      }
    }
  }
}
