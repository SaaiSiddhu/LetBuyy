{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LetBuyy Next App Environment",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "LETBUYY_MERCHANT_MOBILE_AUTH_ENABLED": { "enum": ["true", "false"] },
    "LETBUYY_ANDROID_APP_LINKS_SHA256": { "type": "string", "description": "Comma-separated public SHA-256 fingerprints of this estate's approved Android signing certificates." },
    "NEXT_PUBLIC_API_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_API_BASE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_ACCOUNTS_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_MARKETING_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_ADMIN_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_STOREFRONT_URL": { "type": "string", "format": "uri" },
    "CHECKOUT_ORIGIN": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_THEME_MARKETPLACE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_APP_MARKETPLACE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_DEVELOPER_PORTAL_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_STORE_ROOT_DOMAIN_ALIASES": { "type": "string", "description": "Comma-separated exact platform preview hostnames; never tenant wildcard patterns." },
    "NEXT_PUBLIC_STORE_ROOT_DOMAIN": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "NEXT_PUBLIC_SUPPORT_EMAIL": { "type": "string", "format": "email" },
    "NEXT_PUBLIC_ASSET_PUBLIC_BASE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_APP_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_ENV": { "type": "string" },
    "NEXT_PUBLIC_SUPABASE_URL": { "type": "string", "format": "uri" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "type": "string" },
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": { "type": "string" },
    "NEXT_PUBLIC_LETBUYY_ENABLE_DEV_AUTH_BYPASS": { "enum": ["true", "false"] },
    "NEXT_PUBLIC_LETBUYY_ENABLE_LEGACY_SITE_TYPES": { "enum": ["true", "false"] },
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": { "type": "string" },
    "LETBUYY_API_URL": { "type": "string", "format": "uri" },
    "LETBUYY_API_BASE_URL": { "type": "string", "format": "uri" },
    "API_URL": { "type": "string", "format": "uri" },
    "API_BASE_URL": { "type": "string", "format": "uri" },
    "INTERNAL_API_SECRET": { "type": "string" },
    "QUEUE_TENANT_ENVELOPE_SECRET": { "type": "string" },
    "PREVIEW_SIGNING_KEY": { "type": "string" },
    "STORE_ACCESS_SIGNING_KEY": { "type": "string" },
    "CHECKOUT_SIGNING_SECRET": { "type": "string" },
    "AUTH_SECRET": { "type": "string" },
    "CUSTOMER_SESSION_SECRET": { "type": "string" },
    "ACCOUNTS_COOKIE_SECRET": { "type": "string" },
    "LETBUYY_IDENTITY_ISSUER": { "type": "string", "format": "uri" },
    "LETBUYY_IDENTITY_PRIVATE_JWK": { "type": "string", "description": "Identity runtime only; never configure on Console or Gateway." },
    "LETBUYY_IDENTITY_PUBLIC_JWKS": { "type": "string", "description": "Public asymmetric verification keys; no private JWK members." },
    "LETBUYY_IDENTITY_URL": { "type": "string", "format": "uri", "description": "Console server-to-server Identity origin." },
    "CSRF_SECRET": { "type": "string" },
    "COOKIE_DOMAIN": { "type": "string" },
    "ADMIN_ORIGIN": { "type": "string", "format": "uri" },
    "STOREFRONT_FRAME_ANCESTORS": { "type": "string" },
    "PLATFORM_CONSOLE_ALLOWED_EMAILS": { "type": "string" },
    "PLATFORM_CONSOLE_SESSION_SECRET": { "type": "string", "deprecated": true, "description": "Retired from canonical Console/Gateway session verification." },
    "PLATFORM_CONSOLE_TOTP_SECRETS": { "type": "string", "description": "Per-account configuration JSON, held by Identity only." },
    "PLATFORM_CONSOLE_TOTP_SECRET": { "type": "string" },
    "PLATFORM_CONSOLE_DEV_MFA_CODE": { "type": "string" },
    "PLATFORM_CONSOLE_API_TOKEN": { "type": "string" },
    "PLATFORM_CONSOLE_API_BASE_URL": { "type": "string", "format": "uri" },
    "LETBUYY_ENABLE_DEV_AUTH_BYPASS": { "enum": ["true", "false"] },
    "LETBUYY_ENABLE_LEGACY_SITE_TYPES": { "enum": ["true", "false"] },
