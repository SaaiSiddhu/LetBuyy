# ============================================================
# LETBUYY PRODUCTION ENVIRONMENT VARIABLES
# Copy these into Vercel environment variables for production.
# Never commit real values — only this template.
# ============================================================

# API
NEXT_PUBLIC_API_URL=https://api.letbuyy.store/v1
NEXT_PUBLIC_API_BASE_URL=https://api.letbuyy.store/v1
LETBUYY_API_URL=https://api.letbuyy.store/v1
LETBUYY_API_BASE_URL=https://api.letbuyy.store/v1
API_URL=https://api.letbuyy.store/v1
API_BASE_URL=https://api.letbuyy.store/v1

# App URLs
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.letbuyy.store
NEXT_PUBLIC_ADMIN_URL=https://admin.letbuyy.store
NEXT_PUBLIC_STOREFRONT_URL=https://store.letbuyy.store
NEXT_PUBLIC_STOREFRONT_LOCAL_URL=https://store.letbuyy.store
NEXT_PUBLIC_APP_URL=https://store.letbuyy.store
NEXT_PUBLIC_ENV=production

# Supabase (from config/supabase/production.json after Phase 5)
NEXT_PUBLIC_SUPABASE_URL=https://PRODUCTION_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PRODUCTION_ANON_KEY
SUPABASE_URL=https://PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PRODUCTION_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PRODUCTION_SERVICE_ROLE_KEY

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
CUSTOMER_SESSION_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
LETBUYY_INTERNAL_API_SECRET=generate-with-openssl-rand-base64-32
CSRF_SECRET=generate-with-openssl-rand-base64-32
COOKIE_DOMAIN=.letbuyy.store
ADMIN_ORIGIN=https://admin.letbuyy.store

# Email (Resend)
RESEND_API_KEY=re_production_xxxx
RESEND_FROM_EMAIL=noreply@letbuyy.store

# Payments (Razorpay live keys for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=razorpay_production_secret
RAZORPAY_WEBHOOK_SECRET=razorpay_production_webhook_secret
PAYMENT_CONFIG_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# Optional payment providers (configure only when enabled)
STRIPE_SECRET_KEY=stripe_production_secret
STRIPE_WEBHOOK_SECRET=stripe_production_webhook_secret
PAYPAL_CLIENT_ID=paypal_production_client_id
PAYPAL_CLIENT_SECRET=paypal_production_client_secret
PAYPAL_WEBHOOK_ID=paypal_production_webhook_id
PAYPAL_MODE=live

# Turnstile (Cloudflare)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=production_turnstile_site_key
TURNSTILE_SECRET_KEY=production_turnstile_secret_key

# Platform Console
PLATFORM_CONSOLE_ALLOWED_EMAILS=your@email.com
PLATFORM_CONSOLE_SESSION_SECRET=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_TOTP_SECRET=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_API_TOKEN=generate-with-openssl-rand-base64-32
PLATFORM_CONSOLE_API_BASE_URL=https://api.letbuyy.store/v1

# Upstash Redis (if used)
UPSTASH_REDIS_REST_URL=https://production-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=production_redis_token
