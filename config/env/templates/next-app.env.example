# Next app public configuration
NEXT_PUBLIC_API_URL=https://api.example.com/v1
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.example.com
NEXT_PUBLIC_MARKETING_URL=https://www.example.com
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_STOREFRONT_URL=https://storefront.example.com
CHECKOUT_ORIGIN=https://checkout.example.com
NEXT_PUBLIC_THEME_MARKETPLACE_URL=https://themes.example.com
NEXT_PUBLIC_APP_MARKETPLACE_URL=https://apps.example.com
NEXT_PUBLIC_DEVELOPER_PORTAL_URL=https://developer.example.com
NEXT_PUBLIC_STORE_ROOT_DOMAIN=letbuyy.store
NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET=connect.letbuyy.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_ASSET_PUBLIC_BASE_URL=https://cdn.example.com
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-public-site-key
NEXT_PUBLIC_LETBUYY_ENABLE_DEV_AUTH_BYPASS=false
NEXT_PUBLIC_LETBUYY_ENABLE_LEGACY_SITE_TYPES=false
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace-with-public-razorpay-key-id

# Server-only Next route handler configuration
LETBUYY_API_URL=https://api.example.com/v1
LETBUYY_API_BASE_URL=https://api.example.com/v1
API_URL=https://api.example.com/v1
API_BASE_URL=https://api.example.com/v1
INTERNAL_API_SECRET=replace-with-server-secret
INTERNAL_API_SECRET_PREVIOUS=
LETBUYY_INTERNAL_API_SECRET=replace-with-server-secret
LETBUYY_INTERNAL_API_SECRET_PREVIOUS=
QUEUE_TENANT_ENVELOPE_SECRET=replace-with-server-secret
PREVIEW_SIGNING_KEY=replace-with-server-secret
STORE_ACCESS_SIGNING_KEY=replace-with-server-secret
CHECKOUT_SIGNING_SECRET=replace-with-server-secret
AUTH_SECRET=replace-with-server-secret
CUSTOMER_SESSION_SECRET=replace-with-server-secret
ACCOUNTS_COOKIE_SECRET=replace-with-server-secret
LETBUYY_IDENTITY_ISSUER=https://accounts.example.com
# Identity runtime ONLY: never supply the private JWK to Console/Gateway.
LETBUYY_IDENTITY_PRIVATE_JWK=replace-with-identity-platform-private-jwk-json
# Public verification configuration on Console and Gateway (also valid on Identity).
LETBUYY_IDENTITY_PUBLIC_JWKS=replace-with-public-jwks-json
# Console server-to-server origin; use HTTPS outside isolated loopback proof.
LETBUYY_IDENTITY_URL=https://accounts.example.com
CSRF_SECRET=replace-with-server-secret
# Storefront runtime must leave COOKIE_DOMAIN unset so shopper cookies are host-only.
COOKIE_DOMAIN=.example.com
ADMIN_ORIGIN=https://admin.example.com
STOREFRONT_FRAME_ANCESTORS=https://admin.example.com https://console.example.com
PLATFORM_CONSOLE_ALLOWED_EMAILS=admin@letbuyy.local
# Identity runtime ONLY; retain per-account custody and approved administrator reset.
PLATFORM_CONSOLE_TOTP_SECRETS={"admin@letbuyy.local":"replace-with-per-principal-totp-secret"}
PLATFORM_CONSOLE_API_TOKEN=replace-with-server-secret
PLATFORM_CONSOLE_API_BASE_URL=https://api.example.com/v1
LETBUYY_ENABLE_DEV_AUTH_BYPASS=false
LETBUYY_ENABLE_LEGACY_SITE_TYPES=false
RESEND_API_KEY=replace-with-server-secret
RESEND_FROM_EMAIL=noreply@example.com
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-secret
TURNSTILE_SECRET_KEY=replace-with-server-secret
STRIPE_SECRET_KEY=replace-with-server-secret
STRIPE_WEBHOOK_SECRET=replace-with-server-secret
PAYPAL_CLIENT_ID=replace-with-server-client-id
PAYPAL_CLIENT_SECRET=replace-with-server-secret
PAYPAL_WEBHOOK_ID=replace-with-webhook-id
PAYPAL_MODE=sandbox

# Optional staging-only guard for storefront-runtime /api/seed.
# Do not configure this route for production seeding.
SEED_SECRET=replace-with-optional-staging-seed-secret
