# Cloudflare Worker variables and secrets
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-worker-secret
AUTH_SECRET=replace-with-worker-secret
CSRF_SECRET=replace-with-worker-secret
INTERNAL_API_SECRET=replace-with-worker-secret
INTERNAL_API_SECRET_PREVIOUS=
PREVIEW_SIGNING_KEY=replace-with-worker-secret
STORE_ACCESS_SIGNING_KEY=replace-with-worker-secret
LETBUYY_INTERNAL_API_SECRET=replace-with-worker-secret
LETBUYY_INTERNAL_API_SECRET_PREVIOUS=
INTERNAL_GATEWAY_IP_ALLOWLIST=127.0.0.1/32
PLATFORM_CONSOLE_API_TOKEN=replace-with-worker-secret
NEXT_PUBLIC_STORE_ROOT_DOMAIN=letbuyy.com
STOREFRONT_ROOT_DOMAIN=letbuyy.com
CUSTOM_DOMAIN_CNAME_TARGET=connect.letbuyy.com
NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET=connect.letbuyy.com
# CUTOVER (same DNS/Vercel release only): PLATFORM_ROOT_DOMAIN=letbuyy.com
PLATFORM_ROOT_DOMAIN=letbuyy.com
ENVIRONMENT=staging
APP_ENV=staging
NODE_ENV=production
DEPLOYMENT_ENV=staging
TELEMETRY_ENV=staging
RUNTIME_NAME=API Gateway
LETBUYY_ENABLE_LEGACY_SITE_TYPES=false
CORS_CREDENTIAL_ORIGINS=https://accounts-staging.letbuyy.com,https://admin-staging.letbuyy.com,https://store-staging.letbuyy.com
PRIMARY_REGION=ap-south-1
EDGE_SCOPE=global-edge
ASSET_PUBLIC_BASE_URL=https://cdn-staging.letbuyy.com/assets
EVENT_QUEUE_NAME=letbuyy-events-staging
ANALYTICS_QUEUE_NAME=letbuyy-analytics-staging
SEARCH_QUEUE_NAME=letbuyy-search-indexing-staging
NOTIFICATION_QUEUE_NAME=letbuyy-notifications-staging
RUNTIME_QUEUE_NAME=letbuyy-runtime-staging

# Identity, platform URLs, and signing seams
CUSTOMER_SESSION_SECRET=replace-with-worker-secret
STEP_UP_SIGNING_SECRET=replace-with-worker-secret
LETBUYY_IDENTITY_ISSUER=https://accounts-staging.letbuyy.com
LETBUYY_IDENTITY_PUBLIC_JWKS=https://accounts-staging.letbuyy.com/.well-known/jwks.json
CUSTOMER_PASSWORD_RESET_URL=https://accounts-staging.letbuyy.com/reset-password
STOREFRONT_BASE_URL=https://store-staging.letbuyy.com
NEXT_PUBLIC_STOREFRONT_URL=https://store-staging.letbuyy.com
NEXT_PUBLIC_ADMIN_URL=https://admin-staging.letbuyy.com
LETBUYY_PLATFORM_DOMAIN=letbuyy.com
NEXT_PUBLIC_PLATFORM_DOMAIN=letbuyy.com
VERCEL_ORG_ID=replace-with-vercel-org-id
QUEUE_TENANT_ENVELOPE_SECRET=replace-with-worker-secret
LETBUYY_KMS_MODE=sandbox
LETBUYY_KMS_SANDBOX_SECRET=replace-with-worker-secret
LETBUYY_KMS_KEY_ID=letbuyy-sandbox
LETBUYY_ALLOW_SANDBOX_KMS=true
LETBUYY_WAREHOUSE_MODE=sandbox
LETBUYY_AI_MODEL_MODE=sandbox
PRODUCT_VARIANTS_RELATIONAL_READS=on
REQUEST_LOG_SAMPLE_RATE=0.01
RATE_LIMIT_KV_FALLBACK=off

# Provider secrets
RAZORPAY_KEY_ID=replace-with-provider-key-id
RAZORPAY_KEY_SECRET=replace-with-provider-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-provider-secret
STRIPE_SECRET_KEY=replace-with-provider-secret
STRIPE_WEBHOOK_SECRET=replace-with-provider-secret
PAYPAL_CLIENT_ID=replace-with-provider-client-id
PAYPAL_CLIENT_SECRET=replace-with-provider-secret
PAYPAL_WEBHOOK_ID=replace-with-provider-webhook-id
PAYPAL_MODE=sandbox
CASHFREE_APP_ID=replace-with-provider-app-id
CASHFREE_SECRET_KEY=replace-with-provider-secret
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01
AI_PROVIDER_MODE=sandbox
AI_PROVIDER=letbuyy_sandbox
AI_PROVIDER_MODEL=letbuyy-sandbox-copywriter
AI_PROVIDER_API_KEY=SKIP_NEEDS_HUMAN_AI_PROVIDER_API_KEY
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_CREDIT_PURCHASE_MODE=sandbox
AI_CREDIT_PURCHASE_PROVIDER=letbuyy_sandbox
AI_CREDIT_PRICE_INR_PAISE=100
WHATSAPP_PROVIDER_MODE=sandbox
WHATSAPP_PROVIDER=letbuyy_sandbox
WHATSAPP_WEBHOOK_SECRET=letbuyy-sandbox-whatsapp-webhook
TWILIO_ACCOUNT_SID=SKIP_NEEDS_HUMAN_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=SKIP_NEEDS_HUMAN_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=SKIP_NEEDS_HUMAN_TWILIO_WHATSAPP_FROM
# Gateway and queue-workers: same purpose key within one environment, distinct across staging/production.
# Rotation invalidates outstanding proofs; owners must renew those invitations. Never expose to apps.
STAFF_INVITATION_SIGNING_SECRET=replace-with-purpose-specific-secret-at-least-32-characters
RESEND_API_KEY=replace-with-provider-secret
RESEND_FROM_EMAIL=noreply@example.com
LETBUYY_EMAIL_MODE=sandbox
SES_ACCESS_KEY_ID=SKIP_NEEDS_HUMAN_SES_ACCESS_KEY_ID
SES_SECRET_ACCESS_KEY=SKIP_NEEDS_HUMAN_SES_SECRET_ACCESS_KEY
SENDGRID_API_KEY=SKIP_NEEDS_HUMAN_SENDGRID_API_KEY
LOGISTICS_MODE=sandbox
SHIPROCKET_TOKEN=SKIP_NEEDS_HUMAN_SHIPROCKET_TOKEN
DELHIVERY_TOKEN=SKIP_NEEDS_HUMAN_DELHIVERY_TOKEN
PICKRR_TOKEN=SKIP_NEEDS_HUMAN_PICKRR_TOKEN
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-provider-secret
PAYMENT_CONFIG_ENCRYPTION_KEY=replace-with-worker-secret
TOTP_ENCRYPTION_KEY=replace-with-worker-secret
TURNSTILE_SECRET_KEY=SKIP_NEEDS_HUMAN_MOBILE_TURNSTILE_SECRET

# Custom-domain automation and abuse screening
VERCEL_API_TOKEN=replace-with-provider-secret
VERCEL_STOREFRONT_PROJECT_ID=replace-with-vercel-project-id
VERCEL_TEAM_ID=replace-with-vercel-team-id
ABUSE_REPUTATION_API_URL=https://reputation-provider.example/check
ABUSE_REPUTATION_API_KEY=replace-with-provider-secret
CUSTOM_DOMAIN_RECONCILE_BATCH_LIMIT=25

# Buy-a-domain registrar resale
REGISTRAR_PROVIDER=resellerclub
REGISTRAR_API_URL=https://registrar-api.example
REGISTRAR_RESELLER_ID=replace-with-registrar-reseller-id
REGISTRAR_API_KEY=replace-with-provider-secret
REGISTRAR_USERNAME=replace-with-opensrs-username
REGISTRAR_PASSWORD=replace-with-opensrs-secret
REGISTRAR_DEFAULT_CURRENCY=INR
REGISTRAR_MOCK_ENABLED=false

# Cloudflare binding names are configured in wrangler.toml/IaC, not as raw secrets.
R2_BUCKET=letbuyy-media-staging
