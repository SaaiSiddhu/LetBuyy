# Cloudflare Worker variables and secrets
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-worker-secret
AUTH_SECRET=replace-with-worker-secret
INTERNAL_API_SECRET=replace-with-worker-secret
LETBUYY_INTERNAL_API_SECRET=replace-with-worker-secret
ENVIRONMENT=local

# Provider secrets
RAZORPAY_KEY_ID=replace-with-provider-key-id
RAZORPAY_KEY_SECRET=replace-with-provider-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-provider-secret
STRIPE_SECRET_KEY=replace-with-provider-secret
STRIPE_WEBHOOK_SECRET=replace-with-provider-secret
RESEND_API_KEY=replace-with-provider-secret
RESEND_FROM_EMAIL=noreply@example.com
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-provider-secret
PAYMENT_CONFIG_ENCRYPTION_KEY=replace-with-worker-secret

# Cloudflare binding names are configured in wrangler.toml/IaC, not as raw secrets.
R2_BUCKET=letbuyy-local

