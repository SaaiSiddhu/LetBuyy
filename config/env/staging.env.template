# LetBuyy Staging Environment Variables
# Legacy compatibility template only. Prefer staging.env.example plus
# secret-manager-backed Vercel, Cloudflare, Supabase, and provider stores.
# NEVER commit actual values.

# ========== SUPABASE (Letbuyy-Store-Staging) ==========
NEXT_PUBLIC_SUPABASE_URL=https://[STAGING_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[STAGING_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[STAGING_SERVICE_ROLE_KEY]
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ========== UPSTASH REDIS (Letbuyy-Store-Staging) ==========
UPSTASH_REDIS_REST_URL=https://[STAGING_REDIS_HOST].upstash.io
UPSTASH_REDIS_REST_TOKEN=[STAGING_REDIS_TOKEN]

# ========== CLOUDFLARE ==========
CLOUDFLARE_API_TOKEN=[CF_API_TOKEN]
CLOUDFLARE_ACCOUNT_ID=[CF_ACCOUNT_ID]

# ========== VERCEL / CI ==========
VERCEL_TOKEN=[VERCEL_TOKEN]
VERCEL_ORG_ID=[VERCEL_ORG_ID]
VERCEL_PROJECT_ID_MARKETING=[VERCEL_PROJECT_ID_MARKETING]
VERCEL_PROJECT_ID_IDENTITY=[VERCEL_PROJECT_ID_IDENTITY]
VERCEL_PROJECT_ID_MERCHANT=[VERCEL_PROJECT_ID_MERCHANT]
VERCEL_PROJECT_ID_STOREFRONT=[VERCEL_PROJECT_ID_STOREFRONT]
VERCEL_PROJECT_ID_APP_MARKETPLACE=[VERCEL_PROJECT_ID_APP_MARKETPLACE]
VERCEL_PROJECT_ID_THEME_MARKETPLACE=[VERCEL_PROJECT_ID_THEME_MARKETPLACE]
VERCEL_PROJECT_ID_PLATFORM_CONSOLE=[VERCEL_PROJECT_ID_PLATFORM_CONSOLE]
VERCEL_PROJECT_ID_PLATFORM_OPERATIONS_PORTAL=[VERCEL_PROJECT_ID_PLATFORM_OPERATIONS_PORTAL]
NEXT_PUBLIC_LETBUYY_ENABLE_LEGACY_SITE_TYPES=false
LETBUYY_ENABLE_LEGACY_SITE_TYPES=false
SUPABASE_ACCESS_TOKEN=[SUPABASE_ACCESS_TOKEN]
STAGING_SUPABASE_PROJECT_REF=[STAGING_PROJECT_REF]
STAGING_SUPABASE_URL=https://[STAGING_PROJECT_REF].supabase.co
STAGING_SUPABASE_ANON_KEY=[STAGING_ANON_KEY]
STAGING_SUPABASE_SERVICE_ROLE_KEY=[STAGING_SERVICE_ROLE_KEY]
STAGING_DB_CONNECTION_STRING=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ========== RAZORPAY TEST MODE ==========
RAZORPAY_KEY_ID=rzp_test_[KEY]
RAZORPAY_KEY_SECRET=[TEST_SECRET]
RAZORPAY_WEBHOOK_SECRET=[TEST_WEBHOOK_SECRET]
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_[KEY]

# ========== RAZORPAY ROUTE / PAYOUT RAILS ==========
RAZORPAY_ROUTE_ACCOUNT_ID=[TEST_ROUTE_ACCOUNT_ID]
RAZORPAY_ROUTE_KEY_SECRET=[TEST_ROUTE_SECRET]
RAZORPAY_ROUTE_WEBHOOK_SECRET=[TEST_ROUTE_WEBHOOK_SECRET]
RAZORPAY_ROUTE_MODE=sandbox

# ========== STRIPE TEST MODE ==========
STRIPE_SECRET_KEY=sk_test_[KEY]
STRIPE_WEBHOOK_SECRET=whsec_[TEST_WEBHOOK_SECRET]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_[KEY]

# ========== PAYPAL SANDBOX ==========
PAYPAL_CLIENT_ID=[SANDBOX_CLIENT_ID]
PAYPAL_CLIENT_SECRET=[SANDBOX_SECRET]
PAYPAL_WEBHOOK_ID=[SANDBOX_WEBHOOK_ID]

# ========== CASHFREE SANDBOX ==========
CASHFREE_APP_ID=[SANDBOX_APP_ID]
CASHFREE_SECRET_KEY=[SANDBOX_SECRET]
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2025-01-01

# ========== RESEND (EMAIL) ==========
RESEND_API_KEY=re_[STAGING_KEY]
EMAIL_FROM=noreply@staging.letbuyy.store
RESEND_FROM_EMAIL=noreply@staging.letbuyy.store

# ========== SOCIAL OAUTH ==========
GOOGLE_OAUTH_CLIENT_ID=[GOOGLE_STAGING_CLIENT_ID]
GOOGLE_OAUTH_CLIENT_SECRET=[GOOGLE_STAGING_CLIENT_SECRET]
APPLE_OAUTH_CLIENT_ID=[APPLE_STAGING_CLIENT_ID]
APPLE_OAUTH_CLIENT_SECRET=[APPLE_STAGING_CLIENT_SECRET]
OAUTH_REDIRECT_URL=https://accounts.staging.letbuyy.store/auth/callback

# ========== CLOUDFLARE TURNSTILE ==========
NEXT_PUBLIC_TURNSTILE_SITE_KEY=[STAGING_SITE_KEY]
TURNSTILE_SECRET_KEY=[STAGING_SECRET_KEY]

# ========== SESSION / AUTH SECRETS ==========
SESSION_SECRET=[64_char_random_hex]
AUTH_SECRET=[64_char_random_hex]
CUSTOMER_SESSION_SECRET=[64_char_random_hex]
COOKIE_DOMAIN=.staging.letbuyy.store
ADMIN_ORIGIN=https://admin.staging.letbuyy.store

# ========== INTERNAL SERVICE AUTH ==========
INTERNAL_API_SECRET=[32_char_random_hex]
WORKER_INTERNAL_SECRET=[32_char_random_hex]

# ========== APP URLS (STAGING) ==========
NEXT_PUBLIC_APP_URL=https://staging.letbuyy.store
NEXT_PUBLIC_ACCOUNTS_URL=https://accounts.staging.letbuyy.store
NEXT_PUBLIC_MARKETING_URL=https://staging.letbuyy.store
NEXT_PUBLIC_ADMIN_URL=https://admin.staging.letbuyy.store
NEXT_PUBLIC_STOREFRONT_URL=https://storefront.staging.letbuyy.store
NEXT_PUBLIC_THEME_MARKETPLACE_URL=https://themes.staging.letbuyy.store
NEXT_PUBLIC_API_URL=https://api.staging.letbuyy.store
NEXT_PUBLIC_API_BASE_URL=https://api.staging.letbuyy.store/v1
WORKER_API_BASE_URL=https://api.staging.letbuyy.store
ASSET_PUBLIC_BASE_URL=https://cdn-staging.letbuyy.store
STOREFRONT_FRAME_ANCESTORS=https://admin.staging.letbuyy.store https://console.staging.letbuyy.store

# ========== PLATFORM CONSOLE ==========
PLATFORM_CONSOLE_ALLOWED_EMAILS=[STAGING_OPERATOR_EMAILS]
PLATFORM_CONSOLE_API_TOKEN=[32_char_random_hex]

# ========== ENVIRONMENT LABEL ==========
NODE_ENV=production
NEXT_PUBLIC_ENV=staging
